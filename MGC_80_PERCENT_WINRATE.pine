//@version=5
indicator("MGC 80% WIN RATE SYSTEM — ALERT ONLY (TradersPost) — 10-Point Confluence",
     overlay=true,
     max_bars_back=500)

// =====================================================================
// 🎯 MGC 80% WIN RATE SYSTEM (ALERT ONLY)
// =====================================================================
// TradingView indicator that sends JSON webhooks via alert() to TradersPost.
// - No strategy/backtest functions are used.
// - Maintains an internal "virtual position" to sequence TP/STOP alerts.
//
// Recommended TradingView alert:
// - Condition: "Any alert() function call"
// - Frequency: "Once per bar close"
// =====================================================================

// ==============================
// 🎯 INSTRUMENT VERIFICATION
// ==============================
isMGC = str.contains(syminfo.ticker, "MGC") or str.contains(syminfo.ticker, "GC")
if not isMGC
    runtime.error("⚠️ This indicator is optimized for MGC/GC only. Please switch to an MGC chart.")

// ==============================
// 📊 CONFLUENCE SETTINGS
// ==============================
minConfluenceScore = input.int(7, "Minimum Confluence Score (7-10)", minval=6, maxval=10,
     tooltip="Higher = fewer trades but higher quality. 7 is the intended default.")

adxThreshold = input.float(30.0, "ADX Threshold (Strong Trends Only)", minval=20.0, maxval=40.0)
minTrendStrength = input.float(0.40, "Min Trend Strength", minval=0.30, maxval=0.60)

maxTradesPerDay = input.int(5, "Max Trades Per Day", minval=3, maxval=8)
minBarsBetweenTrades = input.int(15, "Min Bars Between Trades", minval=10, maxval=30)

volumeRatioMin = input.float(1.5, "Volume Ratio Minimum", minval=1.2, maxval=2.0)
srTolerance = input.float(0.3, "S/R Tolerance (ATR)", minval=0.2, maxval=0.5)

// ==============================
// 🕒 SESSION FILTERS
// ==============================
tradingHoursOnly = input.bool(true, "US Trading Hours Only")
currentTime = math.round(hour * 100 + minute)
inTradingHours = currentTime >= 930 and currentTime <= 1550
sessionOK = not tradingHoursOnly or inTradingHours

// ==============================
// 📊 HIGHER TIMEFRAME CONFIRMATION
// ==============================
htfTimeframe = input.timeframe("15", "Higher Timeframe",
     tooltip="15m for 5m charts, 1H for 15m charts")

htf_close = request.security(syminfo.tickerid, htfTimeframe, close)
htf_ema20 = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, 20))
htf_ema50 = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, 50))

htf_bullish = htf_close > htf_ema20 and htf_ema20 > htf_ema50
htf_bearish = htf_close < htf_ema20 and htf_ema20 < htf_ema50

// ==============================
// 📈 CORE INDICATORS
// ==============================
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

ema_bullish_aligned = ema9 > ema21 and ema21 > ema50 and ema50 > ema100 and ema100 > ema200
ema_bearish_aligned = ema9 < ema21 and ema21 < ema50 and ema50 < ema100 and ema100 < ema200

hullLen = 20
hma(src, len) =>
    half_length = math.round(len / 2)
    sqrt_length = math.round(math.sqrt(len))
    ta.wma(2 * ta.wma(src, half_length) - ta.wma(src, len), sqrt_length)

hull = hma(close, hullLen)
hull_bullish = hull > hull[1] and hull[1] > hull[2]
hull_bearish = hull < hull[1] and hull[1] < hull[2]

adxLen = 14
f_adx(_len) =>
    upMove = high - high[1]
    downMove = low[1] - low
    plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
    minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
    tr = ta.tr(true)
    atr_val = ta.rma(tr, _len)
    plusDI = atr_val != 0 ? 100 * ta.rma(plusDM, _len) / atr_val : 0.0
    minusDI = atr_val != 0 ? 100 * ta.rma(minusDM, _len) / atr_val : 0.0
    dx = (plusDI + minusDI) != 0 ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
    ta.rma(dx, _len)

adx = f_adx(adxLen)
strongTrend = adx > adxThreshold

[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
macd_bullish = macdLine > signalLine and histLine > 0
macd_bearish = macdLine < signalLine and histLine < 0

rsi = ta.rsi(close, 14)
rsi_neutral = rsi > 35 and rsi < 65

volumeMA = ta.sma(volume, 20)
volumeSpike = volume > volumeMA * volumeRatioMin

atr = ta.atr(14)

// ==============================
// 📊 SUPPORT/RESISTANCE DETECTION
// ==============================
pivotHighs = ta.pivothigh(high, 5, 5)
pivotLows = ta.pivotlow(low, 5, 5)

var float[] resistanceLevels = array.new_float(0)
var float[] supportLevels = array.new_float(0)

if not na(pivotHighs)
    array.push(resistanceLevels, pivotHighs)
    if array.size(resistanceLevels) > 10
        array.shift(resistanceLevels)

if not na(pivotLows)
    array.push(supportLevels, pivotLows)
    if array.size(supportLevels) > 10
        array.shift(supportLevels)

nearSupport = false
nearResistance = false

if array.size(supportLevels) > 0
    for i = 0 to array.size(supportLevels) - 1
        level = array.get(supportLevels, i)
        if math.abs(close - level) < atr * srTolerance
            nearSupport := true
            break

if array.size(resistanceLevels) > 0
    for i = 0 to array.size(resistanceLevels) - 1
        level = array.get(resistanceLevels, i)
        if math.abs(close - level) < atr * srTolerance
            nearResistance := true
            break

// ==============================
// 📊 MARKET STRUCTURE
// ==============================
lookbackStructure = 20
hiN = ta.highest(high, lookbackStructure)
loN = ta.lowest(low, lookbackStructure)

higherHighs = high > hiN[lookbackStructure]
higherLows = low > loN[lookbackStructure]
lowerHighs = high < hiN[lookbackStructure]
lowerLows = low < loN[lookbackStructure]

cleanBullStructure = higherHighs and higherLows
cleanBearStructure = lowerHighs and lowerLows

// ==============================
// 📊 TREND STRENGTH CALCULATION
// ==============================
trendLookback = 50
priceRange = ta.highest(high, trendLookback) - ta.lowest(low, trendLookback)
priceMove = close - close[trendLookback]
trendStrength = priceRange > 0 ? math.abs(priceMove) / priceRange : 0.0
strongTrendDirection = trendStrength > minTrendStrength

// ==============================
// 🎯 10-POINT CONFLUENCE SCORING
// ==============================
var int confluenceLong = 0
var int confluenceShort = 0
confluenceLong := 0
confluenceShort := 0

// 1) HTF confirm (2 pts)
if htf_bullish
    confluenceLong += 2
if htf_bearish
    confluenceShort += 2

// 2) ADX strong (1 pt)
if strongTrend
    confluenceLong += 1
    confluenceShort += 1

// 3) EMA aligned (1 pt)
if ema_bullish_aligned
    confluenceLong += 1
if ema_bearish_aligned
    confluenceShort += 1

// 4) Hull direction (1 pt)
if hull_bullish
    confluenceLong += 1
if hull_bearish
    confluenceShort += 1

// 5) MACD (1 pt)
if macd_bullish
    confluenceLong += 1
if macd_bearish
    confluenceShort += 1

// 6) RSI neutral (1 pt)
if rsi_neutral
    confluenceLong += 1
    confluenceShort += 1

// 7) Near S/R (1 pt)
if nearSupport
    confluenceLong += 1
if nearResistance
    confluenceShort += 1

// 8) Volume spike (1 pt)
if volumeSpike
    confluenceLong += 1
    confluenceShort += 1

// 9) Clean structure (1 pt)
if cleanBullStructure
    confluenceLong += 1
if cleanBearStructure
    confluenceShort += 1

// 10) Trend strength (1 pt)
if strongTrendDirection and close > close[trendLookback]
    confluenceLong += 1
if strongTrendDirection and close < close[trendLookback]
    confluenceShort += 1

// ==============================
// 🛡️ COOPERATIVE STOPS + TPS
// ==============================
useCooperativeStops = input.bool(true, "Use Cooperative Stop System")

initialStopATR = input.float(1.2, "Initial Stop (ATR)", minval=0.8, maxval=2.0)
breakevenTriggerATR = input.float(1.5, "Breakeven Trigger (ATR)", minval=1.0, maxval=2.5)
trailingActivateATR = input.float(3.0, "Trailing Activation (ATR)", minval=2.0, maxval=4.0)
trailingDistanceATR = input.float(1.5, "Trailing Distance (ATR)", minval=1.0, maxval=2.5)

tp1_ATR = input.float(2.5, "TP1 (ATR)", minval=1.5, maxval=3.5)
tp1_Percent = input.int(70, "TP1 % of position", minval=50, maxval=80)

tp2_ATR = input.float(4.0, "TP2 (ATR)", minval=3.0, maxval=5.0)
tp2_Percent = input.int(25, "TP2 % of REMAINING (after TP1)", minval=15, maxval=35,
     tooltip="This percent is applied to what remains after TP1 (better for small contract counts).")

tp3_ATR = input.float(6.0, "TP3 (ATR)", minval=4.5, maxval=8.0)

// ==============================
// 📈 RISK + SIZING (VIRTUAL GUARDRAILS)
// ==============================
guardrailCapital = input.float(25000, "Guardrail Capital ($)", minval=5000, step=1000)
maxDailyLossPercent = input.float(2.0, "Max Daily Loss % (virtual guardrail)", minval=1.0, maxval=3.0)
maxDailyLossDollars = guardrailCapital * maxDailyLossPercent / 100.0

fixedContracts = input.int(1, "Fixed Contracts", minval=1, maxval=50)

// ==============================
// 🔔 TRADERSPOST ALERT SETTINGS
// ==============================
enableAlerts = input.bool(true, "Enable TradersPost Alerts")
emitExitAlerts = input.bool(true, "Emit TP/STOP Exit Alerts")
includeBracketOnEntry = input.bool(true, "Include Stop + TP1 on Entry Alert")

traderspostTicker = input.string("MGC1!", "TradersPost Ticker", tooltip="Sent in JSON. Map in TradersPost to your broker symbol.")

// ==============================
// 🧾 DAILY TRACKING (VIRTUAL)
// ==============================
var float dailyRealizedPnL = 0.0
var int dailyTrades = 0
var int lastTradeBar = 0

newDay = ta.change(time("D")) != 0
if newDay
    dailyRealizedPnL := 0.0
    dailyTrades := 0
    lastTradeBar := 0

maxLossReached = dailyRealizedPnL < -maxDailyLossDollars
maxTradesReached = dailyTrades >= maxTradesPerDay

// ==============================
// 📊 VIRTUAL POSITION STATE
// ==============================
var bool inPos = false
var bool isLong = false
var float entryPrice = na
var float currentStop = na
var bool tp1_hit = false
var bool tp2_hit = false
var bool breakeven_active = false
var bool trailing_active = false
var float qtyRemaining = 0.0
var float qtyOriginal = 0.0

barsSinceLastTrade = bar_index - lastTradeBar
canTrade = sessionOK and not maxLossReached and not maxTradesReached and (not inPos) and (barsSinceLastTrade >= minBarsBetweenTrades)

longSignal = confluenceLong >= minConfluenceScore and canTrade
shortSignal = confluenceShort >= minConfluenceScore and canTrade

// ==============================
// 🔧 JSON HELPERS
// ==============================
f_json_num(x) => str.tostring(x, "#.####")

f_json_entry(_isLong, _qty, _stopPrice, _tp1Price, _score) =>
    action = _isLong ? "buy" : "sell"
    base = '{"ticker":"' + traderspostTicker + '","action":"' + action + '","orderType":"market","quantity":' + str.tostring(_qty) + ',"confluenceScore":' + str.tostring(_score)
    br = includeBracketOnEntry ? ',"stopLoss":{"stopPrice":' + f_json_num(_stopPrice) + '},"takeProfit":{"limitPrice":' + f_json_num(_tp1Price) + '}' : ""
    base + br + '}'

f_json_exit(_isLong, _qty, _reason, _refPrice) =>
    action = _isLong ? "sell" : "buy"
    '{"ticker":"' + traderspostTicker + '","action":"' + action + '","orderType":"market","quantity":' + f_json_num(_qty) + ',"reduceOnly":true,"reason":"' + _reason + '","referencePrice":' + f_json_num(_refPrice) + '}'

// ==============================
// 📍 ENTRY (ALERT + MODEL STATE)
// ==============================
if enableAlerts and barstate.isconfirmed
    if longSignal and fixedContracts > 0
        inPos := true
        isLong := true
        entryPrice := close
        qtyOriginal := fixedContracts
        qtyRemaining := fixedContracts

        currentStop := entryPrice - (atr * initialStopATR)
        tp1_hit := false
        tp2_hit := false
        breakeven_active := false
        trailing_active := false

        dailyTrades += 1
        lastTradeBar := bar_index

        tp1_price = entryPrice + (atr * tp1_ATR)
        alert(f_json_entry(true, fixedContracts, currentStop, tp1_price, confluenceLong), alert.freq_once_per_bar_close)

    if shortSignal and fixedContracts > 0
        inPos := true
        isLong := false
        entryPrice := close
        qtyOriginal := fixedContracts
        qtyRemaining := fixedContracts

        currentStop := entryPrice + (atr * initialStopATR)
        tp1_hit := false
        tp2_hit := false
        breakeven_active := false
        trailing_active := false

        dailyTrades += 1
        lastTradeBar := bar_index

        tp1_price = entryPrice - (atr * tp1_ATR)
        alert(f_json_entry(false, fixedContracts, currentStop, tp1_price, confluenceShort), alert.freq_once_per_bar_close)

// ==============================
// 🛡️ COOPERATIVE STOP MANAGEMENT (MODEL)
// ==============================
if useCooperativeStops and inPos and not na(entryPrice)
    currentProfit = isLong ? (close - entryPrice) : (entryPrice - close)

    if not breakeven_active and currentProfit >= atr * breakevenTriggerATR
        breakeven_active := true
        beStop = isLong ? (entryPrice + (2 * syminfo.mintick)) : (entryPrice - (2 * syminfo.mintick))
        currentStop := isLong ? math.max(currentStop, beStop) : math.min(currentStop, beStop)

    if not trailing_active and currentProfit >= atr * trailingActivateATR
        trailing_active := true

    if trailing_active
        trailStop = isLong ? (close - (atr * trailingDistanceATR)) : (close + (atr * trailingDistanceATR))
        currentStop := isLong ? math.max(currentStop, trailStop) : math.min(currentStop, trailStop)

// ==============================
// 🎯 EXITS (TP1/TP2/TP3 + STOP) — ALERT ONLY
// ==============================
if enableAlerts and emitExitAlerts and inPos and not na(entryPrice) and qtyRemaining > 0 and barstate.isconfirmed
    tp1_price = isLong ? entryPrice + (atr * tp1_ATR) : entryPrice - (atr * tp1_ATR)
    tp2_price = isLong ? entryPrice + (atr * tp2_ATR) : entryPrice - (atr * tp2_ATR)
    tp3_price = isLong ? entryPrice + (atr * tp3_ATR) : entryPrice - (atr * tp3_ATR)

    tp1Touched = isLong ? (high >= tp1_price) : (low <= tp1_price)
    tp2Touched = isLong ? (high >= tp2_price) : (low <= tp2_price)
    tp3Touched = isLong ? (high >= tp3_price) : (low <= tp3_price)

    stopTouched = isLong ? (low <= currentStop) : (high >= currentStop)

    // Priority: STOP first (conservative for same-bar TP/STOP conflicts)
    if stopTouched
        alert(f_json_exit(isLong, qtyRemaining, "STOP", currentStop), alert.freq_once_per_bar_close)

        // virtual realized PnL
        pnlPoints = (currentStop - entryPrice) * (isLong ? 1 : -1)
        dailyRealizedPnL += pnlPoints * syminfo.pointvalue * qtyRemaining

        // reset model
        inPos := false
        entryPrice := na
        currentStop := na
        tp1_hit := false
        tp2_hit := false
        breakeven_active := false
        trailing_active := false
        qtyRemaining := 0.0
        qtyOriginal := 0.0
    else
        // Determine the highest TP stage reached this bar
        stage = tp3Touched ? 3 : tp2Touched ? 2 : tp1Touched ? 1 : 0

        // Contract allocation:
        // - TP1 is % of ORIGINAL
        // - TP2 is % of REMAINING after TP1 (works better for small contract counts)
        tp1_qty_target = math.round(qtyOriginal * (tp1_Percent / 100.0))
        tp1_qty_target := math.min(tp1_qty_target, qtyOriginal)
        remaining_after_tp1 = math.max(qtyOriginal - tp1_qty_target, 0)
        tp2_qty_target = math.round(remaining_after_tp1 * (tp2_Percent / 100.0))
        tp2_qty_target := math.min(tp2_qty_target, remaining_after_tp1)
        tp3_qty_target = math.max(qtyOriginal - tp1_qty_target - tp2_qty_target, 0)

        // Fire the missing exits needed to "catch up" to the stage.
        if stage >= 1 and not tp1_hit and tp1_qty_target > 0 and qtyRemaining > 0
            qtyOut = math.min(tp1_qty_target, qtyRemaining)
            alert(f_json_exit(isLong, qtyOut, "TP1", tp1_price), alert.freq_once_per_bar_close)
            pnlPoints = (tp1_price - entryPrice) * (isLong ? 1 : -1)
            dailyRealizedPnL += pnlPoints * syminfo.pointvalue * qtyOut
            qtyRemaining -= qtyOut
            tp1_hit := true

        if stage >= 2 and tp1_hit and not tp2_hit and tp2_qty_target > 0 and qtyRemaining > 0
            qtyOut = math.min(tp2_qty_target, qtyRemaining)
            alert(f_json_exit(isLong, qtyOut, "TP2", tp2_price), alert.freq_once_per_bar_close)
            pnlPoints = (tp2_price - entryPrice) * (isLong ? 1 : -1)
            dailyRealizedPnL += pnlPoints * syminfo.pointvalue * qtyOut
            qtyRemaining -= qtyOut
            tp2_hit := true

        if stage >= 3 and tp2_hit and qtyRemaining > 0
            alert(f_json_exit(isLong, qtyRemaining, "TP3", tp3_price), alert.freq_once_per_bar_close)
            pnlPoints = (tp3_price - entryPrice) * (isLong ? 1 : -1)
            dailyRealizedPnL += pnlPoints * syminfo.pointvalue * qtyRemaining

            // reset model
            inPos := false
            entryPrice := na
            currentStop := na
            tp1_hit := false
            tp2_hit := false
            breakeven_active := false
            trailing_active := false
            qtyRemaining := 0.0
            qtyOriginal := 0.0

        // safety reset if fully scaled out
        if inPos and qtyRemaining <= 0
            inPos := false
            entryPrice := na
            currentStop := na
            tp1_hit := false
            tp2_hit := false
            breakeven_active := false
            trailing_active := false
            qtyRemaining := 0.0
            qtyOriginal := 0.0

// ==============================
// 📊 DISPLAYS
// ==============================
var table perfTable = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 85))
if barstate.isconfirmed
    table.cell(perfTable, 0, 0, "MGC ALERT-ONLY", colspan=2, bgcolor=color.new(color.gold, 60), text_color=color.white)
    table.cell(perfTable, 0, 1, "Daily Trades", text_color=color.white)
    table.cell(perfTable, 1, 1, str.tostring(dailyTrades) + "/" + str.tostring(maxTradesPerDay), text_color=maxTradesReached ? color.orange : color.lime)
    table.cell(perfTable, 0, 2, "Daily P&L (virtual)", text_color=color.white)
    table.cell(perfTable, 1, 2, "$" + str.tostring(dailyRealizedPnL, "#.##"), text_color=dailyRealizedPnL >= 0 ? color.lime : color.red)
    table.cell(perfTable, 0, 3, "Confluence", text_color=color.white)
    table.cell(perfTable, 1, 3, str.tostring(math.max(confluenceLong, confluenceShort)) + "/10", text_color=color.white)
    table.cell(perfTable, 0, 4, "ADX", text_color=color.white)
    table.cell(perfTable, 1, 4, str.tostring(adx, "#.#"), text_color=adx >= adxThreshold ? color.lime : color.gray)
    table.cell(perfTable, 0, 5, "Session", text_color=color.white)
    table.cell(perfTable, 1, 5, sessionOK ? "OK" : "OFF", text_color=sessionOK ? color.lime : color.red)
    table.cell(perfTable, 0, 6, "Position", text_color=color.white)
    table.cell(perfTable, 1, 6, inPos ? (isLong ? "LONG" : "SHORT") : "FLAT", text_color=inPos ? color.yellow : color.gray)
    table.cell(perfTable, 0, 7, "Stop Mode", text_color=color.white)
    table.cell(perfTable, 1, 7, inPos ? (breakeven_active ? "BE" : trailing_active ? "TRAIL" : "INIT") : "-", text_color=color.aqua)
    table.cell(perfTable, 0, 8, "Qty Rem", text_color=color.white)
    table.cell(perfTable, 1, 8, inPos ? str.tostring(qtyRemaining) : "0", text_color=color.white)

// ==============================
// 📈 VISUAL PLOTS
// ==============================
plot(ema9, "EMA 9", color=color.new(color.red, 50), linewidth=1)
plot(ema21, "EMA 21", color=color.new(color.orange, 50), linewidth=1)
plot(ema50, "EMA 50", color=color.new(color.blue, 50), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.purple, 50), linewidth=2)
plot(hull, "Hull MA", color=hull_bullish ? color.green : hull_bearish ? color.red : color.gray, linewidth=3)

plot(inPos ? currentStop : na, "Stop (model)", color=breakeven_active ? color.yellow : trailing_active ? color.aqua : color.red, linewidth=2, style=plot.style_cross)

plotshape(longSignal, "Long Signal", shape.triangleup, location.belowbar, color=color.green, size=size.tiny, text="L " + str.tostring(confluenceLong))
plotshape(shortSignal, "Short Signal", shape.triangledown, location.abovebar, color=color.red, size=size.tiny, text="S " + str.tostring(confluenceShort))

bgcolor(not sessionOK ? color.new(color.red, 92) : na)
bgcolor(maxLossReached ? color.new(color.red, 88) : na)
bgcolor(maxTradesReached ? color.new(color.orange, 92) : na)
