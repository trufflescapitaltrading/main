//@version=5
strategy("1.14.2026 12:18 WIN-OPT MNQ/MES 3m/5m Multi-TF Cursor V.71+% 5-Star Scalper P1/P2 SAFE", overlay=true, initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1, calc_on_order_fills=false, calc_on_every_tick=true, process_orders_on_close=false, backtest_fill_limits_assumption=0, dynamic_requests=true)

// ==================== 💰 DAILY PROFIT TARGET ====================
profitTargetGroup = "💰 Daily Profit Target"
enableDailyProfitTarget = input.bool(true, "Enable Daily Profit Target", group=profitTargetGroup)
dailyProfitTarget = input.float(1500.0, "Daily Profit Target ($)", minval=500, maxval=5000, group=profitTargetGroup)

// ==================== 🎯 PRICE MOMENTUM OVERRIDE ====================
momentumOverrideGroup = "🎯 PRICE MOMENTUM OVERRIDE"
enableMomentumOverride = input.bool(true, "✅ Enable Price Momentum Override", group=momentumOverrideGroup)
momentumLookback = input.int(5, "Momentum Lookback Bars", minval=3, maxval=10, group=momentumOverrideGroup)
momentumThresholdPct = input.float(0.4, "Min Price Move (%)", minval=0.3, maxval=2.0, group=momentumOverrideGroup)
momentumThresholdPoints = input.float(100.0, "Min Price Move (MNQ points)", minval=50, maxval=300, group=momentumOverrideGroup)

// ==================== 🎯 FIXED SIGNAL LINE SYSTEM ====================
signalGroup = "🎯 Fixed Signal Line System"
enableSignalLine = input.bool(true, "✅ Enable Signal Line System", group=signalGroup)
useSignalLineStrict = input.bool(false, "⚠️ STRICT: Only trade with signal line", group=signalGroup)
swingPeriod = input.int(3, "BUY/SELL Swing Period", minval=1, maxval=10, group=signalGroup)
enableSwingSignals = input.bool(true, "Enable BUY/SELL Swing Signals", group=signalGroup)
swingSignalPriority = input.bool(true, "Add Swing to Priority System", group=signalGroup)
swingInjectToBase = input.bool(false, "Allow Swing to feed base signals", group=signalGroup)
grayZoneEnabled = input.bool(true, "Enable Gray Zone", group=signalGroup)
grayADXThreshold = input.float(20.0, "Gray Zone: ADX Below", minval=10.0, maxval=30.0, group=signalGroup)
grayATRMultiplier = input.float(0.75, "Gray Zone: ATR Compression", minval=0.4, maxval=1.2, group=signalGroup)
grayBBWidthThreshold = input.float(0.015, "Gray Zone: BB Width Below", minval=0.005, maxval=0.030, group=signalGroup)
grayMinFactors = input.int(2, "Gray Zone: Min Factors", minval=2, maxval=6, group=signalGroup)

// ==================== 🕯️ CANDLESTICK PATTERNS (ALL 18) ====================
candleGroup = "🕯️ Candlestick Pattern System"
enableCandlePatterns = input.bool(true, "✅ MASTER: Enable Candlestick Patterns", group=candleGroup)
requireVolumeConfirmation = input.bool(true, "Require Volume Confirmation", group=candleGroup)
minPatternSize = input.float(0.5, "Min Pattern Size (×ATR)", minval=0.3, maxval=2.0, group=candleGroup)
bullishPatternsGroup = "🟢 Bullish Patterns"
enableBullishEngulfing = input.bool(true, "Bullish Engulfing", group=bullishPatternsGroup)
enableHammer = input.bool(true, "Hammer", group=bullishPatternsGroup)
enableInvertedHammer = input.bool(true, "Inverted Hammer", group=bullishPatternsGroup)
enableMorningStar = input.bool(true, "Morning Star", group=bullishPatternsGroup)
enableBullishHarami = input.bool(true, "Bullish Harami", group=bullishPatternsGroup)
enablePiercingLine = input.bool(true, "Piercing Line", group=bullishPatternsGroup)
enableThreeWhiteSoldiers = input.bool(true, "Three White Soldiers", group=bullishPatternsGroup)
enableBullishMarubozu = input.bool(true, "Bullish Marubozu", group=bullishPatternsGroup)
bearishPatternsGroup = "🔴 Bearish Patterns"
enableBearishEngulfing = input.bool(true, "Bearish Engulfing", group=bearishPatternsGroup)
enableShootingStar = input.bool(true, "Shooting Star", group=bearishPatternsGroup)
enableHangingMan = input.bool(true, "Hanging Man", group=bearishPatternsGroup)
enableEveningStar = input.bool(true, "Evening Star", group=bearishPatternsGroup)
enableBearishHarami = input.bool(true, "Bearish Harami", group=bearishPatternsGroup)
enableDarkCloudCover = input.bool(true, "Dark Cloud Cover", group=bearishPatternsGroup)
enableThreeBlackCrows = input.bool(true, "Three Black Crows", group=bearishPatternsGroup)
enableBearishMarubozu = input.bool(true, "Bearish Marubozu", group=bearishPatternsGroup)
neutralPatternsGroup = "⚪ Neutral/Indecision Patterns"
enableDoji = input.bool(true, "Doji", group=neutralPatternsGroup)
enableSpinningTop = input.bool(true, "Spinning Top", group=neutralPatternsGroup)
patternTierGroup = "🕯️ Ranked Pattern Tiers"
enableTier1 = input.bool(true, "🥇 Tier 1 (75%+)", group=patternTierGroup)
enableTier2 = input.bool(true, "🥈 Tier 2 (65-74%)", group=patternTierGroup)
enableTier3 = input.bool(true, "🥉 Tier 3 (55-64%)", group=patternTierGroup)
enableTier4 = input.bool(true, "⚪ Tier 4 (Power/Neutral)", group=patternTierGroup)
highWinRateMode = input.bool(true, "🎯 High Win Rate Mode (70%+)")
quickTPMultiplier = input.float(0.6, "Quick TP Multiplier", minval=0.3, maxval=1.0)
widerSLMultiplier = input.float(1.5, "Wider SL Multiplier", minval=1.0, maxval=2.5)

// ==================== 🎯 MNQ 3m WIN-RATE BOOSTER (OPTIONAL) ====================
mnq3mBoosterGroup = "🎯 MNQ 3m Win-Rate Booster"
enableMnq3mWinRateBooster = input.bool(false, "Enable MNQ 3m Win-Rate Booster (single contract)", group=mnq3mBoosterGroup)
mnq3mBoosterTargetPctOfTP1 = input.float(0.60, "Target = TP1 × pct (0.30–1.00)", minval=0.30, maxval=1.00, step=0.05, group=mnq3mBoosterGroup)
mnq3mBoosterBETriggerPctOfTarget = input.float(0.60, "Move stop to BE after Target × pct", minval=0.20, maxval=1.00, step=0.05, group=mnq3mBoosterGroup)
mnq3mBoosterUseFeesForBE = input.bool(true, "BE includes est. fees/slippage", group=mnq3mBoosterGroup)

// ==================== 🎯 MES 3m WIN-RATE BOOSTER (DEFAULT ON) ====================
mes3mBoosterGroup = "🎯 MES 3m Win-Rate Booster"
enableMes3mWinRateBooster = input.bool(true, "Enable MES 3m Win-Rate Booster (single contract)", group=mes3mBoosterGroup)
mes3mBoosterTargetPctOfTP1 = input.float(0.60, "Target = TP1 × pct (0.30–1.00)", minval=0.30, maxval=1.00, step=0.05, group=mes3mBoosterGroup)
mes3mBoosterBETriggerPctOfTarget = input.float(0.60, "Move stop to BE after Target × pct", minval=0.20, maxval=1.00, step=0.05, group=mes3mBoosterGroup)
mes3mBoosterUseFeesForBE = input.bool(true, "BE includes est. fees/slippage", group=mes3mBoosterGroup)

// ==================== 🎯 MES 5m WIN-RATE BOOSTER (DEFAULT ON) ====================
mes5mBoosterGroup = "🎯 MES 5m Win-Rate Booster"
enableMes5mWinRateBooster = input.bool(true, "Enable MES 5m Win-Rate Booster (single contract)", group=mes5mBoosterGroup)
mes5mTargetSLMult = input.float(0.90, "Target = SL × mult", minval=0.30, maxval=2.00, step=0.05, group=mes5mBoosterGroup)
mes5mBETriggerPctOfTarget = input.float(0.60, "Move stop to BE after Target × pct", minval=0.20, maxval=1.00, step=0.05, group=mes5mBoosterGroup)
mes5mUseFeesForBE = input.bool(true, "BE includes est. fees/slippage", group=mes5mBoosterGroup)

// ==================== 🔥 MES MJV6 PROFIT LOGIC (SIMPLIFIED LADDER) ====================
mesProfitGroup = "🔥 MES Profit Logic (MJV6)"
useMJV6MesProfitLogic = input.bool(true, "MES: Use MJV6 profit logic (TP ladder + trail + time exit)", group=mesProfitGroup)

// ==================== 🔥 MNQ 3m "KENYA" PROFIT LOGIC (AS POSTED) ====================
kenyaGroup = "🔥 MNQ 3m Profit Logic (Kenya)"
useKenyaMnq3mProfitLogic = input.bool(true, "Use Kenya 60/25/10/5 ladder on MNQ 3m", group=kenyaGroup)
kenyaAllowIntrabarEntries = input.bool(true, "Kenya MNQ 3m: allow intrabar entries (restore original behavior)", group=kenyaGroup)
kenyaEnableSignalReversal = input.bool(true, "Kenya MNQ 3m: enable signal-reversal exits", group=kenyaGroup)
useV20KenyaPerfectProfit = input.bool(true, "Use V20 Kenya PERFECT PROFIT module (overrides other exits)", group=kenyaGroup)
v20AllowOn3m = input.bool(false, "V20: allow on 3m charts (default OFF to protect 3m expectancy)", group=kenyaGroup)

// ==================== 🏆 WIN RATE OPTIMIZATION V71 ====================
winOptGroup = "🏆 WIN RATE OPTIMIZATION V71"
enableAdaptiveTrailing = input.bool(true, "✅ Enable Adaptive Trailing Stop", group=winOptGroup)
trailingActivationPct = input.float(50.0, "Trailing Activation (% of TP1)", minval=20, maxval=100, group=winOptGroup)
trailingStepPct = input.float(25.0, "Trailing Step (%)", minval=10, maxval=50, group=winOptGroup)
enableTimeProfitLock = input.bool(true, "✅ Enable Time-Decay Profit Lock", group=winOptGroup)
profitLockBars = input.int(8, "Bars Before Profit Lock", minval=3, maxval=20, group=winOptGroup)
profitLockMinPct = input.float(30.0, "Min Profit for Lock (% of TP1)", minval=10, maxval=80, group=winOptGroup)
profitLockKeepPct = input.float(50.0, "Keep Profit %", minval=20, maxval=90, group=winOptGroup)
enableMomentumFadeExit = input.bool(true, "✅ Enable Momentum-Fade Exit", group=winOptGroup)
momentumFadeBars = input.int(3, "Bars for Momentum Check", minval=2, maxval=10, group=winOptGroup)
momentumFadeThreshold = input.float(0.7, "Fade Threshold (RSI delta)", minval=0.3, maxval=2.0, group=winOptGroup)
enableQuickScalpExit = input.bool(true, "✅ Quick Scalp Exit", group=winOptGroup)
quickScalpProfitPct = input.float(40.0, "Quick Scalp Profit (% of TP1)", minval=20, maxval=80, group=winOptGroup)
quickScalpBars = input.int(5, "Quick Scalp Max Bars", minval=2, maxval=15, group=winOptGroup)
enableVolatilityAdjustedExits = input.bool(true, "✅ Volatility-Adjusted Exits", group=winOptGroup)
volAdjustFactor = input.float(0.8, "Vol Adjustment Factor", minval=0.5, maxval=1.2, group=winOptGroup)
enableStrictEntryFilter = input.bool(true, "✅ Strict Entry Filter for Higher WR", group=winOptGroup)
minADXForEntry = input.float(18.0, "Min ADX for Entry", minval=10, maxval=30, group=winOptGroup)
minRSIRangeLow = input.float(35.0, "RSI Range Low", minval=20, maxval=45, group=winOptGroup)
minRSIRangeHigh = input.float(65.0, "RSI Range High", minval=55, maxval=80, group=winOptGroup)

// ==================== ✅ ENTRY EXECUTION ====================
entryGroup = "✅ Entry Execution"
enterOnBarClose = input.bool(true, "Enter ONLY on bar close (no intrabar entries)", group=entryGroup)
allowIntrabarForP1P2 = input.bool(true, "Allow intrabar entries for P1/P2 (earlier impulse/trend)", group=entryGroup)
require5mCandleColorConfirm = input.bool(true, "3m entries require 5m candle color confirmation", group=entryGroup)

// ==================== 🛡️ MES ANTI-CHOP GUARD ====================
mesGuardGroup = "🛡️ MES Anti-Chop Guard"
enableMesAntiChop = input.bool(true, "Enable MES stricter filters (reduces chop entries)", group=mesGuardGroup)
mesMinADXForEntry = input.float(22.0, "MES Min ADX", minval=10, maxval=40, group=mesGuardGroup)
mesConfluenceBoost = input.int(1, "MES Confluence +", minval=0, maxval=5, group=mesGuardGroup)
mesMinHTFAligned = input.int(2, "MES Min HTF Align (1-3)", minval=1, maxval=3, group=mesGuardGroup)

// ==================== ✅ MANDATORY TREND-ONLY FILTER (NON-NEGOTIABLE) ====================
trendOnlyGroup = "✅ Mandatory Trend-Only Filter"
enableMandatoryTrendOnly = input.bool(false, "Enable Mandatory Trend-Only Filter (hard block)", group=trendOnlyGroup)
trendHTFTF = input.timeframe("60", "HTF Structure TF (60m+)", group=trendOnlyGroup)
htfPivotLen = input.int(3, "HTF Pivot Len (structure)", minval=1, maxval=10, group=trendOnlyGroup)
maxVwapCrosses = input.int(2, "Max VWAP crosses (last 2-3h)", minval=0, maxval=10, group=trendOnlyGroup)
atrExpLen = input.int(20, "ATR baseline length", minval=5, maxval=200, group=trendOnlyGroup)
atrExpMult = input.float(1.10, "ATR expanding mult", minval=1.00, maxval=2.00, step=0.05, group=trendOnlyGroup)
vwapSlopeLen = input.int(10, "VWAP slope lookback", minval=2, maxval=50, group=trendOnlyGroup)

// ==================== ⭐ PRIORITY HIERARCHY SYSTEM ====================
priorityGroup = "⭐ PRIORITY HIERARCHY SYSTEM"
enablePrioritySystem = input.bool(true, "✅ Enable Priority Hierarchy", group=priorityGroup)
allowPriority0 = input.bool(true, "P0: Momentum Override 🎯", group=priorityGroup)
allowPriorityMinus1 = input.bool(true, "P-1: Trend Start (Ignition) 🔥", group=priorityGroup)
allowPriority1 = input.bool(true, "P1: Impulse Override 🚀", group=priorityGroup)
allowPriority1Early = input.bool(true, "P1: Early Trend Start (SuperTrend flip + momentum)", group=priorityGroup)
allowPriority2 = input.bool(true, "P2: Strong Trend Override 📈", group=priorityGroup)
allowPriority3 = input.bool(false, "P3: 5-Star Entry", group=priorityGroup)
