enableDollarStops = input.bool(true, "V8: Send Dollar-based SL/TP")
includeSignalPrice = input.bool(true, "V8: Include signalPrice in webhook")
useManualDollarOverrides = input.bool(false, "V8: Use FIXED Dollar SL/TP")
