allowPriority5 = input.bool(false, "P5: 3-Star Entry", group=priorityGroup)
allowPriority6 = input.bool(false, "P6: 2-Star Entry", group=priorityGroup)
allowPriority7 = input.bool(false, "P7: Swing Signal", group=priorityGroup)
group_entryConfirm = "✅ Entry Confirmation"
requireCandleDirection = input.bool(true, "⚠️ STRICT: Long=Green, Short=Red", group=group_entryConfirm)
requireBodyStrength = input.bool(false, "Require Body Strength", group=group_entryConfirm)
