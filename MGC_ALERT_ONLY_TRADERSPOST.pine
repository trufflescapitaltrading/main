//@version=5
indicator("MGC ALERT ONLY - TradersPost/Tradovate",
     overlay=true,
     max_bars_back=500)

// =====================================================================
// MGC 80% WIN RATE SYSTEM - ALERT ONLY VERSION
// =====================================================================
// FOR LIVE AUTOMATED TRADING via TradersPost -> Tradovate/TopstepX
// 
// This version uses ONLY alert() calls - NO strategy.entry() or strategy.exit()
// Compatible with TradersPost webhook integration
// 
// Strategy: QUALITY over QUANTITY
// - 10-point confluence scoring (need 7/10 minimum)
// - Higher timeframe confirmation required
// - Very strict trend filters (ADX > 30)
// - Cooperative stop loss system (no conflicts)
// - Expected: 3-5 trades/day, 75-85% win rate
// =====================================================================

// ==============================
// INSTRUMENT VERIFICATION
// ==============================
isMGC = str.contains(syminfo.ticker, "MGC") or str.contains(syminfo.ticker, "GC")

if not isMGC
    runtime.error("This indicator is optimized for MGC only. Please switch to MGC chart.")

// ==============================
// 80% WIN RATE SETTINGS
// ==============================
minConfluenceScore = input.int(7, "Minimum Confluence Score (7-10)", minval=6, maxval=10, 
     tooltip="Higher = fewer trades but higher win rate. 7 = ~80% wins, 8 = ~85% wins, 9 = ~90% wins",
     group="Confluence Settings")

adxThreshold = input.float(30.0, "ADX Threshold (Strong Trends Only)", minval=20.0, maxval=40.0,
     tooltip="30 = very strong trends only. Lower = more trades but lower win rate",
     group="Confluence Settings")

minTrendStrength = input.float(0.40, "Min Trend Strength", minval=0.30, maxval=0.60,
     tooltip="40% = minimum directional move required",
     group="Confluence Settings")

maxTradesPerDay = input.int(5, "Max Trades Per Day", minval=3, maxval=8,
     tooltip="Quality over quantity. 5 is optimal for 80% win rate",
     group="Trade Management")

minBarsBetweenTrades = input.int(15, "Min Bars Between Trades", minval=10, maxval=30,
     tooltip="Prevents overtrading. 15 bars = ~1-2 hours on 5m chart",
     group="Trade Management")

volumeRatioMin = input.float(1.5, "Volume Ratio Minimum", minval=1.2, maxval=2.0,
     tooltip="1.5x average volume minimum for entries",
     group="Confluence Settings")

srTolerance = input.float(0.3, "S/R Tolerance (ATR)", minval=0.2, maxval=0.5,
     tooltip="How close to support/resistance for confluence point",
     group="Confluence Settings")

// ==============================
// STOP LOSS & TAKE PROFIT SETTINGS
// ==============================
// Initial stop loss
initialStopATR = input.float(1.2, "Initial Stop Loss (ATR)", minval=0.8, maxval=2.0,
     tooltip="~$30 for MGC. Tight but allows breathing room",
     group="Stop Loss")

// Take profit levels (progressive exit)
tp1_ATR = input.float(2.5, "TP1 Target (ATR)", minval=1.5, maxval=3.5,
     tooltip="~$60 for MGC. Exit 70% here",
     group="Take Profit")
tp1_Percent = input.float(0.70, "TP1 Exit Ratio", minval=0.50, maxval=0.80,
     tooltip="0.70 = 70% of position",
     group="Take Profit")

tp2_ATR = input.float(4.0, "TP2 Target (ATR)", minval=3.0, maxval=5.0,
     tooltip="~$100 for MGC. Exit 25% here",
     group="Take Profit")
tp2_Percent = input.float(0.25, "TP2 Exit Ratio", minval=0.15, maxval=0.35,
     tooltip="0.25 = 25% of remaining position",
     group="Take Profit")

tp3_ATR = input.float(6.0, "TP3 Target (ATR)", minval=4.5, maxval=8.0,
     tooltip="~$150 for MGC. Exit final 5% here",
     group="Take Profit")

// Breakeven threshold
breakevenTriggerATR = input.float(1.5, "Breakeven Trigger (ATR)", minval=1.0, maxval=2.5,
     tooltip="Move stop to breakeven after this profit level",
     group="Stop Loss")

// Trailing stop activation
trailingActivateATR = input.float(3.0, "Trailing Stop Activation (ATR)", minval=2.0, maxval=4.0,
     tooltip="Start trailing after this profit",
     group="Stop Loss")
trailingDistanceATR = input.float(1.5, "Trailing Distance (ATR)", minval=1.0, maxval=2.5,
     tooltip="How far trailing stop follows price",
     group="Stop Loss")

// ==============================
// POSITION SIZING
// ==============================
fixedContracts = input.int(1, "Fixed Contracts", minval=1, maxval=10,
     tooltip="Number of contracts per trade",
     group="Position Sizing")

// ==============================
// TRADERSPOST ALERT SETTINGS
// ==============================
enableAlerts = input.bool(true, "Enable TradersPost Alerts",
     tooltip="Master switch for all alerts",
     group="TradersPost Alerts")

tickerSymbol = input.string("MGC1!", "Ticker Symbol for Alerts",
     tooltip="Symbol sent in webhook (e.g., MGC1!, GC1!)",
     group="TradersPost Alerts")

// ==============================
// SESSION FILTERS
// ==============================
tradingHoursOnly = input.bool(true, "US Trading Hours Only (9:30-15:50 ET)",
     group="Session Filter")
currentTime = math.round(hour * 100 + minute)
inTradingHours = currentTime >= 930 and currentTime <= 1550

sessionOK = not tradingHoursOnly or inTradingHours

// ==============================
// HIGHER TIMEFRAME CONFIRMATION
// ==============================
htfTimeframe = input.timeframe("15", "Higher Timeframe", 
     tooltip="15m for 5m charts, 1H for 15m charts",
     group="Timeframe Settings")

htf_close = request.security(syminfo.tickerid, htfTimeframe, close)
htf_ema20 = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, 20))
htf_ema50 = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, 50))

htf_bullish = htf_close > htf_ema20 and htf_ema20 > htf_ema50
htf_bearish = htf_close < htf_ema20 and htf_ema20 < htf_ema50

// ==============================
// CORE INDICATORS
// ==============================

// EMAs (all must align for confluence)
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

// Perfect EMA alignment (no cross-cutting)
ema_bullish_aligned = ema9 > ema21 and ema21 > ema50 and ema50 > ema100 and ema100 > ema200
ema_bearish_aligned = ema9 < ema21 and ema21 < ema50 and ema50 < ema100 and ema100 < ema200

// Hull MA
hullLen = 20
hma(src, len) =>
    half_length = math.round(len / 2)
    sqrt_length = math.round(math.sqrt(len))
    ta.wma(2 * ta.wma(src, half_length) - ta.wma(src, len), sqrt_length)

hull = hma(close, hullLen)
hull_bullish = hull > hull[1] and hull[1] > hull[2]
hull_bearish = hull < hull[1] and hull[1] < hull[2]

// ADX (Wilder's method)
adxLen = 14
f_adx(_len) =>
    upMove = high - high[1]
    downMove = low[1] - low
    plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
    minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
    tr = ta.tr(true)
    atr_val = ta.rma(tr, _len)
    plusDI = atr_val != 0 ? 100 * ta.rma(plusDM, _len) / atr_val : 0.0
    minusDI = atr_val != 0 ? 100 * ta.rma(minusDM, _len) / atr_val : 0.0
    dx = (plusDI + minusDI) != 0 ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
    ta.rma(dx, _len)

adx = f_adx(adxLen)
strongTrend = adx > adxThreshold

// MACD
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
macd_bullish = macdLine > signalLine and histLine > 0
macd_bearish = macdLine < signalLine and histLine < 0

// RSI (not extreme)
rsi = ta.rsi(close, 14)
rsi_neutral = rsi > 35 and rsi < 65

// Volume
volumeMA = ta.sma(volume, 20)
volumeSpike = volume > volumeMA * volumeRatioMin

// ATR for stops and targets
atr = ta.atr(14)

// ==============================
// SUPPORT/RESISTANCE DETECTION
// ==============================
lookbackSR = 50
pivotHighs = ta.pivothigh(high, 5, 5)
pivotLows = ta.pivotlow(low, 5, 5)

var float[] resistanceLevels = array.new_float(0)
var float[] supportLevels = array.new_float(0)

// Update S/R levels
if not na(pivotHighs)
    array.push(resistanceLevels, pivotHighs)
    if array.size(resistanceLevels) > 10
        array.shift(resistanceLevels)

if not na(pivotLows)
    array.push(supportLevels, pivotLows)
    if array.size(supportLevels) > 10
        array.shift(supportLevels)

// Check if near S/R
nearSupport = false
nearResistance = false

if array.size(supportLevels) > 0
    for i = 0 to array.size(supportLevels) - 1
        level = array.get(supportLevels, i)
        if math.abs(close - level) < atr * srTolerance
            nearSupport := true
            break

if array.size(resistanceLevels) > 0
    for i = 0 to array.size(resistanceLevels) - 1
        level = array.get(resistanceLevels, i)
        if math.abs(close - level) < atr * srTolerance
            nearResistance := true
            break

// ==============================
// MARKET STRUCTURE
// ==============================
lookbackStructure = 20

highs = ta.highest(high, lookbackStructure)
lows = ta.lowest(low, lookbackStructure)

higherHighs = high > highs[lookbackStructure]
higherLows = low > lows[lookbackStructure]
lowerHighs = high < highs[lookbackStructure]
lowerLows = low < lows[lookbackStructure]

cleanBullStructure = higherHighs and higherLows
cleanBearStructure = lowerHighs and lowerLows

// ==============================
// TREND STRENGTH CALCULATION
// ==============================
trendLookback = 50
priceRange = ta.highest(high, trendLookback) - ta.lowest(low, trendLookback)
priceMove = close - close[trendLookback]
trendStrength = priceRange > 0 ? math.abs(priceMove) / priceRange : 0

strongTrendDirection = trendStrength > minTrendStrength

// ==============================
// 10-POINT CONFLUENCE SCORING
// ==============================
var int confluenceLong = 0
var int confluenceShort = 0

confluenceLong := 0
confluenceShort := 0

// 1. Higher Timeframe Confirmation (2 points - most important)
if htf_bullish
    confluenceLong += 2
if htf_bearish
    confluenceShort += 2

// 2. ADX > 30 (1 point)
if strongTrend
    confluenceLong += 1
    confluenceShort += 1

// 3. All EMAs Aligned (1 point)
if ema_bullish_aligned
    confluenceLong += 1
if ema_bearish_aligned
    confluenceShort += 1

// 4. Hull MA Direction (1 point)
if hull_bullish
    confluenceLong += 1
if hull_bearish
    confluenceShort += 1

// 5. MACD Confirmation (1 point)
if macd_bullish
    confluenceLong += 1
if macd_bearish
    confluenceShort += 1

// 6. RSI Not Extreme (1 point)
if rsi_neutral
    confluenceLong += 1
    confluenceShort += 1

// 7. Near S/R Level (1 point)
if nearSupport
    confluenceLong += 1
if nearResistance
    confluenceShort += 1

// 8. Volume Spike (1 point)
if volumeSpike
    confluenceLong += 1
    confluenceShort += 1

// 9. Clean Market Structure (1 point)
if cleanBullStructure
    confluenceLong += 1
if cleanBearStructure
    confluenceShort += 1

// 10. Strong Trend Direction (1 point)
if strongTrendDirection and close > close[trendLookback]
    confluenceLong += 1
if strongTrendDirection and close < close[trendLookback]
    confluenceShort += 1

// ==============================
// POSITION TRACKING (Manual for Indicator)
// ==============================
var int dailyTrades = 0
var int lastTradeBar = 0
var bool inPosition = false
var bool isLong = false
var float entryPrice = na
var float currentStop = na
var float tp1_price = na
var float tp2_price = na
var float tp3_price = na
var bool tp1_hit = false
var bool tp2_hit = false
var bool breakeven_active = false
var bool trailing_active = false
var float remainingQty = 0.0

// Reset daily counters
if ta.change(dayofweek) != 0
    dailyTrades := 0
    lastTradeBar := 0

// ==============================
// ENTRY CONDITIONS
// ==============================
barsSinceLastTrade = bar_index - lastTradeBar

longSignal = confluenceLong >= minConfluenceScore and 
     barsSinceLastTrade >= minBarsBetweenTrades and
     not inPosition

shortSignal = confluenceShort >= minConfluenceScore and 
     barsSinceLastTrade >= minBarsBetweenTrades and
     not inPosition

canTrade = sessionOK and 
     dailyTrades < maxTradesPerDay and
     not inPosition

longCondition = longSignal and canTrade
shortCondition = shortSignal and canTrade

// ==============================
// ENTRY ALERT EXECUTION
// ==============================
if longCondition and enableAlerts
    // Calculate levels
    stopPrice = close - (atr * initialStopATR)
    tp1 = close + (atr * tp1_ATR)
    tp2 = close + (atr * tp2_ATR)
    tp3 = close + (atr * tp3_ATR)
    
    // Update position tracking
    inPosition := true
    isLong := true
    entryPrice := close
    currentStop := stopPrice
    tp1_price := tp1
    tp2_price := tp2
    tp3_price := tp3
    tp1_hit := false
    tp2_hit := false
    breakeven_active := false
    trailing_active := false
    remainingQty := fixedContracts
    dailyTrades += 1
    lastTradeBar := bar_index
    
    // Send ENTRY alert to TradersPost
    entryAlert = '{"ticker": "' + tickerSymbol + '", "action": "buy", "orderType": "market", "quantity": ' + 
         str.tostring(fixedContracts) + 
         ', "stopLoss": {"type": "stop", "stopPrice": ' + str.tostring(math.round(stopPrice * 100) / 100) + 
         '}, "takeProfit": {"type": "limit", "limitPrice": ' + str.tostring(math.round(tp1 * 100) / 100) + 
         '}, "sentiment": "bullish", "confluenceScore": ' + str.tostring(confluenceLong) + '}'
    
    alert(entryAlert, alert.freq_once_per_bar)

if shortCondition and enableAlerts
    // Calculate levels
    stopPrice = close + (atr * initialStopATR)
    tp1 = close - (atr * tp1_ATR)
    tp2 = close - (atr * tp2_ATR)
    tp3 = close - (atr * tp3_ATR)
    
    // Update position tracking
    inPosition := true
    isLong := false
    entryPrice := close
    currentStop := stopPrice
    tp1_price := tp1
    tp2_price := tp2
    tp3_price := tp3
    tp1_hit := false
    tp2_hit := false
    breakeven_active := false
    trailing_active := false
    remainingQty := fixedContracts
    dailyTrades += 1
    lastTradeBar := bar_index
    
    // Send ENTRY alert to TradersPost
    entryAlert = '{"ticker": "' + tickerSymbol + '", "action": "sell", "orderType": "market", "quantity": ' + 
         str.tostring(fixedContracts) + 
         ', "stopLoss": {"type": "stop", "stopPrice": ' + str.tostring(math.round(stopPrice * 100) / 100) + 
         '}, "takeProfit": {"type": "limit", "limitPrice": ' + str.tostring(math.round(tp1 * 100) / 100) + 
         '}, "sentiment": "bearish", "confluenceScore": ' + str.tostring(confluenceShort) + '}'
    
    alert(entryAlert, alert.freq_once_per_bar)

// ==============================
// COOPERATIVE STOP MANAGEMENT
// ==============================
if inPosition and not na(entryPrice)
    currentProfit = isLong ? (close - entryPrice) : (entryPrice - close)
    
    // Stage 1: Breakeven Protection
    if not breakeven_active and currentProfit >= atr * breakevenTriggerATR
        breakeven_active := true
        newStop = isLong ? 
             math.max(currentStop, entryPrice + (2 * syminfo.mintick)) : 
             math.min(currentStop, entryPrice - (2 * syminfo.mintick))
        
        if newStop != currentStop
            currentStop := newStop
            // Send stop update alert
            if enableAlerts
                stopUpdateAlert = '{"ticker": "' + tickerSymbol + '", "action": "update_stop", "stopLoss": {"type": "stop", "stopPrice": ' + 
                     str.tostring(math.round(currentStop * 100) / 100) + '}, "reason": "breakeven"}'
                alert(stopUpdateAlert, alert.freq_once_per_bar)
    
    // Stage 2: Trailing Stop Activation
    if not trailing_active and currentProfit >= atr * trailingActivateATR
        trailing_active := true
    
    // Stage 3: Active Trailing
    if trailing_active
        trailStop = isLong ? 
             close - (atr * trailingDistanceATR) : 
             close + (atr * trailingDistanceATR)
        
        newTrailStop = isLong ? 
             math.max(currentStop, trailStop) : 
             math.min(currentStop, trailStop)
        
        if newTrailStop != currentStop
            currentStop := newTrailStop
            // Send trailing stop update alert
            if enableAlerts
                trailAlert = '{"ticker": "' + tickerSymbol + '", "action": "update_stop", "stopLoss": {"type": "stop", "stopPrice": ' + 
                     str.tostring(math.round(currentStop * 100) / 100) + '}, "reason": "trailing"}'
                alert(trailAlert, alert.freq_once_per_bar)

// ==============================
// TAKE PROFIT EXIT ALERTS
// ==============================
if inPosition and enableAlerts
    
    // TP1 Hit - Exit 70%
    if not tp1_hit
        tp1_triggered = isLong ? (high >= tp1_price) : (low <= tp1_price)
        if tp1_triggered
            tp1_hit := true
            exitQty = math.round(fixedContracts * tp1_Percent * 100) / 100
            remainingQty := remainingQty - exitQty
            
            exitAction = isLong ? "sell" : "buy"
            tp1Alert = '{"ticker": "' + tickerSymbol + '", "action": "' + exitAction + '", "orderType": "limit", "quantity": ' + 
                 str.tostring(exitQty) + 
                 ', "limitPrice": ' + str.tostring(math.round(tp1_price * 100) / 100) + 
                 ', "reason": "TP1_70_percent"}'
            alert(tp1Alert, alert.freq_once_per_bar)
    
    // TP2 Hit - Exit 25% of remaining
    if tp1_hit and not tp2_hit
        tp2_triggered = isLong ? (high >= tp2_price) : (low <= tp2_price)
        if tp2_triggered
            tp2_hit := true
            exitQty = math.round(fixedContracts * tp2_Percent * 100) / 100
            remainingQty := remainingQty - exitQty
            
            exitAction = isLong ? "sell" : "buy"
            tp2Alert = '{"ticker": "' + tickerSymbol + '", "action": "' + exitAction + '", "orderType": "limit", "quantity": ' + 
                 str.tostring(exitQty) + 
                 ', "limitPrice": ' + str.tostring(math.round(tp2_price * 100) / 100) + 
                 ', "reason": "TP2_25_percent"}'
            alert(tp2Alert, alert.freq_once_per_bar)
    
    // TP3 Hit - Exit final position
    if tp2_hit
        tp3_triggered = isLong ? (high >= tp3_price) : (low <= tp3_price)
        if tp3_triggered
            exitAction = isLong ? "sell" : "buy"
            tp3Alert = '{"ticker": "' + tickerSymbol + '", "action": "' + exitAction + '", "orderType": "limit", "quantity": ' + 
                 str.tostring(math.round(remainingQty * 100) / 100) + 
                 ', "limitPrice": ' + str.tostring(math.round(tp3_price * 100) / 100) + 
                 ', "reason": "TP3_final"}'
            alert(tp3Alert, alert.freq_once_per_bar)
            
            // Reset position
            inPosition := false
            entryPrice := na
            currentStop := na
            remainingQty := 0

// ==============================
// STOP LOSS EXIT ALERT
// ==============================
if inPosition and enableAlerts
    stopHit = isLong ? (low <= currentStop) : (high >= currentStop)
    if stopHit
        exitAction = isLong ? "sell" : "buy"
        stopReason = breakeven_active ? "breakeven_stop" : trailing_active ? "trailing_stop" : "initial_stop"
        
        stopAlert = '{"ticker": "' + tickerSymbol + '", "action": "' + exitAction + '", "orderType": "market", "quantity": ' + 
             str.tostring(math.round(remainingQty * 100) / 100) + 
             ', "reason": "' + stopReason + '"}'
        alert(stopAlert, alert.freq_once_per_bar)
        
        // Reset position
        inPosition := false
        entryPrice := na
        currentStop := na
        remainingQty := 0

// ==============================
// FLATTEN POSITION ALERT (End of Day)
// ==============================
endOfDay = currentTime >= 1550 and currentTime < 1555
if inPosition and endOfDay and enableAlerts
    exitAction = isLong ? "sell" : "buy"
    flattenAlert = '{"ticker": "' + tickerSymbol + '", "action": "' + exitAction + '", "orderType": "market", "quantity": ' + 
         str.tostring(math.round(remainingQty * 100) / 100) + 
         ', "reason": "end_of_day_flatten"}'
    alert(flattenAlert, alert.freq_once_per_bar)
    
    // Reset position
    inPosition := false
    entryPrice := na
    currentStop := na
    remainingQty := 0

// ==============================
// PERFORMANCE DISPLAY TABLE
// ==============================
var table perfTable = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 85))

if barstate.isconfirmed
    table.cell(perfTable, 0, 0, "MGC ALERT-ONLY SYSTEM", colspan=2, 
         bgcolor=color.new(color.gold, 60), text_color=color.white, text_size=size.normal)
    
    table.cell(perfTable, 0, 1, "Daily Trades", text_color=color.white)
    table.cell(perfTable, 1, 1, str.tostring(dailyTrades) + "/" + str.tostring(maxTradesPerDay), 
         text_color=dailyTrades >= maxTradesPerDay ? color.red : color.lime)
    
    table.cell(perfTable, 0, 2, "Alerts", text_color=color.white)
    table.cell(perfTable, 1, 2, enableAlerts ? "ENABLED" : "DISABLED", 
         text_color=enableAlerts ? color.lime : color.red)
    
    table.cell(perfTable, 0, 3, "Session", text_color=color.white)
    table.cell(perfTable, 1, 3, sessionOK ? "ACTIVE" : "CLOSED", 
         text_color=sessionOK ? color.lime : color.gray)
    
    table.cell(perfTable, 0, 4, "Confluence L/S", text_color=color.white)
    table.cell(perfTable, 1, 4, str.tostring(confluenceLong) + " / " + str.tostring(confluenceShort), 
         text_color=math.max(confluenceLong, confluenceShort) >= minConfluenceScore ? color.lime : color.gray)
    
    table.cell(perfTable, 0, 5, "ADX", text_color=color.white)
    table.cell(perfTable, 1, 5, str.tostring(adx, "#.#"), 
         text_color=adx > adxThreshold ? color.lime : color.gray)
    
    table.cell(perfTable, 0, 6, "Position", text_color=color.white)
    posText = inPosition ? (isLong ? "LONG" : "SHORT") : "FLAT"
    table.cell(perfTable, 1, 6, posText, 
         text_color=inPosition ? color.yellow : color.gray)
    
    table.cell(perfTable, 0, 7, "Stop Status", text_color=color.white)
    stopStatus = trailing_active ? "TRAILING" : breakeven_active ? "BREAKEVEN" : inPosition ? "INITIAL" : "-"
    table.cell(perfTable, 1, 7, stopStatus, text_color=color.aqua)
    
    table.cell(perfTable, 0, 8, "TP Stage", text_color=color.white)
    tpStage = tp2_hit ? "TP3" : tp1_hit ? "TP2" : inPosition ? "TP1" : "-"
    table.cell(perfTable, 1, 8, tpStage, text_color=color.orange)
    
    table.cell(perfTable, 0, 9, "Remaining Qty", text_color=color.white)
    table.cell(perfTable, 1, 9, str.tostring(remainingQty, "#.##"), text_color=color.white)

// ==============================
// CONFLUENCE BREAKDOWN TABLE
// ==============================
var table confTable = table.new(position.top_left, 3, 12, bgcolor=color.new(color.black, 85))

if barstate.isconfirmed
    table.cell(confTable, 0, 0, "Confluence Factor", colspan=3, 
         bgcolor=color.new(color.blue, 70), text_color=color.white)
    
    table.cell(confTable, 0, 1, "HTF Confirm", text_color=color.white)
    table.cell(confTable, 1, 1, htf_bullish ? "+" : "-", text_color=htf_bullish ? color.lime : color.gray)
    table.cell(confTable, 2, 1, htf_bearish ? "+" : "-", text_color=htf_bearish ? color.red : color.gray)
    
    table.cell(confTable, 0, 2, "ADX > 30", text_color=color.white)
    table.cell(confTable, 1, 2, strongTrend ? "+" : "-", text_color=strongTrend ? color.lime : color.gray)
    table.cell(confTable, 2, 2, strongTrend ? "+" : "-", text_color=strongTrend ? color.red : color.gray)
    
    table.cell(confTable, 0, 3, "EMA Aligned", text_color=color.white)
    table.cell(confTable, 1, 3, ema_bullish_aligned ? "+" : "-", text_color=ema_bullish_aligned ? color.lime : color.gray)
    table.cell(confTable, 2, 3, ema_bearish_aligned ? "+" : "-", text_color=ema_bearish_aligned ? color.red : color.gray)
    
    table.cell(confTable, 0, 4, "Hull MA", text_color=color.white)
    table.cell(confTable, 1, 4, hull_bullish ? "+" : "-", text_color=hull_bullish ? color.lime : color.gray)
    table.cell(confTable, 2, 4, hull_bearish ? "+" : "-", text_color=hull_bearish ? color.red : color.gray)
    
    table.cell(confTable, 0, 5, "MACD", text_color=color.white)
    table.cell(confTable, 1, 5, macd_bullish ? "+" : "-", text_color=macd_bullish ? color.lime : color.gray)
    table.cell(confTable, 2, 5, macd_bearish ? "+" : "-", text_color=macd_bearish ? color.red : color.gray)
    
    table.cell(confTable, 0, 6, "RSI Neutral", text_color=color.white)
    table.cell(confTable, 1, 6, rsi_neutral ? "+" : "-", text_color=rsi_neutral ? color.lime : color.gray)
    table.cell(confTable, 2, 6, rsi_neutral ? "+" : "-", text_color=rsi_neutral ? color.red : color.gray)
    
    table.cell(confTable, 0, 7, "Near S/R", text_color=color.white)
    table.cell(confTable, 1, 7, nearSupport ? "+" : "-", text_color=nearSupport ? color.lime : color.gray)
    table.cell(confTable, 2, 7, nearResistance ? "+" : "-", text_color=nearResistance ? color.red : color.gray)
    
    table.cell(confTable, 0, 8, "Volume", text_color=color.white)
    table.cell(confTable, 1, 8, volumeSpike ? "+" : "-", text_color=volumeSpike ? color.lime : color.gray)
    table.cell(confTable, 2, 8, volumeSpike ? "+" : "-", text_color=volumeSpike ? color.red : color.gray)
    
    table.cell(confTable, 0, 9, "Structure", text_color=color.white)
    table.cell(confTable, 1, 9, cleanBullStructure ? "+" : "-", text_color=cleanBullStructure ? color.lime : color.gray)
    table.cell(confTable, 2, 9, cleanBearStructure ? "+" : "-", text_color=cleanBearStructure ? color.red : color.gray)
    
    table.cell(confTable, 0, 10, "Trend Strength", text_color=color.white)
    bullTrend = strongTrendDirection and close > close[trendLookback]
    bearTrend = strongTrendDirection and close < close[trendLookback]
    table.cell(confTable, 1, 10, bullTrend ? "+" : "-", text_color=bullTrend ? color.lime : color.gray)
    table.cell(confTable, 2, 10, bearTrend ? "+" : "-", text_color=bearTrend ? color.red : color.gray)
    
    table.cell(confTable, 0, 11, "TOTAL SCORE", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(confTable, 1, 11, str.tostring(confluenceLong) + "/10", 
         bgcolor=confluenceLong >= minConfluenceScore ? color.new(color.lime, 70) : color.new(color.gray, 80),
         text_color=color.white)
    table.cell(confTable, 2, 11, str.tostring(confluenceShort) + "/10",
         bgcolor=confluenceShort >= minConfluenceScore ? color.new(color.red, 70) : color.new(color.gray, 80),
         text_color=color.white)

// ==============================
// VISUAL PLOTS
// ==============================
plot(ema9, "EMA 9", color=color.new(color.red, 50), linewidth=1)
plot(ema21, "EMA 21", color=color.new(color.orange, 50), linewidth=1)
plot(ema50, "EMA 50", color=color.new(color.blue, 50), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.purple, 50), linewidth=2)
plot(hull, "Hull MA", color=hull_bullish ? color.green : hull_bearish ? color.red : color.gray, linewidth=3)

// Plot stop loss level
plot(inPosition and not na(currentStop) ? currentStop : na,
     "Stop Loss",
     color=trailing_active ? color.aqua : breakeven_active ? color.yellow : color.red,
     linewidth=2,
     style=plot.style_cross)

// Plot TP levels when in position
plot(inPosition and isLong and not tp1_hit ? tp1_price : na,
     "TP1 Long", color=color.new(color.lime, 50), style=plot.style_circles)
plot(inPosition and not isLong and not tp1_hit ? tp1_price : na,
     "TP1 Short", color=color.new(color.red, 50), style=plot.style_circles)

plot(inPosition and isLong and tp1_hit and not tp2_hit ? tp2_price : na,
     "TP2 Long", color=color.new(color.lime, 30), style=plot.style_circles)
plot(inPosition and not isLong and tp1_hit and not tp2_hit ? tp2_price : na,
     "TP2 Short", color=color.new(color.red, 30), style=plot.style_circles)

// Entry markers
plotshape(longCondition, "Long Signal", shape.triangleup, location.belowbar, 
     color=color.green, size=size.normal, text="BUY")
plotshape(shortCondition, "Short Signal", shape.triangledown, location.abovebar,
     color=color.red, size=size.normal, text="SELL")

// Background colors
bgcolor(not sessionOK ? color.new(color.red, 95) : na)
bgcolor(dailyTrades >= maxTradesPerDay ? color.new(color.orange, 95) : na)
bgcolor(confluenceLong >= minConfluenceScore and not inPosition ? color.new(color.green, 97) : na)
bgcolor(confluenceShort >= minConfluenceScore and not inPosition ? color.new(color.red, 97) : na)
bgcolor(inPosition ? color.new(color.yellow, 97) : na)
