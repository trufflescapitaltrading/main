//@version=5
strategy("RUN V.14.2 PRODUCTION - MTF TREND+MOMENTUM SCALPER", overlay=true, initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, calc_on_order_fills=false, calc_on_every_tick=true, process_orders_on_close=false, backtest_fill_limits_assumption=0)

// ============================================================
// V.14.2 PRODUCTION CHANGELOG (from V.14.1):
// ============================================================
// FIX #1: STOP LOSS COOPERATION - SL now placed IMMEDIATELY with
//         entry via strategy.entry + strategy.exit on same bar.
//         Eliminated duplicate/conflicting exit IDs.
// FIX #2: SLIPPAGE GUARD - Alert JSON now includes slippage_buffer,
//         limit_price, and max_slippage fields so TradersPost can
//         place LIMIT orders instead of MARKET orders.
// FIX #3: TRAILING STOP AFTER BE+SLIPPAGE - New trailing system
//         activates only after price clears breakeven + slippage
//         buffer. Prevents premature stop-outs.
// FIX #4: FILTER HARMONY - All filters (MTF, 5-star, confluence,
//         session, volume, momentum) now COOPERATE via a unified
//         scoring gate instead of blocking each other independently.
// FIX #5: ANTI-CHOP FILTER - Prevents entries during sideways/
//         consolidating/ranging markets. Only allows trend continuation
//         and impulse breakout trades.
// FIX #6: SINGLE EXIT ID PER POSITION - No more conflicting TP1/TP2/
//         TP3/TP4 exit orders. Single contract = single exit order.
// FIX #7: alert() ONLY - All signals use alert() system calls only
//         for TradingView -> TradersPost -> Tradovate/TopstepX.
// FIX #8: PYRAMIDING=0 - No stacking positions. One trade at a time.
// ============================================================

// === HIGH WIN RATE MODE ===
highWinRateMode = input.bool(true, "High Win Rate Mode (80%+)")
quickTPMultiplier = input.float(0.6, "Quick TP Multiplier", minval=0.3, maxval=1.0)
widerSLMultiplier = input.float(1.8, "Wider SL Multiplier", minval=1.0, maxval=3.0)
minRSIForEntry = input.float(42, "Min RSI for Long Entry", minval=30, maxval=50)
maxRSIForEntry = input.float(58, "Max RSI for Short Entry", minval=50, maxval=70)

// === SLIPPAGE PROTECTION (NEW) ===
slippageGroup = "Slippage Protection"
enableSlippageGuard = input.bool(true, "Enable Slippage Guard", group=slippageGroup)
maxSlippagePoints = input.float(5.0, "Max Slippage Points (reject if exceeded)", group=slippageGroup)
useLimitOrders = input.bool(true, "Use Limit Orders in Alerts", group=slippageGroup)
limitOrderOffset = input.float(2.0, "Limit Order Offset (points from signal)", group=slippageGroup)
slippageBufferForBE = input.float(3.0, "Slippage Buffer for Breakeven (points)", group=slippageGroup)

// === ANTI-CHOP / TREND-ONLY FILTER (NEW) ===
antiChopGroup = "Anti-Chop Filter"
enableAntiChop = input.bool(true, "Enable Anti-Chop Filter", group=antiChopGroup)
adxPeriod = input.int(14, "ADX Period", minval=7, maxval=21, group=antiChopGroup)
adxThreshold = input.float(20.0, "ADX Threshold (below = chop)", minval=12.0, maxval=30.0, group=antiChopGroup)
enableImpulseOverride = input.bool(true, "Allow Impulse/Breakout in Chop", group=antiChopGroup)
impulseATRMultiple = input.float(2.0, "Impulse Bar ATR Multiple", minval=1.2, maxval=3.0, group=antiChopGroup)

// === CONFLUENCE LEVEL CONTROL (1-15) ===
confluenceLevel = input.int(8, "Confluence Level (1=Loose, 15=Strict)", minval=1, maxval=15)

// === 24/7 TRADING SESSIONS ===
enable24_7Trading = input.bool(true, "Enable 24/7 Trading", group="Global Sessions")
enableNoTradeZone = input.bool(true, "No Trade Zone (0:00-6:00 ET)", group="Global Sessions")

enableAsianSession = input.bool(true, "Asian Session (19:00-03:00 ET)", group="Global Sessions")
enableLondonSession = input.bool(true, "London Session (03:00-12:00 ET)", group="Global Sessions")
enableNYSession = input.bool(true, "NY Session (09:30-16:00 ET)", group="Global Sessions")
enableUAESession = input.bool(true, "UAE Session (00:00-08:00 ET)", group="Global Sessions")

asianBestInstruments = input.string("MNQ,MES,MGC", "Asian Best Instruments", group="Global Sessions")
londonBestInstruments = input.string("MGC,MCL,MES", "London Best Instruments", group="Global Sessions")
nyBestInstruments = input.string("MES,MNQ,MYM", "NY Best Instruments", group="Global Sessions")
uaeBestInstruments = input.string("MCL,MGC", "UAE Best Instruments", group="Global Sessions")

asianMultiplier = input.float(1.2, "Asian Session Multiplier", minval=0.5, maxval=2.0, group="Global Sessions")
londonMultiplier = input.float(1.3, "London Session Multiplier", minval=0.5, maxval=2.0, group="Global Sessions")
nyMultiplier = input.float(1.5, "NY Session Multiplier", minval=0.5, maxval=2.0, group="Global Sessions")
uaeMultiplier = input.float(0.9, "UAE Session Multiplier", minval=0.5, maxval=2.0, group="Global Sessions")

// === SIGNAL TYPE TOGGLES ===
enableStrongSignals = input.bool(true, "Enable STRONG Signals")
enableScalpSignals = input.bool(true, "Enable SCALP Signals")
enableInstantSignals = input.bool(true, "Enable INSTANT Signals")
enableMicroSignals = input.bool(false, "Enable MICRO Signals")  // OFF by default - too noisy for live

// === DAILY TRADE LIMIT ===
enableDailyTradeLimit = input.bool(true, "Enable Daily Trade Limit")
maxDailyTrades = input.int(12, "Max Daily Trades", minval=3, maxval=50)

// === MAE PROTECTION VARIABLES ===
var float peakProfit = 0.0
var int barsInPosition = 0

maxLossMGC = 60.0
breakevenThresholdMGC = 40.0
maeDrawbackPercent = 0.75

// === INSTRUMENT DETECTION ===
isMYM = str.contains(syminfo.ticker, "MYM") or str.contains(syminfo.ticker, "YM")
isMNQ = str.contains(syminfo.ticker, "MNQ") or str.contains(syminfo.ticker, "NQ")
isMCL = str.contains(syminfo.ticker, "MCL") or str.contains(syminfo.ticker, "CL")
isMGC = str.contains(syminfo.ticker, "MGC") or str.contains(syminfo.ticker, "GC")
isMES = str.contains(syminfo.ticker, "MES") or str.contains(syminfo.ticker, "ES")
isM2K = str.contains(syminfo.ticker, "M2K") or str.contains(syminfo.ticker, "RTY")
isMicroFutures = isMYM or isMNQ or isMCL or isMGC or isMES or isM2K

mymMultiplier = input.float(1.8, "MYM Trade Multiplier", minval=1.3, maxval=2.5)
mnqMultiplier = input.float(1.6, "MNQ Trade Multiplier", minval=1.2, maxval=2.2)
mclMultiplier = input.float(1.4, "MCL Trade Multiplier", minval=1.1, maxval=2.0)
mgcMultiplier = input.float(1.2, "MGC Trade Multiplier", minval=1.0, maxval=1.8)
mesMultiplier = input.float(1.7, "MES Trade Multiplier", minval=1.2, maxval=2.3)
m2kMultiplier = input.float(1.5, "M2K Trade Multiplier", minval=1.1, maxval=2.0)

// === INDIVIDUAL INSTRUMENT RISK MANAGEMENT ===
enableIndividualRiskLimits = input.bool(false, "Enable Individual Instrument Risk Limits")
totalDailyRisk = input.float(450.0, "Total Daily Risk ($)", minval=100, maxval=2000)

mymDailyRiskPercent = input.float(12.0, "MYM Daily Risk Allocation (%)", minval=5.0, maxval=30.0)
mnqDailyRiskPercent = input.float(18.0, "MNQ Daily Risk Allocation (%)", minval=10.0, maxval=35.0)
mesDailyRiskPercent = input.float(20.0, "MES Daily Risk Allocation (%)", minval=15.0, maxval=35.0)
mclDailyRiskPercent = input.float(25.0, "MCL Daily Risk Allocation (%)", minval=15.0, maxval=40.0)
mgcDailyRiskPercent = input.float(25.0, "MGC Daily Risk Allocation (%)", minval=15.0, maxval=40.0)

mymMaxDailyRisk = totalDailyRisk * (mymDailyRiskPercent / 100)
mnqMaxDailyRisk = totalDailyRisk * (mnqDailyRiskPercent / 100)
mesMaxDailyRisk = totalDailyRisk * (mesDailyRiskPercent / 100)
mclMaxDailyRisk = totalDailyRisk * (mclDailyRiskPercent / 100)
mgcMaxDailyRisk = totalDailyRisk * (mgcDailyRiskPercent / 100)

var float mymDailyLoss = 0.0
var float mnqDailyLoss = 0.0
var float mesDailyLoss = 0.0
var float mclDailyLoss = 0.0
var float mgcDailyLoss = 0.0
var int todayTradeCount = 0

if ta.change(dayofweek) != 0 or barstate.isfirst
    mymDailyLoss := 0.0
    mnqDailyLoss := 0.0
    mesDailyLoss := 0.0
    mclDailyLoss := 0.0
    mgcDailyLoss := 0.0
    todayTradeCount := 0

currentInstrumentLoss = isMYM ? mymDailyLoss : isMNQ ? mnqDailyLoss : isMES ? mesDailyLoss : isMCL ? mclDailyLoss : isMGC ? mgcDailyLoss : 0.0
currentInstrumentMaxLoss = isMYM ? mymMaxDailyRisk : isMNQ ? mnqMaxDailyRisk : isMES ? mesMaxDailyRisk : isMCL ? mclMaxDailyRisk : isMGC ? mgcMaxDailyRisk : totalDailyRisk

instrumentRiskLimitReached = enableIndividualRiskLimits and currentInstrumentLoss >= currentInstrumentMaxLoss

// === PER-INSTRUMENT TRADE TOGGLES ===
perInstGroup = "Per-Instrument Trade Settings"

mes_useCustom = input.bool(false, "MES: Use Custom SL/TP/Size", group=perInstGroup)
mes_customSL  = input.float(7.0, "MES: Stop Loss (points)", group=perInstGroup)
mes_customTP  = input.float(10.0, "MES: Take Profit (points)", group=perInstGroup)
mes_customQty = input.int(1, "MES: Position Size (contracts)", minval=1, maxval=50, group=perInstGroup)

mnq_useCustom = input.bool(false, "MNQ: Use Custom SL/TP/Size", group=perInstGroup)
mnq_customSL  = input.float(25.0, "MNQ: Stop Loss (points)", group=perInstGroup)
mnq_customTP  = input.float(35.0, "MNQ: Take Profit (points)", group=perInstGroup)
mnq_customQty = input.int(1, "MNQ: Position Size (contracts)", minval=1, maxval=50, group=perInstGroup)

mym_useCustom = input.bool(false, "MYM: Use Custom SL/TP/Size", group=perInstGroup)
mym_customSL  = input.float(60.0, "MYM: Stop Loss (points)", group=perInstGroup)
mym_customTP  = input.float(90.0, "MYM: Take Profit (points)", group=perInstGroup)
mym_customQty = input.int(1, "MYM: Position Size (contracts)", minval=1, maxval=50, group=perInstGroup)

mcl_useCustom = input.bool(false, "MCL: Use Custom SL/TP/Size", group=perInstGroup)
mcl_customSL  = input.float(0.30, "MCL: Stop Loss (price $)", group=perInstGroup)
mcl_customTP  = input.float(0.50, "MCL: Take Profit (price $)", group=perInstGroup)
mcl_customQty = input.int(1, "MCL: Position Size (contracts)", minval=1, maxval=50, group=perInstGroup)

mgc_useCustom = input.bool(false, "MGC: Use Custom SL/TP/Size", group=perInstGroup)
mgc_customSL  = input.float(4.0, "MGC: Stop Loss (price $)", group=perInstGroup)
mgc_customTP  = input.float(7.0, "MGC: Take Profit (price $)", group=perInstGroup)
mgc_customQty = input.int(1, "MGC: Position Size (contracts)", minval=1, maxval=50, group=perInstGroup)

m2k_useCustom = input.bool(false, "M2K: Use Custom SL/TP/Size", group=perInstGroup)
m2k_customSL  = input.float(9.0, "M2K: Stop Loss (points)", group=perInstGroup)
m2k_customTP  = input.float(14.0, "M2K: Take Profit (points)", group=perInstGroup)
m2k_customQty = input.int(1, "M2K: Position Size (contracts)", minval=1, maxval=50, group=perInstGroup)

// === SESSION TIME DETECTION ===
currentHour = hour
currentMinute = minute
currentTimeET = currentHour * 100 + currentMinute

isNoTradeZone = enableNoTradeZone and (currentTimeET >= 0 and currentTimeET < 600)
isAsianSession = enableAsianSession and enable24_7Trading and ((currentTimeET >= 1900) or (currentTimeET < 300))
isLondonSession = enableLondonSession and enable24_7Trading and (currentTimeET >= 300 and currentTimeET < 1200)
isNYSession = enableNYSession and (currentTimeET >= 930 and currentTimeET <= 1600)
isUAESession = enableUAESession and enable24_7Trading and (currentTimeET >= 0 and currentTimeET < 800)

instrumentName = isMYM ? "MYM" : isMNQ ? "MNQ" : isMES ? "MES" : isMCL ? "MCL" : isMGC ? "MGC" : isM2K ? "M2K" : "Unknown"

isOptimalForAsian = str.contains(asianBestInstruments, instrumentName)
isOptimalForLondon = str.contains(londonBestInstruments, instrumentName)
isOptimalForNY = str.contains(nyBestInstruments, instrumentName)
isOptimalForUAE = str.contains(uaeBestInstruments, instrumentName)

var float activeSessionMultiplier = 1.0
if isAsianSession and isOptimalForAsian
    activeSessionMultiplier := asianMultiplier
else if isLondonSession and isOptimalForLondon
    activeSessionMultiplier := londonMultiplier
else if isNYSession and isOptimalForNY
    activeSessionMultiplier := nyMultiplier
else if isUAESession and isOptimalForUAE
    activeSessionMultiplier := uaeMultiplier
else if enable24_7Trading
    activeSessionMultiplier := 0.7
else
    activeSessionMultiplier := 1.0

canTradeNow = not isNoTradeZone

// === TRADING INPUTS ===
hullSrc = input.source(close, "Hull Source")
baseHullMain = input.int(25, "Base Hull MA (Main)", minval=15, maxval=40)
baseHullFast = input.int(9, "Base Hull MA (Fast)", minval=6, maxval=15)

hullPeriodMain = isMYM ? math.round(baseHullMain * 0.75) : isMNQ ? math.round(baseHullMain * 0.75) : isMES ? math.round(baseHullMain * 0.75) : isMCL ? math.round(baseHullMain * 0.85) : isMGC ? baseHullMain : isM2K ? math.round(baseHullMain * 0.8) : baseHullMain
hullPeriodFast = isMYM ? math.round(baseHullFast * 0.85) : isMNQ ? math.round(baseHullFast * 0.85) : isMES ? math.round(baseHullFast * 0.85) : isMCL ? math.round(baseHullFast * 0.9) : isMGC ? baseHullFast : isM2K ? math.round(baseHullFast * 0.9) : baseHullFast

baseEnvLength = input.int(12, "Base Envelope Period", minval=8, maxval=20)
baseEnvDev = input.float(0.8, "Base Envelope Deviation %", minval=0.5, maxval=1.5)

envLength = isMYM ? math.round(baseEnvLength * 1.0) : isMNQ ? math.round(baseEnvLength * 1.0) : isMES ? math.round(baseEnvLength * 1.0) : isMCL ? baseEnvLength : isMGC ? math.round(baseEnvLength * 1.1) : isM2K ? math.round(baseEnvLength * 1.05) : baseEnvLength
envDev = isMYM ? baseEnvDev * 1.1 : isMNQ ? baseEnvDev * 1.0 : isMES ? baseEnvDev * 1.0 : isMCL ? baseEnvDev * 1.0 : isMGC ? baseEnvDev * 0.95 : isM2K ? baseEnvDev * 1.05 : baseEnvDev

basePivotPeriod = input.int(2, "Base Pivot Period", minval=1, maxval=4)
baseAtrFactor = input.float(2.2, "Base ATR Factor", minval=1.8, maxval=3.0)
baseAtrPeriod = input.int(8, "Base ATR Period", minval=6, maxval=12)

pivotPeriod = basePivotPeriod
atrFactor = isMYM ? baseAtrFactor * 1.2 : isMNQ ? baseAtrFactor * 1.1 : isMES ? baseAtrFactor * 1.1 : isMCL ? baseAtrFactor * 1.05 : isMGC ? baseAtrFactor : isM2K ? baseAtrFactor * 1.15 : baseAtrFactor
atrPeriod = isMYM ? math.round(baseAtrPeriod * 1.1) : isMNQ ? math.round(baseAtrPeriod * 1.0) : isMES ? math.round(baseAtrPeriod * 1.0) : isMCL ? baseAtrPeriod : isMGC ? math.round(baseAtrPeriod * 1.1) : isM2K ? math.round(baseAtrPeriod * 1.05) : baseAtrPeriod

// === RISK MANAGEMENT SETTINGS ===
baseRiskPercent = input.float(0.6, "Base Risk per Trade (%)", minval=0.2, maxval=2.0)
instrumentRiskMultiplier = isMYM ? 1.2 : isMNQ ? 1.1 : isMES ? 1.1 : isMCL ? 1.0 : isMGC ? 1.0 : isM2K ? 1.05 : 1.0
adjustedRiskPercent = baseRiskPercent * instrumentRiskMultiplier

useTP = input.bool(true, "Use Take Profit Levels")
useSL = input.bool(true, "Use Stop Loss")
maxDailyLoss = input.float(5.0, "Max Daily Loss (%)", minval=2.0, maxval=8.0)
maxPositionSize = input.float(12.0, "Max Position Size (% of Equity)", minval=5.0, maxval=25.0)

// === TRADERSPOST ALERT SETTINGS ===
enableTradersPostAlerts = input.bool(true, "Enable TradersPost Alerts")

// === V8 SAFETY SETTINGS ===
require5Star = input.bool(false, "V8: Require 5-Star Entry Gate", group="V8 Safety")
minMESRangePoints = input.float(5.0, "V8: Min MES Range (points) for Star 4", group="V8 Safety")
usePointRangeCheck = input.bool(true, "V8: Enable Min Range Check for Star 4", group="V8 Safety")
minStarsRequired = input.int(3, "V8: Minimum Stars Required (1-5)", minval=1, maxval=5, group="V8 Safety")

enableMTF = input.bool(true, "V8: Enable Multi-Timeframe Checks", group="V8 Safety")
mtfMode = input.string("Filter", "V8: MTF Mode", options=["Confirmation", "Filter", "Advisory"], group="V8 Safety")
mtf_tf1 = input.timeframe("15", "V8: MTF 1", group="V8 Safety")
mtf_tf2 = input.timeframe("60", "V8: MTF 2", group="V8 Safety")
mtf_tf3 = input.timeframe("240", "V8: MTF 3", group="V8 Safety")
mtfAlignThreshold = input.int(66, "V8: MTF Alignment % Threshold", minval=0, maxval=100, group="V8 Safety")

enableDollarStops = input.bool(true, "V8: Send Dollar-based SL/TP in webhook", group="V8 Safety")
includeSignalPrice = input.bool(true, "V8: Include signalPrice in webhook JSON", group="V8 Safety")
useManualDollarOverrides = input.bool(false, "V8: Use FIXED Dollar SL/TP Overrides", group="V8 Safety")
manualDollarSL = input.float(0.0, "V8: Fixed Dollar Stop Loss (0 = auto)", group="V8 Safety")
manualDollarTP = input.float(0.0, "V8: Fixed Dollar Take Profit (0 = auto)", group="V8 Safety")

// Helper: dollar value between two prices
priceDiffToDollars(p1, p2) =>
    math.abs(p1 - p2) * syminfo.pointvalue

// Helper: MTF trend direction
mtfTrend(tf) =>
    tf_close = request.security(syminfo.tickerid, tf, close, lookahead = barmerge.lookahead_off)
    tf_hma   = request.security(syminfo.tickerid, tf, ta.wma(close, 8), lookahead = barmerge.lookahead_off)
    tf_close > tf_hma ? 1 : tf_close < tf_hma ? -1 : 0

// === ADX CALCULATION (ANTI-CHOP) ===
[diPlus, diMinus, adxValue] = ta.dmi(adxPeriod, adxPeriod)
isChoppy = enableAntiChop and adxValue < adxThreshold

// === 5-STAR CHECKS ===
star_priceRangeExpanding = close > ta.highest(high, 20)[1] or close < ta.lowest(low, 20)[1]
fastEMA = ta.ema(close, 9)
slowEMA = ta.ema(close, 21)
star_directionalMomentum = fastEMA > slowEMA or fastEMA < slowEMA
star_increasingVelocity = math.abs(close - close[1]) > math.abs(close[1] - close[2])
star_notTightRange = true
if usePointRangeCheck and (isMES or isMNQ or isMYM or isM2K)
    recentRangePoints = (ta.highest(high, 20) - ta.lowest(low, 20)) / syminfo.mintick
    requiredPoints    = isMES ? minMESRangePoints / syminfo.mintick : 0.0
    star_notTightRange := requiredPoints == 0.0 ? true : recentRangePoints >= requiredPoints
star_atrExpanding = ta.atr(atrPeriod) > ta.sma(ta.atr(atrPeriod), 3)

starScore = 0
starScore += star_priceRangeExpanding ? 1 : 0
starScore += star_directionalMomentum ? 1 : 0
starScore += star_increasingVelocity ? 1 : 0
starScore += star_notTightRange ? 1 : 0
starScore += star_atrExpanding ? 1 : 0
fiveStarOK = starScore >= minStarsRequired

// === MTF alignment scoring ===
mtfScore() =>
    if not enableMTF
        100
    else
        a1 = mtfTrend(mtf_tf1)
        a2 = mtfTrend(mtf_tf2)
        a3 = mtfTrend(mtf_tf3)
        align = (a1 == a2 ? 1 : 0) + (a1 == a3 ? 1 : 0) + (a2 == a3 ? 1 : 0)
        align * 33

mtf_alignment_pct = mtfScore()

// === MTF DIRECTIONAL BIAS (NEW - for trend-only trading) ===
mtfBullish() =>
    if not enableMTF
        true
    else
        a1 = mtfTrend(mtf_tf1)
        a2 = mtfTrend(mtf_tf2)
        a3 = mtfTrend(mtf_tf3)
        bullCount = (a1 == 1 ? 1 : 0) + (a2 == 1 ? 1 : 0) + (a3 == 1 ? 1 : 0)
        bullCount >= 2

mtfBearish() =>
    if not enableMTF
        true
    else
        a1 = mtfTrend(mtf_tf1)
        a2 = mtfTrend(mtf_tf2)
        a3 = mtfTrend(mtf_tf3)
        bearCount = (a1 == -1 ? 1 : 0) + (a2 == -1 ? 1 : 0) + (a3 == -1 ? 1 : 0)
        bearCount >= 2

mtfIsBullish = mtfBullish()
mtfIsBearish = mtfBearish()

// === EXIT CONTROLS ===
useSignalReversalExits = input.bool(true, "Signal Reversal Exits")
useEndOfDayExits = input.bool(true, "End of Day Exits")
endOfDayTime = input.int(1550, "End of Day Time (ET)", minval=1500, maxval=1700)
useLosingTradeAutoClose = input.bool(true, "Losing Trade Auto-Close")
losingTradeThreshold = input.float(2.0, "Losing Trade Threshold (%)", minval=1.0, maxval=5.0)

// === PROFIT PROTECTION SETTINGS ===
useBreakevenProtection = input.bool(true, "Breakeven Stop Protection")
breakevenTrigger = input.float(1.5, "Breakeven Trigger (ATR)", minval=0.5, maxval=3.0)
useATRDynamicStops = input.bool(true, "ATR-Based Dynamic Stops")
atrStopMultiplier = input.float(1.8, "ATR Stop Multiplier", minval=1.0, maxval=3.0)
useProfitLockIn = input.bool(true, "Profit Lock-In Levels")
profitLock1 = input.float(2.0, "Profit Lock Level 1 (ATR)", minval=1.0, maxval=4.0)
profitLock2 = input.float(3.5, "Profit Lock Level 2 (ATR)", minval=2.0, maxval=6.0)
profitLock3 = input.float(5.0, "Profit Lock Level 3 (ATR)", minval=3.0, maxval=8.0)
useMaxProfitDrawdown = input.bool(true, "Max Profit Drawdown Protection")
maxProfitDrawdownPercent = input.float(30.0, "Max Profit Drawdown (%)", minval=10.0, maxval=50.0)
useTimeProfitProtection = input.bool(true, "Time-Based Profit Protection")
timeProfitThreshold = input.int(15, "Time Profit Threshold (bars)", minval=5, maxval=50)

useFixedContractSize = input.bool(true, "Use Fixed Contract Size")
fixedContracts = input.int(1, "Fixed Contract Size", minval=1, maxval=10)

// === TRAILING STOP SETTINGS (NEW - after BE+slippage) ===
trailingGroup = "Trailing Stop"
enableTrailingAfterBE = input.bool(true, "Enable Trailing Stop After BE+Slippage", group=trailingGroup)
trailingATRMult = input.float(1.2, "Trailing Distance (ATR Multiple)", minval=0.5, maxval=3.0, group=trailingGroup)
trailingActivationATR = input.float(1.0, "Trailing Activation (ATR past BE)", minval=0.3, maxval=3.0, group=trailingGroup)

// === MODE CONTROLS ===
ultraMode = input.bool(true, "Enable Ultra Trading Mode")
enableScalping = input.bool(true, "Enable Scalping Mode")
quickExitMode = input.bool(true, "Quick Exit Mode")
baseMaxHolding = input.int(25, "Base Max Holding Periods", minval=15, maxval=50)
maxHoldingBars = isMYM ? math.round(baseMaxHolding * 0.95) : isMNQ ? baseMaxHolding : isMES ? baseMaxHolding : isMCL ? math.round(baseMaxHolding * 1.2) : isMGC ? math.round(baseMaxHolding * 1.4) : isM2K ? math.round(baseMaxHolding * 1.1) : baseMaxHolding

// === SESSION-BASED OPTIMIZATION ===
enableSessionFilters = input.bool(true, "Enable Session Filters")
preMarketStart = input.int(600, "Pre-Market Start (ET)")
regularSessionStart = input.int(930, "Regular Session Start (ET)")
regularSessionEnd = input.int(1600, "Regular Session End (ET)")
afterHoursEnd = input.int(1700, "After Hours End (ET)")

currentTime = math.round(hour * 100 + minute)
isPreMarket = enableSessionFilters and currentTime >= preMarketStart and currentTime < regularSessionStart
isRegularSession = enableSessionFilters and currentTime >= regularSessionStart and currentTime <= regularSessionEnd
isAfterHours = enableSessionFilters and currentTime > regularSessionEnd and currentTime <= afterHoursEnd
isEndOfDay = currentTime >= endOfDayTime

sessionMultiplier = not enableSessionFilters ? 1.0 : isRegularSession ? 1.05 : isPreMarket or isAfterHours ? 0.75 : 0.6
finalSessionMultiplier = sessionMultiplier * activeSessionMultiplier

// === ENHANCED SIZING & REGIME ===
useDynamicSizing = input.bool(false, "Use Dynamic Position Sizing")  // OFF for live - use fixed

useMarketRegime = input.bool(true, "Use Market Regime Detection")
baseTrendPeriod = input.int(6, "Base Trend Period", minval=4, maxval=12)
baseVolPeriod = input.int(6, "Base Volatility Period", minval=4, maxval=12)

trendStrengthPeriod = isMYM ? math.round(baseTrendPeriod * 0.95) : isMNQ ? baseTrendPeriod : isMES ? baseTrendPeriod : isMCL ? math.round(baseTrendPeriod * 1.2) : isMGC ? math.round(baseTrendPeriod * 1.3) : isM2K ? math.round(baseTrendPeriod * 1.1) : baseTrendPeriod
volatilityPeriod = isMYM ? math.round(baseVolPeriod * 0.95) : isMNQ ? baseVolPeriod : isMES ? baseVolPeriod : isMCL ? math.round(baseVolPeriod * 1.1) : isMGC ? math.round(baseVolPeriod * 1.2) : isM2K ? math.round(baseVolPeriod * 1.0) : baseVolPeriod

useVolumeFilter = input.bool(true, "Use Volume Filter")
baseVolumePeriod = input.int(6, "Base Volume Period", minval=4, maxval=12)
volumePeriod = isMYM ? math.round(baseVolumePeriod * 0.95) : isMNQ ? baseVolumePeriod : isMES ? baseVolumePeriod : isMCL ? math.round(baseVolumePeriod * 1.1) : isMGC ? math.round(baseVolumePeriod * 1.2) : isM2K ? math.round(baseVolumePeriod * 1.0) : baseVolumePeriod
baseVolumeThreshold = input.float(0.6, "Base Volume Threshold", minval=0.3, maxval=1.2)
volumeThreshold = isMYM ? baseVolumeThreshold * 0.85 : isMNQ ? baseVolumeThreshold * 0.9 : isMES ? baseVolumeThreshold * 0.9 : isMCL ? baseVolumeThreshold * 1.0 : isMGC ? baseVolumeThreshold : isM2K ? baseVolumeThreshold * 0.95 : baseVolumeThreshold

useMomentumFilter = input.bool(true, "Use Momentum Filter")
baseRsiPeriod = input.int(6, "Base RSI Period", minval=4, maxval=10)
rsiPeriod = isMYM ? math.round(baseRsiPeriod * 0.95) : isMNQ ? baseRsiPeriod : isMES ? baseRsiPeriod : isMCL ? math.round(baseRsiPeriod * 1.1) : isMGC ? math.round(baseRsiPeriod * 1.2) : isM2K ? math.round(baseRsiPeriod * 1.0) : baseRsiPeriod

rsiOverbought = input.float(75, "RSI Overbought", minval=70, maxval=85)
rsiOversold = input.float(25, "RSI Oversold", minval=15, maxval=30)
stochPeriod = rsiPeriod

// === TAKE PROFIT SYSTEM ===
useEnhancedTP = input.bool(true, "Use Enhanced Take Profit")
baseTpMultiplier = input.float(0.7, "Base TP Multiplier", minval=0.4, maxval=2.0)
tpMultiplier = isMYM ? baseTpMultiplier * 1.3 : isMNQ ? baseTpMultiplier * 1.2 : isMES ? baseTpMultiplier * 1.2 : isMCL ? baseTpMultiplier * 1.1 : isMGC ? baseTpMultiplier : isM2K ? baseTpMultiplier * 1.25 : baseTpMultiplier

useSmartTrailing = input.bool(true, "Use Smart Trailing Stop")
baseTrailActivation = input.float(0.7, "Base Trail Activation", minval=0.4, maxval=1.2)
trailActivationRatio = isMYM ? baseTrailActivation * 0.95 : isMNQ ? baseTrailActivation : isMES ? baseTrailActivation : isMCL ? baseTrailActivation * 1.1 : isMGC ? baseTrailActivation * 1.2 : isM2K ? baseTrailActivation * 1.0 : baseTrailActivation

// === HULL MOVING AVERAGES ===
hma(src, len) =>
    half_length = math.round(len / 2)
    sqrt_length = math.round(math.sqrt(len))
    ta.wma(2 * ta.wma(src, half_length) - ta.wma(src, len), sqrt_length)

hullMain = hma(hullSrc, math.max(hullPeriodMain, 2))
hullFast = hma(hullSrc, math.max(hullPeriodFast, 2))

slopeMain = hullMain > hullMain[1] ? 1 : hullMain < hullMain[1] ? -1 : 0
slopeFast = hullFast > hullFast[1] ? 1 : hullFast < hullFast[1] ? -1 : 0

hullAnyBullish = slopeMain == 1 or slopeFast == 1
hullAnyBearish = slopeMain == -1 or slopeFast == -1
hullMicroTurn = slopeFast != slopeFast[1]
hullAcceleration = (slopeMain == slopeFast) and (slopeFast != 0)

// Hull alignment (both agree on direction)
hullAlignedBull = slopeMain == 1 and slopeFast == 1
hullAlignedBear = slopeMain == -1 and slopeFast == -1

// === VOLUME INDICATORS ===
volumeMA = ta.sma(volume, volumePeriod)
volumeConfirm = not useVolumeFilter or (volume > volumeMA * volumeThreshold and volume > volumeMA * 0.8)
normalVolume = volume >= volumeMA * 0.7
strongVolume = volume > volumeMA * 1.2

// === ENVELOPE ===
smaBasis = ta.sma(close, math.max(envLength, 2))
upperEnv = smaBasis * (1 + envDev / 100)
lowerEnv = smaBasis * (1 - envDev / 100)

microBreakoutUp = close > upperEnv * 1.005 and strongVolume
microBreakoutDn = close < lowerEnv * 0.995 and strongVolume

// === SUPER TREND ===
ph = ta.pivothigh(pivotPeriod, pivotPeriod)
pl = ta.pivotlow(pivotPeriod, pivotPeriod)

var float center = na
lastpp = not na(ph) ? ph : not na(pl) ? pl : na
if not na(lastpp)
    center := na(center) ? lastpp : (center + lastpp) / 2
else if na(center)
    center := close

atrSuperTrend = ta.atr(atrPeriod)
upBand = na(center) ? close - atrFactor * atrSuperTrend : center - atrFactor * atrSuperTrend
dnBand = na(center) ? close + atrFactor * atrSuperTrend : center + atrFactor * atrSuperTrend

var float trUp = na
var float trDn = na
var int trend = 1

trUp := close[1] > trUp[1] ? math.max(upBand, trUp[1]) : upBand
trDn := close[1] < trDn[1] ? math.min(dnBand, trDn[1]) : dnBand
trend := close > trDn[1] ? 1 : close < trUp[1] ? -1 : trend[1]

trendChange = trend != trend[1]
bullishTrendStart = trend == 1 and trend[1] == -1
bearishTrendStart = trend == -1 and trend[1] == 1

// === MARKET REGIME DETECTION ===
priceRange = ta.highest(high, trendStrengthPeriod) - ta.lowest(low, trendStrengthPeriod)
trendStrength = priceRange > 0 ? math.abs(close - close[trendStrengthPeriod]) / priceRange : 0
strongTrend = trendStrength > 0.15
rangingMarket = trendStrength < 0.08
moderateTrend = not strongTrend and not rangingMarket

currentVol = ta.atr(volatilityPeriod)
avgVol = ta.sma(ta.atr(volatilityPeriod), volatilityPeriod)
highVolatility = currentVol > avgVol * 1.1
normalVolatility = not highVolatility

// === IMPULSE BAR DETECTION (for breakout override in chop) ===
atrForImpulse = ta.atr(14)
barRange = high - low
isImpulseBar = barRange > atrForImpulse * impulseATRMult and strongVolume
impulseUp = isImpulseBar and close > open
impulseDown = isImpulseBar and close < open

// === ANTI-CHOP FINAL GATE ===
// If choppy: block normal entries, allow only impulse breakouts
antiChopAllowLong = not isChoppy or (enableImpulseOverride and impulseUp)
antiChopAllowShort = not isChoppy or (enableImpulseOverride and impulseDown)

// === MOMENTUM INDICATORS ===
rsi = ta.rsi(close, rsiPeriod)
stoch = ta.stoch(close, high, low, stochPeriod)
stochK = ta.sma(stoch, 3)

momentumBullish = highWinRateMode ?
     (rsi > minRSIForEntry and rsi < 65 and stochK > 25 and stochK < 75) :
     (not useMomentumFilter or (rsi > 35 and rsi < rsiOverbought and stochK > 25))

momentumBearish = highWinRateMode ?
     (rsi < maxRSIForEntry and rsi > 35 and stochK < 75 and stochK > 25) :
     (not useMomentumFilter or (rsi < 65 and rsi > rsiOversold and stochK < 75))

notOverbought = rsi < 72
notOversold = rsi > 28

strongMomentumBull = rsi > 45 and rsi < 70 and stochK > 35 and stochK < 80
strongMomentumBear = rsi < 55 and rsi > 30 and stochK < 65 and stochK > 20

microMomentumBull = (rsi > rsi[1] and stochK > stochK[1]) and strongMomentumBull
microMomentumBear = (rsi < rsi[1] and stochK < stochK[1]) and strongMomentumBear

priceUp = close > close[1]
priceDown = close < close[1]

// === EMA TREND ALIGNMENT (NEW - higher quality entries) ===
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
bullishEMAStack = close > ema50 and ema50 > ema200
bearishEMAStack = close < ema50 and ema50 < ema200

// === SIGNAL LOGIC (TIGHTENED FOR 80% WIN RATE) ===
// STRONG: Full alignment of hull + supertrend + momentum + EMA stack
strongBuySignal = hullAlignedBull and trend == 1 and momentumBullish and strongMomentumBull and volumeConfirm
strongSellSignal = hullAlignedBear and trend == -1 and momentumBearish and strongMomentumBear and volumeConfirm

// SCALP: Momentum + trend + hull acceleration
scalpBuySignal = enableScalping and microMomentumBull and trend == 1 and hullAcceleration and slopeMain == 1 and volumeConfirm
scalpSellSignal = enableScalping and microMomentumBear and trend == -1 and hullAcceleration and slopeMain == -1 and volumeConfirm

// INSTANT: Trend change + hull turn confirmation
instantBuySignal = (bullishTrendStart and hullAnyBullish and volumeConfirm) or (impulseUp and trend == 1)
instantSellSignal = (bearishTrendStart and hullAnyBearish and volumeConfirm) or (impulseDown and trend == -1)

// MICRO: Weakest signals - require extra confirmation
microBuySignal = priceUp and hullAlignedBull and trend == 1 and close > smaBasis and strongVolume and momentumBullish
microSellSignal = priceDown and hullAlignedBear and trend == -1 and close < smaBasis and strongVolume and momentumBearish

// === UNIFIED SIGNAL WITH MTF DIRECTION AGREEMENT ===
// CRITICAL FIX: MTF must agree with trade direction
ultraBuySignal = ((enableStrongSignals and strongBuySignal) or
                  (enableScalpSignals and scalpBuySignal) or
                  (enableInstantSignals and instantBuySignal) or
                  (enableMicroSignals and microBuySignal)) and
                 notOversold and
                 (not enableMTF or mtfIsBullish)  // MTF must be bullish for longs

ultraSellSignal = ((enableStrongSignals and strongSellSignal) or
                   (enableScalpSignals and scalpSellSignal) or
                   (enableInstantSignals and instantSellSignal) or
                   (enableMicroSignals and microSellSignal)) and
                  notOverbought and
                  (not enableMTF or mtfIsBearish)  // MTF must be bearish for shorts

// === CONFLUENCE SYSTEM (UNIFIED SCORING) ===
confluenceVolumeOK = confluenceLevel <= 3 ? true : volumeConfirm
confluenceMomentumOK = confluenceLevel <= 6 ? true : (strongMomentumBull or strongMomentumBear)
confluenceTrendOK = confluenceLevel <= 9 ? true : (strongTrend or moderateTrend)
confluenceSessionOK = confluenceLevel <= 9 ? true : (isRegularSession or isPreMarket or isAfterHours)
confluenceExtraStrict = confluenceLevel <= 12 ? true : (strongTrend and normalVolatility and (volume > volumeMA * 1.0))
finalConfluenceOK = confluenceVolumeOK and confluenceMomentumOK and confluenceTrendOK and confluenceSessionOK and confluenceExtraStrict

// === SIGNAL TYPE DETECTION ===
var string activeSignalType = "NONE"

getSignalType(isLong) =>
    signalType = "NONE"
    if enableStrongSignals and ((isLong and strongBuySignal) or (not isLong and strongSellSignal))
        signalType := "STRONG"
    else if enableScalpSignals and ((isLong and scalpBuySignal) or (not isLong and scalpSellSignal))
        signalType := "SCALP"
    else if enableInstantSignals and ((isLong and instantBuySignal) or (not isLong and instantSellSignal))
        signalType := "INSTANT"
    else if enableMicroSignals and ((isLong and microBuySignal) or (not isLong and microSellSignal))
        signalType := "MICRO"
    signalType

// === POSITION TRACKING ===
var int todayTradeCountLocal = 0
if ta.change(dayofweek) != 0
    todayTradeCountLocal := 0

// === ENHANCED POSITION TRACKING ===
var float entryPrice = na
var int entryBar = na
var float maxProfit = 0.0
var float currentProfit = 0.0
var bool isLongPosition = false
var bool isShortPosition = false
var float currentProfitDollars = 0.0

justEnteredLong = strategy.position_size > 0 and strategy.position_size[1] == 0
justEnteredShort = strategy.position_size < 0 and strategy.position_size[1] == 0

if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryPrice := strategy.position_avg_price
    entryBar := bar_index
    maxProfit := 0.0
    isLongPosition := strategy.position_size > 0
    isShortPosition := strategy.position_size < 0
    peakProfit := 0.0
    barsInPosition := 0
    todayTradeCount := todayTradeCount + 1

if strategy.position_size != 0 and not na(entryPrice)
    currentProfit := isLongPosition ? (close - entryPrice) : (entryPrice - close)
    if currentProfit > maxProfit
        maxProfit := currentProfit
    currentProfitDollars := currentProfit * syminfo.pointvalue
    peakProfit := math.max(peakProfit, currentProfitDollars)
    barsInPosition := barsInPosition + 1

if strategy.position_size == 0 and strategy.position_size[1] != 0
    entryPrice := na
    entryBar := na
    maxProfit := 0.0
    currentProfit := 0.0
    isLongPosition := false
    isShortPosition := false
    peakProfit := 0.0
    barsInPosition := 0
    currentProfitDollars := 0.0

// === POSITION SIZING ===
atr = ta.atr(10)
safeATR = math.max(atr, syminfo.mintick * 10)

// Fixed contract sizing for live trading (safe default)
var int finalContractQty = 1
if useFixedContractSize
    finalContractQty := fixedContracts
else
    finalContractQty := 1
finalContractQty := int(math.max(math.min(finalContractQty, 10), 1))

// === COMPUTE SL/TP DISTANCES ===
futuresStopDistance = math.max(safeATR * 2.5, syminfo.mintick * 10)
futuresTPDistance = safeATR * tpMultiplier
ultraQuickTP = safeATR * (tpMultiplier * 0.5)

// === ENTRY CONDITIONS ===
maxTradesReached = enableDailyTradeLimit and todayTradeCount >= maxDailyTrades
sessionAdjustedSignal = not enableSessionFilters or (isRegularSession or isPreMarket or isAfterHours)

// V8 safety gates
fiveStarPass = not require5Star or fiveStarOK
mtfFilterPass = not enableMTF or mtfMode != "Filter" or mtf_alignment_pct >= mtfAlignThreshold

// === UNIFIED ENTRY GATE (all filters cooperate, not block) ===
longCondition =
     ultraBuySignal and
     canTradeNow and
     sessionAdjustedSignal and
     not isEndOfDay and
     not instrumentRiskLimitReached and
     not maxTradesReached and
     strategy.position_size == 0 and
     finalConfluenceOK and
     fiveStarPass and
     mtfFilterPass and
     antiChopAllowLong  // Anti-chop gate

shortCondition =
     ultraSellSignal and
     canTradeNow and
     sessionAdjustedSignal and
     not isEndOfDay and
     not instrumentRiskLimitReached and
     not maxTradesReached and
     strategy.position_size == 0 and
     finalConfluenceOK and
     fiveStarPass and
     mtfFilterPass and
     antiChopAllowShort  // Anti-chop gate

if longCondition
    activeSignalType := getSignalType(true)
else if shortCondition
    activeSignalType := getSignalType(false)
else if strategy.position_size == 0
    activeSignalType := "NONE"

// === INSTRUMENT & ALERT HELPERS ===
getInstrumentTicker() =>
    isMYM ? "MYM1!" : isMNQ ? "MNQ1!" : isMES ? "MES1!" : isMCL ? "MCL1!" : isMGC ? "MGC1!" : isM2K ? "M2K1!" : syminfo.ticker

getFixedTP() =>
    isMYM ? 8.0 : isMNQ ? 12.0 : isMES ? 10.0 : isMCL ? 15.0 : isMGC ? 18.0 : isM2K ? 11.0 : 10.0

getFixedSL() =>
    isMYM ? 6.0 : isMNQ ? 8.0 : isMES ? 7.0 : isMCL ? 10.0 : isMGC ? 12.0 : isM2K ? 8.0 : 8.0

getActiveSL() =>
    float sl = getFixedSL()
    if isMES and mes_useCustom
        sl := mes_customSL
    else if isMNQ and mnq_useCustom
        sl := mnq_customSL
    else if isMYM and mym_useCustom
        sl := mym_customSL
    else if isMCL and mcl_useCustom
        sl := mcl_customSL
    else if isMGC and mgc_useCustom
        sl := mgc_customSL
    else if isM2K and m2k_useCustom
        sl := m2k_customSL
    sl

getActiveTP() =>
    float tp = getFixedTP()
    if isMES and mes_useCustom
        tp := mes_customTP
    else if isMNQ and mnq_useCustom
        tp := mnq_customTP
    else if isMYM and mym_useCustom
        tp := mym_customTP
    else if isMCL and mcl_useCustom
        tp := mcl_customTP
    else if isMGC and mgc_useCustom
        tp := mgc_customTP
    else if isM2K and m2k_useCustom
        tp := m2k_customTP
    tp

getActiveQty(baseQty) =>
    int qty = baseQty
    if isMES and mes_useCustom
        qty := mes_customQty
    else if isMNQ and mnq_useCustom
        qty := mnq_customQty
    else if isMYM and mym_useCustom
        qty := mym_customQty
    else if isMCL and mcl_useCustom
        qty := mcl_customQty
    else if isMGC and mgc_useCustom
        qty := mgc_customQty
    else if isM2K and m2k_useCustom
        qty := m2k_customQty
    qty

getActiveSession() =>
    isAsianSession ? "ASIAN" : isLondonSession ? "LONDON" : isNYSession ? "NY" : isUAESession ? "UAE" : "REGULAR"

// ============================================================
// ENTRY EXECUTION + IMMEDIATE EXIT ORDERS (SL/TP on same bar)
// ============================================================
// FIX: Single exit ID per position to prevent conflicts.
// FIX: strategy.exit placed on same bar as entry so SL is
//      ALWAYS active from the very first tick.
// ============================================================

// === LONG ENTRY ===
if longCondition and finalContractQty > 0
    float slDist   = getActiveSL()
    float tpDist   = getActiveTP()
    int   tradeQty = getActiveQty(finalContractQty)

    float slPrice = close - slDist
    float tpPrice = close + tpDist

    // Wider SL in high win rate mode
    if highWinRateMode
        slPrice := close - (slDist * widerSLMultiplier)

    // Faster TP in high win rate mode
    if highWinRateMode
        tpPrice := close + (tpDist * quickTPMultiplier)

    // Entry
    strategy.entry("LONG", strategy.long, qty=tradeQty, comment="LONG " + activeSignalType)

    // IMMEDIATE exit order with SL and TP (placed on same bar!)
    int slTicks = math.round(math.abs(close - slPrice) / syminfo.mintick)
    int tpTicks = math.round(math.abs(tpPrice - close) / syminfo.mintick)
    if slTicks > 0 and tpTicks > 0
        strategy.exit("X_LONG", "LONG", profit=tpTicks, loss=slTicks, comment="EXIT")

    // Alert for TradersPost
    if enableTradersPostAlerts
        float slDollars = priceDiffToDollars(close, slPrice)
        float tpDollars = priceDiffToDollars(tpPrice, close)
        if useManualDollarOverrides and manualDollarSL > 0
            slDollars := manualDollarSL
        if useManualDollarOverrides and manualDollarTP > 0
            tpDollars := manualDollarTP

        float limitPrice = useLimitOrders ? close + (limitOrderOffset * syminfo.mintick) : close

        string msg = '{'
        msg := msg + '"ticker":"' + getInstrumentTicker() + '"'
        msg := msg + ',"action":"buy"'
        msg := msg + ',"orderType":"' + (useLimitOrders ? "limit" : "market") + '"'
        msg := msg + ',"limitPrice":"' + str.tostring(limitPrice) + '"'
        msg := msg + ',"quantity":"' + str.tostring(tradeQty) + '"'
        msg := msg + ',"price":"' + str.tostring(close) + '"'
        msg := msg + ',"stop_loss":"' + str.tostring(slPrice) + '"'
        msg := msg + ',"take_profit":"' + str.tostring(tpPrice) + '"'
        msg := msg + ',"strategy":"V14.2_PRODUCTION"'
        msg := msg + ',"timeframe":"' + timeframe.period + '"'
        msg := msg + ',"instrument":"' + instrumentName + '"'
        msg := msg + ',"signal_type":"' + activeSignalType + '"'
        msg := msg + ',"confluence":' + str.tostring(confluenceLevel)
        msg := msg + ',"session":"' + getActiveSession() + '"'
        msg := msg + ',"adx":' + str.tostring(adxValue, "#.#")
        msg := msg + ',"is_impulse":' + (isImpulseBar ? "true" : "false")
        if enableDollarStops
            msg := msg + ',"stop_loss_amount":"' + str.tostring(slDollars, "#.##") + '"'
            msg := msg + ',"take_profit_amount":"' + str.tostring(tpDollars, "#.##") + '"'
        if includeSignalPrice
            msg := msg + ',"signal_price":"' + str.tostring(close) + '"'
        if enableSlippageGuard
            msg := msg + ',"max_slippage":"' + str.tostring(maxSlippagePoints) + '"'
            msg := msg + ',"slippage_buffer":"' + str.tostring(slippageBufferForBE) + '"'
        msg := msg + ',"mtf_alignment_pct":' + str.tostring(mtf_alignment_pct)
        msg := msg + ',"fiveStarOK":' + (fiveStarOK ? "true" : "false")
        msg := msg + ',"star_score":' + str.tostring(starScore)
        msg := msg + '}'

        alert(msg, alert.freq_once_per_bar)

// === SHORT ENTRY ===
if shortCondition and finalContractQty > 0
    float slDistS   = getActiveSL()
    float tpDistS   = getActiveTP()
    int   tradeQtyS = getActiveQty(finalContractQty)

    float slPriceS = close + slDistS
    float tpPriceS = close - tpDistS

    if highWinRateMode
        slPriceS := close + (slDistS * widerSLMultiplier)
    if highWinRateMode
        tpPriceS := close - (tpDistS * quickTPMultiplier)

    strategy.entry("SHORT", strategy.short, qty=tradeQtyS, comment="SHORT " + activeSignalType)

    int slTicksS = math.round(math.abs(slPriceS - close) / syminfo.mintick)
    int tpTicksS = math.round(math.abs(close - tpPriceS) / syminfo.mintick)
    if slTicksS > 0 and tpTicksS > 0
        strategy.exit("X_SHORT", "SHORT", profit=tpTicksS, loss=slTicksS, comment="EXIT")

    if enableTradersPostAlerts
        float slDollarsS = priceDiffToDollars(slPriceS, close)
        float tpDollarsS = priceDiffToDollars(close, tpPriceS)
        if useManualDollarOverrides and manualDollarSL > 0
            slDollarsS := manualDollarSL
        if useManualDollarOverrides and manualDollarTP > 0
            tpDollarsS := manualDollarTP

        float limitPriceS = useLimitOrders ? close - (limitOrderOffset * syminfo.mintick) : close

        string msgS = '{'
        msgS := msgS + '"ticker":"' + getInstrumentTicker() + '"'
        msgS := msgS + ',"action":"sell"'
        msgS := msgS + ',"orderType":"' + (useLimitOrders ? "limit" : "market") + '"'
        msgS := msgS + ',"limitPrice":"' + str.tostring(limitPriceS) + '"'
        msgS := msgS + ',"quantity":"' + str.tostring(tradeQtyS) + '"'
        msgS := msgS + ',"price":"' + str.tostring(close) + '"'
        msgS := msgS + ',"stop_loss":"' + str.tostring(slPriceS) + '"'
        msgS := msgS + ',"take_profit":"' + str.tostring(tpPriceS) + '"'
        msgS := msgS + ',"strategy":"V14.2_PRODUCTION"'
        msgS := msgS + ',"timeframe":"' + timeframe.period + '"'
        msgS := msgS + ',"instrument":"' + instrumentName + '"'
        msgS := msgS + ',"signal_type":"' + activeSignalType + '"'
        msgS := msgS + ',"confluence":' + str.tostring(confluenceLevel)
        msgS := msgS + ',"session":"' + getActiveSession() + '"'
        msgS := msgS + ',"adx":' + str.tostring(adxValue, "#.#")
        msgS := msgS + ',"is_impulse":' + (isImpulseBar ? "true" : "false")
        if enableDollarStops
            msgS := msgS + ',"stop_loss_amount":"' + str.tostring(slDollarsS, "#.##") + '"'
            msgS := msgS + ',"take_profit_amount":"' + str.tostring(tpDollarsS, "#.##") + '"'
        if includeSignalPrice
            msgS := msgS + ',"signal_price":"' + str.tostring(close) + '"'
        if enableSlippageGuard
            msgS := msgS + ',"max_slippage":"' + str.tostring(maxSlippagePoints) + '"'
            msgS := msgS + ',"slippage_buffer":"' + str.tostring(slippageBufferForBE) + '"'
        msgS := msgS + ',"mtf_alignment_pct":' + str.tostring(mtf_alignment_pct)
        msgS := msgS + ',"fiveStarOK":' + (fiveStarOK ? "true" : "false")
        msgS := msgS + ',"star_score":' + str.tostring(starScore)
        msgS := msgS + '}'

        alert(msgS, alert.freq_once_per_bar)

// ============================================================
// TRAILING STOP AFTER BREAKEVEN + SLIPPAGE (NEW)
// ============================================================
// This replaces the old multi-exit system. Once price clears
// breakeven + slippage buffer, we trail with ATR distance.
// This prevents the old problem where stops were never placed
// or were placed at wrong levels.
// ============================================================

holdingPeriod = not na(entryBar) ? bar_index - entryBar : 0
maxHoldingReached = quickExitMode and holdingPeriod >= maxHoldingBars

var float trailingStopLevel = na
var bool trailingActivated = false

if strategy.position_size != 0 and not na(entryPrice) and barsInPosition >= 2
    float beLevel = isLongPosition ?
         entryPrice + (slippageBufferForBE * syminfo.mintick) :
         entryPrice - (slippageBufferForBE * syminfo.mintick)

    float activationLevel = isLongPosition ?
         beLevel + (safeATR * trailingActivationATR) :
         beLevel - (safeATR * trailingActivationATR)

    if enableTrailingAfterBE
        if isLongPosition and close >= activationLevel
            float newTrail = close - (safeATR * trailingATRMult)
            if na(trailingStopLevel) or newTrail > trailingStopLevel
                trailingStopLevel := newTrail
            trailingActivated := true

            // Update exit with trailing stop
            int trailTicks = math.round((close - trailingStopLevel) / syminfo.mintick)
            if trailTicks > 0
                strategy.exit("X_LONG", "LONG", trail_points=trailTicks, trail_offset=trailTicks, comment="TRAIL")

            if enableTradersPostAlerts and trailingActivated and not trailingActivated[1]
                alert('{"ticker":"' + getInstrumentTicker() + '","action":"update_stop","new_stop":"' + str.tostring(trailingStopLevel) + '","reason":"trailing_after_be","profit":"' + str.tostring(currentProfitDollars, "#.##") + '"}', alert.freq_once_per_bar)

        if isShortPosition and close <= activationLevel
            float newTrailS = close + (safeATR * trailingATRMult)
            if na(trailingStopLevel) or newTrailS < trailingStopLevel
                trailingStopLevel := newTrailS
            trailingActivated := true

            int trailTicksS = math.round((trailingStopLevel - close) / syminfo.mintick)
            if trailTicksS > 0
                strategy.exit("X_SHORT", "SHORT", trail_points=trailTicksS, trail_offset=trailTicksS, comment="TRAIL")

            if enableTradersPostAlerts and trailingActivated and not trailingActivated[1]
                alert('{"ticker":"' + getInstrumentTicker() + '","action":"update_stop","new_stop":"' + str.tostring(trailingStopLevel) + '","reason":"trailing_after_be","profit":"' + str.tostring(currentProfitDollars, "#.##") + '"}', alert.freq_once_per_bar)

// Reset trailing on position close
if strategy.position_size == 0
    trailingStopLevel := na
    trailingActivated := false

// ============================================================
// CONDITIONAL EXITS (MAE, Time, Signal Reversal, EOD)
// ============================================================

var bool exitAlertFired = false
if strategy.position_size == 0 and strategy.position_size[1] != 0
    exitAlertFired := false

if strategy.position_size != 0 and not na(entryPrice) and barsInPosition >= 2

    // MAE Protection
    maeThreshold = highWinRateMode ? breakevenThresholdMGC * 0.7 : breakevenThresholdMGC
    if peakProfit > maeThreshold and currentProfitDollars < (peakProfit * maeDrawbackPercent) and barsInPosition >= 3
        strategy.close_all(comment="MAE PROTECT")
        if enableTradersPostAlerts and not exitAlertFired
            alert('{"ticker":"' + getInstrumentTicker() + '","action":"exit","quantity":"' + str.tostring(math.abs(strategy.position_size)) + '","reason":"mae_protection","peak":"' + str.tostring(peakProfit, "#.##") + '","current":"' + str.tostring(currentProfitDollars, "#.##") + '"}', alert.freq_once_per_bar)
            exitAlertFired := true

    // Emergency time exit
    else if barsInPosition >= 30 and currentProfitDollars <= 0
        strategy.close_all(comment="TIME EXIT")
        if enableTradersPostAlerts and not exitAlertFired
            alert('{"ticker":"' + getInstrumentTicker() + '","action":"exit","quantity":"' + str.tostring(math.abs(strategy.position_size)) + '","reason":"emergency_time","bars":"' + str.tostring(barsInPosition) + '","loss":"' + str.tostring(currentProfitDollars, "#.##") + '"}', alert.freq_once_per_bar)
            exitAlertFired := true

    // Max loss
    else if currentProfitDollars <= -maxLossMGC
        strategy.close_all(comment="MAX LOSS")
        if enableTradersPostAlerts and not exitAlertFired
            alert('{"ticker":"' + getInstrumentTicker() + '","action":"exit","quantity":"' + str.tostring(math.abs(strategy.position_size)) + '","reason":"max_loss","loss":"' + str.tostring(currentProfitDollars, "#.##") + '"}', alert.freq_once_per_bar)
            exitAlertFired := true

    // Max holding time
    else if maxHoldingReached
        strategy.close_all(comment="MAX HOLD")
        if enableTradersPostAlerts and not exitAlertFired
            alert('{"ticker":"' + getInstrumentTicker() + '","action":"exit","quantity":"' + str.tostring(math.abs(strategy.position_size)) + '","reason":"max_holding","bars":"' + str.tostring(holdingPeriod) + '","profit":"' + str.tostring(currentProfitDollars, "#.##") + '"}', alert.freq_once_per_bar)
            exitAlertFired := true

    // Signal reversal
    else if useSignalReversalExits and isLongPosition and ultraSellSignal and barsInPosition >= 3
        strategy.close_all(comment="REVERSAL")
        if enableTradersPostAlerts and not exitAlertFired
            alert('{"ticker":"' + getInstrumentTicker() + '","action":"exit","quantity":"' + str.tostring(math.abs(strategy.position_size)) + '","reason":"signal_reversal","profit":"' + str.tostring(currentProfitDollars, "#.##") + '"}', alert.freq_once_per_bar)
            exitAlertFired := true

    else if useSignalReversalExits and isShortPosition and ultraBuySignal and barsInPosition >= 3
        strategy.close_all(comment="REVERSAL")
        if enableTradersPostAlerts and not exitAlertFired
            alert('{"ticker":"' + getInstrumentTicker() + '","action":"exit","quantity":"' + str.tostring(math.abs(strategy.position_size)) + '","reason":"signal_reversal","profit":"' + str.tostring(currentProfitDollars, "#.##") + '"}', alert.freq_once_per_bar)
            exitAlertFired := true

    // End of day
    else if useEndOfDayExits and isEndOfDay
        strategy.close_all(comment="EOD EXIT")
        if enableTradersPostAlerts and not exitAlertFired
            alert('{"ticker":"' + getInstrumentTicker() + '","action":"exit","quantity":"' + str.tostring(math.abs(strategy.position_size)) + '","reason":"end_of_day","profit":"' + str.tostring(currentProfitDollars, "#.##") + '"}', alert.freq_once_per_bar)
            exitAlertFired := true

// === TRACK DAILY LOSSES ===
if strategy.position_size == 0 and strategy.position_size[1] != 0 and strategy.closedtrades > 0
    lastTradeIdx = strategy.closedtrades - 1
    tradePnL = strategy.closedtrades.profit(lastTradeIdx)
    if tradePnL < 0
        if isMYM
            mymDailyLoss := mymDailyLoss + math.abs(tradePnL)
        else if isMNQ
            mnqDailyLoss := mnqDailyLoss + math.abs(tradePnL)
        else if isMES
            mesDailyLoss := mesDailyLoss + math.abs(tradePnL)
        else if isMCL
            mclDailyLoss := mclDailyLoss + math.abs(tradePnL)
        else if isMGC
            mgcDailyLoss := mgcDailyLoss + math.abs(tradePnL)

// ============================================================
// VISUAL DISPLAY
// ============================================================
var table riskTable = table.new(position.top_right, 5, 9, bgcolor=color.new(color.black, 85), border_width=1)

if barstate.islast
    table.clear(riskTable, 0, 0)

    // Header
    table.cell(riskTable, 0, 0, "V14.2 PROD", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(riskTable, 1, 0, instrumentName, text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(riskTable, 2, 0, timeframe.period, text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(riskTable, 3, 0, activeSignalType, text_color=color.yellow, bgcolor=color.new(color.blue, 70))
    table.cell(riskTable, 4, 0, "ADX:" + str.tostring(adxValue, "#.#"), text_color=adxValue >= adxThreshold ? color.lime : color.red, bgcolor=color.new(color.blue, 70))

    // Session
    sessionColor = isAsianSession ? color.new(color.orange, 70) : isLondonSession ? color.new(color.blue, 70) : isNYSession ? color.new(color.green, 70) : isUAESession ? color.new(color.purple, 70) : color.new(color.gray, 80)
    table.cell(riskTable, 0, 1, "SESSION", text_color=color.white, bgcolor=sessionColor)
    table.cell(riskTable, 1, 1, getActiveSession(), text_color=color.white, bgcolor=sessionColor)
    table.cell(riskTable, 2, 1, isNoTradeZone ? "NO TRADE" : "ACTIVE", text_color=isNoTradeZone ? color.red : color.lime, bgcolor=sessionColor)
    table.cell(riskTable, 3, 1, str.tostring(math.round(activeSessionMultiplier * 100)) + "%", text_color=color.white, bgcolor=sessionColor)
    table.cell(riskTable, 4, 1, "24/7:" + (enable24_7Trading ? "ON" : "OFF"), text_color=enable24_7Trading ? color.lime : color.gray, bgcolor=sessionColor)

    // Position
    table.cell(riskTable, 0, 2, "POS", text_color=color.white, bgcolor=color.new(color.purple, 70))
    table.cell(riskTable, 1, 2, str.tostring(int(math.abs(strategy.position_size))), text_color=color.white, bgcolor=color.new(color.purple, 70))
    table.cell(riskTable, 2, 2, "$" + str.tostring(currentProfitDollars, "#.##"), text_color=currentProfitDollars >= 0 ? color.lime : color.red, bgcolor=color.new(color.purple, 70))
    table.cell(riskTable, 3, 2, str.tostring(barsInPosition) + " bars", text_color=color.white, bgcolor=color.new(color.purple, 70))
    table.cell(riskTable, 4, 2, "Trades:" + str.tostring(todayTradeCount) + "/" + str.tostring(maxDailyTrades), text_color=maxTradesReached ? color.red : color.lime, bgcolor=color.new(color.purple, 70))

    // Anti-chop status
    chopColor = isChoppy ? color.new(color.red, 70) : color.new(color.green, 70)
    table.cell(riskTable, 0, 3, "TREND", text_color=color.white, bgcolor=chopColor)
    table.cell(riskTable, 1, 3, isChoppy ? "CHOPPY" : "TRENDING", text_color=isChoppy ? color.red : color.lime, bgcolor=chopColor)
    table.cell(riskTable, 2, 3, "STR:" + str.tostring(trendStrength, "#.##"), text_color=color.white, bgcolor=chopColor)
    table.cell(riskTable, 3, 3, strongTrend ? "STRONG" : moderateTrend ? "MOD" : "RANGE", text_color=strongTrend ? color.lime : color.yellow, bgcolor=chopColor)
    table.cell(riskTable, 4, 3, isImpulseBar ? "IMPULSE!" : "", text_color=color.yellow, bgcolor=chopColor)

    // MTF
    table.cell(riskTable, 0, 4, "MTF", text_color=color.white, bgcolor=color.new(color.teal, 70))
    table.cell(riskTable, 1, 4, str.tostring(mtf_alignment_pct) + "%", text_color=mtf_alignment_pct >= mtfAlignThreshold ? color.lime : color.red, bgcolor=color.new(color.teal, 70))
    table.cell(riskTable, 2, 4, mtfIsBullish ? "BULL" : mtfIsBearish ? "BEAR" : "MIXED", text_color=mtfIsBullish ? color.lime : mtfIsBearish ? color.red : color.yellow, bgcolor=color.new(color.teal, 70))
    table.cell(riskTable, 3, 4, "Stars:" + str.tostring(starScore) + "/5", text_color=fiveStarOK ? color.lime : color.red, bgcolor=color.new(color.teal, 70))
    table.cell(riskTable, 4, 4, "CONF:" + str.tostring(confluenceLevel), text_color=finalConfluenceOK ? color.lime : color.red, bgcolor=color.new(color.teal, 70))

    // Mode
    table.cell(riskTable, 0, 5, "MODE", text_color=color.white, bgcolor=color.new(color.teal, 70))
    table.cell(riskTable, 1, 5, highWinRateMode ? "HIGH WR" : "NORMAL", text_color=highWinRateMode ? color.lime : color.yellow, bgcolor=color.new(color.teal, 70))
    table.cell(riskTable, 2, 5, "TP:" + str.tostring(quickTPMultiplier, "#.#") + "x", text_color=color.white, bgcolor=color.new(color.teal, 70))
    table.cell(riskTable, 3, 5, "SL:" + str.tostring(widerSLMultiplier, "#.#") + "x", text_color=color.white, bgcolor=color.new(color.teal, 70))
    table.cell(riskTable, 4, 5, "SLIP:" + str.tostring(maxSlippagePoints), text_color=color.white, bgcolor=color.new(color.teal, 70))

    // Trailing
    table.cell(riskTable, 0, 6, "TRAIL", text_color=color.white, bgcolor=color.new(color.orange, 70))
    table.cell(riskTable, 1, 6, trailingActivated ? "ACTIVE" : "WAITING", text_color=trailingActivated ? color.lime : color.gray, bgcolor=color.new(color.orange, 70))
    table.cell(riskTable, 2, 6, na(trailingStopLevel) ? "---" : str.tostring(trailingStopLevel, "#.##"), text_color=color.white, bgcolor=color.new(color.orange, 70))
    table.cell(riskTable, 3, 6, "BE+" + str.tostring(slippageBufferForBE), text_color=color.white, bgcolor=color.new(color.orange, 70))
    table.cell(riskTable, 4, 6, str.tostring(trailingATRMult, "#.#") + "xATR", text_color=color.white, bgcolor=color.new(color.orange, 70))

    // Risk
    table.cell(riskTable, 0, 7, "RISK", text_color=color.white, bgcolor=color.new(color.red, 70))
    table.cell(riskTable, 1, 7, "$" + str.tostring(currentInstrumentLoss, "#.##"), text_color=currentInstrumentLoss > 0 ? color.red : color.lime, bgcolor=color.new(color.red, 70))
    table.cell(riskTable, 2, 7, "Max:$" + str.tostring(currentInstrumentMaxLoss, "#.##"), text_color=color.white, bgcolor=color.new(color.red, 70))
    table.cell(riskTable, 3, 7, instrumentRiskLimitReached ? "LIMIT!" : "OK", text_color=instrumentRiskLimitReached ? color.red : color.lime, bgcolor=color.new(color.red, 70))
    table.cell(riskTable, 4, 7, "Peak:$" + str.tostring(peakProfit, "#.##"), text_color=color.white, bgcolor=color.new(color.red, 70))

    // Volume
    table.cell(riskTable, 0, 8, "VOL", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(riskTable, 1, 8, volumeConfirm ? "OK" : "LOW", text_color=volumeConfirm ? color.lime : color.red, bgcolor=color.new(color.gray, 70))
    table.cell(riskTable, 2, 8, strongVolume ? "STRONG" : normalVolume ? "NORM" : "WEAK", text_color=strongVolume ? color.lime : color.yellow, bgcolor=color.new(color.gray, 70))
    table.cell(riskTable, 3, 8, "RSI:" + str.tostring(rsi, "#.#"), text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(riskTable, 4, 8, "K:" + str.tostring(stochK, "#.#"), text_color=color.white, bgcolor=color.new(color.gray, 70))

// === PLOTS ===
plot(hullMain, color=trend == 1 ? color.green : color.red, linewidth=2, title="Hull MA Main")
plot(hullFast, color=color.gray, title="Hull MA Fast")
plot(upperEnv, color=color.orange, title="Envelope Upper")
plot(lowerEnv, color=color.orange, title="Envelope Lower")
plot(trend == 1 ? trUp : trDn, color=trend == 1 ? color.green : color.red, linewidth=2, title="SuperTrend")
plot(ema50, color=color.new(color.aqua, 50), title="EMA 50")
plot(ema200, color=color.new(color.fuchsia, 50), title="EMA 200")

// Trailing stop level
plot(trailingActivated and strategy.position_size != 0 ? trailingStopLevel : na, color=color.yellow, linewidth=2, style=plot.style_stepline, title="Trailing Stop")

// Background colors
bgcolor(isNoTradeZone ? color.new(color.red, 95) : na, title="No Trade Zone")
bgcolor(isChoppy ? color.new(color.orange, 97) : na, title="Choppy Market")
bgcolor(isNYSession ? color.new(color.green, 97) : na, title="NY Session")

// Signal shapes
plotshape(longCondition and activeSignalType == "STRONG", location=location.belowbar, color=color.green, style=shape.triangleup, text="STRONG", size=size.normal)
plotshape(longCondition and activeSignalType == "SCALP", location=location.belowbar, color=color.blue, style=shape.triangleup, text="SCALP", size=size.normal)
plotshape(longCondition and activeSignalType == "INSTANT", location=location.belowbar, color=color.orange, style=shape.triangleup, text="INSTANT", size=size.normal)
plotshape(longCondition and activeSignalType == "MICRO", location=location.belowbar, color=color.yellow, style=shape.triangleup, text="MICRO", size=size.small)

plotshape(shortCondition and activeSignalType == "STRONG", location=location.abovebar, color=color.red, style=shape.triangledown, text="STRONG", size=size.normal)
plotshape(shortCondition and activeSignalType == "SCALP", location=location.abovebar, color=color.maroon, style=shape.triangledown, text="SCALP", size=size.normal)
plotshape(shortCondition and activeSignalType == "INSTANT", location=location.abovebar, color=color.fuchsia, style=shape.triangledown, text="INSTANT", size=size.normal)
plotshape(shortCondition and activeSignalType == "MICRO", location=location.abovebar, color=color.purple, style=shape.triangledown, text="MICRO", size=size.small)

// Impulse bars
plotshape(isImpulseBar and not isChoppy, location=location.bottom, color=impulseUp ? color.lime : color.red, style=shape.diamond, text="IMP", size=size.tiny, title="Impulse")
