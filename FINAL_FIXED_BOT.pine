ultraSellSignalBase = (strongSellSignal or (microSellSignal and momentumBearish) or (instantSellSignal and slopeMain == -1) or (scalpSellSignal and (veryStrongTrend or isMYM)) or (isMYM and hullAnyBearish and trend == -1 and candleBear)) and (not highWinRateMode or notOverbought)
