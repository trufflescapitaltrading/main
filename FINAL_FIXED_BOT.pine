currentInstrumentMaxLoss = isMYM ? mymMaxDailyRisk : isMNQ ? mnqMaxDailyRisk : isMES ? mesMaxDailyRisk : isMCL ? mclMaxDailyRisk : isMGC ? mgcMaxDailyRisk : totalDailyRisk
instrumentRiskLimitReached = enableIndividualRiskLimits and currentInstrumentLoss >= currentInstrumentMaxLoss
strongCountLong = (hasMomentumOverrideLong ? 1 : 0) + (impulseLong ? 1 : 0) + (hasStrongTrendOverrideBull ? 1 : 0) + ((starScore >= 4) ? 1 : 0) + (veryStrongTrend ? 1 : 0) + (finalConfluenceOK ? 1 : 0) + (trendAlignedLong ? 1 : 0)
strongCountShort = (hasMomentumOverrideShort ? 1 : 0) + (impulseShort ? 1 : 0) + (hasStrongTrendOverrideBear ? 1 : 0) + ((starScore >= 4) ? 1 : 0) + (veryStrongTrend ? 1 : 0) + (finalConfluenceOK ? 1 : 0) + (trendAlignedShort ? 1 : 0)
