                selectedPriority := "P2:TREND"
                entryPriority := "P2:TREND"
        if not shouldEnterLong and not shouldEnterShort and allowPriority3
            if canGoLong and is5Star and ultraBuySignal and candleBull and emaTrendOK_Long and momentumOK_Long and candleConfirmLong
                shouldEnterLong := true
                selectedPriority := "P3:5STAR"
                entryPriority := "P3:5STAR"
            else if canGoShort and is5Star and ultraSellSignal and candleBear and emaTrendOK_Short and momentumOK_Short and candleConfirmShort
                shouldEnterShort := true
                selectedPriority := "P3:5STAR"
                entryPriority := "P3:5STAR"
        if not shouldEnterLong and not shouldEnterShort and allowPriority4
            if canGoLong and is4Star and ultraBuySignal and candleBull and emaTrendOK_Long and momentumOK_Long and candleConfirmLong
                shouldEnterLong := true
                selectedPriority := "P4:4STAR"
                entryPriority := "P4:4STAR"
            else if canGoShort and is4Star and ultraSellSignal and candleBear and emaTrendOK_Short and momentumOK_Short and candleConfirmShort
                shouldEnterShort := true
                selectedPriority := "P4:4STAR"
                entryPriority := "P4:4STAR"
        if not shouldEnterLong and not shouldEnterShort and allowPriority5
            if canGoLong and is3Star and ultraBuySignal and candleBull and emaTrendOK_Long and candleConfirmLong
                shouldEnterLong := true
                selectedPriority := "P5:3STAR"
                entryPriority := "P5:3STAR"
            else if canGoShort and is3Star and ultraSellSignal and candleBear and emaTrendOK_Short and candleConfirmShort
                shouldEnterShort := true
                selectedPriority := "P5:3STAR"
                entryPriority := "P5:3STAR"
        if not shouldEnterLong and not shouldEnterShort and allowPriority6
            if canGoLong and is2Star and ultraBuySignal and candleBull and candleConfirmLong
                shouldEnterLong := true
                selectedPriority := "P6:2STAR"
                entryPriority := "P6:2STAR"
            else if canGoShort and is2Star and ultraSellSignal and candleBear and candleConfirmShort
                shouldEnterShort := true
                selectedPriority := "P6:2STAR"
                entryPriority := "P6:2STAR"
        if not shouldEnterLong and not shouldEnterShort and allowPriority7
            if canGoLong and swingBuySignal and candleBull and signalAllowsLong and not isSignalGrayZone and candleConfirmLong
                shouldEnterLong := true
                selectedPriority := "P7:SWING"
                entryPriority := "P7:SWING"
            else if canGoShort and swingSellSignal and candleBear and signalAllowsShort and not isSignalGrayZone and candleConfirmShort
                shouldEnterShort := true
                selectedPriority := "P7:SWING"
                entryPriority := "P7:SWING"
    else
        bool rawLongCondition = (ultraBuySignal or swingBuySignal or hasMomentumOverrideLong or impulseLong or hasTrendOverrideBull) and canEnterLong and not maxLossReached and not maxTradesReached and not profitTargetReached and canEnterNewPosition and candleBull and routerLongRegimeOK and allowLongByBias and cooldownOK and candleConfirmLong
        bool rawShortCondition = (ultraSellSignal or swingSellSignal or hasMomentumOverrideShort or impulseShort or hasTrendOverrideBear) and canEnterShort and not maxLossReached and not maxTradesReached and not profitTargetReached and canEnterNewPosition and candleBear and routerShortRegimeOK and allowShortByBias and cooldownOK and candleConfirmShort
        shouldEnterLong := rawLongCondition
        shouldEnterShort := rawShortCondition
        selectedPriority := "NO_PRIORITY"
    if isMES and enableMesHighWinEntryGate and mesRestrictToPminus1P1P2
        bool mesPriorityAllowed = (selectedPriority == "P-1:TREND_START") or (selectedPriority == "P1:EARLY_TREND") or (selectedPriority == "P1:IGNITION") or (selectedPriority == "P1:IMPULSE") or (selectedPriority == "P2:CONTINUATION") or (selectedPriority == "P2:TREND") or (selectedPriority == "P2:STRONG_TREND")
        if not mesPriorityAllowed
            shouldEnterLong := false
            shouldEnterShort := false
            selectedPriority := "MES_BLOCKED"
var int lastLongSignalBar = na
var int lastShortSignalBar = na
barsSinceLongSignal = na(lastLongSignalBar) ? 999999 : (bar_index - lastLongSignalBar)
barsSinceShortSignal = na(lastShortSignalBar) ? 999999 : (bar_index - lastShortSignalBar)
dedupeLongOK = not enableDedupe or (barsSinceLongSignal > dedupeBars)
dedupeShortOK = not enableDedupe or (barsSinceShortSignal > dedupeBars)
sameBarOK = not (enableDedupe and dedupeSameBar and tookTradeThisBar)
shouldEnterLong := shouldEnterLong and dedupeLongOK and sameBarOK
shouldEnterShort := shouldEnterShort and dedupeShortOK and sameBarOK
htf5mBull = request.security(syminfo.tickerid, "5", (close > open) and (math.abs(close - open) > (high - low) * 0.05), barmerge.gaps_off, barmerge.lookahead_off)
htf5mBear = request.security(syminfo.tickerid, "5", (close < open) and (math.abs(close - open) > (high - low) * 0.05), barmerge.gaps_off, barmerge.lookahead_off)
htfCandleColorOK_Long = (not require5mCandleColorConfirm) or (not is3min) or htf5mBull
htfCandleColorOK_Short = (not require5mCandleColorConfirm) or (not is3min) or htf5mBear
shouldEnterLong := shouldEnterLong and htfCandleColorOK_Long
shouldEnterShort := shouldEnterShort and htfCandleColorOK_Short
ltfGroup = "🧷 Intrabar LTF Confirm"
enableLTFConfirm = input.bool(true, "Enable 1m LTF confirm for intrabar entries", group=ltfGroup)
ltfBodyMin = input.float(0.15, "LTF min body ratio", minval=0.05, maxval=0.50, step=0.01, group=ltfGroup)
ltfBull = request.security(syminfo.tickerid, "1", (close > open) and ((high - low) > 0) and (math.abs(close - open) / (high - low) >= ltfBodyMin), barmerge.gaps_off, barmerge.lookahead_off)
ltfBear = request.security(syminfo.tickerid, "1", (close < open) and ((high - low) > 0) and (math.abs(close - open) / (high - low) >= ltfBodyMin), barmerge.gaps_off, barmerge.lookahead_off)
intrabarAllowedNow = (not barstate.isconfirmed) and allowIntrabarForP1P2
ltfOK_Long = (not enableLTFConfirm) or (not intrabarAllowedNow) or ltfBull
ltfOK_Short = (not enableLTFConfirm) or (not intrabarAllowedNow) or ltfBear
shouldEnterLong := shouldEnterLong and ltfOK_Long
shouldEnterShort := shouldEnterShort and ltfOK_Short
isPriorityIntrabar = (selectedPriority == "P-1:TREND_START") or (selectedPriority == "P1:IMPULSE") or (selectedPriority == "P2:CONTINUATION") or (selectedPriority == "P2:TREND") or (selectedPriority == "P2:STRONG_TREND")
entryOK = (not enterOnBarClose or barstate.isconfirmed) or (kenyaAllowIntrabarEntries and useKenyaMnq3mProfitLogic and isMNQ and timeframe.period == "3") or (allowIntrabarForP1P2 and isPriorityIntrabar)
bool longCondition = entryOK and shouldEnterLong and not tookTradeThisBar
bool shortCondition = entryOK and shouldEnterShort and not tookTradeThisBar
var string lastBlockReason = "NONE"
rawLongSignal = (hasTrendStartLong or hasMomentumOverrideLong or impulseLong or hasTrendOverrideBull or tibLong or cpbLong or ultraBuySignal or swingBuySignal)
rawShortSignal = (hasTrendStartShort or hasMomentumOverrideShort or impulseShort or hasTrendOverrideBear or tibShort or cpbShort or ultraSellSignal or swingSellSignal)
if strategy.position_size == 0
    lastBlockReason := "NONE"
    if rawLongSignal and not longCondition
        lastBlockReason := not canTradeNow ? "TIME" : (isMES and enableMesHighWinEntryGate and mesOnlyRegularSession and not isRegularSession) ? "MES_SESSION" : maxTradesReached ? "DAILY_TRADES" : maxLossReached ? "DAILY_LOSS" : profitTargetReached ? "DAILY_TARGET" : instrumentRiskLimitReached ? "INSTR_RISK" : (pauseAfterLosses and not pauseBypass) ? "STREAK_PAUSE" : (enableTrendOnly and not routerLongRegimeOK and not bypassLong) ? "TREND_ONLY" : (enableBestSideRouter and not allowLongByBias) ? "BIAS_LOCK" : (not oppCooldownOK and not bypassLong and not bypassShort) ? "COOLDOWN" : (not volRegimeOK and not (allowImpulseBypassVol and (impulseLong or hasTrendOverrideBull or hasMomentumOverrideLong))) ? "VOL_REGIME" : (not htfConfirmLongOK and not (allowImpulseBypassHTF and (impulseLong or hasTrendOverrideBull or hasMomentumOverrideLong))) ? "HTF_ALIGN" : (not strengthGateLongOK) ? "STRENGTH" : (not (v71_strictEntryOK or strictBypassLong)) ? "STRICT_FILTER" : (not trendOnlyLongGate) ? "MANDATORY_TREND" : (not mtfLongOK) ? "MTF_FILTER" : (not candleConfirmLong) ? "CANDLE_CONFIRM" : (not dedupeLongOK) ? "DEDUPE" : (not htfCandleColorOK_Long) ? "5M_COLOR" : (not entryOK) ? (enterOnBarClose ? "BAR_CLOSE" : "ENTRY_GATE") : "OTHER"
    else if rawShortSignal and not shortCondition
        lastBlockReason := not canTradeNow ? "TIME" : (isMES and enableMesHighWinEntryGate and mesOnlyRegularSession and not isRegularSession) ? "MES_SESSION" : maxTradesReached ? "DAILY_TRADES" : maxLossReached ? "DAILY_LOSS" : profitTargetReached ? "DAILY_TARGET" : instrumentRiskLimitReached ? "INSTR_RISK" : (pauseAfterLosses and not pauseBypass) ? "STREAK_PAUSE" : (enableTrendOnly and not routerShortRegimeOK and not bypassShort) ? "TREND_ONLY" : (enableBestSideRouter and not allowShortByBias) ? "BIAS_LOCK" : (not oppCooldownOK and not bypassLong and not bypassShort) ? "COOLDOWN" : (not volRegimeOK and not (allowImpulseBypassVol and (impulseShort or hasTrendOverrideBear or hasMomentumOverrideShort))) ? "VOL_REGIME" : (not htfConfirmShortOK and not (allowImpulseBypassHTF and (impulseShort or hasTrendOverrideBear or hasMomentumOverrideShort))) ? "HTF_ALIGN" : (not strengthGateShortOK) ? "STRENGTH" : (not (v71_strictEntryOK or strictBypassShort)) ? "STRICT_FILTER" : (not trendOnlyShortGate) ? "MANDATORY_TREND" : (not mtfShortOK) ? "MTF_FILTER" : (not candleConfirmShort) ? "CANDLE_CONFIRM" : (not dedupeShortOK) ? "DEDUPE" : (not htfCandleColorOK_Short) ? "5M_COLOR" : (not entryOK) ? (enterOnBarClose ? "BAR_CLOSE" : "ENTRY_GATE") : "OTHER"
if longCondition and strategy.position_size == 0
    activeSignalType := selectedPriority == "P-1:TREND_START" ? "IGNITION" : selectedPriority == "P2:CONTINUATION" ? "CONTINUATION" : hasMomentumOverrideLong ? "MOMENTUM" : impulseLong ? "IMPULSE" : hasTrendOverrideBull ? "TREND" : microBuySignal ? "MICRO" : instantBuySignal ? "INSTANT" : scalpBuySignal ? "SCALP" : strongBuySignal ? "STRONG" : swingBuySignal ? "SWING" : "NORMAL"
else if shortCondition and strategy.position_size == 0
    activeSignalType := selectedPriority == "P-1:TREND_START" ? "IGNITION" : selectedPriority == "P2:CONTINUATION" ? "CONTINUATION" : hasMomentumOverrideShort ? "MOMENTUM" : impulseShort ? "IMPULSE" : hasTrendOverrideBear ? "TREND" : microSellSignal ? "MICRO" : instantSellSignal ? "INSTANT" : scalpSellSignal ? "SCALP" : strongSellSignal ? "STRONG" : swingSellSignal ? "SWING" : "NORMAL"
else if strategy.position_size == 0
    activeSignalType := "NONE"
getActiveQty(baseQty) =>
    int qty = baseQty
    if isMES and mes_useCustom
        qty := mes_customQty
    else if isMNQ and mnq_useCustom
        qty := mnq_customQty
    else if isMYM and mym_useCustom
        qty := mym_customQty
    else if isMCL and mcl_useCustom
        qty := mcl_customQty
    else if isMGC and mgc_useCustom
        qty := mgc_customQty
    else if isM2K and m2k_useCustom
        qty := m2k_customQty
    qty
// ==================== SIMPLIFIED MJV6-STYLE ENTRIES ====================
// Using cash-based position sizing like original MJV6 (default_qty_value=1000)
// Removed excessive filters that were blocking trades

// Keep these for compatibility with plots/alerts
bool allowEntryLong = true
bool allowEntryShort = true

// Simple entry conditions - match MJV6 simplicity
simpleLongCondition = (ultraBuySignal or swingBuySignal or impulseLong or hasTrendOverrideBull or hasMomentumOverrideLong) and strategy.position_size == 0 and not maxLossReached
simpleShortCondition = (ultraSellSignal or swingSellSignal or impulseShort or hasTrendOverrideBear or hasMomentumOverrideShort) and strategy.position_size == 0 and not maxLossReached

// Entry ID for tracking (like MJV6)
entryId = str.tostring(bar_index) + (isMES ? "_MES" : isMNQ ? "_MNQ" : isMYM ? "_MYM" : isM2K ? "_M2K" : isMCL ? "_MCL" : isMGC ? "_MGC" : "")

if simpleLongCondition
    strategy.entry("Long_" + entryId, strategy.long)
    tookTradeThisBar := true
    lastLongSignalBar := bar_index
    lastSignalDir := 1
    lastSignalBar := bar_index
   
if simpleShortCondition
    strategy.entry("Short_" + entryId, strategy.short)
    tookTradeThisBar := true
    lastShortSignalBar := bar_index
    lastSignalDir := -1
    lastSignalBar := bar_index
// ==================== ⭐⭐⭐ EXACT ORIGINAL MJV6 PROFIT LOGIC (VERBATIM) ====================
// This is the EXACT profit logic from the original MJV6 script - NO from_entry, simple exit names
// DO NOT MODIFY - This produced $20k+ MES 3m and $44k+ MES 5m

// ATR for profit calculations (EXACT from original MJV6)
atr = ta.atr(10)
futuresStopDist_MJV6 = atr * (is1min ? 1.2 : is2min ? 1.3 : is3min ? 1.4 : 1.6)
futuresTPDist_MJV6 = atr * tpMultiplier
ultraQuickTP_MJV6 = atr * (tpMultiplier * 0.5)

// Holding period for time-based exit
maxHoldingReached_MJV6 = quickExitMode and holdingPeriod >= maxHoldingBars

if strategy.position_size > 0 // Long positions
    entryPrice_MJV6 = strategy.position_avg_price
    stopLoss_MJV6 = entryPrice_MJV6 - futuresStopDist_MJV6
   
    if useEnhancedTP
        // Futures-optimized profit taking - very aggressive
        tp1Points = math.round((ultraQuickTP_MJV6 * 0.4) / syminfo.mintick) // 60% at ultra-quick
        tp2Points = math.round((futuresTPDist_MJV6 * 0.3) / syminfo.mintick) // 25% at quick
        tp3Points = math.round((futuresTPDist_MJV6 * 0.6) / syminfo.mintick) // 10% medium
        tp4Points = math.round((futuresTPDist_MJV6 * 1.0) / syminfo.mintick) // 5% runners
       
        // Aggressive profit percentages for futures - NO from_entry (EXACT MJV6)
        strategy.exit("TP1", qty_percent=60, profit=tp1Points)
        strategy.exit("TP2", qty_percent=25, profit=tp2Points)
        strategy.exit("TP3", qty_percent=10, profit=tp3Points)
        strategy.exit("TP4", qty_percent=5, profit=tp4Points)
   
    // Time-based exit optimized for futures
    if maxHoldingReached_MJV6
        strategy.close_all(comment="TIME_EXIT")
   
    // Ultra-tight trailing for futures - NO from_entry (EXACT MJV6)
    if useSmartTrailing and close > entryPrice_MJV6 + (futuresTPDist_MJV6 * trailActivationRatio)
        trailDistance_MJV6 = atr * 0.6 // Very tight for futures
        strategy.exit("TrailSL", stop=close - trailDistance_MJV6)
    else
        strategy.exit("SL", stop=stopLoss_MJV6)

if strategy.position_size < 0 // Short positions
    entryPrice_MJV6 = strategy.position_avg_price
    stopLoss_MJV6 = entryPrice_MJV6 + futuresStopDist_MJV6
   
    if useEnhancedTP
        // Futures-optimized short profit taking
        tp1Points = math.round((ultraQuickTP_MJV6 * 0.5) / syminfo.mintick)
        tp2Points = math.round((futuresTPDist_MJV6 * 0.4) / syminfo.mintick)
        tp3Points = math.round((futuresTPDist_MJV6 * 0.7) / syminfo.mintick)
        tp4Points = math.round((futuresTPDist_MJV6 * 1.1) / syminfo.mintick)
       
        // NO from_entry (EXACT MJV6)
        strategy.exit("TP1", qty_percent=60, profit=tp1Points)
        strategy.exit("TP2", qty_percent=25, profit=tp2Points)
        strategy.exit("TP3", qty_percent=10, profit=tp3Points)
        strategy.exit("TP4", qty_percent=5, profit=tp4Points)
   
    // Time-based exit
    if maxHoldingReached_MJV6
        strategy.close_all(comment="TIME_EXIT")
   
    // Ultra-tight trailing for shorts - NO from_entry (EXACT MJV6)
    if useSmartTrailing and close < entryPrice_MJV6 - (futuresTPDist_MJV6 * trailActivationRatio)
        trailDistance_MJV6 = atr * 0.6
        strategy.exit("TrailSL", stop=close + trailDistance_MJV6)
    else
        strategy.exit("SL", stop=stopLoss_MJV6)

// ==================== END MJV6 PROFIT LOGIC ====================
// ==================== 🚨 SAFETY EXITS ONLY (MJV6 handles main profit logic) ====================
// NOTE: All exit controls that interfere with MJV6 profit logic have been DISABLED
// Only essential safety exits are kept below

// End of Day Exit (SAFETY - keep)
if useEndOfDayExits and isEndOfDay and strategy.position_size != 0
    strategy.close_all(comment="EOD_EXIT")

// Daily Loss Circuit Breaker (SAFETY - keep)
if maxLossReached and strategy.position_size != 0
    strategy.close_all(comment="DAILY_LOSS_LIMIT")

// ==================== 🎨 VISUAL INDICATORS ====================
visSectionGroup = "🎨 Visual Settings"
showHullLines = input.bool(true, "Show Hull MA Lines", group=visSectionGroup)
showEnvelope = input.bool(true, "Show Envelope Bands", group=visSectionGroup)
showTrendLine = input.bool(true, "Show SuperTrend Line", group=visSectionGroup)
showSignals = input.bool(true, "Show Entry Signals", group=visSectionGroup)
showInfoTable = input.bool(true, "Show Info Table", group=visSectionGroup)
showSwingLine = input.bool(true, "Show Swing Line", group=visSectionGroup)
showVWAP = input.bool(false, "Show VWAP", group=visSectionGroup)
showEMAs = input.bool(false, "Show EMAs", group=visSectionGroup)

// Hull MA plots
hullMainColor = slopeMain == 1 ? color.new(color.green, 30) : slopeMain == -1 ? color.new(color.red, 30) : color.new(color.gray, 30)
hullFastColor = slopeFast == 1 ? color.new(color.lime, 50) : slopeFast == -1 ? color.new(color.orange, 50) : color.new(color.gray, 50)
plot(showHullLines ? hullMain : na, "Hull Main", color=hullMainColor, linewidth=2)
plot(showHullLines ? hullFast : na, "Hull Fast", color=hullFastColor, linewidth=1)

// Envelope plots
envUpperColor = color.new(color.blue, 80)
envLowerColor = color.new(color.blue, 80)
envFillColor = color.new(color.blue, 95)
envUp = plot(showEnvelope ? upperEnv : na, "Envelope Upper", color=envUpperColor)
envDn = plot(showEnvelope ? lowerEnv : na, "Envelope Lower", color=envLowerColor)
fill(envUp, envDn, color=showEnvelope ? envFillColor : na)

// SuperTrend plot
trendLineColor = trend == 1 ? color.new(color.green, 20) : color.new(color.red, 20)
plot(showTrendLine ? (trend == 1 ? trUp : trDn) : na, "SuperTrend", color=trendLineColor, linewidth=2, style=plot.style_linebr)

// Swing Line plot
plot(showSwingLine ? tsl : na, "Swing Line", color=swingColor, linewidth=2)

// VWAP plot
plot(showVWAP ? vwapVal : na, "VWAP", color=color.new(color.purple, 30), linewidth=2)

// EMA plots
plot(showEMAs ? ema20 : na, "EMA 20", color=color.new(color.yellow, 50), linewidth=1)
plot(showEMAs ? emaLong : na, "EMA 50", color=color.new(color.orange, 50), linewidth=1)
plot(showEMAs ? ema200 : na, "EMA 200", color=color.new(color.red, 50), linewidth=2)

// Entry signal markers
plotshape(showSignals and longCondition and strategy.position_size == 0 and allowEntryLong, "Long Signal", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(showSignals and shortCondition and strategy.position_size == 0 and allowEntryShort, "Short Signal", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// Special signal markers
plotshape(showSignals and impulseLong, "Impulse Long", shape.diamond, location.belowbar, color.new(color.lime, 0), size=size.tiny)
plotshape(showSignals and impulseShort, "Impulse Short", shape.diamond, location.abovebar, color.new(color.orange, 0), size=size.tiny)
plotshape(showSignals and hasTrendOverrideBull, "Trend Long", shape.circle, location.belowbar, color.new(color.teal, 0), size=size.tiny)
plotshape(showSignals and hasTrendOverrideBear, "Trend Short", shape.circle, location.abovebar, color.new(color.maroon, 0), size=size.tiny)

// Gray zone background
bgcolor(isSignalGrayZone ? color.new(color.gray, 90) : na, title="Gray Zone")
bgcolor(isChoppy ? color.new(color.yellow, 95) : na, title="Choppy Market")

// Position background
bgcolor(strategy.position_size > 0 ? color.new(color.green, 95) : strategy.position_size < 0 ? color.new(color.red, 95) : na, title="Position Background")

// ==================== 📊 INFO TABLE ====================
var table infoTable = table.new(position.top_right, 3, 18, bgcolor=color.new(color.black, 80), border_width=1)

if showInfoTable and barstate.islast
    // Header
    table.cell(infoTable, 0, 0, "Metric", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "Value", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 0, "Status", text_color=color.white, text_size=size.small)
    
    // Instrument
    table.cell(infoTable, 0, 1, "Instrument", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 1, instrumentName, text_color=color.yellow, text_size=size.tiny)
    table.cell(infoTable, 2, 1, isMES ? "MJV6" : "STD", text_color=isMES ? color.lime : color.white, text_size=size.tiny)
    
    // Position
    posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posColor = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(infoTable, 0, 2, "Position", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 2, posText, text_color=posColor, text_size=size.tiny)
    table.cell(infoTable, 2, 2, str.tostring(math.abs(strategy.position_size), "#"), text_color=color.white, text_size=size.tiny)
    
    // Entry Priority
    table.cell(infoTable, 0, 3, "Entry Type", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 3, entryPriority, text_color=color.yellow, text_size=size.tiny)
    table.cell(infoTable, 2, 3, activeSignalType, text_color=color.aqua, text_size=size.tiny)
    
    // Daily P&L
    pnlColor = dailyPnL >= 0 ? color.green : color.red
    table.cell(infoTable, 0, 4, "Daily P&L", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 4, "$" + str.tostring(dailyPnL, "#.##"), text_color=pnlColor, text_size=size.tiny)
    table.cell(infoTable, 2, 4, maxLossReached ? "LIMIT" : profitTargetReached ? "TARGET" : "OK", text_color=maxLossReached ? color.red : profitTargetReached ? color.lime : color.white, text_size=size.tiny)
    
    // Trade Count
    table.cell(infoTable, 0, 5, "Trades Today", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 5, str.tostring(todayTradeCount), text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 5, maxTradesReached ? "MAX" : "OK", text_color=maxTradesReached ? color.yellow : color.white, text_size=size.tiny)
    
    // Trend
    trendText = veryStrongTrend ? "STRONG" : moderateTrend ? "MODERATE" : rangingMarket ? "RANGING" : "MIXED"
    trendColor = veryStrongTrend ? color.green : moderateTrend ? color.yellow : rangingMarket ? color.orange : color.gray
    table.cell(infoTable, 0, 6, "Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 6, trendText, text_color=trendColor, text_size=size.tiny)
    table.cell(infoTable, 2, 6, isChoppy ? "CHOP" : "CLEAR", text_color=isChoppy ? color.orange : color.white, text_size=size.tiny)
    
    // Star Score
    starColor = is5Star ? color.lime : is4Star ? color.green : is3Star ? color.yellow : is2Star ? color.orange : color.red
    table.cell(infoTable, 0, 7, "Star Score", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 7, str.tostring(starScore) + "/7", text_color=starColor, text_size=size.tiny)
    table.cell(infoTable, 2, 7, fiveStarOK ? "OK" : "LOW", text_color=fiveStarOK ? color.white : color.orange, text_size=size.tiny)
    
    // HTF Alignment
    htfLongPct = str.tostring(htfAlignmentPctLong) + "%"
    htfShortPct = str.tostring(htfAlignmentPctShort) + "%"
    table.cell(infoTable, 0, 8, "HTF Align", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 8, "L:" + htfLongPct + " S:" + htfShortPct, text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 8, htfConfirmLongOK or htfConfirmShortOK ? "OK" : "WAIT", text_color=htfConfirmLongOK or htfConfirmShortOK ? color.white : color.orange, text_size=size.tiny)
    
    // MTF
    table.cell(infoTable, 0, 9, "MTF", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 9, str.tostring(mtf_alignment_pct) + "%", text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 9, mtfLongOK or mtfShortOK ? "OK" : "WAIT", text_color=mtfLongOK or mtfShortOK ? color.white : color.orange, text_size=size.tiny)
    
    // Confluence
    table.cell(infoTable, 0, 10, "Confluence", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 10, str.tostring(totalConfluenceScore) + "/" + str.tostring(requiredConfluence), text_color=finalConfluenceOK ? color.green : color.orange, text_size=size.tiny)
    table.cell(infoTable, 2, 10, finalConfluenceOK ? "OK" : "LOW", text_color=finalConfluenceOK ? color.white : color.orange, text_size=size.tiny)
    
    // Vol Regime
    volRegText = highVolRegime ? "HIGH" : lowVolRegime ? "LOW" : "NORMAL"
    volRegColor = highVolRegime ? color.red : lowVolRegime ? color.orange : color.green
    table.cell(infoTable, 0, 11, "Vol Regime", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 11, volRegText, text_color=volRegColor, text_size=size.tiny)
    table.cell(infoTable, 2, 11, volRegimeOK ? "OK" : "BLOCK", text_color=volRegimeOK ? color.white : color.red, text_size=size.tiny)
    
    // Session
    sessionText = isRegularSession ? "REGULAR" : isPreMarket ? "PRE" : isAfterHours ? "AFTER" : "OTHER"
    sessionColor = isRegularSession ? color.green : isPreMarket ? color.yellow : isAfterHours ? color.orange : color.gray
    table.cell(infoTable, 0, 12, "Session", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 12, sessionText, text_color=sessionColor, text_size=size.tiny)
    table.cell(infoTable, 2, 12, canTradeNow ? "TRADE" : "WAIT", text_color=canTradeNow ? color.white : color.red, text_size=size.tiny)
    
    // RSI
    rsiColor = rsi > 70 ? color.red : rsi < 30 ? color.green : color.white
    table.cell(infoTable, 0, 13, "RSI(7)", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 13, str.tostring(rsi, "#.#"), text_color=rsiColor, text_size=size.tiny)
    table.cell(infoTable, 2, 13, rsi > 70 ? "OB" : rsi < 30 ? "OS" : "OK", text_color=rsiColor, text_size=size.tiny)
    
    // ADX
    adxColor = adxValue > 25 ? color.green : adxValue > 20 ? color.yellow : color.orange
    table.cell(infoTable, 0, 14, "ADX", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 14, str.tostring(adxValue, "#.#"), text_color=adxColor, text_size=size.tiny)
    table.cell(infoTable, 2, 14, adxValue > 25 ? "TREND" : "WEAK", text_color=adxColor, text_size=size.tiny)
    
    // Holding Bars
    table.cell(infoTable, 0, 15, "Hold Bars", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 15, str.tostring(holdingPeriod), text_color=color.white, text_size=size.tiny)
    table.cell(infoTable, 2, 15, holdingPeriod >= maxHoldingBars ? "MAX" : "OK", text_color=holdingPeriod >= maxHoldingBars ? color.yellow : color.white, text_size=size.tiny)
    
    // Block Reason
    table.cell(infoTable, 0, 16, "Block", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 16, lastBlockReason, text_color=lastBlockReason == "NONE" ? color.white : color.orange, text_size=size.tiny)
    table.cell(infoTable, 2, 16, lastBlockReason == "NONE" ? "CLEAR" : "BLOCKED", text_color=lastBlockReason == "NONE" ? color.white : color.red, text_size=size.tiny)
    
    // Streak
    streakText = consecutiveLosses > 0 ? "L:" + str.tostring(consecutiveLosses) : consecutiveWins > 0 ? "W:" + str.tostring(consecutiveWins) : "0"
    streakColor = consecutiveLosses >= maxConsecutiveLosses ? color.red : consecutiveLosses > 0 ? color.orange : consecutiveWins > 0 ? color.green : color.white
    table.cell(infoTable, 0, 17, "Streak", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 17, streakText, text_color=streakColor, text_size=size.tiny)
    table.cell(infoTable, 2, 17, pauseAfterLosses ? "PAUSE" : "OK", text_color=pauseAfterLosses ? color.red : color.white, text_size=size.tiny)
// ==================== 🔔 ALERTS ====================
alertGroup = "🔔 Alert Settings"
enableLongAlerts = input.bool(true, "Enable Long Entry Alerts", group=alertGroup)
enableShortAlerts = input.bool(true, "Enable Short Entry Alerts", group=alertGroup)
enableExitAlerts = input.bool(true, "Enable Exit Alerts", group=alertGroup)
enableImpulseAlerts = input.bool(true, "Enable Impulse Alerts", group=alertGroup)
enableTrendAlerts = input.bool(true, "Enable Trend Override Alerts", group=alertGroup)

// Long Entry Alert
if enableLongAlerts and longCondition and strategy.position_size == 0 and allowEntryLong
    alert("🟢 LONG ENTRY: " + instrumentName + " | " + selectedPriority + " | " + activeSignalType + " | Price: " + str.tostring(close, "#.##") + " | Stars: " + str.tostring(starScore) + "/7", alert.freq_once_per_bar)

// Short Entry Alert
if enableShortAlerts and shortCondition and strategy.position_size == 0 and allowEntryShort
    alert("🔴 SHORT ENTRY: " + instrumentName + " | " + selectedPriority + " | " + activeSignalType + " | Price: " + str.tostring(close, "#.##") + " | Stars: " + str.tostring(starScore) + "/7", alert.freq_once_per_bar)

// Impulse Alerts
if enableImpulseAlerts and impulseLong and strategy.position_size == 0
    alert("⚡ IMPULSE LONG: " + instrumentName + " | ATR Move Detected | Price: " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

if enableImpulseAlerts and impulseShort and strategy.position_size == 0
    alert("⚡ IMPULSE SHORT: " + instrumentName + " | ATR Move Detected | Price: " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

// Trend Override Alerts
if enableTrendAlerts and hasTrendOverrideBull and strategy.position_size == 0
    alert("📈 TREND OVERRIDE LONG: " + instrumentName + " | " + str.tostring(runUpCloses) + " bullish closes | Price: " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

if enableTrendAlerts and hasTrendOverrideBear and strategy.position_size == 0
    alert("📉 TREND OVERRIDE SHORT: " + instrumentName + " | " + str.tostring(runDownCloses) + " bearish closes | Price: " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

// Exit Alerts
if enableExitAlerts and exitIssuedThisBar
    exitDir = strategy.position_size[1] > 0 ? "LONG" : "SHORT"
    alert("🚪 EXIT " + exitDir + ": " + instrumentName + " | Reason: " + lastExitReason + " | Price: " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

// Daily Limit Alerts
if maxLossReached and not maxLossReached[1]
    alert("🛑 DAILY LOSS LIMIT REACHED: " + instrumentName + " | P&L: $" + str.tostring(dailyPnL, "#.##") + " | Trading halted", alert.freq_once_per_bar)

if profitTargetReached and not profitTargetReached[1]
    alert("🎯 DAILY PROFIT TARGET REACHED: " + instrumentName + " | P&L: $" + str.tostring(dailyPnL, "#.##") + " | Trading halted", alert.freq_once_per_bar)

if maxTradesReached and not maxTradesReached[1]
    alert("📊 MAX DAILY TRADES REACHED: " + instrumentName + " | Trades: " + str.tostring(todayTradeCount) + " | Trading halted", alert.freq_once_per_bar)

// Streak Pause Alert
if pauseAfterLosses and not pauseAfterLosses[1]
    alert("⏸️ STREAK PAUSE ACTIVATED: " + instrumentName + " | Consecutive Losses: " + str.tostring(consecutiveLosses) + " | Pausing for " + str.tostring(pauseBarsAfterLossStreak) + " bars", alert.freq_once_per_bar)

// ==================== 📊 DEBUG PLOTS (OPTIONAL) ====================
debugGroup = "🔧 Debug"
showDebugPlots = input.bool(false, "Show Debug Plots", group=debugGroup)

plot(showDebugPlots ? starScore : na, "Star Score", color=color.yellow, display=display.data_window)
plot(showDebugPlots ? totalConfluenceScore : na, "Confluence Score", color=color.aqua, display=display.data_window)
plot(showDebugPlots ? htfAlignLongCount : na, "HTF Long Count", color=color.green, display=display.data_window)
plot(showDebugPlots ? htfAlignShortCount : na, "HTF Short Count", color=color.red, display=display.data_window)
plot(showDebugPlots ? rsi : na, "RSI", color=color.purple, display=display.data_window)
plot(showDebugPlots ? adxValue : na, "ADX", color=color.orange, display=display.data_window)
plot(showDebugPlots ? atrRegRatio : na, "ATR Ratio", color=color.blue, display=display.data_window)
plot(showDebugPlots ? holdingPeriod : na, "Holding Bars", color=color.white, display=display.data_window)
plot(showDebugPlots ? consecutiveLosses : na, "Consec Losses", color=color.red, display=display.data_window)
plot(showDebugPlots ? dailyPnL : na, "Daily P&L", color=color.lime, display=display.data_window)

// ==================== END OF STRATEGY ====================
