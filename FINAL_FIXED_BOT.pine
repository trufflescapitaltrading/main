mym_customSL = input.float(60.0, "MYM: Stop Loss (points)", group=perInstGroup)
mym_customTP = input.float(90.0, "MYM: Take Profit (points)", group=perInstGroup)
mym_customQty = input.int(1, "MYM: Position Size", minval=1, maxval=50, group=perInstGroup)
mcl_useCustom = input.bool(false, "MCL: Use Custom SL/TP/Size", group=perInstGroup)
