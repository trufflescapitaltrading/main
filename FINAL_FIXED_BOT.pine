// ==================== 🕐 OPTIMAL TRADING SESSIONS (FIXED) ====================
optimalSessionGroup = "🕐 Optimal Liquidity Sessions"
useOptimalSessionsOnly = input.bool(false, "⚠️ BONUS for Optimal (not blocking)", group=optimalSessionGroup)
optNyOpenStart = input.int(930, "NY Open Start (ET)", group=optimalSessionGroup)
optNyOpenEnd = input.int(1130, "NY Open End (ET)", group=optimalSessionGroup)
optNyCloseStart = input.int(1400, "NY Close Start (ET)", group=optimalSessionGroup)
optNyCloseEnd = input.int(1600, "NY Close End (ET)", group=optimalSessionGroup)
optOverlapStart = input.int(800, "London/NY Overlap Start (ET)", group=optimalSessionGroup)
optOverlapEnd = input.int(1200, "London/NY Overlap End (ET)", group=optimalSessionGroup)
