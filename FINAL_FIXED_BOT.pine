//@version=5
strategy("FIXED MJV6 + Cursor Features", overlay=true, initial_capital=25000, default_qty_type=strategy.cash, default_qty_value=1000, pyramiding=0, calc_on_order_fills=false, calc_on_every_tick=true, process_orders_on_close=false, dynamic_requests=true)
// ==================== 💰 DAILY PROFIT TARGET ====================
profitTargetGroup = "💰 Daily Profit Target"
enableDailyProfitTarget = input.bool(true, "Enable Daily Profit Target", group=profitTargetGroup)
dailyProfitTarget = input.float(1500.0, "Daily Profit Target ($)", minval=500, maxval=5000, group=profitTargetGroup)
// ==================== 🎯 PRICE MOMENTUM OVERRIDE ====================
momentumOverrideGroup = "🎯 PRICE MOMENTUM OVERRIDE"
enableMomentumOverride = input.bool(true, "✅ Enable Price Momentum Override", group=momentumOverrideGroup)
momentumLookback = input.int(5, "Momentum Lookback Bars", minval=3, maxval=10, group=momentumOverrideGroup)
momentumThresholdPct = input.float(0.4, "Min Price Move (%)", minval=0.3, maxval=2.0, group=momentumOverrideGroup)
momentumThresholdPoints = input.float(100.0, "Min Price Move (MNQ points)", minval=50, maxval=300, group=momentumOverrideGroup)
// ==================== 🎯 FIXED SIGNAL LINE SYSTEM ====================
signalGroup = "🎯 Fixed Signal Line System"
enableSignalLine = input.bool(true, "✅ Enable Signal Line System", group=signalGroup)
useSignalLineStrict = input.bool(false, "⚠️ STRICT: Only trade with signal line", group=signalGroup)
swingPeriod = input.int(3, "BUY/SELL Swing Period", minval=1, maxval=10, group=signalGroup)
enableSwingSignals = input.bool(true, "Enable BUY/SELL Swing Signals", group=signalGroup)
swingSignalPriority = input.bool(true, "Add Swing to Priority System", group=signalGroup)
swingInjectToBase = input.bool(false, "Allow Swing to feed base signals", group=signalGroup)
grayZoneEnabled = input.bool(true, "Enable Gray Zone", group=signalGroup)
grayADXThreshold = input.float(20.0, "Gray Zone: ADX Below", minval=10.0, maxval=30.0, group=signalGroup)
grayATRMultiplier = input.float(0.75, "Gray Zone: ATR Compression", minval=0.4, maxval=1.2, group=signalGroup)
grayBBWidthThreshold = input.float(0.015, "Gray Zone: BB Width Below", minval=0.005, maxval=0.030, group=signalGroup)
grayMinFactors = input.int(2, "Gray Zone: Min Factors", minval=2, maxval=6, group=signalGroup)
// ==================== 🕯️ CANDLESTICK PATTERNS (ALL 18) ====================
candleGroup = "🕯️ Candlestick Pattern System"
enableCandlePatterns = input.bool(true, "✅ MASTER: Enable Candlestick Patterns", group=candleGroup)
requireVolumeConfirmation = input.bool(true, "Require Volume Confirmation", group=candleGroup)
minPatternSize = input.float(0.5, "Min Pattern Size (×ATR)", minval=0.3, maxval=2.0, group=candleGroup)
bullishPatternsGroup = "🟢 Bullish Patterns"
enableBullishEngulfing = input.bool(true, "Bullish Engulfing", group=bullishPatternsGroup)
enableHammer = input.bool(true, "Hammer", group=bullishPatternsGroup)
enableInvertedHammer = input.bool(true, "Inverted Hammer", group=bullishPatternsGroup)
enableMorningStar = input.bool(true, "Morning Star", group=bullishPatternsGroup)
enableBullishHarami = input.bool(true, "Bullish Harami", group=bullishPatternsGroup)
enablePiercingLine = input.bool(true, "Piercing Line", group=bullishPatternsGroup)
enableThreeWhiteSoldiers = input.bool(true, "Three White Soldiers", group=bullishPatternsGroup)
enableBullishMarubozu = input.bool(true, "Bullish Marubozu", group=bullishPatternsGroup)
bearishPatternsGroup = "🔴 Bearish Patterns"
enableBearishEngulfing = input.bool(true, "Bearish Engulfing", group=bearishPatternsGroup)
enableShootingStar = input.bool(true, "Shooting Star", group=bearishPatternsGroup)
enableHangingMan = input.bool(true, "Hanging Man", group=bearishPatternsGroup)
enableEveningStar = input.bool(true, "Evening Star", group=bearishPatternsGroup)
enableBearishHarami = input.bool(true, "Bearish Harami", group=bearishPatternsGroup)
enableDarkCloudCover = input.bool(true, "Dark Cloud Cover", group=bearishPatternsGroup)
enableThreeBlackCrows = input.bool(true, "Three Black Crows", group=bearishPatternsGroup)
enableBearishMarubozu = input.bool(true, "Bearish Marubozu", group=bearishPatternsGroup)
neutralPatternsGroup = "⚪ Neutral/Indecision Patterns"
enableDoji = input.bool(true, "Doji", group=neutralPatternsGroup)
enableSpinningTop = input.bool(true, "Spinning Top", group=neutralPatternsGroup)
patternTierGroup = "🕯️ Ranked Pattern Tiers"
enableTier1 = input.bool(true, "🥇 Tier 1 (75%+)", group=patternTierGroup)
enableTier2 = input.bool(true, "🥈 Tier 2 (65-74%)", group=patternTierGroup)
enableTier3 = input.bool(true, "🥉 Tier 3 (55-64%)", group=patternTierGroup)
enableTier4 = input.bool(true, "⚪ Tier 4 (Power/Neutral)", group=patternTierGroup)
highWinRateMode = input.bool(true, "🎯 High Win Rate Mode (70%+)")
quickTPMultiplier = input.float(0.6, "Quick TP Multiplier", minval=0.3, maxval=1.0)
widerSLMultiplier = input.float(1.5, "Wider SL Multiplier", minval=1.0, maxval=2.5)
// ==================== 🎯 MNQ 3m WIN-RATE BOOSTER (OPTIONAL) ====================
mnq3mBoosterGroup = "🎯 MNQ 3m Win-Rate Booster"
enableMnq3mWinRateBooster = input.bool(false, "Enable MNQ 3m Win-Rate Booster (single contract)", group=mnq3mBoosterGroup)
mnq3mBoosterTargetPctOfTP1 = input.float(0.60, "Target = TP1 × pct (0.30–1.00)", minval=0.30, maxval=1.00, step=0.05, group=mnq3mBoosterGroup)
mnq3mBoosterBETriggerPctOfTarget = input.float(0.60, "Move stop to BE after Target × pct", minval=0.20, maxval=1.00, step=0.05, group=mnq3mBoosterGroup)
mnq3mBoosterUseFeesForBE = input.bool(true, "BE includes est. fees/slippage", group=mnq3mBoosterGroup)
// ==================== 🎯 MES 3m WIN-RATE BOOSTER (DEFAULT ON) ====================
mes3mBoosterGroup = "🎯 MES 3m Win-Rate Booster"
enableMes3mWinRateBooster = input.bool(true, "Enable MES 3m Win-Rate Booster (single contract)", group=mes3mBoosterGroup)
mes3mBoosterTargetPctOfTP1 = input.float(0.60, "Target = TP1 × pct (0.30–1.00)", minval=0.30, maxval=1.00, step=0.05, group=mes3mBoosterGroup)
mes3mBoosterBETriggerPctOfTarget = input.float(0.60, "Move stop to BE after Target × pct", minval=0.20, maxval=1.00, step=0.05, group=mes3mBoosterGroup)
mes3mBoosterUseFeesForBE = input.bool(true, "BE includes est. fees/slippage", group=mes3mBoosterGroup)
// ==================== 🎯 MES 5m WIN-RATE BOOSTER (DEFAULT ON) ====================
mes5mBoosterGroup = "🎯 MES 5m Win-Rate Booster"
enableMes5mWinRateBooster = input.bool(true, "Enable MES 5m Win-Rate Booster (single contract)", group=mes5mBoosterGroup)
mes5mTargetSLMult = input.float(0.90, "Target = SL × mult", minval=0.30, maxval=2.00, step=0.05, group=mes5mBoosterGroup)
mes5mBETriggerPctOfTarget = input.float(0.60, "Move stop to BE after Target × pct", minval=0.20, maxval=1.00, step=0.05, group=mes5mBoosterGroup)
mes5mUseFeesForBE = input.bool(true, "BE includes est. fees/slippage", group=mes5mBoosterGroup)
// ==================== 🔥 MES MJV6 PROFIT LOGIC (FIXED - EXACT MJV6) ====================
mesProfitGroup = "🔥 MES Profit Logic (MJV6)"
useMJV6MesProfitLogic = input.bool(true, "MES: Use MJV6 profit logic (TP ladder + trail + time exit)", group=mesProfitGroup)
// ==================== 🛡️ MES HIGH-WIN ENTRY GATE ====================
// ⚠️ DISABLED BY DEFAULT - Original MJV6 did NOT have these restrictions
mesEntryGateGroup = "🛡️ MES High-Win Entry Gate"
enableMesHighWinEntryGate = input.bool(false, "Enable MES-only strict entry gate (DISABLED for MJV6 compatibility)", group=mesEntryGateGroup)
mesOnlyRegularSession = input.bool(false, "MES: Trade only Regular Session", group=mesEntryGateGroup)
mesForceMandatoryTrend = input.bool(false, "MES: Require Mandatory Trend-Only conditions", group=mesEntryGateGroup)
mesMinConfluenceScore = input.int(2, "MES: Min confluence score (0-7)", minval=0, maxval=7, group=mesEntryGateGroup)
mesMinMtfDirectionalPct = input.int(33, "MES: Min MTF alignment % (Filter mode)", minval=0, maxval=100, group=mesEntryGateGroup)
mesRestrictToPminus1P1P2 = input.bool(false, "MES: Only allow P-1/P1/P2 entries", group=mesEntryGateGroup)
// ==================== 🔥 MNQ 3m "KENYA" PROFIT LOGIC (AS POSTED) ====================
kenyaGroup = "🔥 MNQ 3m Profit Logic (Kenya)"
useKenyaMnq3mProfitLogic = input.bool(true, "Use Kenya 60/25/10/5 ladder on MNQ 3m", group=kenyaGroup)
kenyaAllowIntrabarEntries = input.bool(true, "Kenya MNQ 3m: allow intrabar entries (restore original behavior)", group=kenyaGroup)
kenyaEnableSignalReversal = input.bool(true, "Kenya MNQ 3m: enable signal-reversal exits", group=kenyaGroup)
useV20KenyaPerfectProfit = input.bool(true, "Use V20 Kenya PERFECT PROFIT module (overrides other exits)", group=kenyaGroup)
v20AllowOn3m = input.bool(false, "V20: allow on 3m charts (default OFF to protect 3m expectancy)", group=kenyaGroup)
// ==================== 🏆 WIN RATE OPTIMIZATION V71 ====================
winOptGroup = "🏆 WIN RATE OPTIMIZATION V71"
enableAdaptiveTrailing = input.bool(true, "✅ Enable Adaptive Trailing Stop", group=winOptGroup)
trailingActivationPct = input.float(50.0, "Trailing Activation (% of TP1)", minval=20, maxval=100, group=winOptGroup)
trailingStepPct = input.float(25.0, "Trailing Step (%)", minval=10, maxval=50, group=winOptGroup)
enableTimeProfitLock = input.bool(true, "✅ Enable Time-Decay Profit Lock", group=winOptGroup)
profitLockBars = input.int(8, "Bars Before Profit Lock", minval=3, maxval=20, group=winOptGroup)
profitLockMinPct = input.float(30.0, "Min Profit for Lock (% of TP1)", minval=10, maxval=80, group=winOptGroup)
profitLockKeepPct = input.float(50.0, "Keep Profit %", minval=20, maxval=90, group=winOptGroup)
enableMomentumFadeExit = input.bool(true, "✅ Enable Momentum-Fade Exit", group=winOptGroup)
momentumFadeBars = input.int(3, "Bars for Momentum Check", minval=2, maxval=10, group=winOptGroup)
momentumFadeThreshold = input.float(0.7, "Fade Threshold (RSI delta)", minval=0.3, maxval=2.0, group=winOptGroup)
enableQuickScalpExit = input.bool(true, "✅ Quick Scalp Exit", group=winOptGroup)
quickScalpProfitPct = input.float(40.0, "Quick Scalp Profit (% of TP1)", minval=20, maxval=80, group=winOptGroup)
quickScalpBars = input.int(5, "Quick Scalp Max Bars", minval=2, maxval=15, group=winOptGroup)
enableVolatilityAdjustedExits = input.bool(true, "✅ Volatility-Adjusted Exits", group=winOptGroup)
volAdjustFactor = input.float(0.8, "Vol Adjustment Factor", minval=0.5, maxval=1.2, group=winOptGroup)
enableStrictEntryFilter = input.bool(false, "Strict Entry Filter (DISABLED for MJV6 compatibility)", group=winOptGroup)
minADXForEntry = input.float(15.0, "Min ADX for Entry", minval=10, maxval=30, group=winOptGroup)
minRSIRangeLow = input.float(35.0, "RSI Range Low", minval=20, maxval=45, group=winOptGroup)
minRSIRangeHigh = input.float(65.0, "RSI Range High", minval=55, maxval=80, group=winOptGroup)
// ==================== ✅ ENTRY EXECUTION ====================
entryGroup = "✅ Entry Execution"
enterOnBarClose = input.bool(false, "Enter ONLY on bar close (DISABLED for more trades)", group=entryGroup)
allowIntrabarForP1P2 = input.bool(true, "Allow intrabar entries for P1/P2 (earlier impulse/trend)", group=entryGroup)
require5mCandleColorConfirm = input.bool(false, "3m entries require 5m candle color confirmation (DISABLED)", group=entryGroup)
// ==================== 🛡️ MES ANTI-CHOP GUARD ====================
// ⚠️ LOOSENED - Original MJV6 had simpler filters
mesGuardGroup = "🛡️ MES Anti-Chop Guard"
enableMesAntiChop = input.bool(false, "Enable MES stricter filters (DISABLED for MJV6 compatibility)", group=mesGuardGroup)
mesMinADXForEntry = input.float(15.0, "MES Min ADX", minval=10, maxval=40, group=mesGuardGroup)
mesConfluenceBoost = input.int(0, "MES Confluence +", minval=0, maxval=5, group=mesGuardGroup)
mesMinHTFAligned = input.int(1, "MES Min HTF Align (1-3)", minval=1, maxval=3, group=mesGuardGroup)
// ==================== ✅ MANDATORY TREND-ONLY FILTER (NON-NEGOTIABLE) ====================
trendOnlyGroup = "✅ Mandatory Trend-Only Filter"
enableMandatoryTrendOnly = input.bool(false, "Enable Mandatory Trend-Only Filter (hard block)", group=trendOnlyGroup)
trendHTFTF = input.timeframe("60", "HTF Structure TF (60m+)", group=trendOnlyGroup)
htfPivotLen = input.int(3, "HTF Pivot Len (structure)", minval=1, maxval=10, group=trendOnlyGroup)
maxVwapCrosses = input.int(2, "Max VWAP crosses (last 2-3h)", minval=0, maxval=10, group=trendOnlyGroup)
atrExpLen = input.int(20, "ATR baseline length", minval=5, maxval=200, group=trendOnlyGroup)
atrExpMult = input.float(1.10, "ATR expanding mult", minval=1.00, maxval=2.00, step=0.05, group=trendOnlyGroup)
vwapSlopeLen = input.int(10, "VWAP slope lookback", minval=2, maxval=50, group=trendOnlyGroup)
// ==================== ⭐ PRIORITY HIERARCHY SYSTEM ====================
priorityGroup = "⭐ PRIORITY HIERARCHY SYSTEM"
enablePrioritySystem = input.bool(true, "✅ Enable Priority Hierarchy", group=priorityGroup)
allowPriority0 = input.bool(true, "P0: Momentum Override 🎯", group=priorityGroup)
allowPriorityMinus1 = input.bool(true, "P-1: Trend Start (Ignition) 🔥", group=priorityGroup)
allowPriority1 = input.bool(true, "P1: Impulse Override 🚀", group=priorityGroup)
allowPriority1Early = input.bool(true, "P1: Early Trend Start (SuperTrend flip + momentum)", group=priorityGroup)
allowPriority2 = input.bool(true, "P2: Strong Trend Override 📈", group=priorityGroup)
allowPriority3 = input.bool(true, "P3: 5-Star Entry", group=priorityGroup)
allowPriority4 = input.bool(true, "P4: 4-Star Entry", group=priorityGroup)
allowPriority5 = input.bool(true, "P5: 3-Star Entry", group=priorityGroup)
allowPriority6 = input.bool(true, "P6: 2-Star Entry", group=priorityGroup)
allowPriority7 = input.bool(true, "P7: Swing Signal", group=priorityGroup)
group_entryConfirm = "✅ Entry Confirmation"
requireCandleDirection = input.bool(true, "⚠️ STRICT: Long=Green, Short=Red", group=group_entryConfirm)
requireBodyStrength = input.bool(false, "Require Body Strength", group=group_entryConfirm)
minBodyPctOfATR = input.float(0.10, "Min Body % of ATR", minval=0.0, maxval=1.0, step=0.01, group=group_entryConfirm)
enableImpulseOverride = input.bool(true, "Enable Impulse Override", group=group_entryConfirm)
impulseATRMult = input.float(1.15, "Impulse Move ATR Multiple", minval=0.3, maxval=5.0, step=0.05, group=group_entryConfirm)
impulseVolMult = input.float(1.7, "Impulse Volume Multiple", minval=1.0, maxval=10.0, step=0.05, group=group_entryConfirm)
impulseBodyMin = input.float(0.6, "Impulse: Min body ratio", minval=0.10, maxval=0.95, step=0.05, group=group_entryConfirm)
impulseRangeMinATR = input.float(0.90, "Impulse: Min full range × ATR", minval=0.30, maxval=3.0, step=0.05, group=group_entryConfirm)
confluenceLevel = input.int(3, "🎯 Confluence Level (1=Loose, 15=Strict)", minval=1, maxval=15)
enableTrendOverride = input.bool(true, "🚀 Enable Strong Trend Override", group="Trend Override")
consecutiveCandlesRequired = input.int(3, "Consecutive Candles for Override", minval=2, maxval=5, group="Trend Override")
trendOverrideVolMultiplier = input.float(0.6, "Volume Multiplier for Override", minval=0.5, maxval=1.5, group="Trend Override")
trendOverrideRangeMultiplier = input.float(0.9, "Range Multiplier for Override", minval=0.5, maxval=3.0, group="Trend Override")
choppyFilterGroup = "Choppy Market Filter"
enableChoppyFilter = input.bool(false, "Enable Choppy/Sideways Market Filter (DISABLED for MJV6)", group=choppyFilterGroup)
choppyADXThreshold = input.float(23.0, "ADX Threshold (below = choppy)", minval=10.0, maxval=35.0, group=choppyFilterGroup)
choppyATRMultiplier = input.float(0.85, "ATR Multiplier (below avg = choppy)", minval=0.5, maxval=1.2, group=choppyFilterGroup)
choppyBBWidthThreshold = input.float(0.020, "BB Width Threshold", minval=0.005, maxval=0.050, group=choppyFilterGroup)
disableChoppyInTrend = input.bool(true, "Disable Choppy Filter During Trends", group=choppyFilterGroup)
disableChoppyInPosition = input.bool(false, "Disable Choppy When In Position", group=choppyFilterGroup)
emergencyGroup = "V8 Emergency Safety System"
enableBackupSL = input.bool(true, "Enable Backup Stop Loss", group=emergencyGroup)
backupSL_MES = input.float(40.0, "MES Backup SL (points)", group=emergencyGroup)
backupSL_MNQ = input.float(120.0, "MNQ Backup SL (points)", group=emergencyGroup)
backupSL_Default = input.float(30.0, "Default Backup SL (points)", group=emergencyGroup)
enableNuclearExit = input.bool(true, "Enable Nuclear Emergency Exit", group=emergencyGroup)
nuclearExtraFactor = input.float(2.5, "Nuclear Distance Factor", minval=1.5, maxval=5.0, group=emergencyGroup)
nuclearMaxBars = input.int(150, "Nuclear Max Bars", minval=10, maxval=500, group=emergencyGroup)
// ==================== 🕐 SESSION FILTERS (FIXED) ====================
sessionGroup = "🌍 Trading Sessions & Times"
enable24_7Trading = input.bool(true, "✅ Enable 24/7 Trading", group=sessionGroup)
enableTradingHours = input.bool(true, "Trading Hours (4 AM - 8 PM ET)", group=sessionGroup)
tradingHoursStart = input.int(400, "Start (4:00 AM ET)", minval=0, maxval=2359, group=sessionGroup)
tradingHoursEnd = input.int(2000, "End (8:00 PM ET)", minval=0, maxval=2359, group=sessionGroup)
enableNoTradeZone = input.bool(false, "🚫 No Trade Zone (BLOCKS trades)", group=sessionGroup)
noTradeStart = input.int(0, "No Trade Start (12:00 AM ET)", minval=0, maxval=2359, group=sessionGroup)
noTradeEnd = input.int(600, "No Trade End (6:00 AM ET)", minval=0, maxval=2359, group=sessionGroup)
enableAsianSession = input.bool(true, "🇯🇵 Asian Session", group=sessionGroup)
asianStart = input.int(1900, "Asian Start (ET)", minval=0, maxval=2359, group=sessionGroup)
asianEnd = input.int(300, "Asian End (ET)", minval=0, maxval=2359, group=sessionGroup)
enableLondonSession = input.bool(true, "🇬🇧 London Session", group=sessionGroup)
londonStart = input.int(300, "London Start (ET)", minval=0, maxval=2359, group=sessionGroup)
londonEnd = input.int(1200, "London End (ET)", minval=0, maxval=2359, group=sessionGroup)
enableNYSession = input.bool(true, "🇺🇸 NY Session", group=sessionGroup)
nyStart = input.int(400, "NY Start (ET)", minval=0, maxval=2359, group=sessionGroup)
nyEnd = input.int(2000, "NY End (ET)", minval=0, maxval=2359, group=sessionGroup)
enableUAESession = input.bool(true, "🇦🇪 UAE Session", group=sessionGroup)
uaeStart = input.int(0, "UAE Start (ET)", minval=0, maxval=2359, group=sessionGroup)
uaeEnd = input.int(800, "UAE End (ET)", minval=0, maxval=2359, group=sessionGroup)
asianBestInstruments = input.string("MNQ,MES,MGC", "Asian Best Instruments", group=sessionGroup)
londonBestInstruments = input.string("MGC,MCL,MES", "London Best Instruments", group=sessionGroup)
nyBestInstruments = input.string("MES,MNQ,MYM", "NY Best Instruments", group=sessionGroup)
uaeBestInstruments = input.string("MCL,MGC", "UAE Best Instruments", group=sessionGroup)
asianMultiplier = input.float(1.2, "Asian Session Multiplier", minval=0.5, maxval=2.0, group=sessionGroup)
londonMultiplier = input.float(1.3, "London Session Multiplier", minval=0.5, maxval=2.0, group=sessionGroup)
nyMultiplier = input.float(1.5, "NY Session Multiplier", minval=0.5, maxval=2.0, group=sessionGroup)
uaeMultiplier = input.float(0.9, "UAE Session Multiplier", minval=0.5, maxval=2.0, group=sessionGroup)
enableStrongSignals = input.bool(true, "Enable STRONG Signals")
enableScalpSignals = input.bool(true, "Enable SCALP Signals")
enableInstantSignals = input.bool(true, "Enable INSTANT Signals")
enableMicroSignals = input.bool(true, "Enable MICRO Signals")
enableDailyTradeLimit = input.bool(true, "Enable Daily Trade Limit")
maxDailyTrades = input.int(20, "Max Daily Trades", minval=5, maxval=100)
var float peakProfit = 0.0
var int positionBars = 0
maxLossMGC = 60.0
breakevenThresholdMGC = 40.0
maeDrawbackPercent = 0.75
// ==================== 🎯 INSTRUMENT DETECTION ====================
isMYM = str.contains(syminfo.ticker, "MYM") or str.contains(syminfo.ticker, "YM")
isMNQ = str.contains(syminfo.ticker, "MNQ") or str.contains(syminfo.ticker, "NQ")
isMCL = str.contains(syminfo.ticker, "MCL") or str.contains(syminfo.ticker, "CL")
isMGC = str.contains(syminfo.ticker, "MGC") or str.contains(syminfo.ticker, "GC")
isMES = str.contains(syminfo.ticker, "MES") or str.contains(syminfo.ticker, "ES")
isM2K = str.contains(syminfo.ticker, "M2K") or str.contains(syminfo.ticker, "RTY")
isMicroFutures = isMYM or isMNQ or isMCL or isMGC or isMES or isM2K
mymMultiplier = input.float(1.8, "MYM Trade Multiplier", minval=1.3, maxval=2.5)
mnqMultiplier = input.float(1.6, "MNQ Trade Multiplier", minval=1.2, maxval=2.2)
mclMultiplier = input.float(1.4, "MCL Trade Multiplier", minval=1.1, maxval=2.0)
mgcMultiplier = input.float(1.2, "MGC Trade Multiplier", minval=1.0, maxval=1.8)
mesMultiplier = input.float(1.7, "MES Trade Multiplier", minval=1.2, maxval=2.3)
m2kMultiplier = input.float(1.5, "M2K Trade Multiplier", minval=1.1, maxval=2.0)
enableIndividualRiskLimits = input.bool(false, "Enable Individual Instrument Risk Limits")
totalDailyRisk = input.float(450.0, "Total Daily Risk ($)", minval=100, maxval=2000)
mymDailyRiskPercent = input.float(12.0, "MYM Daily Risk %", minval=5.0, maxval=30.0)
mnqDailyRiskPercent = input.float(18.0, "MNQ Daily Risk %", minval=10.0, maxval=35.0)
mesDailyRiskPercent = input.float(20.0, "MES Daily Risk %", minval=15.0, maxval=35.0)
mclDailyRiskPercent = input.float(25.0, "MCL Daily Risk %", minval=15.0, maxval=40.0)
mgcDailyRiskPercent = input.float(25.0, "MGC Daily Risk %", minval=15.0, maxval=40.0)
mymMaxDailyRisk = totalDailyRisk * (mymDailyRiskPercent / 100)
mnqMaxDailyRisk = totalDailyRisk * (mnqDailyRiskPercent / 100)
mesMaxDailyRisk = totalDailyRisk * (mesDailyRiskPercent / 100)
mclMaxDailyRisk = totalDailyRisk * (mclDailyRiskPercent / 100)
mgcMaxDailyRisk = totalDailyRisk * (mgcDailyRiskPercent / 100)
var float mymDailyLoss = 0.0
var float mnqDailyLoss = 0.0
var float mesDailyLoss = 0.0
var float mclDailyLoss = 0.0
var float mgcDailyLoss = 0.0
var int todayTradeCount = 0
var bool isChoppy = false
// ==================== 📊 PER-INSTRUMENT SETTINGS ====================
perInstGroup = "Per-Instrument Trade Settings"
mes_useCustom = input.bool(true, "MES: Use Custom SL/TP/Size", group=perInstGroup)
mes_customSL = input.float(14.0, "MES: Stop Loss (points)", group=perInstGroup)
mes_customTP = input.float(18.0, "MES: Take Profit (points)", group=perInstGroup)
