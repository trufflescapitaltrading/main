// © Filter Harmony v3 - MCL A++ Trend-Only Continuation Bot
// Optimized for 80% Win Rate with Cooperative Filter System

//@version=6
strategy("MCL — Filter Harmony v3 A++ Trend-Only [BOT]",
     overlay=true, pyramiding=0, calc_on_every_tick=false, 
     initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=4.76)

// ═══════════════════════════════════════════════════════════════════════════════
// ██╗  ██╗██╗   ██╗ FILTER HARMONY v3 - MCL TRADING BOT
// ██║  ██║██║   ██║ ALL FILTERS WORK TOGETHER FOR 80% WIN RATE
// ███████║███████║ Cooperative Quality Scoring System
// ██╔══██║██╔══██║ NOT BLOCKING - SCORING!
// ██║  ██║██║  ██║ 
// ╚═╝  ╚═╝╚═╝  ╚═╝ Ready for Live Trading with $1500 Daily Target
// ═══════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 1: CONTRACT CONSTANTS & INSTRUMENT GUARD
// ───────────────────────────────────────────────────────────────────────────────

// MCL Contract Specifications
pointValue = 100.0  // $100 per point for MCL
tick = syminfo.mintick
tickValue = 1.0     // $1.00 per $0.10 move

// Instrument Guard - Prevents running on wrong chart
expectedRoot = input.string("MCL", "Expected root symbol", group="🔒 Instrument Guard")
isRightChart = str.contains(syminfo.ticker, expectedRoot) or str.contains(syminfo.tickerid, expectedRoot)
botEnabled = isRightChart

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 2: FILTER HARMONY v3 MASTER SETTINGS
// ───────────────────────────────────────────────────────────────────────────────

harmonyGroup = "🎯 FILTER HARMONY v3"
enableFilterHarmony = input.bool(true, "✅ MASTER: Enable Filter Harmony v3", group=harmonyGroup, 
     tooltip="All filters work TOGETHER via quality scoring, not against each other")
minQualityThreshold = input.float(70.0, "Min Entry Quality % (70=Strict)", minval=50, maxval=95, step=1, group=harmonyGroup)
enableSmartOverrides = input.bool(true, "Enable Smart Overrides (Extreme Trends)", group=harmonyGroup)
extremeTrendBoostPct = input.float(2.0, "Extreme Trend Boost × MinMove%", minval=1.2, maxval=4.0, step=0.1, group=harmonyGroup)

// High Win Rate Mode
hwrGroup = "⭐ HIGH WIN RATE MODE"
enableHighWinRate = input.bool(true, "✅ Enable High Win Rate Mode (70-77% target)", group=hwrGroup)
hwrQuickTPMult = input.float(0.6, "Quick TP Multiplier", minval=0.3, maxval=1.0, step=0.1, group=hwrGroup)
hwrWiderSLMult = input.float(1.5, "Wider SL Multiplier", minval=1.0, maxval=2.5, step=0.1, group=hwrGroup)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 3: TIMEFRAME & SESSION SETTINGS
// ───────────────────────────────────────────────────────────────────────────────

tfGroup = "📅 Timeframe & Sessions"
htfTf1 = input.timeframe("15", "HTF1 Timeframe", group=tfGroup)
htfTf2 = input.timeframe("60", "HTF2 Timeframe", group=tfGroup)
htfTf3 = input.timeframe("240", "HTF3 Timeframe", group=tfGroup)

useTimeFilter = input.bool(true, "Enable Time Filter", group=tfGroup)
tradeSess = input.session("0700-1330", "Trade Session (exchange time)", group=tfGroup)
lockSess = input.session("1700-1510", "Daily Reset Session (CT)", group=tfGroup)

// Session Detection
enableSessionFilter = input.bool(true, "Enable Session Filters", group=tfGroup)
sessionNYOpen = input.session("0930-1130", "NY Open Session", group=tfGroup)
sessionNYClose = input.session("1400-1600", "NY Close Session", group=tfGroup)
sessionLondonOverlap = input.session("0800-1200", "London Overlap", group=tfGroup)

// No Trade Zone
enableNoTradeZone = input.bool(true, "Enable No Trade Zone", group=tfGroup)
noTradeZone = input.session("0000-0600", "No Trade Zone", group=tfGroup)

// Time calculations
inSession = not useTimeFilter or not na(time(timeframe.period, tradeSess))
inNYOpen = not na(time(timeframe.period, sessionNYOpen))
inNYClose = not na(time(timeframe.period, sessionNYClose))
inLondonOverlap = not na(time(timeframe.period, sessionLondonOverlap))
inNoTradeZone = enableNoTradeZone and not na(time(timeframe.period, noTradeZone))

sessionMultiplier = inNYOpen ? 1.5 : inNYClose ? 1.3 : inLondonOverlap ? 1.4 : 1.0

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 4: RISK MANAGEMENT SETTINGS
// ───────────────────────────────────────────────────────────────────────────────

riskGroup = "💰 Risk Management"
riskPerTrade = input.float(100, "Max $ Risk Per Trade", step=10, group=riskGroup)
dailyLossStop = input.float(500, "Daily Loss Stop ($)", step=50, group=riskGroup)
dailyProfitTarget = input.float(1500, "Daily Profit Target ($)", step=100, group=riskGroup)
maxConsecLoss = input.int(3, "Max Consecutive Losses", minval=1, maxval=10, group=riskGroup)
maxDailyTrades = input.int(10, "Max Daily Trades", minval=1, maxval=50, group=riskGroup)
stopBuffTicks = input.int(2, "Stop Buffer (ticks)", minval=0, maxval=10, group=riskGroup)

// Drawdown Protection
enableDrawdownProtection = input.bool(true, "Enable Drawdown Protection", group=riskGroup)
maxDrawdownPct = input.float(10.0, "Max Drawdown % (auto-stop)", minval=1.0, maxval=25.0, step=0.5, group=riskGroup)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 5: TREND & REGIME DETECTION
// ───────────────────────────────────────────────────────────────────────────────

trendGroup = "📈 Trend Detection"
emaFastLen = input.int(20, "EMA Fast Length", minval=5, maxval=50, group=trendGroup)
emaMidLen = input.int(50, "EMA Mid Length", minval=20, maxval=100, group=trendGroup)
emaSlowLen = input.int(200, "EMA Slow Length", minval=100, maxval=300, group=trendGroup)
slopeBars = input.int(3, "Slope Detection Bars", minval=1, maxval=10, group=trendGroup)

// Trend-Only Settings
useTrendDayOnly = input.bool(true, "TRADE TREND DAYS ONLY", group=trendGroup)
enableTrendOnly = input.bool(true, "Enable Trend-Only Regime Gate", group=trendGroup)
allowModerateTrend = input.bool(false, "Allow Moderate Trends (not just strong)", group=trendGroup)

// Consecutive Candle Detection
consecutiveCandlesRequired = input.int(3, "Consecutive Candles Required", minval=2, maxval=10, group=trendGroup)
minPriceMovePercent = input.float(0.5, "Min Price Move %", minval=0.1, maxval=2.0, step=0.1, group=trendGroup)

// Calculate EMAs
ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaMidLen)
ema200 = ta.ema(close, emaSlowLen)

// HTF EMAs
emaF = request.security(syminfo.tickerid, htfTf2, ta.ema(close, emaFastLen), barmerge.gaps_off, barmerge.lookahead_off)
emaM = request.security(syminfo.tickerid, htfTf2, ta.ema(close, emaMidLen), barmerge.gaps_off, barmerge.lookahead_off)
emaS = request.security(syminfo.tickerid, htfTf2, ta.ema(close, emaSlowLen), barmerge.gaps_off, barmerge.lookahead_off)

// Slope Detection
emaSlopeUp = emaF > emaF[slopeBars]
emaSlopeDown = emaF < emaF[slopeBars]

// HTF Trend Direction
trendLong = emaF > emaM and emaM > emaS and emaSlopeUp
trendShort = emaF < emaM and emaM < emaS and emaSlopeDown

// EMA Stack Alignment
emaStackBull = ema20 > ema50 and ema50 > ema200
emaStackBear = ema20 < ema50 and ema50 < ema200

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 6: VWAP & ATR ANALYSIS
// ───────────────────────────────────────────────────────────────────────────────

vwapGroup = "📊 VWAP & Volatility"
atrLen = input.int(14, "ATR Length", minval=5, maxval=50, group=vwapGroup)
atrExpMult = input.float(1.07, "ATR Expansion Multiplier", step=0.01, group=vwapGroup)
vwapCrossBars = input.int(24, "VWAP Cross Window (bars)", minval=5, maxval=50, group=vwapGroup)
vwapCrossMax = input.int(1, "Max VWAP Crosses (clean trend)", minval=0, maxval=5, group=vwapGroup)

// VWAP Calculations
vwap = ta.vwap(hlc3)
vwapSlopeUp = vwap > vwap[3]
vwapSlopeDown = vwap < vwap[3]
vwapAcceptLong = close > vwap and close[1] > vwap[1]
vwapAcceptShort = close < vwap and close[1] < vwap[1]

// ATR Calculations
atr = ta.atr(atrLen)
atr10 = ta.atr(10)
atrSma = ta.sma(atr, 50)
atrOk = atr > atrSma * atrExpMult
star_atrExpanding = atr > atrSma

// VWAP Cross Count (choppiness indicator)
crossCount = ta.sum(ta.cross(close, vwap) ? 1 : 0, vwapCrossBars)
chopOk = crossCount <= vwapCrossMax

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 7: COMPRESSION & RANGE DETECTION
// ───────────────────────────────────────────────────────────────────────────────

compressGroup = "📦 Compression Detection"
compressBars = input.int(20, "Compression Window (bars)", minval=5, maxval=50, group=compressGroup)
compressMin = input.float(2.4, "Min Range/ATR Ratio", step=0.1, group=compressGroup)

// Compression Calculations
rng = ta.highest(high, compressBars) - ta.lowest(low, compressBars)
compressOk = (rng / atr) >= compressMin

// Range Detection
rangingMarket = (rng / atr) < 1.5
isChoppy = crossCount > 2 or (rng / atr) < 1.2

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 8: VOLUME ANALYSIS
// ───────────────────────────────────────────────────────────────────────────────

volGroup = "📊 Volume Analysis"
useVolFilter = input.bool(true, "Require Volume Confirmation", group=volGroup)
volLen = input.int(20, "Volume SMA Length", minval=5, maxval=50, group=volGroup)
volSurgeThreshold = input.float(1.8, "Volume Surge Threshold", minval=1.2, maxval=3.0, step=0.1, group=volGroup)

// Volume Calculations
volSma = ta.sma(volume, volLen)
volOk = not useVolFilter or (volume > volSma)
volumeConfirm = volume > volSma * 0.6
strongVolume = volume > volSma * 1.2
volSurgeNow = volume > volSma * volSurgeThreshold
normalVolume = volume >= volSma * 0.7

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 9: ADX & MOMENTUM INDICATORS
// ───────────────────────────────────────────────────────────────────────────────

adxGroup = "📈 ADX & Momentum"
useAdx = input.bool(true, "Enable ADX Filter", group=adxGroup)
adxLen = input.int(14, "ADX Length", minval=7, maxval=30, group=adxGroup)
adxMin = input.float(22, "Min ADX (trend strength)", step=0.5, group=adxGroup)
adxChopThreshold = input.float(20, "ADX Chop Threshold", step=0.5, group=adxGroup)

// ADX Calculations
[diplus, diminus, adxValue] = ta.dmi(adxLen, adxLen)
adxOk = not useAdx or (adxValue >= adxMin)
adxChoppy = adxValue < adxChopThreshold

// RSI
rsiLen = input.int(14, "RSI Length", minval=5, maxval=30, group=adxGroup)
rsiOB = input.int(70, "RSI Overbought", minval=60, maxval=85, group=adxGroup)
rsiOS = input.int(30, "RSI Oversold", minval=15, maxval=40, group=adxGroup)

rsi = ta.rsi(close, rsiLen)
rsiLongOK = enableHighWinRate ? (rsi > 40 and rsi < 65) : (rsi < rsiOB)
rsiShortOK = enableHighWinRate ? (rsi < 60 and rsi > 35) : (rsi > rsiOS)

// Stochastic
stochLen = input.int(14, "Stochastic Length", minval=5, maxval=30, group=adxGroup)
stochK = ta.stoch(close, high, low, stochLen)
stochD = ta.sma(stochK, 3)
stochLongOK = enableHighWinRate ? (stochK > 25 and stochK < 75) : (stochK < 80)
stochShortOK = enableHighWinRate ? (stochK > 25 and stochK < 75) : (stochK > 20)

// Momentum
momentumBullish = rsi > 50 and stochK > stochD
momentumBearish = rsi < 50 and stochK < stochD
strongMomentumBull = rsi > 55 and stochK > 60 and stochK > stochD
strongMomentumBear = rsi < 45 and stochK < 40 and stochK < stochD

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 10: SPIKE FILTER
// ───────────────────────────────────────────────────────────────────────────────

spikeGroup = "⚡ Spike Filter"
useSpikeFilter = input.bool(true, "Block Spike Candles", group=spikeGroup)
maxAtrCandle = input.float(1.2, "Max Candle Range in ATR", step=0.1, group=spikeGroup)

candleRange = high - low
spikeOk = not useSpikeFilter or (candleRange <= atr * maxAtrCandle)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 11: TREND STRENGTH & REGIME SCORING
// ───────────────────────────────────────────────────────────────────────────────

// Trend Strength Calculation
trendStrength = (math.abs(close - close[20]) / close[20]) * 100
strongTrend = trendStrength > 1.5
moderateTrend = trendStrength > 0.8 and trendStrength <= 1.5
weakTrend = trendStrength <= 0.8

// Trend Day Determination
trendDay = atrOk and adxOk and compressOk and chopOk
allowedToTrade = (not useTrendDayOnly) or trendDay

// ═══════════════════════════════════════════════════════════════════════════════
// FILTER HARMONY v3: PROGRESSIVE SCORING SYSTEM
// Filters WORK TOGETHER instead of blocking each other
// ═══════════════════════════════════════════════════════════════════════════════

// Trend Strength Score (0-4)
trendStrengthScore = 0
trendStrengthScore := strongTrend ? 2 : moderateTrend ? 1 : 0
trendStrengthScore := trendStrengthScore + (not rangingMarket ? 1 : 0)
trendStrengthScore := trendStrengthScore + (not isChoppy ? 1 : 0)

// Soft Regime OK (allows moderate trends)
regimeSoftOK = (trendStrengthScore >= (allowModerateTrend ? 2 : 3))

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 12: CANDLE ANALYSIS & DIRECTION
// ───────────────────────────────────────────────────────────────────────────────

candleGroup = "🕯️ Candle Analysis"
requireCandleDirection = input.bool(true, "Require Candle Direction Match", group=candleGroup)
requireBodyStrength = input.bool(true, "Require Body Strength", group=candleGroup)
minBodyRatio = input.float(0.45, "Min Body Ratio", minval=0.1, maxval=0.9, step=0.05, group=candleGroup)

// Candle calculations
bodySize = math.abs(close - open)
totalRange = high - low
bodyRatio = totalRange > 0 ? bodySize / totalRange : 0

candleBull = close > open
candleBear = close < open
strongBullCandle = candleBull and bodyRatio >= minBodyRatio
strongBearCandle = candleBear and bodyRatio >= minBodyRatio

// Consecutive candle detection
var int consecutiveBullCandles = 0
var int consecutiveBearCandles = 0

if candleBull
    consecutiveBullCandles := consecutiveBullCandles + 1
    consecutiveBearCandles := 0
else if candleBear
    consecutiveBearCandles := consecutiveBearCandles + 1
    consecutiveBullCandles := 0
else
    consecutiveBullCandles := 0
    consecutiveBearCandles := 0

consecutiveLongTrend = consecutiveBullCandles >= consecutiveCandlesRequired
consecutiveShortTrend = consecutiveBearCandles >= consecutiveCandlesRequired

// Price movement
priceChange = ((close - close[consecutiveCandlesRequired]) / close[consecutiveCandlesRequired]) * 100
priceMovePercent = math.abs(priceChange)
priceUp = priceChange > 0
priceDown = priceChange < 0

// Bar OK for direction
longBarOK = not requireCandleDirection or candleBull
shortBarOK = not requireCandleDirection or candleBear

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 13: CANDLESTICK PATTERN RECOGNITION (18 PATTERNS)
// ───────────────────────────────────────────────────────────────────────────────

patternGroup = "🕯️ Candlestick Patterns"
enableCandlePatterns = input.bool(true, "Enable Pattern Recognition", group=patternGroup)

// Tier settings
enableTier1 = input.bool(true, "🥇 Tier 1 (75%+): Soldiers/Crows + Engulfing", group=patternGroup)
enableTier2 = input.bool(true, "🥈 Tier 2 (65-74%): Morning/Evening Star", group=patternGroup)
enableTier3 = input.bool(true, "🥉 Tier 3 (55-64%): Hammer/Harami", group=patternGroup)
enableTier4 = input.bool(true, "⚪ Tier 4: Marubozu/Doji", group=patternGroup)

// Pattern Detection Functions
// Bullish Engulfing
bullishEngulfing = close[1] < open[1] and close > open and open <= close[1] and close >= open[1] and close > open[1]

// Bearish Engulfing
bearishEngulfing = close[1] > open[1] and close < open and open >= close[1] and close <= open[1] and close < open[1]

// Hammer
wickLower = math.min(open, close) - low
wickUpper = high - math.max(open, close)
isHammer = wickLower >= bodySize * 2 and wickUpper <= bodySize * 0.5 and bodySize > 0

// Shooting Star
isShootingStar = wickUpper >= bodySize * 2 and wickLower <= bodySize * 0.5 and bodySize > 0

// Inverted Hammer
invertedHammer = isShootingStar and close[1] < open[1]

// Hanging Man
hangingMan = isHammer and close[1] > open[1]

// Doji
isDoji = bodyRatio < 0.1 and totalRange > 0

// Spinning Top
spinningTop = bodyRatio < 0.3 and bodyRatio >= 0.1 and wickLower > bodySize * 0.5 and wickUpper > bodySize * 0.5

// Morning Star (3-candle pattern)
morningStar = close[2] < open[2] and 
              bodySize[1] < bodySize[2] * 0.3 and 
              close > open and 
              close > (open[2] + close[2]) / 2

// Evening Star (3-candle pattern)
eveningStar = close[2] > open[2] and 
              bodySize[1] < bodySize[2] * 0.3 and 
              close < open and 
              close < (open[2] + close[2]) / 2

// Three White Soldiers
threeWhiteSoldiers = close > open and close[1] > open[1] and close[2] > open[2] and
                     close > close[1] and close[1] > close[2] and
                     open > open[1] and open[1] > open[2]

// Three Black Crows
threeBlackCrows = close < open and close[1] < open[1] and close[2] < open[2] and
                  close < close[1] and close[1] < close[2] and
                  open < open[1] and open[1] < open[2]

// Bullish Harami
bullishHarami = close[1] < open[1] and close > open and
                open > close[1] and close < open[1] and
                bodySize < bodySize[1] * 0.5

// Bearish Harami
bearishHarami = close[1] > open[1] and close < open and
                open < close[1] and close > open[1] and
                bodySize < bodySize[1] * 0.5

// Piercing Line
piercingLine = close[1] < open[1] and close > open and
               open < close[1] and close > (open[1] + close[1]) / 2 and close < open[1]

// Dark Cloud Cover
darkCloudCover = close[1] > open[1] and close < open and
                 open > close[1] and close < (open[1] + close[1]) / 2 and close > open[1]

// Marubozu
bullishMarubozu = candleBull and bodyRatio > 0.9
bearishMarubozu = candleBear and bodyRatio > 0.9

// Tier Classification
tier1Bull = threeWhiteSoldiers or bullishEngulfing
tier2Bull = morningStar or piercingLine
tier3Bull = isHammer or invertedHammer or bullishHarami
tier4Bull = bullishMarubozu or (isDoji and close[1] < open[1]) or spinningTop

tier1Bear = threeBlackCrows or bearishEngulfing
tier2Bear = eveningStar or darkCloudCover
tier3Bear = isShootingStar or hangingMan or bearishHarami
tier4Bear = bearishMarubozu or (isDoji and close[1] > open[1]) or spinningTop

// Allowed patterns based on tier settings
allowedBullPattern = (enableTier1 and tier1Bull) or
                     (enableTier2 and tier2Bull) or
                     (enableTier3 and tier3Bull) or
                     (enableTier4 and tier4Bull)

allowedBearPattern = (enableTier1 and tier1Bear) or
                     (enableTier2 and tier2Bear) or
                     (enableTier3 and tier3Bear) or
                     (enableTier4 and tier4Bear)

hasBullPattern = allowedBullPattern
hasBearPattern = allowedBearPattern

patternOKLong = not enableCandlePatterns or hasBullPattern
patternOKShort = not enableCandlePatterns or hasBearPattern

candleConfirmLong = patternOKLong
candleConfirmShort = patternOKShort

// Pattern tier score for quality calculation
patternScoreLong = tier1Bull ? 20.0 : tier2Bull ? 15.0 : tier3Bull ? 10.0 : tier4Bull ? 5.0 : 0.0
patternScoreShort = tier1Bear ? 20.0 : tier2Bear ? 15.0 : tier3Bear ? 10.0 : tier4Bear ? 5.0 : 0.0

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 14: CONFLUENCE SCORING SYSTEM (0-7 Progressive)
// ───────────────────────────────────────────────────────────────────────────────

confluenceGroup = "🎯 Confluence Scoring"
useScoreConfluence = input.bool(true, "Use Score Confluence Gate", group=confluenceGroup)
confluenceLevel = input.int(8, "Confluence Level (1-15)", minval=1, maxval=15, group=confluenceGroup)

// 7 Confluence Factors
conf_volume = volumeConfirm ? 1 : 0
conf_strongVolume = strongVolume ? 1 : 0
conf_momentum = (momentumBullish or momentumBearish) ? 1 : 0
conf_strongMom = (strongMomentumBull or strongMomentumBear) ? 1 : 0
conf_trend = (strongTrend or moderateTrend) ? 1 : 0
conf_priceAction = (priceUp or priceDown) ? 1 : 0
conf_atrExpanding = star_atrExpanding ? 1 : 0

totalConfluenceScore = conf_volume + conf_strongVolume + conf_momentum + conf_strongMom + conf_trend + conf_priceAction + conf_atrExpanding

// Map confluence level to required score
requiredConfluence = confluenceLevel <= 2 ? 1 :
                     confluenceLevel <= 4 ? 2 :
                     confluenceLevel <= 6 ? 3 :
                     confluenceLevel <= 8 ? 4 :
                     confluenceLevel <= 10 ? 5 :
                     confluenceLevel <= 12 ? 6 : 7

finalConfluenceOK = useScoreConfluence ? (totalConfluenceScore >= requiredConfluence) : true

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 15: STAR SCORING SYSTEM (0-5 Stars)
// ───────────────────────────────────────────────────────────────────────────────

// Star components
star_trend = (trendLong or trendShort) ? 1 : 0
star_momentum = (momentumBullish or momentumBearish) ? 1 : 0
star_volume = strongVolume ? 1 : 0
star_pattern = (hasBullPattern or hasBearPattern) ? 1 : 0
star_atr = star_atrExpanding ? 1 : 0

starScore = star_trend + star_momentum + star_volume + star_pattern + star_atr

// Star-only flags (prevents overlap)
is5StarOnly = starScore == 5
is4StarOnly = starScore == 4
is3StarOnly = starScore == 3
is2StarOnly = starScore == 2

is5Star = starScore >= 5
is4Star = starScore >= 4
is3Star = starScore >= 3
is2Star = starScore >= 2

// 5-star requirement
require5Star = input.bool(false, "Require 5-Star Setups Only", group=confluenceGroup)
fiveStarOK = starScore >= 5

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 16: SIGNAL LINE SYSTEM (SMA 9/50/180)
// ───────────────────────────────────────────────────────────────────────────────

signalGroup = "📊 Signal Lines"
enableSignalLine = input.bool(true, "Enable Signal Line System", group=signalGroup)
grayZoneBuffer = input.float(0.2, "Gray Zone Buffer %", minval=0.0, maxval=1.0, step=0.05, group=signalGroup)

sma9 = ta.sma(close, 9)
sma50 = ta.sma(close, 50)
sma180 = ta.sma(close, 180)
signalEma = ta.ema(close, 20)

// Signal alignment
smaAlignBull = sma9 > sma50 and sma50 > sma180
smaAlignBear = sma9 < sma50 and sma50 < sma180

// Gray zone detection (consolidation)
smaSpread = (math.max(sma9, sma50, sma180) - math.min(sma9, sma50, sma180)) / close * 100
isSignalGrayZone = smaSpread < grayZoneBuffer
grayZoneWithBuffer = smaSpread < (grayZoneBuffer * 1.5)

// Signal permissions
signalAllowsLong = not enableSignalLine or (smaAlignBull and not isSignalGrayZone)
signalAllowsShort = not enableSignalLine or (smaAlignBear and not isSignalGrayZone)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 17: IMPULSE & TREND OVERRIDE DETECTION
// ───────────────────────────────────────────────────────────────────────────────

impulseGroup = "🚀 Impulse Detection"
enableImpulseOverride = input.bool(true, "Enable Impulse Override", group=impulseGroup)
impulseATRMult = input.float(1.1, "Impulse ATR Multiplier", minval=0.8, maxval=2.0, step=0.1, group=impulseGroup)
impulseBodyMin = input.float(0.45, "Impulse Min Body Ratio", minval=0.2, maxval=0.9, step=0.05, group=impulseGroup)
impulseRangeMinATR = input.float(0.90, "Impulse Min Range × ATR", minval=0.3, maxval=2.0, step=0.05, group=impulseGroup)

// Impulse calculations
impulseMove = candleRange >= atr * impulseATRMult
rangeOK = (atr10 > 0) and (candleRange >= atr10 * impulseRangeMinATR)
bodyOK = (totalRange > 0) and (bodyRatio >= impulseBodyMin)

// Impulse signals (requires direction + strength + pattern)
impulseLong = enableImpulseOverride and candleBull and impulseMove and volSurgeNow and rangeOK and bodyOK and patternOKLong
impulseShort = enableImpulseOverride and candleBear and impulseMove and volSurgeNow and rangeOK and bodyOK and patternOKShort

// Strong Trend Override (consecutive candles)
hasStrongTrendOverrideBull = consecutiveLongTrend and priceMovePercent >= minPriceMovePercent and emaStackBull
hasStrongTrendOverrideBear = consecutiveShortTrend and priceMovePercent >= minPriceMovePercent and emaStackBear

// Bypass flags (for Filter Harmony)
isBypassLong = impulseLong or hasStrongTrendOverrideBull or consecutiveLongTrend
isBypassShort = impulseShort or hasStrongTrendOverrideBear or consecutiveShortTrend

// Extreme trend detection
extremeLong = consecutiveLongTrend and priceMovePercent >= (minPriceMovePercent * extremeTrendBoostPct) and starScore >= 3
extremeShort = consecutiveShortTrend and priceMovePercent >= (minPriceMovePercent * extremeTrendBoostPct) and starScore >= 3

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 18: HTF MULTI-TIMEFRAME CONFIRMATION
// ───────────────────────────────────────────────────────────────────────────────

mtfGroup = "📈 HTF Confirmation"
enableMTF = input.bool(true, "Enable MTF Confirmation", group=mtfGroup)
mtfMode = input.string("Advisory", "MTF Mode", options=["Filter", "Advisory", "Off"], group=mtfGroup)
mtfAlignThreshold = input.float(66.0, "MTF Alignment Threshold %", minval=33, maxval=100, step=1, group=mtfGroup)

// HTF1 (15m) indicators
htf1_ema20 = request.security(syminfo.tickerid, htfTf1, ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
htf1_ema50 = request.security(syminfo.tickerid, htfTf1, ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
htf1_rsi = request.security(syminfo.tickerid, htfTf1, ta.rsi(close, 14), barmerge.gaps_off, barmerge.lookahead_off)
htf1_bullish = htf1_ema20 > htf1_ema50 and htf1_rsi > 50
htf1_bearish = htf1_ema20 < htf1_ema50 and htf1_rsi < 50

// HTF2 (60m) indicators
htf2_ema20 = request.security(syminfo.tickerid, htfTf2, ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
htf2_ema50 = request.security(syminfo.tickerid, htfTf2, ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
htf2_rsi = request.security(syminfo.tickerid, htfTf2, ta.rsi(close, 14), barmerge.gaps_off, barmerge.lookahead_off)
htf2_bullish = htf2_ema20 > htf2_ema50 and htf2_rsi > 50
htf2_bearish = htf2_ema20 < htf2_ema50 and htf2_rsi < 50

// HTF3 (240m) indicators
htf3_ema20 = request.security(syminfo.tickerid, htfTf3, ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
htf3_ema50 = request.security(syminfo.tickerid, htfTf3, ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
htf3_rsi = request.security(syminfo.tickerid, htfTf3, ta.rsi(close, 14), barmerge.gaps_off, barmerge.lookahead_off)
htf3_bullish = htf3_ema20 > htf3_ema50 and htf3_rsi > 50
htf3_bearish = htf3_ema20 < htf3_ema50 and htf3_rsi < 50

// MTF Alignment calculation
mtfLongCount = (htf1_bullish ? 1 : 0) + (htf2_bullish ? 1 : 0) + (htf3_bullish ? 1 : 0)
mtfShortCount = (htf1_bearish ? 1 : 0) + (htf2_bearish ? 1 : 0) + (htf3_bearish ? 1 : 0)
mtf_alignment_pct = math.max(mtfLongCount, mtfShortCount) / 3.0 * 100.0

htfLongPerfect = mtfLongCount == 3
htfLongStrong = mtfLongCount >= 2
htfShortPerfect = mtfShortCount == 3
htfShortStrong = mtfShortCount >= 2

htfMultiLongAllowed = mtfLongCount >= 2
htfMultiShortAllowed = mtfShortCount >= 2

// MTF soft gates
mtfSoftOKLong = (not enableMTF) or (mtfMode != "Filter") or (mtf_alignment_pct >= mtfAlignThreshold) or isBypassLong
mtfSoftOKShort = (not enableMTF) or (mtfMode != "Filter") or (mtf_alignment_pct >= mtfAlignThreshold) or isBypassShort

mtfLongOK = mtfSoftOKLong
mtfShortOK = mtfSoftOKShort

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 19: PULLBACK & ENTRY MODEL
// ───────────────────────────────────────────────────────────────────────────────

// Pullback detection
pullbackLong = (low <= math.max(ema20, ema50) or low <= vwap) and close > ema20
pullbackShort = (high >= math.min(ema20, ema50) or high >= vwap) and close < ema20

// Reversal confirmation
revLong = close > open and close > high[1]
revShort = close < open and close < low[1]

// Swing signals
swingBuySignal = ta.crossover(signalEma, sma50) and candleBull
swingSellSignal = ta.crossunder(signalEma, sma50) and candleBear

// Ultra signals
ultraBuyCondition = trendLong and volumeConfirm and momentumBullish and candleBull
ultraSellCondition = trendShort and volumeConfirm and momentumBearish and candleBear

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 20: STRUCTURE STOPS (Pivot-Based)
// ───────────────────────────────────────────────────────────────────────────────

// Pivot calculations
pl = ta.pivotlow(low, 2, 2)
ph = ta.pivothigh(high, 2, 2)
var float lastPL = na
var float lastPH = na

if not na(pl)
    lastPL := pl
if not na(ph)
    lastPH := ph

stopLong = (na(lastPL) ? low : lastPL) - stopBuffTicks * tick
stopShort = (na(lastPH) ? high : lastPH) + stopBuffTicks * tick

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 21: POSITION SIZING
// ───────────────────────────────────────────────────────────────────────────────

riskPerContractLong = math.abs(close - stopLong) * pointValue
riskPerContractShort = math.abs(stopShort - close) * pointValue
qtyLong = math.max(1, math.floor(riskPerTrade / math.max(riskPerContractLong, 1)))
qtyShort = math.max(1, math.floor(riskPerTrade / math.max(riskPerContractShort, 1)))

// ═══════════════════════════════════════════════════════════════════════════════
// FILTER HARMONY v3: QUALITY SCORING FUNCTION
// All filters contribute to a single quality score (0-100%)
// ═══════════════════════════════════════════════════════════════════════════════

// Soft versions for cooperative scoring
confluenceSoftOK = (not useScoreConfluence) or finalConfluenceOK or isBypassLong or isBypassShort
patternSoftOKLong = (not enableCandlePatterns) or candleConfirmLong or isBypassLong
patternSoftOKShort = (not enableCandlePatterns) or candleConfirmShort or isBypassShort
signalLineSoftOKLong = (not enableSignalLine) or signalAllowsLong or isBypassLong
signalLineSoftOKShort = (not enableSignalLine) or signalAllowsShort or isBypassShort
fiveStarSoftOKLong = (not require5Star) or fiveStarOK or isBypassLong
fiveStarSoftOKShort = (not require5Star) or fiveStarOK or isBypassShort

// Quality Score Function
f_qualityScore(isLong) =>
    float score = 0.0
    float maxS = 0.0
    
    // 1) Regime/Trend (30 points max)
    maxS += 30
    score += math.min(trendStrengthScore * 7.5, 30)
    
    // 2) Confluence (20 points max)
    maxS += 20
    score += finalConfluenceOK ? 20 : math.min(totalConfluenceScore * (20.0 / 7.0), 18)
    
    // 3) Signal Line permission (15 points max)
    maxS += 15
    score += isLong ? (signalLineSoftOKLong ? 15 : 0) : (signalLineSoftOKShort ? 15 : 0)
    
    // 4) Pattern Quality (10 points max)
    maxS += 10
    if isLong
        score += patternSoftOKLong ? math.min(patternScoreLong / 2, 10) : 0
    else
        score += patternSoftOKShort ? math.min(patternScoreShort / 2, 10) : 0
    
    // 5) Star Score (15 points max)
    maxS += 15
    score += math.min(starScore * 3.0, 15)
    
    // 6) MTF Alignment (10 points max)
    maxS += 10
    score += isLong ? (mtfSoftOKLong ? 10 : 0) : (mtfSoftOKShort ? 10 : 0)
    
    // 7) Extreme Trend Bonus (10 points)
    if (isLong and extremeLong) or (not isLong and extremeShort)
        score += 10
        maxS += 10
    
    // Calculate percentage
    maxS > 0 ? (score / maxS) * 100.0 : 0.0

// Calculate quality scores
longQuality = enableFilterHarmony ? f_qualityScore(true) : 100.0
shortQuality = enableFilterHarmony ? f_qualityScore(false) : 100.0

qualityOKLong = (not enableFilterHarmony) or (longQuality >= minQualityThreshold) or extremeLong
qualityOKShort = (not enableFilterHarmony) or (shortQuality >= minQualityThreshold) or extremeShort

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 22: COOPERATIVE ROUTER GATES
// ───────────────────────────────────────────────────────────────────────────────

routerGroup = "🔀 Router System"
enableBestSideRouter = input.bool(true, "Enable Best-Side Router", group=routerGroup)
flipCooldownBars = input.int(5, "Flip Cooldown Bars", minval=1, maxval=20, group=routerGroup)
dedupeBars = input.int(3, "Dedupe Window (bars)", minval=1, maxval=10, group=routerGroup)

// Trend Regime OK (cooperative, not blocking)
trendRegimeOK = not enableTrendOnly or regimeSoftOK or isBypassLong or isBypassShort or extremeLong or extremeShort

// Bias tracking
var int biasDir = 0  // 0 = neutral, 1 = long, -1 = short
var int barsSinceLastEntry = 0
var int lastEntryDirection = 0

barsSinceLastEntry := barsSinceLastEntry + 1

// Bias strength
biasStrong = (biasDir == 1 and consecutiveBullCandles >= consecutiveCandlesRequired) or 
             (biasDir == -1 and consecutiveBearCandles >= consecutiveCandlesRequired)

// Cooperative bias lock (allows strong signals to override weak bias)
allowLongByBias = (not enableBestSideRouter) or biasDir == 0 or biasDir == 1 or
                  (isBypassLong and not biasStrong) or extremeLong

allowShortByBias = (not enableBestSideRouter) or biasDir == 0 or biasDir == -1 or
                   (isBypassShort and not biasStrong) or extremeShort

// Cooldown (cooperative)
oppCooldownOK = barsSinceLastEntry > flipCooldownBars
cooldownOK = oppCooldownOK or isBypassLong or isBypassShort or extremeLong or extremeShort

// Dedupe tracking
var int lastLongBar = -999
var int lastShortBar = -999
dedupeLongOK = (bar_index - lastLongBar) > dedupeBars
dedupeShortOK = (bar_index - lastShortBar) > dedupeBars

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 23: SCORING (A++ Grade System)
// ───────────────────────────────────────────────────────────────────────────────

scoreGroup = "📊 A++ Scoring"
minScoreToTrade = input.int(90, "A++ Score Threshold", minval=0, maxval=100, group=scoreGroup)
showGrade = input.bool(true, "Show Grade Label", group=scoreGroup)

// Regime gates
regimeLong = botEnabled and inSession and allowedToTrade and trendLong and vwapAcceptLong and atrOk and compressOk and chopOk and adxOk
regimeShort = botEnabled and inSession and allowedToTrade and trendShort and vwapAcceptShort and atrOk and compressOk and chopOk and adxOk

// A++ Score calculation
scoreTrend = (regimeLong or regimeShort) ? 50 : 0
scoreATR = atrOk ? 15 : 0
scoreCompress = compressOk ? 15 : 0
scoreChop = chopOk ? 10 : 0
scoreVol = volOk ? 10 : 0
scoreEntry = ((pullbackLong and revLong) or (pullbackShort and revShort)) ? 10 : 0
scoreAxx = (adxOk ? 5 : 0) + (spikeOk ? 5 : 0)
score = math.min(100, scoreTrend + scoreATR + scoreCompress + scoreChop + scoreVol + scoreEntry + scoreAxx)

gradeTxt = score >= 90 ? "A++" : score >= 80 ? "A+" : score >= 60 ? "B" : "NO TRADE"
allowScore = score >= minScoreToTrade

// Grade label
if showGrade and barstate.islast
    label.new(bar_index, high, expectedRoot + " " + gradeTxt + " (" + str.tostring(score) + ")",
        style=label.style_label_down, textcolor=color.white, 
        color=score >= 90 ? color.green : score >= 80 ? color.orange : color.red)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 24: DAILY LOCKOUT & STREAK PROTECTION
// ───────────────────────────────────────────────────────────────────────────────

sessTime = time(timeframe.period, lockSess)
newDay = not na(sessTime) and na(sessTime[1])

var float dayStartEquity = na
var float lastNetProfit = na
var int consecLoss = 0
var int dailyTradeCount = 0
var float dailyPnL = 0.0
var float peakEquity = na
var float maxDrawdown = 0.0

if newDay
    dayStartEquity := strategy.equity
    lastNetProfit := strategy.netprofit
    consecLoss := 0
    dailyTradeCount := 0
    dailyPnL := 0.0
    peakEquity := strategy.equity

// Update peak equity
if na(peakEquity)
    peakEquity := strategy.equity
else
    peakEquity := math.max(peakEquity, strategy.equity)

// Track drawdown
currentDrawdown = (peakEquity - strategy.equity) / peakEquity * 100
maxDrawdown := math.max(maxDrawdown, currentDrawdown)

// Track closed trades
closedTrade = strategy.closedtrades > strategy.closedtrades[1]
if closedTrade
    npNow = strategy.netprofit
    npPrev = na(lastNetProfit) ? strategy.netprofit[1] : lastNetProfit
    delta = npNow - npPrev
    consecLoss := delta < 0 ? consecLoss + 1 : 0
    dailyTradeCount := dailyTradeCount + 1
    dailyPnL := npNow - (na(dayStartEquity) ? strategy.equity : dayStartEquity)
    lastNetProfit := npNow

// Lockout conditions
dayPnL = na(dayStartEquity) ? 0.0 : (strategy.equity - dayStartEquity)
dailyLossLocked = dayPnL <= -dailyLossStop
dailyProfitReached = dayPnL >= dailyProfitTarget
streakLocked = consecLoss >= maxConsecLoss
tradeLimitReached = dailyTradeCount >= maxDailyTrades
drawdownLocked = enableDrawdownProtection and currentDrawdown >= maxDrawdownPct

lockedOut = dailyLossLocked or dailyProfitReached or streakLocked or tradeLimitReached or drawdownLocked or inNoTradeZone

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 25: PRIORITY SYSTEM (P1-P7)
// ───────────────────────────────────────────────────────────────────────────────

priorityGroup = "⭐ Priority System"
enablePrioritySystem = input.bool(true, "Enable Priority System", group=priorityGroup)
enableP1 = input.bool(true, "P1: Impulse Override", group=priorityGroup)
enableP2 = input.bool(true, "P2: Trend Override", group=priorityGroup)
enableP3 = input.bool(true, "P3: 5-Star Perfect", group=priorityGroup)
enableP4 = input.bool(true, "P4: 4-Star Strong", group=priorityGroup)
enableP5 = input.bool(true, "P5: 3-Star Standard", group=priorityGroup)
enableP6 = input.bool(true, "P6: 2-Star Basic", group=priorityGroup)
enableP7 = input.bool(true, "P7: Swing Signal", group=priorityGroup)

// Priority determination
var string priorityLabel = ""

// P1: Impulse Override (highest priority)
p1Long = enableP1 and impulseLong and trendLong and candleConfirmLong and fiveStarSoftOKLong
p1Short = enableP1 and impulseShort and trendShort and candleConfirmShort and fiveStarSoftOKShort

// P2: Strong Trend Override
p2Long = enableP2 and hasStrongTrendOverrideBull and ultraBuyCondition and candleConfirmLong and fiveStarSoftOKLong
p2Short = enableP2 and hasStrongTrendOverrideBear and ultraSellCondition and candleConfirmShort and fiveStarSoftOKShort

// P3: 5-Star Perfect Setup
p3Long = enableP3 and is5StarOnly and htfLongPerfect and candleConfirmLong and signalAllowsLong
p3Short = enableP3 and is5StarOnly and htfShortPerfect and candleConfirmShort and signalAllowsShort

// P4: 4-Star Strong Setup
p4Long = enableP4 and is4StarOnly and htfLongStrong and candleConfirmLong and signalAllowsLong
p4Short = enableP4 and is4StarOnly and htfShortStrong and candleConfirmShort and signalAllowsShort

// P5: 3-Star Standard Setup
p5Long = enableP5 and is3StarOnly and htfMultiLongAllowed and candleConfirmLong
p5Short = enableP5 and is3StarOnly and htfMultiShortAllowed and candleConfirmShort

// P6: 2-Star Basic Setup
p6Long = enableP6 and is2StarOnly and htfMultiLongAllowed and candleConfirmLong
p6Short = enableP6 and is2StarOnly and htfMultiShortAllowed and candleConfirmShort

// P7: Swing Signal
p7Long = enableP7 and swingBuySignal and candleConfirmLong and signalAllowsLong and not isSignalGrayZone
p7Short = enableP7 and swingSellSignal and candleConfirmShort and signalAllowsShort and not isSignalGrayZone

// Determine priority
priorityLong = p1Long ? "P1:IMPULSE" : p2Long ? "P2:TREND" : p3Long ? "P3:5⭐" : 
               p4Long ? "P4:4⭐" : p5Long ? "P5:3⭐" : p6Long ? "P6:2⭐" : 
               p7Long ? "P7:SWING" : "NONE"

priorityShort = p1Short ? "P1:IMPULSE" : p2Short ? "P2:TREND" : p3Short ? "P3:5⭐" : 
                p4Short ? "P4:4⭐" : p5Short ? "P5:3⭐" : p6Short ? "P6:2⭐" : 
                p7Short ? "P7:SWING" : "NONE"

hasPriorityLong = priorityLong != "NONE"
hasPriorityShort = priorityShort != "NONE"

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 26: FINAL ENTRY CONDITIONS
// ───────────────────────────────────────────────────────────────────────────────

// Base conditions
var bool canGoLong = false
var bool canGoShort = false

canGoLong := botEnabled and inSession and allowedToTrade and not lockedOut and 
             trendRegimeOK and allowLongByBias and cooldownOK and 
             qualityOKLong and longBarOK and spikeOk and 
             rsiLongOK and stochLongOK and dedupeLongOK

canGoShort := botEnabled and inSession and allowedToTrade and not lockedOut and 
              trendRegimeOK and allowShortByBias and cooldownOK and 
              qualityOKShort and shortBarOK and spikeOk and 
              rsiShortOK and stochShortOK and dedupeShortOK

// Final entry signals
enterLong = canGoLong and allowScore and regimeLong and pullbackLong and revLong and 
            strategy.position_size == 0 and 
            (not enablePrioritySystem or hasPriorityLong)

enterShort = canGoShort and allowScore and regimeShort and pullbackShort and revShort and 
             strategy.position_size == 0 and 
             (not enablePrioritySystem or hasPriorityShort)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 27: WEBHOOK JSON GENERATION
// ───────────────────────────────────────────────────────────────────────────────

webhookGroup = "📡 Webhook Settings"
acctTag = input.string("TOPSTEPX", "Account Tag", group=webhookGroup)
routeTag = input.string("TRADERSPOST", "Route Tag", group=webhookGroup)
orderType = input.string("market", "Order Type", group=webhookGroup)

jsonLong = '{"strategy":"MCL_FilterHarmony_v3","account":"' + acctTag + '","route":"' + routeTag + 
           '","ticker":"' + syminfo.ticker + '","action":"buy","orderType":"' + orderType + 
           '","quantity":' + str.tostring(qtyLong) + ',"score":' + str.tostring(score) + 
           ',"quality":' + str.tostring(math.round(longQuality)) + 
           ',"priority":"' + priorityLong + '","stars":' + str.tostring(starScore) + '}'

jsonShort = '{"strategy":"MCL_FilterHarmony_v3","account":"' + acctTag + '","route":"' + routeTag + 
            '","ticker":"' + syminfo.ticker + '","action":"sell","orderType":"' + orderType + 
            '","quantity":' + str.tostring(qtyShort) + ',"score":' + str.tostring(score) + 
            ',"quality":' + str.tostring(math.round(shortQuality)) + 
            ',"priority":"' + priorityShort + '","stars":' + str.tostring(starScore) + '}'

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 28: ENTRY EXECUTION
// ───────────────────────────────────────────────────────────────────────────────

if enterLong
    strategy.entry("L", strategy.long, qty=qtyLong, alert_message=jsonLong)
    lastLongBar := bar_index
    lastEntryDirection := 1
    biasDir := 1
    barsSinceLastEntry := 0
    priorityLabel := priorityLong

if enterShort
    strategy.entry("S", strategy.short, qty=qtyShort, alert_message=jsonShort)
    lastShortBar := bar_index
    lastEntryDirection := -1
    biasDir := -1
    barsSinceLastEntry := 0
    priorityLabel := priorityShort

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 29: EXIT SETTINGS
// ───────────────────────────────────────────────────────────────────────────────

exitGroup = "🚪 Exit Settings"
tp1R = input.float(1.0, "TP1 (R)", step=0.1, group=exitGroup)
tp2R = input.float(2.0, "TP2 (R)", step=0.1, group=exitGroup)
tp1Pct = input.int(70, "TP1 %", minval=1, maxval=100, group=exitGroup)
tp2Pct = input.int(20, "TP2 %", minval=0, maxval=100, group=exitGroup)
trailPct = input.int(10, "Runner %", minval=0, maxval=100, group=exitGroup)

// Breakeven settings
useBreakEven = input.bool(true, "Enable Break-Even", group=exitGroup)
beTriggerR = input.float(0.8, "BE Trigger (R)", step=0.1, group=exitGroup)
beOffsetTicks = input.int(1, "BE Offset Ticks", minval=0, group=exitGroup)

// Max hold time
enableMaxHold = input.bool(true, "Enable Max Hold Time", group=exitGroup)
maxHoldBars = input.int(50, "Max Hold Bars", minval=10, maxval=200, group=exitGroup)

// Apply High Win Rate multipliers
effectiveTP1R = enableHighWinRate ? tp1R * hwrQuickTPMult : tp1R
effectiveTP2R = enableHighWinRate ? tp2R * hwrQuickTPMult : tp2R
effectiveBETrigger = enableHighWinRate ? beTriggerR * 0.5 : beTriggerR

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 30: DYNAMIC STOP MANAGEMENT
// ───────────────────────────────────────────────────────────────────────────────

var float dynStopLong = na
var float dynStopShort = na
var int barsInPosition = 0
var float entryPrice = na
var float maxProfitReached = 0.0

if strategy.position_size == 0
    dynStopLong := na
    dynStopShort := na
    barsInPosition := 0
    entryPrice := na
    maxProfitReached := 0.0
else
    barsInPosition := barsInPosition + 1
    if na(entryPrice)
        entryPrice := strategy.position_avg_price

// Long position stop management
if strategy.position_size > 0
    entry = strategy.position_avg_price
    r = math.abs(entry - stopLong)
    bePrice = entry + beOffsetTicks * tick
    currentProfit = (close - entry) * pointValue * strategy.position_size
    maxProfitReached := math.max(maxProfitReached, currentProfit)
    
    if useBreakEven and high >= entry + r * effectiveBETrigger
        dynStopLong := math.max(nz(dynStopLong, stopLong), bePrice)
    else
        dynStopLong := nz(dynStopLong, stopLong)

// Short position stop management
if strategy.position_size < 0
    entry = strategy.position_avg_price
    r = math.abs(stopShort - entry)
    bePrice = entry - beOffsetTicks * tick
    currentProfit = (entry - close) * pointValue * math.abs(strategy.position_size)
    maxProfitReached := math.max(maxProfitReached, currentProfit)
    
    if useBreakEven and low <= entry - r * effectiveBETrigger
        dynStopShort := math.min(nz(dynStopShort, stopShort), bePrice)
    else
        dynStopShort := nz(dynStopShort, stopShort)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 31: EXIT EXECUTION
// ───────────────────────────────────────────────────────────────────────────────

rLong = math.abs(close - stopLong)
rShort = math.abs(stopShort - close)

tp1Long = close + rLong * effectiveTP1R
tp2Long = close + rLong * effectiveTP2R
tp1Short = close - rShort * effectiveTP1R
tp2Short = close - rShort * effectiveTP2R

// Max hold time exit
maxHoldExit = enableMaxHold and barsInPosition >= maxHoldBars

if strategy.position_size > 0
    strategy.exit("L-TP1", from_entry="L", limit=tp1Long, stop=dynStopLong, qty_percent=tp1Pct)
    strategy.exit("L-TP2", from_entry="L", limit=tp2Long, stop=dynStopLong, qty_percent=tp2Pct)
    if trailPct > 0
        strategy.exit("L-TRAIL", from_entry="L", stop=ema20, qty_percent=trailPct)
    if maxHoldExit
        strategy.close("L", comment="MAX_HOLD")

if strategy.position_size < 0
    strategy.exit("S-TP1", from_entry="S", limit=tp1Short, stop=dynStopShort, qty_percent=tp1Pct)
    strategy.exit("S-TP2", from_entry="S", limit=tp2Short, stop=dynStopShort, qty_percent=tp2Pct)
    if trailPct > 0
        strategy.exit("S-TRAIL", from_entry="S", stop=ema20, qty_percent=trailPct)
    if maxHoldExit
        strategy.close("S", comment="MAX_HOLD")

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 32: DASHBOARD
// ───────────────────────────────────────────────────────────────────────────────

showDash = input.bool(true, "Show Dashboard", group="📊 Display")

var table dash = table.new(position.top_right, 3, 15, border_width=1)

if showDash and barstate.islast
    // Header
    table.cell(dash, 0, 0, "MCL FILTER HARMONY v3", bgcolor=color.new(color.blue, 0), text_color=color.white, colspan=3)
    
    // Bot Status
    table.cell(dash, 0, 1, "BOT", text_color=color.white)
    table.cell(dash, 1, 1, botEnabled ? "ON" : "WRONG CHART", 
               bgcolor=botEnabled ? color.new(color.green, 0) : color.new(color.red, 0), 
               text_color=color.white, colspan=2)
    
    // Status
    table.cell(dash, 0, 2, "STATUS", text_color=color.white)
    table.cell(dash, 1, 2, lockedOut ? "LOCKED" : allowedToTrade ? "TREND DAY" : "NO TRADE",
               bgcolor=lockedOut ? color.new(color.red, 0) : allowedToTrade ? color.new(color.green, 80) : color.new(color.orange, 80),
               text_color=color.white, colspan=2)
    
    // Quality Scores
    table.cell(dash, 0, 3, "QUALITY", text_color=color.white)
    table.cell(dash, 1, 3, "L:" + str.tostring(math.round(longQuality)) + "%", 
               text_color=longQuality >= minQualityThreshold ? color.green : color.red)
    table.cell(dash, 2, 3, "S:" + str.tostring(math.round(shortQuality)) + "%", 
               text_color=shortQuality >= minQualityThreshold ? color.green : color.red)
    
    // Score
    table.cell(dash, 0, 4, "A++ SCORE", text_color=color.white)
    table.cell(dash, 1, 4, gradeTxt + " (" + str.tostring(score) + ")", 
               text_color=score >= 90 ? color.green : score >= 80 ? color.orange : color.red, colspan=2)
    
    // Stars
    table.cell(dash, 0, 5, "STARS", text_color=color.white)
    table.cell(dash, 1, 5, str.tostring(starScore) + "/5 ⭐", 
               text_color=starScore >= 4 ? color.green : starScore >= 3 ? color.yellow : color.red, colspan=2)
    
    // Confluence
    table.cell(dash, 0, 6, "CONFLUENCE", text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(totalConfluenceScore) + "/" + str.tostring(requiredConfluence),
               text_color=finalConfluenceOK ? color.green : color.red, colspan=2)
    
    // HTF
    table.cell(dash, 0, 7, "HTF ALIGN", text_color=color.white)
    table.cell(dash, 1, 7, str.tostring(math.round(mtf_alignment_pct)) + "%",
               text_color=mtf_alignment_pct >= mtfAlignThreshold ? color.green : color.red, colspan=2)
    
    // ADX
    table.cell(dash, 0, 8, "ADX", text_color=color.white)
    table.cell(dash, 1, 8, str.tostring(math.round(adxValue, 1)) + (adxOk ? " ✓" : " ✗"),
               text_color=adxOk ? color.green : color.red, colspan=2)
    
    // ATR
    table.cell(dash, 0, 9, "ATR", text_color=color.white)
    table.cell(dash, 1, 9, atrOk ? "EXPANDING ✓" : "FLAT ✗",
               text_color=atrOk ? color.green : color.red, colspan=2)
    
    // VWAP
    table.cell(dash, 0, 10, "VWAP", text_color=color.white)
    table.cell(dash, 1, 10, chopOk ? "CLEAN ✓" : "CHOP ✗",
               text_color=chopOk ? color.green : color.red, colspan=2)
    
    // Daily PnL
    table.cell(dash, 0, 11, "DAILY P&L", text_color=color.white)
    table.cell(dash, 1, 11, "$" + str.tostring(math.round(dayPnL)),
               text_color=dayPnL >= 0 ? color.green : color.red, colspan=2)
    
    // Trades
    table.cell(dash, 0, 12, "TRADES", text_color=color.white)
    table.cell(dash, 1, 12, str.tostring(dailyTradeCount) + "/" + str.tostring(maxDailyTrades),
               text_color=tradeLimitReached ? color.red : color.white, colspan=2)
    
    // Streak
    table.cell(dash, 0, 13, "LOSSES", text_color=color.white)
    table.cell(dash, 1, 13, str.tostring(consecLoss) + "/" + str.tostring(maxConsecLoss),
               text_color=streakLocked ? color.red : color.white, colspan=2)
    
    // Priority
    table.cell(dash, 0, 14, "PRIORITY", text_color=color.white)
    table.cell(dash, 1, 14, hasPriorityLong ? priorityLong : hasPriorityShort ? priorityShort : "NONE",
               text_color=hasPriorityLong or hasPriorityShort ? color.green : color.gray, colspan=2)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 33: VISUAL PLOTS
// ───────────────────────────────────────────────────────────────────────────────

// EMA plots
plot(ema20, "EMA20", color=color.yellow, linewidth=1)
plot(ema50, "EMA50", color=color.blue, linewidth=1)
plot(vwap, "VWAP", color=color.purple, linewidth=2)

// Quality plots
plot(enableFilterHarmony ? longQuality : na, "Long Quality %", color=color.new(color.lime, 50), linewidth=1, display=display.pane)
plot(enableFilterHarmony ? shortQuality : na, "Short Quality %", color=color.new(color.red, 50), linewidth=1, display=display.pane)

// Background
bgcolor(lockedOut ? color.new(color.red, 85) : 
        (botEnabled and allowedToTrade and allowScore) ? color.new(color.green, 92) : 
        na)

// Entry signals
plotshape(enterLong, "LONG", shape.triangleup, location.belowbar, 
          color=longQuality >= 85 ? color.green : color.lime, size=size.normal,
          text="L " + str.tostring(math.round(longQuality)) + "%")

plotshape(enterShort, "SHORT", shape.triangledown, location.abovebar, 
          color=shortQuality >= 85 ? color.red : color.maroon, size=size.normal,
          text="S " + str.tostring(math.round(shortQuality)) + "%")

// Priority labels
p1 = str.contains(priorityLabel, "P1")
p2 = str.contains(priorityLabel, "P2")
p3 = str.contains(priorityLabel, "P3")
p4 = str.contains(priorityLabel, "P4")
p5 = str.contains(priorityLabel, "P5")
p6 = str.contains(priorityLabel, "P6")
p7 = str.contains(priorityLabel, "P7")

plotshape(enterLong and p1, "P1 Long", text="P1", style=shape.labelup, location=location.belowbar, size=size.tiny, color=color.orange, textcolor=color.white)
plotshape(enterLong and p2, "P2 Long", text="P2", style=shape.labelup, location=location.belowbar, size=size.tiny, color=color.green, textcolor=color.white)
plotshape(enterLong and p3, "P3 Long", text="P3", style=shape.labelup, location=location.belowbar, size=size.tiny, color=color.blue, textcolor=color.white)
plotshape(enterShort and p1, "P1 Short", text="P1", style=shape.labeldown, location=location.abovebar, size=size.tiny, color=color.orange, textcolor=color.white)
plotshape(enterShort and p2, "P2 Short", text="P2", style=shape.labeldown, location=location.abovebar, size=size.tiny, color=color.red, textcolor=color.white)
plotshape(enterShort and p3, "P3 Short", text="P3", style=shape.labeldown, location=location.abovebar, size=size.tiny, color=color.purple, textcolor=color.white)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 34: ALERTS
// ───────────────────────────────────────────────────────────────────────────────

alertcondition(enterLong, "MCL Long Entry", "MCL LONG: {{strategy.order.alert_message}}")
alertcondition(enterShort, "MCL Short Entry", "MCL SHORT: {{strategy.order.alert_message}}")
alertcondition(lockedOut, "MCL Locked Out", "MCL BOT LOCKED - Check conditions")
alertcondition(dailyProfitReached, "MCL Daily Target Hit", "MCL Daily profit target of $" + str.tostring(dailyProfitTarget) + " reached!")

// ═══════════════════════════════════════════════════════════════════════════════
// END OF MCL FILTER HARMONY v3 BOT
// ═══════════════════════════════════════════════════════════════════════════════
