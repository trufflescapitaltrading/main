// This source code is subject to the terms of the Mozilla Public License 2.0
// © Filter Harmony v3 - MCL A++ Trend-Only Continuation Bot

//@version=6
strategy("MCL — Filter Harmony v3 [BOT]",
     overlay=true, pyramiding=0, calc_on_every_tick=false, 
     initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=4.76)

// ═══════════════════════════════════════════════════════════════════════════════
// FILTER HARMONY v3 - MCL TRADING BOT
// All filters work TOGETHER via quality scoring
// ═══════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 1: INSTRUMENT & TEST MODE
// ───────────────────────────────────────────────────────────────────────────────

guardGroup = "🔒 Instrument Guard"
expectedRoot = input.string("MCL", "Expected root symbol", group=guardGroup)
testMode = input.bool(true, "🧪 TEST MODE (bypass instrument check)", group=guardGroup, 
     tooltip="Enable for backtesting on any chart. Disable for live trading.")

isRightChart = str.contains(syminfo.ticker, expectedRoot) or str.contains(syminfo.tickerid, expectedRoot)
botEnabled = testMode or isRightChart

// Contract specs (MCL = Micro Crude)
pointValue = 100.0
tick = syminfo.mintick

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 2: MASTER SETTINGS
// ───────────────────────────────────────────────────────────────────────────────

masterGroup = "🎯 MASTER SETTINGS"
enableFilterHarmony = input.bool(true, "Enable Filter Harmony (Quality Scoring)", group=masterGroup)
minQualityThreshold = input.float(60.0, "Min Quality % for Entry", minval=30, maxval=90, step=5, group=masterGroup)
minScoreToTrade = input.int(70, "Min A++ Score to Trade", minval=0, maxval=100, step=5, group=masterGroup)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 3: TIMEFRAME & SESSION
// ───────────────────────────────────────────────────────────────────────────────

tfGroup = "📅 Timeframe & Sessions"
htfTf = input.timeframe("60", "HTF for Trend Confirmation", group=tfGroup)
useTimeFilter = input.bool(false, "Enable Session Filter", group=tfGroup)
tradeSess = input.session("0700-1500", "Trade Session", group=tfGroup)

inSession = not useTimeFilter or not na(time(timeframe.period, tradeSess))

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 4: RISK MANAGEMENT
// ───────────────────────────────────────────────────────────────────────────────

riskGroup = "💰 Risk Management"
riskPerTrade = input.float(100, "Risk Per Trade ($)", step=10, group=riskGroup)
dailyLossStop = input.float(500, "Daily Loss Limit ($)", step=50, group=riskGroup)
maxConsecLoss = input.int(3, "Max Consecutive Losses", minval=1, group=riskGroup)
maxDailyTrades = input.int(15, "Max Daily Trades", minval=1, group=riskGroup)
stopBuffTicks = input.int(2, "Stop Buffer (ticks)", minval=0, group=riskGroup)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 5: TREND INDICATORS
// ───────────────────────────────────────────────────────────────────────────────

trendGroup = "📈 Trend Settings"
emaFastLen = input.int(20, "EMA Fast", minval=5, group=trendGroup)
emaMidLen = input.int(50, "EMA Mid", minval=10, group=trendGroup)
emaSlowLen = input.int(200, "EMA Slow", minval=50, group=trendGroup)

// Calculate EMAs
ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaMidLen)
ema200 = ta.ema(close, emaSlowLen)

// HTF EMAs for trend confirmation
emaF_htf = request.security(syminfo.tickerid, htfTf, ta.ema(close, emaFastLen), barmerge.gaps_off, barmerge.lookahead_off)
emaM_htf = request.security(syminfo.tickerid, htfTf, ta.ema(close, emaMidLen), barmerge.gaps_off, barmerge.lookahead_off)
emaS_htf = request.security(syminfo.tickerid, htfTf, ta.ema(close, emaSlowLen), barmerge.gaps_off, barmerge.lookahead_off)

// Trend Detection
emaStackBull = ema20 > ema50 and ema50 > ema200
emaStackBear = ema20 < ema50 and ema50 < ema200
htfTrendBull = emaF_htf > emaM_htf and emaM_htf > emaS_htf
htfTrendBear = emaF_htf < emaM_htf and emaM_htf < emaS_htf

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 6: VWAP & VOLATILITY
// ───────────────────────────────────────────────────────────────────────────────

volGroup = "📊 Volatility"
atrLen = input.int(14, "ATR Length", minval=5, group=volGroup)
atrMult = input.float(1.0, "ATR Expansion Mult", step=0.1, group=volGroup)

// VWAP
vwap = ta.vwap(hlc3)
priceAboveVwap = close > vwap
priceBelowVwap = close < vwap

// ATR
atr = ta.atr(atrLen)
atrSma = ta.sma(atr, 50)
atrExpanding = atr > atrSma * atrMult

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 7: VOLUME ANALYSIS
// ───────────────────────────────────────────────────────────────────────────────

volSmaLen = input.int(20, "Volume SMA Length", minval=5, group=volGroup)
volSma = ta.sma(volume, volSmaLen)
volumeOK = volume > volSma * 0.5
strongVolume = volume > volSma * 1.2

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 8: ADX & MOMENTUM
// ───────────────────────────────────────────────────────────────────────────────

adxGroup = "📈 ADX & Momentum"
adxLen = input.int(14, "ADX Length", minval=5, group=adxGroup)
adxMin = input.float(20, "Min ADX", minval=10, step=1, group=adxGroup)

[diplus, diminus, adxValue] = ta.dmi(adxLen, adxLen)
adxOK = adxValue >= adxMin

// RSI
rsiLen = input.int(14, "RSI Length", minval=5, group=adxGroup)
rsi = ta.rsi(close, rsiLen)
rsiLongOK = rsi > 40 and rsi < 70
rsiShortOK = rsi > 30 and rsi < 60

// Stochastic
stochLen = input.int(14, "Stoch Length", minval=5, group=adxGroup)
stochK = ta.stoch(close, high, low, stochLen)
stochLongOK = stochK > 20 and stochK < 80
stochShortOK = stochK > 20 and stochK < 80

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 9: CANDLE ANALYSIS
// ───────────────────────────────────────────────────────────────────────────────

candleBull = close > open
candleBear = close < open
bodySize = math.abs(close - open)
totalRange = high - low
bodyRatio = totalRange > 0 ? bodySize / totalRange : 0

// Strong candles
strongBullCandle = candleBull and bodyRatio > 0.5
strongBearCandle = candleBear and bodyRatio > 0.5

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 10: PATTERN DETECTION (Simplified)
// ───────────────────────────────────────────────────────────────────────────────

// Bullish patterns
bullishEngulfing = close[1] < open[1] and close > open and close > open[1] and open < close[1]
hammer = (math.min(open, close) - low) > bodySize * 2 and (high - math.max(open, close)) < bodySize * 0.5

// Bearish patterns  
bearishEngulfing = close[1] > open[1] and close < open and close < open[1] and open > close[1]
shootingStar = (high - math.max(open, close)) > bodySize * 2 and (math.min(open, close) - low) < bodySize * 0.5

hasBullPattern = bullishEngulfing or hammer or strongBullCandle
hasBearPattern = bearishEngulfing or shootingStar or strongBearCandle

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 11: QUALITY SCORING SYSTEM (0-100)
// ───────────────────────────────────────────────────────────────────────────────

// Calculate quality score for entries
f_calcQuality(isLong) =>
    float score = 0.0
    
    // Trend alignment (40 points max)
    if isLong
        score += emaStackBull ? 20 : (ema20 > ema50 ? 10 : 0)
        score += htfTrendBull ? 20 : (emaF_htf > emaM_htf ? 10 : 0)
    else
        score += emaStackBear ? 20 : (ema20 < ema50 ? 10 : 0)
        score += htfTrendBear ? 20 : (emaF_htf < emaM_htf ? 10 : 0)
    
    // VWAP alignment (15 points)
    if isLong
        score += priceAboveVwap ? 15 : 0
    else
        score += priceBelowVwap ? 15 : 0
    
    // Volume (15 points)
    score += strongVolume ? 15 : (volumeOK ? 10 : 0)
    
    // ADX trend strength (15 points)
    score += adxOK ? 15 : (adxValue > 15 ? 8 : 0)
    
    // Pattern (15 points)
    if isLong
        score += hasBullPattern ? 15 : (candleBull ? 8 : 0)
    else
        score += hasBearPattern ? 15 : (candleBear ? 8 : 0)
    
    math.min(score, 100)

longQuality = f_calcQuality(true)
shortQuality = f_calcQuality(false)

qualityOKLong = longQuality >= minQualityThreshold
qualityOKShort = shortQuality >= minQualityThreshold

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 12: A++ SCORING (Simplified)
// ───────────────────────────────────────────────────────────────────────────────

scoreTrend = (emaStackBull or emaStackBear) ? 30 : (ema20 > ema50 or ema20 < ema50) ? 15 : 0
scoreHTF = (htfTrendBull or htfTrendBear) ? 20 : 10
scoreVWAP = (priceAboveVwap and candleBull) or (priceBelowVwap and candleBear) ? 15 : 5
scoreVol = strongVolume ? 15 : volumeOK ? 10 : 0
scoreADX = adxOK ? 10 : 5
scoreATR = atrExpanding ? 10 : 5

totalScore = scoreTrend + scoreHTF + scoreVWAP + scoreVol + scoreADX + scoreATR
gradeTxt = totalScore >= 90 ? "A++" : totalScore >= 80 ? "A+" : totalScore >= 70 ? "A" : totalScore >= 60 ? "B" : "C"
scoreOK = totalScore >= minScoreToTrade

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 13: ENTRY SIGNALS
// ───────────────────────────────────────────────────────────────────────────────

// Simple trend-following entries
basicLongSignal = ema20 > ema50 and close > ema20 and candleBull
basicShortSignal = ema20 < ema50 and close < ema20 and candleBear

// Quality-filtered entries
qualityLongSignal = basicLongSignal and qualityOKLong
qualityShortSignal = basicShortSignal and qualityOKShort

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 14: STOPS & TARGETS
// ───────────────────────────────────────────────────────────────────────────────

// Pivot-based stops
swingLow = ta.lowest(low, 10)
swingHigh = ta.highest(high, 10)

stopLong = swingLow - stopBuffTicks * tick
stopShort = swingHigh + stopBuffTicks * tick

// Risk-based position sizing
riskPerContractLong = math.max(math.abs(close - stopLong) * pointValue, 1)
riskPerContractShort = math.max(math.abs(stopShort - close) * pointValue, 1)
qtyLong = math.max(1, math.floor(riskPerTrade / riskPerContractLong))
qtyShort = math.max(1, math.floor(riskPerTrade / riskPerContractShort))

// Targets (R-based)
tp1Mult = input.float(1.0, "TP1 (R-multiple)", minval=0.5, step=0.1, group=riskGroup)
tp2Mult = input.float(2.0, "TP2 (R-multiple)", minval=1.0, step=0.1, group=riskGroup)
tp1Pct = input.int(70, "TP1 Exit %", minval=10, maxval=100, group=riskGroup)
tp2Pct = input.int(30, "TP2 Exit %", minval=0, maxval=90, group=riskGroup)

rLong = math.abs(close - stopLong)
rShort = math.abs(stopShort - close)

tp1Long = close + rLong * tp1Mult
tp2Long = close + rLong * tp2Mult
tp1Short = close - rShort * tp1Mult
tp2Short = close - rShort * tp2Mult

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 15: DAILY TRACKING
// ───────────────────────────────────────────────────────────────────────────────

var float dayStartEquity = strategy.equity
var int consecLosses = 0
var int dailyTrades = 0

// Reset on new day (ta.change returns float, need bool comparison)
newDay = ta.change(time("D")) != 0
if newDay
    dayStartEquity := strategy.equity
    consecLosses := 0
    dailyTrades := 0

// Track closed trades
if strategy.closedtrades > strategy.closedtrades[1]
    lastTradeProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastTradeProfit < 0
        consecLosses := consecLosses + 1
    else
        consecLosses := 0
    dailyTrades := dailyTrades + 1

dayPnL = strategy.equity - dayStartEquity
dailyLossLocked = dayPnL <= -dailyLossStop
streakLocked = consecLosses >= maxConsecLoss
tradeLimitReached = dailyTrades >= maxDailyTrades
lockedOut = dailyLossLocked or streakLocked or tradeLimitReached

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 16: FINAL ENTRY CONDITIONS
// ───────────────────────────────────────────────────────────────────────────────

// Entry conditions - simplified and working
canTrade = botEnabled and inSession and not lockedOut and strategy.position_size == 0

enterLong = canTrade and qualityLongSignal and scoreOK and rsiLongOK
enterShort = canTrade and qualityShortSignal and scoreOK and rsiShortOK

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 17: EXECUTE TRADES
// ───────────────────────────────────────────────────────────────────────────────

// JSON for webhooks
jsonLong = '{"action":"buy","ticker":"' + syminfo.ticker + '","qty":' + str.tostring(qtyLong) + ',"score":' + str.tostring(totalScore) + ',"quality":' + str.tostring(math.round(longQuality)) + '}'
jsonShort = '{"action":"sell","ticker":"' + syminfo.ticker + '","qty":' + str.tostring(qtyShort) + ',"score":' + str.tostring(totalScore) + ',"quality":' + str.tostring(math.round(shortQuality)) + '}'

if enterLong
    strategy.entry("Long", strategy.long, qty=qtyLong, alert_message=jsonLong)

if enterShort
    strategy.entry("Short", strategy.short, qty=qtyShort, alert_message=jsonShort)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 18: EXIT MANAGEMENT
// ───────────────────────────────────────────────────────────────────────────────

if strategy.position_size > 0
    strategy.exit("TP1-L", from_entry="Long", limit=tp1Long, stop=stopLong, qty_percent=tp1Pct)
    strategy.exit("TP2-L", from_entry="Long", limit=tp2Long, stop=stopLong, qty_percent=tp2Pct)

if strategy.position_size < 0
    strategy.exit("TP1-S", from_entry="Short", limit=tp1Short, stop=stopShort, qty_percent=tp1Pct)
    strategy.exit("TP2-S", from_entry="Short", limit=tp2Short, stop=stopShort, qty_percent=tp2Pct)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 19: DASHBOARD
// ───────────────────────────────────────────────────────────────────────────────

showDash = input.bool(true, "Show Dashboard", group="📊 Display")

var table dash = table.new(position.top_right, 2, 12, border_width=1)

if showDash and barstate.islast
    table.cell(dash, 0, 0, "HARMONY v3", bgcolor=color.blue, text_color=color.white)
    table.cell(dash, 1, 0, botEnabled ? "ACTIVE" : "OFF", bgcolor=botEnabled ? color.green : color.red, text_color=color.white)
    
    table.cell(dash, 0, 1, "STATUS", text_color=color.white)
    table.cell(dash, 1, 1, lockedOut ? "LOCKED" : "READY", bgcolor=lockedOut ? color.red : color.green, text_color=color.white)
    
    table.cell(dash, 0, 2, "QUALITY L", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(math.round(longQuality)) + "%", text_color=qualityOKLong ? color.green : color.red)
    
    table.cell(dash, 0, 3, "QUALITY S", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(math.round(shortQuality)) + "%", text_color=qualityOKShort ? color.green : color.red)
    
    table.cell(dash, 0, 4, "SCORE", text_color=color.white)
    table.cell(dash, 1, 4, gradeTxt + " (" + str.tostring(totalScore) + ")", text_color=scoreOK ? color.green : color.orange)
    
    table.cell(dash, 0, 5, "TREND", text_color=color.white)
    table.cell(dash, 1, 5, emaStackBull ? "BULL" : emaStackBear ? "BEAR" : "NONE", text_color=emaStackBull ? color.green : emaStackBear ? color.red : color.gray)
    
    table.cell(dash, 0, 6, "ADX", text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(math.round(adxValue, 1)), text_color=adxOK ? color.green : color.red)
    
    table.cell(dash, 0, 7, "RSI", text_color=color.white)
    table.cell(dash, 1, 7, str.tostring(math.round(rsi, 1)), text_color=color.white)
    
    table.cell(dash, 0, 8, "DAILY P&L", text_color=color.white)
    table.cell(dash, 1, 8, "$" + str.tostring(math.round(dayPnL)), text_color=dayPnL >= 0 ? color.green : color.red)
    
    table.cell(dash, 0, 9, "TRADES", text_color=color.white)
    table.cell(dash, 1, 9, str.tostring(dailyTrades) + "/" + str.tostring(maxDailyTrades), text_color=color.white)
    
    table.cell(dash, 0, 10, "LOSSES", text_color=color.white)
    table.cell(dash, 1, 10, str.tostring(consecLosses) + "/" + str.tostring(maxConsecLoss), text_color=consecLosses > 0 ? color.orange : color.white)
    
    table.cell(dash, 0, 11, "POSITION", text_color=color.white)
    table.cell(dash, 1, 11, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", 
               text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 20: PLOTS
// ───────────────────────────────────────────────────────────────────────────────

plot(ema20, "EMA20", color=color.yellow, linewidth=1)
plot(ema50, "EMA50", color=color.blue, linewidth=1)
plot(ema200, "EMA200", color=color.white, linewidth=1)
plot(vwap, "VWAP", color=color.purple, linewidth=2)

// Entry markers
plotshape(enterLong, "Long Entry", shape.triangleup, location.belowbar, color=color.green, size=size.normal, text="BUY")
plotshape(enterShort, "Short Entry", shape.triangledown, location.abovebar, color=color.red, size=size.normal, text="SELL")

// Background
bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : strategy.position_size < 0 ? color.new(color.red, 90) : na)

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 21: ALERTS
// ───────────────────────────────────────────────────────────────────────────────

if enterLong
    alert(jsonLong, alert.freq_once_per_bar_close)

if enterShort
    alert(jsonShort, alert.freq_once_per_bar_close)

if lockedOut and not lockedOut[1]
    alert("BOT LOCKED - P&L: $" + str.tostring(math.round(dayPnL)) + " | Losses: " + str.tostring(consecLosses), alert.freq_once_per_bar)
