plot(longQualityScore, "Long Quality Score", color=color.new(color.lime, 80), display=display.data_window)
plot(shortQualityScore, "Short Quality Score", color=color.new(color.red, 80), display=display.data_window)
plot(consecutiveGreen, "Consecutive Green", color=color.new(color.lime, 80), display=display.data_window)
plot(consecutiveRed, "Consecutive Red", color=color.new(color.red, 80), display=display.data_window)
plot(mtfBullAlignment, "MTF Bull Alignment %", color=color.new(color.green, 80), display=display.data_window)
plot(mtfBearAlignment, "MTF Bear Alignment %", color=color.new(color.orange, 80), display=display.data_window)
plot(grayZoneFactors, "Gray Zone Factors", color=color.new(color.gray, 80), display=display.data_window)
plot(currentWinRate, "Win Rate %", color=color.new(color.lime, 80), display=display.data_window)
plot(profitFactor, "Profit Factor", color=color.new(color.yellow, 80), display=display.data_window)
plot(currentProfit, "Current Profit $", color=color.new(color.green, 80), display=display.data_window)
plot(holdingPeriod, "Holding Period", color=color.new(color.purple, 80), display=display.data_window)
