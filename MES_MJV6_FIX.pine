// ==================== ✅ MES PROFIT LOGIC (FIXED - EXACT MJV6 LOGIC) ====================
// This section REPLACES the complex MES MJV6 section in your original script
// The key is to use the SIMPLE, PROVEN MJV6 profit ladder without extra adjustments

// REMOVE these complex input parameters from the mesProfitGroup:
// - mesMJV6HighWinProtect
// - mesMJV6TPScale  
// - mesMJV6BETriggerPct
// - mesMJV6BEUseFees
// - mesMJV6TrailActivationRatio

// REPLACE the entire MES MJV6 profit block with this simple version:

if not v20Active_profit and isMES and useMJV6MesProfitLogic and strategy.position_size != 0
    // Use simple ATR (exactly like MJV6 reference)
    float mjvAtr = ta.atr(10)
    
    // Simple TP/SL distances (exactly like MJV6 reference)
    float futuresTPDistance_mjv = mjvAtr * tpMultiplier
    float ultraQuickTP_mjv = mjvAtr * (tpMultiplier * 0.5)
    float futuresStopDistance_mjv = mjvAtr * (is1min ? 1.2 : is2min ? 1.3 : is3min ? 1.4 : is5min ? 1.6 : 1.6)
    
    float entryPrice_mjv = not na(entryPrice) ? entryPrice : strategy.position_avg_price
    
    // ---- LONG POSITION ----
    if strategy.position_size > 0 and not exitIssuedThisBar
        float stopLoss_mjv = entryPrice_mjv - futuresStopDistance_mjv
        
        if useTP and useEnhancedTP
            // EXACT MJV6 TP ladder - 60/25/10/5 split
            int tp1Points = math.round((ultraQuickTP_mjv * 0.4) / syminfo.mintick)
            int tp2Points = math.round((futuresTPDistance_mjv * 0.3) / syminfo.mintick)
            int tp3Points = math.round((futuresTPDistance_mjv * 0.6) / syminfo.mintick)
            int tp4Points = math.round((futuresTPDistance_mjv * 1.0) / syminfo.mintick)
            
            strategy.exit("MJV6_TP1_L", from_entry="LONG", qty_percent=60, profit=tp1Points)
            strategy.exit("MJV6_TP2_L", from_entry="LONG", qty_percent=25, profit=tp2Points)
            strategy.exit("MJV6_TP3_L", from_entry="LONG", qty_percent=10, profit=tp3Points)
            strategy.exit("MJV6_TP4_L", from_entry="LONG", qty_percent=5, profit=tp4Points)
        
        // Time-based exit (exactly like MJV6)
        if quickExitMode and holdingPeriod >= maxHoldingBars
            strategy.close("LONG", comment="MJV6_TIME_EXIT_LONG")
            exitIssuedThisBar := true
            lastExitReason := "MJV6_TIME_EXIT"
        
        // Smart trailing OR stop loss (exactly like MJV6)
        if useSL and not exitIssuedThisBar
            if useSmartTrailing and close > entryPrice_mjv + (futuresTPDistance_mjv * trailActivationRatio)
                float trailDistance = mjvAtr * 0.6
                strategy.exit("MJV6_TRAIL_L", from_entry="LONG", stop=close - trailDistance)
            else
                strategy.exit("MJV6_SL_L", from_entry="LONG", stop=stopLoss_mjv)
    
    // ---- SHORT POSITION ----
    if strategy.position_size < 0 and not exitIssuedThisBar
        float stopLoss_mjv = entryPrice_mjv + futuresStopDistance_mjv
        
        if useTP and useEnhancedTP
            // EXACT MJV6 TP ladder for shorts
            int tp1Points = math.round((ultraQuickTP_mjv * 0.5) / syminfo.mintick)
            int tp2Points = math.round((futuresTPDistance_mjv * 0.4) / syminfo.mintick)
            int tp3Points = math.round((futuresTPDistance_mjv * 0.7) / syminfo.mintick)
            int tp4Points = math.round((futuresTPDistance_mjv * 1.1) / syminfo.mintick)
            
            strategy.exit("MJV6_TP1_S", from_entry="SHORT", qty_percent=60, profit=tp1Points)
            strategy.exit("MJV6_TP2_S", from_entry="SHORT", qty_percent=25, profit=tp2Points)
            strategy.exit("MJV6_TP3_S", from_entry="SHORT", qty_percent=10, profit=tp3Points)
            strategy.exit("MJV6_TP4_S", from_entry="SHORT", qty_percent=5, profit=tp4Points)
        
        // Time-based exit
        if quickExitMode and holdingPeriod >= maxHoldingBars
            strategy.close("SHORT", comment="MJV6_TIME_EXIT_SHORT")
            exitIssuedThisBar := true
            lastExitReason := "MJV6_TIME_EXIT"
        
        // Smart trailing OR stop loss
        if useSL and not exitIssuedThisBar
            if useSmartTrailing and close < entryPrice_mjv - (futuresTPDistance_mjv * trailActivationRatio)
                float trailDistance = mjvAtr * 0.6
                strategy.exit("MJV6_TRAIL_S", from_entry="SHORT", stop=close + trailDistance)
            else
                strategy.exit("MJV6_SL_S", from_entry="SHORT", stop=stopLoss_mjv)


// ==================== KEY CHANGES SUMMARY ====================
// 1. REMOVED: mesMJV6HighWinProtect adjustments
// 2. REMOVED: mesMJV6TPScale modifications  
// 3. REMOVED: Complex BE offset calculations
// 4. REMOVED: Multiple conditional stop price adjustments
// 5. KEPT: Simple ATR-based TP ladder (60/25/10/5)
// 6. KEPT: Simple trailing stop at ATR * 0.6
// 7. KEPT: Time-based exit after maxHoldingBars
// 8. KEPT: Simple stop loss = entry - (ATR * timeframe multiplier)

// The MJV6 reference script produced $20,178 on MES 3m and $44,592 on MES 5m
// because it uses this SIMPLE, CLEAN profit logic without over-optimization
