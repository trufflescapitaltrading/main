//@version=5
strategy("MNQ/MES 3m/5m Trend Catcher (24/7 + No Dojis + Early P1/P2 + TradersPost Bracket)", overlay=true, initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, calc_on_every_tick=true, process_orders_on_close=false)

// ==================== TradersPost / Contract Routing ====================
tpGroup = "TradersPost"
enableTradersPostAlerts = input.bool(true, "Enable TradersPost alerts", group=tpGroup)
tpStrategyName = input.string("V16_STRICT_DIRECTION", "TradersPost: strategy name", group=tpGroup)
tpInstanceTag = input.string("AUTO", "TradersPost: instance tag", group=tpGroup, tooltip="Used to match alerts to fills. Set to e.g. TLMNQ_3m, TLmnq_5m, TLMES_3m, TLmes_5m. AUTO uses TL tag.")
tpNumericFormat = input.string("strings", "TradersPost: numeric format", options=["strings", "numbers"], group=tpGroup)

tradersPostSymbolMNQ = input.string("MNQH2026", "MNQ contract ticker", group=tpGroup)
tradersPostSymbolMES = input.string("MESH2026", "MES contract ticker", group=tpGroup)

tpNum(x) =>
    tpNumericFormat == "numbers" ? str.tostring(x) : '"' + str.tostring(x) + '"'
tpNumInt(x) =>
    tpNumericFormat == "numbers" ? str.tostring(x) : '"' + str.tostring(x) + '"'

// ==================== Instrument / Tag ====================
isMNQ = syminfo.root == "MNQ"
isMES = syminfo.root == "MES"
tf = timeframe.period

tpInstTag =
     isMNQ ? (tf == "3" ? "TLMNQ" : "TLmnq") :
     isMES ? (tf == "3" ? "TLMES" : "TLmes") :
     "TLUNK"

actualTicker = isMNQ ? tradersPostSymbolMNQ : isMES ? tradersPostSymbolMES : syminfo.ticker
instTag = tpInstanceTag == "AUTO" ? tpInstTag : tpInstanceTag

// ==================== 24/7 + Session Labels (labels only) ====================
sessGroup = "Sessions (labels only)"
allow24x7 = input.bool(true, "Trade 24/7 (ignore session gate)", group=sessGroup)
tz = input.string(syminfo.timezone, "Session timezone", group=sessGroup)

inNY     = not na(time(tf, "0830-1500", tz))
inLondon = not na(time(tf, "0200-0500", tz))
inUAE    = not na(time(tf, "2000-2300", tz))
inAsia   = not na(time(tf, "1700-2000", tz))

sessTag = inNY ? "NY" : inLondon ? "LONDON" : inUAE ? "UAE" : inAsia ? "ASIA" : "OFF"
tradeAllowed = allow24x7 ? true : (inNY or inLondon or inUAE or inAsia)

// ==================== Candle Filters (NO dojis, enforce direction) ====================
rng = high - low
body = math.abs(close - open)
dojiMax = input.float(0.20, "Doji max body/range", minval=0.05, maxval=0.40, step=0.01)
isDoji = rng > 0 and (body / rng) <= dojiMax

bull = close > open
bear = close < open

allowSignal = tradeAllowed and not isDoji
longOK = allowSignal and bull
shortOK = allowSignal and bear

// ==================== Consecutive Candle Counters ====================
var int upCount = 0
var int dnCount = 0
if bull
    upCount += 1
    dnCount := 0
else if bear
    dnCount += 1
    upCount := 0
else
    upCount := 0
    dnCount := 0

// ==================== Displacement Thresholds (ticks) ====================
tick = syminfo.mintick
mnqMinTicks_5m = input.int(20, "MNQ 5m min ticks (P2)", minval=1)
mnqMinTicks_3m = input.int(14, "MNQ 3m min ticks (P2)", minval=1)
mesMinTicks_5m = input.int(8, "MES 5m min ticks (P2)", minval=1)
mesMinTicks_3m = input.int(6, "MES 3m min ticks (P2)", minval=1)

minTicks =
     isMNQ ? (tf == "3" ? mnqMinTicks_3m : mnqMinTicks_5m) :
     isMES ? (tf == "3" ? mesMinTicks_3m : mesMinTicks_5m) :
     10

// ==================== P1 Ignition (early only) ====================
strongBodyMin = input.float(0.55, "P1 min body/range", minval=0.30, maxval=0.90, step=0.01)
bodyStrong = rng > 0 and (body / rng) >= strongBodyMin
breakUp = close > high[1]
breakDn = close < low[1]

p1Long = longOK and bodyStrong and breakUp and upCount <= 2
p1Short = shortOK and bodyStrong and breakDn and dnCount <= 2

// ==================== P2 Trend (EARLY: candle 2 or 3 only) ====================
moveUpTicks = upCount == 2 ? ((close - open[1]) / tick) : upCount == 3 ? ((close - open[2]) / tick) : 0.0
moveDnTicks = dnCount == 2 ? ((open[1] - close) / tick) : dnCount == 3 ? ((open[2] - close) / tick) : 0.0

p2Long = longOK and (upCount == 2 or upCount == 3) and moveUpTicks >= minTicks
p2Short = shortOK and (dnCount == 2 or dnCount == 3) and moveDnTicks >= minTicks

// ==================== SL/TP (points) ====================
slGroup = "Stops/Targets"
mnqSL_pts_3m = input.float(50.0, "MNQ 3m stop (points)", group=slGroup)
mnqTP_pts_3m = input.float(45.0, "MNQ 3m target (points)", group=slGroup)
mnqSL_pts_5m = input.float(60.0, "MNQ 5m stop (points)", group=slGroup)
mnqTP_pts_5m = input.float(60.0, "MNQ 5m target (points)", group=slGroup)
mesSL_pts_3m = input.float(14.0, "MES 3m stop (points)", group=slGroup)
mesTP_pts_3m = input.float(18.0, "MES 3m target (points)", group=slGroup)
mesSL_pts_5m = input.float(14.0, "MES 5m stop (points)", group=slGroup)
mesTP_pts_5m = input.float(18.0, "MES 5m target (points)", group=slGroup)

is3m = tf == "3"
is5m = tf == "5"

curSL = isMNQ ? (is3m ? mnqSL_pts_3m : mnqSL_pts_5m) : isMES ? (is3m ? mesSL_pts_3m : mesSL_pts_5m) : na
curTP = isMNQ ? (is3m ? mnqTP_pts_3m : mnqTP_pts_5m) : isMES ? (is3m ? mesTP_pts_3m : mesTP_pts_5m) : na

// ==================== Alert Payloads (bracket schema) ====================
mkEntryPayload(side, limitPx, slPx, tpPx, tradeId, setup) =>
    '{' +
    '"ticker":"' + actualTicker + '",' +
    '"action":"' + side + '",' +
    '"quantity":' + tpNumInt(1) + ',' +
    '"orderType":"limit",' +
    '"limit":' + tpNum(limitPx) + ',' +
    '"takeProfit":{"limitPrice":' + tpNum(tpPx) + '},' +
    '"stopLoss":{"stopPrice":' + tpNum(slPx) + '},' +
    '"trade_id":"' + tradeId + '",' +
    '"instance":"' + instTag + '",' +
    '"session":"' + sessTag + '",' +
    '"setup":"' + setup + '",' +
    '"strategy":"' + tpStrategyName + '",' +
    '"timeframe":"' + tf + '",' +
    '"instrument":"' + syminfo.root + '",' +
    '"timestamp":"' + str.tostring(time) + '"' +
    '}'

// ==================== Strategy + alert() dispatch (once per bar close) ====================
onClose = barstate.isconfirmed

// Only run on MNQ/MES 3m/5m
okChart = (isMNQ or isMES) and (is3m or is5m)

if okChart and onClose
    if strategy.position_size == 0
        // P1 has priority over P2
        if p1Long
            entryPx = close
            slPx = entryPx - curSL
            tpPx = entryPx + curTP
            tradeId = str.tostring(time) + "_" + str.tostring(bar_index) + "_P1_LONG"
            strategy.entry("LONG", strategy.long, comment="P1_LONG")
            if enableTradersPostAlerts
                alert(mkEntryPayload("buy", entryPx, slPx, tpPx, tradeId, "P1"), alert.freq_once_per_bar_close)
        else if p1Short
            entryPx = close
            slPx = entryPx + curSL
            tpPx = entryPx - curTP
            tradeId = str.tostring(time) + "_" + str.tostring(bar_index) + "_P1_SHORT"
            strategy.entry("SHORT", strategy.short, comment="P1_SHORT")
            if enableTradersPostAlerts
                alert(mkEntryPayload("sell", entryPx, slPx, tpPx, tradeId, "P1"), alert.freq_once_per_bar_close)
        else if p2Long
            entryPx = close
            slPx = entryPx - curSL
            tpPx = entryPx + curTP
            tradeId = str.tostring(time) + "_" + str.tostring(bar_index) + "_P2_LONG"
            strategy.entry("LONG", strategy.long, comment="P2_LONG")
            if enableTradersPostAlerts
                alert(mkEntryPayload("buy", entryPx, slPx, tpPx, tradeId, "P2"), alert.freq_once_per_bar_close)
        else if p2Short
            entryPx = close
            slPx = entryPx + curSL
            tpPx = entryPx - curTP
            tradeId = str.tostring(time) + "_" + str.tostring(bar_index) + "_P2_SHORT"
            strategy.entry("SHORT", strategy.short, comment="P2_SHORT")
            if enableTradersPostAlerts
                alert(mkEntryPayload("sell", entryPx, slPx, tpPx, tradeId, "P2"), alert.freq_once_per_bar_close)

// Visuals
plotchar(p1Long, "P1 LONG", "P1L", location.belowbar, color=color.new(color.green, 0))
plotchar(p1Short, "P1 SHORT", "P1S", location.abovebar, color=color.new(color.red, 0))
plotchar(p2Long, "P2 LONG", "P2L", location.belowbar, color=color.new(color.lime, 0))
plotchar(p2Short, "P2 SHORT", "P2S", location.abovebar, color=color.new(color.orange, 0))
