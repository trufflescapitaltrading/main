    activeSignalType := "NONE"
getActiveQty(baseQty) =>
    int qty = baseQty
    if isMES and mes_useCustom
        qty := mes_customQty
    else if isMNQ and mnq_useCustom
        qty := mnq_customQty
    else if isMYM and mym_useCustom
        qty := mym_customQty
    else if isMCL and mcl_useCustom
        qty := mcl_customQty
    else if isMGC and mgc_useCustom
        qty := mgc_customQty
    else if isM2K and m2k_useCustom
        qty := m2k_customQty
    qty
bool allowEntryLong = true
if require5Star and not fiveStarOK and not hasStrongTrendOverrideBull and not (impulseLong and candleBull) and not hasMomentumOverrideLong
    allowEntryLong := false
if longCondition and strategy.position_size == 0 and allowEntryLong and finalContractQty > 0
    if enableBestSideRouter and not bypassLong and not bypassShort
        biasDir := 1
        biasLockUntilBar := bar_index + biasLockBars
        lastOppositeEntryBar := bar_index
    int tradeQty = getActiveQty(finalContractQty)
    if not alertOnlyMode
        strategy.entry("LONG", strategy.long, qty=tradeQty, comment="LONG " + activeSignalType + " " + selectedPriority)
        tookTradeThisBar := true
        lastLongSignalBar := bar_index
bool allowEntryShort = true
if require5Star and not fiveStarOK and not hasStrongTrendOverrideBear and not (impulseShort and candleBear) and not hasMomentumOverrideShort
    allowEntryShort := false
if shortCondition and strategy.position_size == 0 and allowEntryShort and finalContractQty > 0
    if enableBestSideRouter and not bypassLong and not bypassShort
        biasDir := -1
        biasLockUntilBar := bar_index + biasLockBars
        lastOppositeEntryBar := bar_index
    int tradeQtyS = getActiveQty(finalContractQty)
    if not alertOnlyMode
        strategy.entry("SHORT", strategy.short, qty=tradeQtyS, comment="SHORT " + activeSignalType + " " + selectedPriority)
        tookTradeThisBar := true
        lastShortSignalBar := bar_index
// ==================== 🔥 PROFIT SYSTEM (60/25/10/5) ====================
// V71 High-win-rate optimizations:
// - Single contract targets TP1 (not TP2) to lift win-rate
// - Optional BE-after-TP1 protection for remaining size
// - Adaptive trailing stop after partial profit
// - Time-decay profit lock for extended holds
// - Momentum-fade early exit system
// - Quick scalp exit for fast profits
// V71: Calculate current volatility adjustment factor
v71_currentVolRatio = atrMain / ta.sma(atrMain, 20)
v71_volAdjust = enableVolatilityAdjustedExits ? (v71_currentVolRatio > 1.2 ? volAdjustFactor : 1.0) : 1.0
// V71: Strict entry filter check (applies to entry quality tracking)
v71_strictEntryOK = not enableStrictEntryFilter or (adxValue >= minADXForEntry and rsi >= minRSIRangeLow and rsi <= minRSIRangeHigh)
if strategy.position_size > 0
    localEntryPrice = strategy.position_avg_price
    bool is3m_chart = is3min
    // Multipliers for high win rate on MNQ 5m/3m
    bool isMnq5m = isMNQ and (is5min or is3min)
    float tpMult = (highWinRateMode and isMnq5m) ? quickTPMultiplier * v71_volAdjust : v71_volAdjust
    float slMult = (highWinRateMode and isMnq5m) ? widerSLMultiplier : 1.0
    float baseSL = isMES ? mes_customSL : (is3m_chart ? mnq_customSL_3m : mnq_customSL)
    float baseTP1 = isMES ? mes_customTP : (is3m_chart ? mnq_customTP1_3m : mnq_customTP1)
    float baseTP2 = isMES ? mes_customTP * 1.5 : (is3m_chart ? mnq_customTP2_3m : mnq_customTP2)
    float baseTP3 = isMES ? mes_customTP * 2.5 : (is3m_chart ? mnq_customTP3_3m : mnq_customTP3)
    float baseTP4 = isMES ? mes_customTP * 4.0 : (is3m_chart ? mnq_customTP4_3m : mnq_customTP4)
    float currentSL = baseSL * slMult
    float currentTP1 = baseTP1 * tpMult
    float currentTP2 = baseTP2 * tpMult
    float currentTP3 = baseTP3 * tpMult
    float currentTP4 = baseTP4 * tpMult
    
    // V71: Store TP1 target for adaptive systems
    v71_tp1Target := currentTP1
    
    // V71: Track profit in bars
    currentProfitPts = close - localEntryPrice
    if currentProfitPts > 0
        v71_profitBarsCount := v71_profitBarsCount + 1
    else
        v71_profitBarsCount := 0
    
    // V71: Track max profit for trailing
    if currentProfitPts > v71_maxProfitSeen
        v71_maxProfitSeen := currentProfitPts
    // Detect TP1 tag (for BE protection)
    if not tp1Hit and high >= localEntryPrice + currentTP1
        tp1Hit := true
    // BE stop (optionally includes estimated fees/slippage)
    float beOffsetPoints = 0.0
    if beAfterTP1UseFees
        oneWayFees = commissionPerContract + extraFeesPerContract
        roundTripFees = oneWayFees * 2
        slipPts = slippageTicksOneWay * syminfo.mintick
        beOffsetPoints := (roundTripFees / syminfo.pointvalue) + slipPts
    localStopLoss = localEntryPrice - currentSL
    localBEStop = localEntryPrice + beOffsetPoints
    
    // V71: Adaptive Trailing Stop System
    v71_trailingActivationLevel = currentTP1 * (trailingActivationPct / 100.0)
    if enableAdaptiveTrailing and currentProfitPts >= v71_trailingActivationLevel
        v71_trailingActive := true
        // Trail from the max profit seen, stepping back by trailingStepPct
        v71_newTrailingStop = localEntryPrice + v71_maxProfitSeen * (1.0 - trailingStepPct / 100.0)
        if na(v71_trailingStop) or v71_newTrailingStop > v71_trailingStop
            v71_trailingStop := v71_newTrailingStop
    
    // V71: Time-Decay Profit Lock
    v71_profitLockLevel = currentTP1 * (profitLockMinPct / 100.0)
    if enableTimeProfitLock and v71_profitBarsCount >= profitLockBars and currentProfitPts >= v71_profitLockLevel
        v71_profitLockActive := true
        v71_lockedProfitLevel := localEntryPrice + currentProfitPts * (profitLockKeepPct / 100.0)
    
    // V71: Determine best stop to use
    float v71_bestStop = localStopLoss
    if (enableBEAfterTP1 or (highWinRateMode and isMnq5m)) and tp1Hit
        v71_bestStop := localBEStop
    if v71_trailingActive and not na(v71_trailingStop) and v71_trailingStop > v71_bestStop
        v71_bestStop := v71_trailingStop
    if v71_profitLockActive and not na(v71_lockedProfitLevel) and v71_lockedProfitLevel > v71_bestStop
        v71_bestStop := v71_lockedProfitLevel
    
    float activeStop = v71_bestStop
    tp1Ticks = math.round(currentTP1 / syminfo.mintick)
    tp2Ticks = math.round(currentTP2 / syminfo.mintick)
    tp3Ticks = math.round(currentTP3 / syminfo.mintick)
    tp4Ticks = math.round(currentTP4 / syminfo.mintick)
    // V71: Quick Scalp Exit - take profit quickly on fast moves
    v71_quickScalpLevel = currentTP1 * (quickScalpProfitPct / 100.0)
    v71_quickScalpTicks = math.round(v71_quickScalpLevel / syminfo.mintick)
    bool v71_useQuickScalp = enableQuickScalpExit and holdingPeriod <= quickScalpBars and highWinRateMode
    if math.abs(strategy.position_size) == 1
        // Single Contract Mode: for MNQ 5m high win rate, take TP1 (or quick scalp)
        targetTicks = v71_useQuickScalp ? v71_quickScalpTicks : ((highWinRateMode and isMnq5m) ? tp1Ticks : tp2Ticks)
        strategy.exit("TP_SINGLE", qty_percent=100, profit=targetTicks, stop=activeStop)
    else
        strategy.exit("TP1", qty_percent=60, profit=tp1Ticks)
        strategy.exit("TP2", qty_percent=25, profit=tp2Ticks)
        strategy.exit("TP3", qty_percent=10, profit=tp3Ticks)
        strategy.exit("TP4", qty_percent=5, profit=tp4Ticks)
        strategy.exit("SL", stop=activeStop)
if strategy.position_size < 0
    localEntryPrice = strategy.position_avg_price
    bool is3m_chart = is3min
    bool isMnq5m = isMNQ and (is5min or is3min)
    float tpMult = (highWinRateMode and isMnq5m) ? quickTPMultiplier * v71_volAdjust : v71_volAdjust
    float slMult = (highWinRateMode and isMnq5m) ? widerSLMultiplier : 1.0
    float baseSL = isMES ? mes_customSL : (is3m_chart ? mnq_customSL_3m : mnq_customSL)
    float baseTP1 = isMES ? mes_customTP : (is3m_chart ? mnq_customTP1_3m : mnq_customTP1)
    float baseTP2 = isMES ? mes_customTP * 1.5 : (is3m_chart ? mnq_customTP2_3m : mnq_customTP2)
    float baseTP3 = isMES ? mes_customTP * 2.5 : (is3m_chart ? mnq_customTP3_3m : mnq_customTP3)
    float baseTP4 = isMES ? mes_customTP * 4.0 : (is3m_chart ? mnq_customTP4_3m : mnq_customTP4)
    float currentSL = baseSL * slMult
    float currentTP1 = baseTP1 * tpMult
    float currentTP2 = baseTP2 * tpMult
    float currentTP3 = baseTP3 * tpMult
    float currentTP4 = baseTP4 * tpMult
    
    // V71: Store TP1 target for adaptive systems
    v71_tp1Target := currentTP1
    
    // V71: Track profit in bars (for short, profit is when price goes down)
    currentProfitPts = localEntryPrice - close
    if currentProfitPts > 0
        v71_profitBarsCount := v71_profitBarsCount + 1
    else
        v71_profitBarsCount := 0
    
    // V71: Track max profit for trailing
    if currentProfitPts > v71_maxProfitSeen
        v71_maxProfitSeen := currentProfitPts
    if not tp1Hit and low <= localEntryPrice - currentTP1
        tp1Hit := true
    float beOffsetPoints = 0.0
    if beAfterTP1UseFees
        oneWayFees = commissionPerContract + extraFeesPerContract
        roundTripFees = oneWayFees * 2
        slipPts = slippageTicksOneWay * syminfo.mintick
        beOffsetPoints := (roundTripFees / syminfo.pointvalue) + slipPts
    localStopLoss = localEntryPrice + currentSL
    localBEStop = localEntryPrice - beOffsetPoints
    
    // V71: Adaptive Trailing Stop System (for shorts)
    v71_trailingActivationLevel = currentTP1 * (trailingActivationPct / 100.0)
    if enableAdaptiveTrailing and currentProfitPts >= v71_trailingActivationLevel
        v71_trailingActive := true
        // Trail from the max profit seen (for shorts, this is below entry)
        v71_newTrailingStop = localEntryPrice - v71_maxProfitSeen * (1.0 - trailingStepPct / 100.0)
        if na(v71_trailingStop) or v71_newTrailingStop < v71_trailingStop
            v71_trailingStop := v71_newTrailingStop
    
    // V71: Time-Decay Profit Lock (for shorts)
    v71_profitLockLevel = currentTP1 * (profitLockMinPct / 100.0)
    if enableTimeProfitLock and v71_profitBarsCount >= profitLockBars and currentProfitPts >= v71_profitLockLevel
        v71_profitLockActive := true
        v71_lockedProfitLevel := localEntryPrice - currentProfitPts * (profitLockKeepPct / 100.0)
    
    // V71: Determine best stop to use (for shorts, lower is better)
    float v71_bestStop = localStopLoss
    if (enableBEAfterTP1 or (highWinRateMode and isMnq5m)) and tp1Hit
        v71_bestStop := localBEStop
    if v71_trailingActive and not na(v71_trailingStop) and v71_trailingStop < v71_bestStop
        v71_bestStop := v71_trailingStop
    if v71_profitLockActive and not na(v71_lockedProfitLevel) and v71_lockedProfitLevel < v71_bestStop
        v71_bestStop := v71_lockedProfitLevel
    
    float activeStop = v71_bestStop
    tp1Ticks = math.round(currentTP1 / syminfo.mintick)
    tp2Ticks = math.round(currentTP2 / syminfo.mintick)
    tp3Ticks = math.round(currentTP3 / syminfo.mintick)
    tp4Ticks = math.round(currentTP4 / syminfo.mintick)
    
    // V71: Quick Scalp Exit - take profit quickly on fast moves
    v71_quickScalpLevel = currentTP1 * (quickScalpProfitPct / 100.0)
    v71_quickScalpTicks = math.round(v71_quickScalpLevel / syminfo.mintick)
    bool v71_useQuickScalp = enableQuickScalpExit and holdingPeriod <= quickScalpBars and highWinRateMode
    if math.abs(strategy.position_size) == 1
        targetTicks = v71_useQuickScalp ? v71_quickScalpTicks : ((highWinRateMode and isMnq5m) ? tp1Ticks : tp2Ticks)
        strategy.exit("TP_SINGLE", qty_percent=100, profit=targetTicks, stop=activeStop)
    else
        strategy.exit("TP1", qty_percent=60, profit=tp1Ticks)
        strategy.exit("TP2", qty_percent=25, profit=tp2Ticks)
        strategy.exit("TP3", qty_percent=10, profit=tp3Ticks)
        strategy.exit("TP4", qty_percent=5, profit=tp4Ticks)
        strategy.exit("SL", stop=activeStop)
// ==================== 🛡️ SAFETY EXITS ====================
getBackupSL() =>
    isMES ? backupSL_MES : isMNQ ? backupSL_MNQ : backupSL_Default
if enableBackupSL and strategy.position_size != 0 and not na(entryPrice)
    backupSLDistance = getBackupSL()
    if strategy.position_size > 0
        backupStopLevel = entryPrice - backupSLDistance
        if close <= backupStopLevel
            strategy.close("LONG", comment="BACKUP_SL")
    else if strategy.position_size < 0
        backupStopLevel = entryPrice + backupSLDistance
        if close >= backupStopLevel
            strategy.close("SHORT", comment="BACKUP_SL")
if enableNuclearExit and strategy.position_size != 0 and holdingPeriod >= nuclearMaxBars
    strategy.close_all(comment="NUCLEAR_EXIT")
// V71: Momentum-Fade Exit System
// Exit early if momentum is fading while we're in profit
v71_rsiNow = ta.rsi(close, 7)
v71_rsiPrev = ta.rsi(close[momentumFadeBars], 7)
v71_rsiFading = math.abs(v71_rsiNow - v71_rsiPrev)
v71_inProfit = strategy.position_size > 0 ? (close > entryPrice) : strategy.position_size < 0 ? (close < entryPrice) : false
if enableMomentumFadeExit and strategy.position_size != 0 and v71_inProfit and holdingPeriod >= momentumFadeBars
    if strategy.position_size > 0
        // For longs: RSI dropping significantly indicates fading bullish momentum
        if v71_rsiNow < v71_rsiPrev - momentumFadeThreshold and v71_rsiNow < 50
            strategy.close("LONG", comment="V71_MOM_FADE")
    else if strategy.position_size < 0
        // For shorts: RSI rising significantly indicates fading bearish momentum
        if v71_rsiNow > v71_rsiPrev + momentumFadeThreshold and v71_rsiNow > 50
            strategy.close("SHORT", comment="V71_MOM_FADE")
strongOpposingBuy = (impulseLong or hasMomentumOverrideLong) and candleBull
strongOpposingSell = (impulseShort or hasMomentumOverrideShort) and candleBear
if useSignalReversalExits and strategy.position_size != 0 and holdingPeriod >= minBarsBeforeSignalReversal
    if strategy.position_size > 0 and strongOpposingSell
        strategy.close("LONG", comment="SIGNAL_REVERSAL_STRONG")
    else if strategy.position_size < 0 and strongOpposingBuy
        strategy.close("SHORT", comment="SIGNAL_REVERSAL_STRONG")
if useEndOfDayExits and strategy.position_size != 0 and isEndOfDay
    strategy.close_all(comment="EOD_EXIT")
if useLosingTradeAutoClose and strategy.position_size != 0 and not na(entryPrice)
    lossThresholdDollars = (strategy.equity * losingTradeThreshold / 100)
    if math.abs(currentProfitDollars) >= lossThresholdDollars and currentProfitDollars < 0
        strategy.close_all(comment="LOSING_AUTO")
if enableMaxHoldExit and strategy.position_size != 0 and holdingPeriod >= maxHoldBars
    strategy.close_all(comment="MAX_HOLD")
// ==================== 🔔 TRADERSPOST WEBHOOK ALERTS ====================
if longCondition and strategy.position_size == 0 and allowEntryLong and finalContractQty > 0 and enableTradersPostAlerts
    bool is3m_chart = timeframe.period == "3"
    float currentSL_pts = isMES ? mes_customSL : (is3m_chart ? mnq_customSL_3m : mnq_customSL)
    float currentTP1_pts = isMES ? mes_customTP : (is3m_chart ? mnq_customTP1_3m : mnq_customTP1)
    localSL = close - currentSL_pts
    localTP1 = close + currentTP1_pts
    longEntryMessage = '{' + '"ticker":"' + actualTicker + '",' +
         '"action":"buy",' +
         '"sentiment":"bullish",' +
         '"orderType":"market",' +
         '"quantity":' + str.tostring(finalContractQty) + ',' +
         '"stopLoss":{"stopPrice":"' + str.tostring(localSL) + '"},' +
         '"takeProfit":{"limitPrice":"' + str.tostring(localTP1) + '"},' +
         '"signalType":"' + activeSignalType + '",' +
         '"priority":"' + selectedPriority + '",' +
         '"entryPrice":' + str.tostring(close) + ',' +
         '"direction":"LONG",' +
         '"starScore":' + str.tostring(starScore) + ',' +
         '"htfAlignment":' + str.tostring(htfAlignLongCount) + ',' +
         '"adx":' + str.tostring(adxValue) + ',' +
         '"rsi":' + str.tostring(rsi) + ',' +
         '"timestamp":"' + str.tostring(time) + '"' +
         '}'
    alert(longEntryMessage, alert.freq_once_per_bar)
if shortCondition and strategy.position_size == 0 and allowEntryShort and finalContractQty > 0 and enableTradersPostAlerts
    bool is3m_chart = timeframe.period == "3"
    float currentSL_pts = isMES ? mes_customSL : (is3m_chart ? mnq_customSL_3m : mnq_customSL)
    float currentTP1_pts = isMES ? mes_customTP : (is3m_chart ? mnq_customTP1_3m : mnq_customTP1)
    localSL = close + currentSL_pts
    localTP1 = close - currentTP1_pts
    shortEntryMessage = '{' + '"ticker":"' + actualTicker + '",' +
         '"action":"sell",' +
         '"sentiment":"bearish",' +
         '"orderType":"market",' +
         '"quantity":' + str.tostring(finalContractQty) + ',' +
         '"stopLoss":{"stopPrice":"' + str.tostring(localSL) + '"},' +
         '"takeProfit":{"limitPrice":"' + str.tostring(localTP1) + '"},' +
         '"signalType":"' + activeSignalType + '",' +
         '"priority":"' + selectedPriority + '",' +
         '"entryPrice":' + str.tostring(close) + ',' +
         '"direction":"SHORT",' +
         '"starScore":' + str.tostring(starScore) + ',' +
         '"htfAlignment":' + str.tostring(htfAlignShortCount) + ',' +
         '"adx":' + str.tostring(adxValue) + ',' +
         '"rsi":' + str.tostring(rsi) + ',' +
         '"timestamp":"' + str.tostring(time) + '"' +
         '}'
    alert(shortEntryMessage, alert.freq_once_per_bar)
if strategy.position_size == 0 and strategy.position_size[1] != 0 and enableTradersPostAlerts
    exitMessage = '{' + '"ticker":"' + actualTicker + '",' +
         '"action":"exit",' +
         '"orderType":"market",' +
         '"sentiment":"flat",' +
         '"timestamp":"' + str.tostring(time) + '"' +
         '}'
    alert(exitMessage, alert.freq_once_per_bar)
// ==================== 📊 VISUAL INDICATORS ====================
hullMainColor = slopeMain == 1 ? color.new(color.green, 50) : slopeMain == -1 ? color.new(color.red, 50) : color.new(color.gray, 70)
hullFastColor = slopeFast == 1 ? color.new(color.lime, 30) : slopeFast == -1 ? color.new(color.orange, 30) : color.new(color.gray, 50)
plot(hullMain, "Hull Main", color=hullMainColor, linewidth=3)
plot(hullFast, "Hull Fast", color=hullFastColor, linewidth=2)
plot(upperEnv, "Upper Envelope", color=color.new(color.blue, 80), linewidth=1)
plot(lowerEnv, "Lower Envelope", color=color.new(color.blue, 80), linewidth=1)
plot(smaBasis, "SMA Basis", color=color.new(color.gray, 70), linewidth=1)
plot(sma9, "SMA 9", color=color.new(color.yellow, 60), linewidth=1)
plot(sma50, "SMA 50", color=color.new(color.orange, 60), linewidth=1)
plot(sma180, "SMA 180", color=color.new(color.purple, 70), linewidth=1)
plot(ema20, "EMA 20", color=color.new(color.aqua, 60), linewidth=1)
plot(tsl, "Swing Line", color=swingColor, linewidth=2)
plot(emaShort, "EMA 9", color=color.new(color.blue, 0), linewidth=2)
plot(emaMedium, "EMA 21", color=color.new(color.orange, 0), linewidth=2)
plot(emaLong, "EMA 50 Filter", color=color.new(color.gray, 50), linewidth=1)
trendColor = trend == 1 ? color.new(color.green, 95) : trend == -1 ? color.new(color.red, 95) : color.new(color.gray, 98)
bgcolor(trendColor, title="SuperTrend Background")
grayZoneBgColor = isSignalGrayZone ? color.new(color.gray, 92) : na
bgcolor(grayZoneBgColor, title="Gray Zone")
choppyBgColor = isChoppy ? color.new(color.red, 95) : na
bgcolor(choppyBgColor, title="Choppy Market")
bgcolor(profitTargetReached ? color.new(color.green, 95) : na, title="Profit Target Reached")
optimalSessionBg = isOptimalSession ? color.new(color.green, 97) : na
bgcolor(isOptimalSession ? optimalSessionBg : na, title="Optimal Session")
// PRIORITY LABELS
plotshape(shouldEnterLong and selectedPriority == "P0:MOMENTUM", "P0 LONG", shape.diamond, location.belowbar, color.new(color.yellow, 0), size=size.huge, text="P0🎯")
plotshape(shouldEnterShort and selectedPriority == "P0:MOMENTUM", "P0 SHORT", shape.diamond, location.abovebar, color.new(color.orange, 0), size=size.huge, text="P0🎯")
plotshape(shouldEnterLong and selectedPriority == "P1:IMPULSE", "P1 LONG", shape.diamond, location.belowbar, color.new(color.aqua, 0), size=size.large, text="P1💥")
plotshape(shouldEnterShort and selectedPriority == "P1:IMPULSE", "P1 SHORT", shape.diamond, location.abovebar, color.new(color.fuchsia, 0), size=size.large, text="P1💥")
plotshape(shouldEnterLong and selectedPriority == "P2:TREND", "P2 LONG", shape.triangleup, location.belowbar, color.new(color.lime, 0), size=size.large, text="P2🚀")
plotshape(shouldEnterShort and selectedPriority == "P2:TREND", "P2 SHORT", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.large, text="P2🚀")
plotshape(shouldEnterLong and selectedPriority == "P3:5STAR", "P3 LONG", shape.circle, location.belowbar, color.new(color.green, 0), size=size.normal, text="P3⭐")
plotshape(shouldEnterShort and selectedPriority == "P3:5STAR", "P3 SHORT", shape.circle, location.abovebar, color.new(color.maroon, 0), size=size.normal, text="P3⭐")
plotshape(shouldEnterLong and selectedPriority == "P4:4STAR", "P4 LONG", shape.circle, location.belowbar, color.new(color.teal, 0), size=size.normal, text="P4⭐")
plotshape(shouldEnterShort and selectedPriority == "P4:4STAR", "P4 SHORT", shape.circle, location.abovebar, color.new(color.purple, 0), size=size.normal, text="P4⭐")
plotshape(shouldEnterLong and selectedPriority == "P5:3STAR", "P5 LONG", shape.circle, location.belowbar, color.new(color.blue, 30), size=size.small, text="P5⭐")
plotshape(shouldEnterShort and selectedPriority == "P5:3STAR", "P5 SHORT", shape.circle, location.abovebar, color.new(color.red, 30), size=size.small, text="P5⭐")
plotshape(shouldEnterLong and selectedPriority == "P6:2STAR", "P6 LONG", shape.circle, location.belowbar, color.new(color.gray, 30), size=size.small, text="P6⭐")
plotshape(shouldEnterShort and selectedPriority == "P6:2STAR", "P6 SHORT", shape.circle, location.abovebar, color.new(color.silver, 30), size=size.small, text="P6⭐")
plotshape(shouldEnterLong and selectedPriority == "P7:SWING", "P7 LONG", shape.xcross, location.belowbar, color.new(color.navy, 0), size=size.tiny, text="P7")
plotshape(shouldEnterShort and selectedPriority == "P7:SWING", "P7 SHORT", shape.xcross, location.abovebar, color.new(color.maroon, 0), size=size.tiny, text="P7")
// MICRO/INSTANT SIGNALS
plotshape(microBuySignal and enableMicroSignals, "MICRO LONG", shape.square, location.belowbar, color.new(color.lime, 50), size=size.tiny, text="M")
plotshape(microSellSignal and enableMicroSignals, "MICRO SHORT", shape.square, location.abovebar, color.new(color.red, 50), size=size.tiny, text="M")
plotshape(instantBuySignal and enableInstantSignals, "INSTANT LONG", shape.cross, location.belowbar, color.new(color.aqua, 50), size=size.tiny, text="I")
plotshape(instantSellSignal and enableInstantSignals, "INSTANT SHORT", shape.cross, location.abovebar, color.new(color.fuchsia, 50), size=size.tiny, text="I")
plotshape(swingBuySignal and enableSwingSignals, "SWING BUY", shape.labelup, location.belowbar, color.new(color.blue, 30), size=size.tiny, text="⚡")
plotshape(swingSellSignal and enableSwingSignals, "SWING SELL", shape.labeldown, location.abovebar, color.new(color.purple, 30), size=size.tiny, text="⚡")
plotshape(bullishEngulfing, "Bull Engulf", shape.labelup, location.belowbar, color.new(color.green, 0), size=size.tiny, text="📈")
plotshape(bearishEngulfing, "Bear Engulf", shape.labeldown, location.abovebar, color.new(color.red, 0), size=size.tiny, text="📉")
plotshape(hammer, "Hammer", shape.labelup, location.belowbar, color.new(color.lime, 0), size=size.tiny, text="🔨")
plotshape(shootingStar, "Shooting", shape.labeldown, location.abovebar, color.new(color.orange, 0), size=size.tiny, text="⭐")
// ==================== 📊 PERFORMANCE METRICS TABLE ====================
// V71: Enhanced performance table with win rate optimization status
var table perfTable = table.new(position.top_right, 2, 12, border_width=1)
winRateAll = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100 : 0
targetProgress = dailyProfitTarget > 0 ? (dailyPnL / dailyProfitTarget) * 100 : 0
if barstate.islast
    table.cell(perfTable, 0, 0, "🏆 WIN RATE", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(perfTable, 1, 0, str.tostring(winRateAll, "#.#") + "%", text_color=winRateAll >= 70 ? color.green : winRateAll >= 60 ? color.yellow : color.red, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 1, "TRADES", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(perfTable, 1, 1, str.tostring(strategy.closedtrades), text_color=color.white, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 2, "NET P&L", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(perfTable, 1, 2, "$" + str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.green : color.red, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 3, "DAILY P&L", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(perfTable, 1, 3, "$" + str.tostring(dailyPnL, "#.##"), text_color=dailyPnL >= 0 ? color.green : color.red, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 4, "TARGET", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(perfTable, 1, 4, str.tostring(targetProgress, "#") + "%", text_color=profitTargetReached ? color.green : color.white, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 5, "HTF LONG", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(perfTable, 1, 5, str.tostring(htfAlignLongCount) + "/3", text_color=htfAlignLongCount >= 1 ? color.green : color.gray, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 6, "HTF SHORT", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(perfTable, 1, 6, str.tostring(htfAlignShortCount) + "/3", text_color=htfAlignShortCount >= 1 ? color.green : color.gray, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 7, "ADX", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(perfTable, 1, 7, str.tostring(adxValue, "#.#"), text_color=adxValue > choppyADXThreshold ? color.green : color.gray, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 8, "RSI", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(perfTable, 1, 8, str.tostring(rsi, "#.#"), text_color=color.white, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 9, "MODE", text_color=color.white, bgcolor=color.new(color.blue, 70))
    modeText = hasMomentumOverrideLong or hasMomentumOverrideShort ? "MOMENTUM" : impulseLong or impulseShort ? "IMPULSE" : hasStrongTrendOverrideBull or hasStrongTrendOverrideBear ? "TREND" : "NORMAL"
    modeColor = hasMomentumOverrideLong or hasMomentumOverrideShort ? color.yellow : impulseLong or impulseShort ? color.aqua : hasStrongTrendOverrideBull or hasStrongTrendOverrideBear ? color.lime : color.white
    table.cell(perfTable, 1, 9, modeText, text_color=modeColor, bgcolor=color.new(color.gray, 85))
    // V71: Win Rate Optimization Status
    table.cell(perfTable, 0, 10, "V71 OPT", text_color=color.white, bgcolor=color.new(color.purple, 70))
    v71StatusText = v71_trailingActive ? "TRAIL" : v71_profitLockActive ? "LOCK" : strategy.position_size != 0 ? "ACTIVE" : "READY"
    v71StatusColor = v71_trailingActive ? color.lime : v71_profitLockActive ? color.aqua : color.white
    table.cell(perfTable, 1, 10, v71StatusText, text_color=v71StatusColor, bgcolor=color.new(color.gray, 85))
    table.cell(perfTable, 0, 11, "VOL ADJ", text_color=color.white, bgcolor=color.new(color.purple, 70))
    table.cell(perfTable, 1, 11, str.tostring(v71_volAdjust, "#.##") + "x", text_color=v71_volAdjust < 1.0 ? color.orange : color.white, bgcolor=color.new(color.gray, 85))