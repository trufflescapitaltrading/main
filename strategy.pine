bool canEnterNewPosition = strategy.position_size == 0
maxTradesReached = enableDailyTradeLimit and todayTradeCount >= maxDailyTrades
bool baseSafety = canEnterNewPosition and not maxTradesReached and not maxLossReached and not profitTargetReached and canTradeNow and not instrumentRiskLimitReached and (not pauseAfterLosses)
bool canGoLong = baseSafety and canEnterLong
bool canGoShort = baseSafety and canEnterShort
// Priority routing
var bool shouldEnterLong = false
var bool shouldEnterShort = false
