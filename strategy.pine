dailyPnL := na(dayStartNetprofit) ? 0.0 : (strategy.netprofit - dayStartNetprofit)
dailyLossLimitPct = (na(dayStartEquity) or dayStartEquity <= 0) ? 0.0 : (dayStartEquity * (maxDailyLoss / 100.0))
dailyLossLimitDol = maxDailyLossDollars
maxLossReached = enableDailyLossCircuit and ((dailyLossMode == "Percent" and dailyPnL <= -dailyLossLimitPct) or (dailyLossMode == "Dollar" and dailyPnL <= -dailyLossLimitDol))
profitTargetReached = enableDailyProfitTarget and dailyPnL >= dailyProfitTarget
var bool tookTradeThisBar = false
