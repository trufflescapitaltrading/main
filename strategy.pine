strengthGateLongOK = (not requireMultipleStrong) or (strongCountLong >= minStrongSignals) or (allowImpulseBypassStrength and (impulseLong or hasStrongTrendOverrideBull or hasMomentumOverrideLong))
strengthGateShortOK = (not requireMultipleStrong) or (strongCountShort >= minStrongSignals) or (allowImpulseBypassStrength and (impulseShort or hasStrongTrendOverrideBear or hasMomentumOverrideShort))
if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryPrice := strategy.position_avg_price
    entryBar := bar_index
    maxProfit := 0.0
    isLongPosition := strategy.position_size > 0
    isShortPosition := strategy.position_size < 0
    peakProfit := 0.0
    positionBars := 0
    lastEntryBar := bar_index
    lastEntryDirection := strategy.position_size > 0 ? 1 : -1
    originalQty := finalContractQty
    tp1Hit := false
    // V71: Initialize optimization variables
