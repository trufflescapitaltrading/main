allowModerateTrend = input.bool(true, "Allow Moderate Trend", group=routerGroup)
enableBestSideRouter = input.bool(false, "Best-Side Router - DISABLED FOR MORE TRADES", group=routerGroup)
biasLockBars = input.int(3, "Bias Lock Bars", minval=1, maxval=20, group=routerGroup)
