// This file was generated by a Cloud Agent based on user instructions to implement
// the Filter Harmony v3 system with MCL specific optimizations.

//@version=6
strategy("Filter Harmony v3 - MCL [BOT]", overlay=true, pyramiding=0, initial_capital=10000, default_qty_type=strategy.cash, default_qty_value=10000, currency=currency.USD)

// =============================================================================
// 🔧 INPUTS & CONFIGURATION
// =============================================================================

// --- Harmony System Settings ---
harmonyGroup = "🎯 Filter Harmony v3"
enableFilterHarmony = input.bool(true, "✅ Enable Filter Harmony v3", group=harmonyGroup)
minQualityThreshold = input.float(70.0, "Min Entry Quality % (70=Strict)", minval=50, maxval=90, step=1, group=harmonyGroup)
extremeTrendBoostPct = input.float(2.0, "Extreme Trend Boost × MinMove%", minval=1.2, maxval=4.0, step=0.1, group=harmonyGroup)

// --- MCL / Instrument Specifics ---
instGroup = "MCL Instrument Settings"
expectedRoot = input.string("MCL", "Expected root symbol (MNQ/MCL/MGC)", group=instGroup)
pointValue = input.float(100.0, "Point Value ($)", group=instGroup)
tickSize   = syminfo.mintick

// --- Risk Management ---
riskGroup = "Risk Management"
riskPerTrade    = input.float(100, "Max $ risk per trade", step=10, group=riskGroup)
dailyLossStop   = input.float(500, "Daily loss stop ($)", step=50, group=riskGroup)
maxConsecLoss   = input.int(3, "Max consecutive losing trades", minval=1, group=riskGroup)
maxDrawdownPct  = input.float(10.0, "Max Drawdown % (Stop Bot)", minval=1.0, group=riskGroup)

// --- Session ---
sessGroup = "Session Management"
useTimeFilter   = input.bool(true, "Use Time Filter", group=sessGroup)
tradeSess       = input.session("0700-1330", "Trading Session (Exchange Time)", group=sessGroup) // MCL Optimized
lockSess        = input.session("1700-1510", "Daily Lockout Session (Reset)", group=sessGroup)

// --- Trend & Regime ---
regimeGroup = "Trend & Regime"
emaFastLen      = input.int(20, "EMA Fast", group=regimeGroup)
emaMidLen       = input.int(50, "EMA Mid", group=regimeGroup)
emaSlowLen      = input.int(200, "EMA Slow", group=regimeGroup)
atrLen          = input.int(14, "ATR Length", group=regimeGroup)
adxLen          = input.int(14, "ADX Length", group=regimeGroup)
adxMin          = input.float(20, "Min ADX", group=regimeGroup)

// --- Additional Indicators (Restored Features) ---
indGroup = "Additional Indicators"
enableSar   = input.bool(true, "Enable Parabolic SAR", group=indGroup)
enableCloud = input.bool(true, "Enable Ichimoku Cloud", group=indGroup)

// --- Pattern Tiers ---
patternTierGroup = "🕯️ Ranked Pattern Tiers"
enableCandlePatterns = input.bool(true, "Enable Pattern Recognition", group=patternTierGroup)
enableTier1 = input.bool(true, "🥇 Tier 1 (75%+): Soldiers/Engulfing", group=patternTierGroup)
enableTier2 = input.bool(true, "🥈 Tier 2 (65-74%): Morning/Evening", group=patternTierGroup)
enableTier3 = input.bool(false, "🥉 Tier 3 (55-64%): Hammer/Harami", group=patternTierGroup)
enableTier4 = input.bool(false, "⚪ Tier 4 (Power/Neutral): Marubozu", group=patternTierGroup)

// --- Confluence ---
confluenceGroup = "🎯 Confluence"
useScoreConfluence = input.bool(true, "Use SCORE Confluence Gate", group=confluenceGroup)
confluenceLevel    = input.int(8, "Confluence Rigidity (1-15)", minval=1, maxval=15, group=confluenceGroup)

// --- Exits ---
exitGroup = "Exits"
tp1R            = input.float(1.0, "TP1 (R)", step=0.1, group=exitGroup)
tp2R            = input.float(2.0, "TP2 (R)", step=0.1, group=exitGroup)
tp1Pct          = input.int(70, "TP1 % Qty", minval=0, maxval=100, group=exitGroup)
tp2Pct          = input.int(20, "TP2 % Qty", minval=0, maxval=100, group=exitGroup)
trailPct        = input.int(10, "Runner % Qty", minval=0, maxval=100, group=exitGroup)
useBreakEven    = input.bool(true, "Move to BE", group=exitGroup)
beTriggerR      = input.float(0.8, "BE Trigger (R)", step=0.1, group=exitGroup)

// =============================================================================
// 📊 INDICATORS & CALCULATIONS
// =============================================================================

// Time & Session
inSession = not useTimeFilter or not na(time(timeframe.period, tradeSess))
sessTime   = time(timeframe.period, lockSess)
newDay     = not na(sessTime) and na(sessTime[1])

// EMAs & VWAP
emaF = ta.ema(close, emaFastLen)
emaM = ta.ema(close, emaMidLen)
emaS = ta.ema(close, emaSlowLen)
vwap = ta.vwap(close)

// ATR & ADX
atr = ta.atr(atrLen)
adx = ta.adx(adxLen)

// Parabolic SAR
sar = ta.sar(0.02, 0.02, 0.2)
sarLong  = close > sar
sarShort = close < sar

// Ichimoku Cloud
donchian(len) => math.avg(ta.lowest(len), ta.highest(len))
conversionLine = donchian(9)
baseLine       = donchian(26)
leadLine1      = math.avg(conversionLine, baseLine)
leadLine2      = donchian(52)
cloudTop       = math.max(leadLine1[26], leadLine2[26])
cloudBottom    = math.min(leadLine1[26], leadLine2[26])
cloudBull      = close > cloudTop
cloudBear      = close < cloudBottom

// Trend Definitions
strongTrend    = adx > 25 and math.abs(emaF - emaM) > atr * 0.5
moderateTrend  = adx > 20 and math.abs(emaF - emaM) > atr * 0.2
rangingMarket  = adx < 20
isChoppy       = adx < 15

// Candle Definitions
candleBull = close > open
candleBear = close < open
bodySize   = math.abs(close - open)
totalRange = high - low
bodyRatio  = totalRange > 0 ? bodySize / totalRange : 0
isDoji     = bodyRatio < 0.1

// -----------------------------------------------------------------------------
// 🕯️ PATTERN RECOGNITION (Tiered)
// -----------------------------------------------------------------------------

// Tier 1: Strong Reversal/Continuation
threeWhiteSoldiers = candleBull and candleBull[1] and candleBull[2] and close > close[1] and close[1] > close[2]
threeBlackCrows    = candleBear and candleBear[1] and candleBear[2] and close < close[1] and close[1] < close[2]
bullishEngulfing   = candleBear[1] and candleBull and close > open[1] and open < close[1]
bearishEngulfing   = candleBull[1] and candleBear and close < open[1] and open > close[1]

// Tier 2: Medium Reversal
morningStar        = candleBear[2] and bodyRatio[1] < 0.3 and candleBull and close > (open[2] + close[2])/2
eveningStar        = candleBull[2] and bodyRatio[1] < 0.3 and candleBear and close < (open[2] + close[2])/2
piercingLine       = candleBear[1] and candleBull and open < low[1] and close > (open[1] + close[1])/2
darkCloudCover     = candleBull[1] and candleBear and open > high[1] and close < (open[1] + close[1])/2

// Tier 3: Weak Reversal
hammer             = candleBull and (high - close) < bodySize * 0.1 and (open - low) > bodySize * 2
shootingStar       = candleBear and (open - low) < bodySize * 0.1 and (high - close) > bodySize * 2
bullishHarami      = candleBear[1] and candleBull and high < open[1] and low > close[1]
bearishHarami      = candleBull[1] and candleBear and high < close[1] and low > open[1]

// Tier 4: Momentum/Neutral
bullishMarubozu    = candleBull and bodyRatio > 0.9
bearishMarubozu    = candleBear and bodyRatio > 0.9

// Tier Grouping
tier1Bull = threeWhiteSoldiers or bullishEngulfing
tier2Bull = morningStar or piercingLine
tier3Bull = hammer or bullishHarami
tier4Bull = bullishMarubozu

tier1Bear = threeBlackCrows or bearishEngulfing
tier2Bear = eveningStar or darkCloudCover
tier3Bear = shootingStar or bearishHarami
tier4Bear = bearishMarubozu

allowedBullPattern = (enableTier1 and tier1Bull) or (enableTier2 and tier2Bull) or (enableTier3 and tier3Bull) or (enableTier4 and tier4Bull)
allowedBearPattern = (enableTier1 and tier1Bear) or (enableTier2 and tier2Bear) or (enableTier3 and tier3Bear) or (enableTier4 and tier4Bear)

patternOKLong  = not enableCandlePatterns or allowedBullPattern
patternOKShort = not enableCandlePatterns or allowedBearPattern

// -----------------------------------------------------------------------------
// 🔄 SIGNALS & CONDITIONAL LOGIC
// -----------------------------------------------------------------------------

// Basic Signals (Trend Follow)
longTrendCondition  = emaF > emaM and emaM > emaS and close > emaF
shortTrendCondition = emaF < emaM and emaM < emaS and close < emaF

// Signal Line Permission
signalAllowsLong  = close > emaM
signalAllowsShort = close < emaM

// Impulse & Volatility
impulseMove = totalRange > atr * 1.5
volSurge    = volume > ta.sma(volume, 20) * 1.5

// Impulse Logic
impulseLong  = impulseMove and volSurge and candleBull and patternOKLong
impulseShort = impulseMove and volSurge and candleBear and patternOKShort

// Consecutive Trend
consecutiveLongTrend  = close > close[1] and close[1] > close[2] and close > emaF
consecutiveShortTrend = close < close[1] and close[1] < close[2] and close < emaF

// Star Scoring (Extended for New Features)
// Base: Trend, Volume, Momentum, Pattern, Value
starScore = 0
starScore += (strongTrend ? 1 : 0)
starScore += (volSurge ? 1 : 0)
starScore += (adx > 25 ? 1 : 0) // Momentum
starScore += (allowedBullPattern or allowedBearPattern ? 1 : 0)
starScore += (math.abs(close - vwap) < atr ? 1 : 0) // Value Check
// Extras
starScore += (enableSar and sarLong and longTrendCondition) or (enableSar and sarShort and shortTrendCondition) ? 1 : 0
starScore += (enableCloud and cloudBull and longTrendCondition) or (enableCloud and cloudBear and shortTrendCondition) ? 1 : 0

// -----------------------------------------------------------------------------
// 🎯 FILTER HARMONY V3 CORE
// -----------------------------------------------------------------------------

// --- 1. Bypass & Extreme Conditions ---
isBypassLong  = impulseLong or consecutiveLongTrend
isBypassShort = impulseShort or consecutiveShortTrend

extremeLong  = consecutiveLongTrend  and totalRange >= atr * extremeTrendBoostPct and starScore >= 4
extremeShort = consecutiveShortTrend and totalRange >= atr * extremeTrendBoostPct and starScore >= 4

// --- 2. Regime Score (0-4) ---
trendStrengthScore = 0
trendStrengthScore += strongTrend ? 2 : moderateTrend ? 1 : 0
trendStrengthScore += (not rangingMarket) ? 1 : 0
trendStrengthScore += (not isChoppy) ? 1 : 0

// --- 3. Confluence Score (0-7+) ---
// Factors: Volume, Mom, Trend, PA, ATR, HTF, Pattern, + SAR/Cloud
conf_volume        = volume > ta.sma(volume, 20) ? 1 : 0
conf_strongVolume  = volSurge ? 1 : 0
conf_momentum      = adx > 20 ? 1 : 0
conf_strongMom     = adx > 30 ? 1 : 0
conf_trend         = (strongTrend or moderateTrend) ? 1 : 0
conf_priceAction   = (longTrendCondition or shortTrendCondition) ? 1 : 0
conf_atr           = atr > ta.sma(atr, 20) ? 1 : 0
conf_extras        = (enableSar and (sarLong or sarShort) ? 1 : 0) + (enableCloud and (cloudBull or cloudBear) ? 1 : 0)

totalConfluenceScore = conf_volume + conf_strongVolume + conf_momentum + conf_strongMom + conf_trend + conf_priceAction + conf_atr + conf_extras

// Confluence Gate
requiredConfluence = confluenceLevel <= 2 ? 1 : confluenceLevel <= 4 ? 2 : confluenceLevel <= 6 ? 3 : confluenceLevel <= 8 ? 4 : confluenceLevel <= 10 ? 5 : 6
finalConfluenceOK = useScoreConfluence ? (totalConfluenceScore >= requiredConfluence) : true

// --- 4. Quality Score Calculation (0-100%) ---
f_qualityScore(isLong) =>
    float score = 0.0
    float maxS  = 0.0

    // Regime (30)
    maxS += 30
    score += math.min(trendStrengthScore * 7.5, 30)

    // Confluence (20)
    maxS += 20
    score += (finalConfluenceOK ? 20 : math.min(totalConfluenceScore * (20.0 / 7.0), 18))

    // Signal Line (15)
    maxS += 15
    score += (isLong ? (signalAllowsLong ? 15 : 0) : (signalAllowsShort ? 15 : 0))

    // Patterns (10)
    maxS += 10
    score += (isLong ? (patternOKLong ? 10 : 0) : (patternOKShort ? 10 : 0))

    // Stars (15)
    maxS += 15
    score += math.min(starScore * 3.0, 15)

    // MTF (Simulated/Placeholder 10)
    maxS += 10
    score += 10 

    // Extreme Boost
    if (isLong and extremeLong) or (not isLong and extremeShort)
        score += 10
        maxS += 10
    
    (maxS > 0 ? (score / maxS) * 100.0 : 0.0)

longQuality  = enableFilterHarmony ? f_qualityScore(true) : 100.0
shortQuality = enableFilterHarmony ? f_qualityScore(false) : 100.0

qualityOKLong  = not enableFilterHarmony or longQuality >= minQualityThreshold or extremeLong
qualityOKShort = not enableFilterHarmony or shortQuality >= minQualityThreshold or extremeShort

// =============================================================================
// 🔒 RISK & EXECUTION GATES
// =============================================================================

// Daily Loss Limit
var float dayStartEquity = na
var float lastNetProfit  = na
var int consecLoss       = 0

if newDay
    dayStartEquity := strategy.equity
    lastNetProfit  := strategy.netprofit
    consecLoss     := 0

dayPnL = na(dayStartEquity) ? 0.0 : (strategy.equity - dayStartEquity)
lockedOut = (dayPnL <= -dailyLossStop) or (consecLoss >= maxConsecLoss)

// Update Consec Loss
if strategy.closedtrades > strategy.closedtrades[1]
    if strategy.netprofit < lastNetProfit
        consecLoss += 1
    else
        consecLoss := 0
    lastNetProfit := strategy.netprofit

// Final Entry Conditions
canGoLong  = inSession and not lockedOut and longTrendCondition and qualityOKLong
canGoShort = inSession and not lockedOut and shortTrendCondition and qualityOKShort

// Priority Label
getPriority(isLong) =>
    if (isLong ? extremeLong : extremeShort)
        "P1:EXTREME"
    else if starScore >= 6
        "P2:6⭐"
    else if starScore >= 5
        "P3:5⭐"
    else if starScore >= 4
        "P4:4⭐"
    else
        "P5:STD"

// =============================================================================
// 🚀 EXECUTION
// =============================================================================

if canGoLong and strategy.position_size == 0
    slPrice = low - atr * 1.5
    qty = math.floor(riskPerTrade / (math.abs(close - slPrice) * pointValue))
    if qty > 0
        strategy.entry("Long", strategy.long, qty=qty, comment=getPriority(true) + " Q" + str.tostring(math.round(longQuality)))
        strategy.exit("TP1", "Long", qty_percent=tp1Pct, limit=close + (close - slPrice) * tp1R, stop=slPrice)
        strategy.exit("TP2", "Long", qty_percent=tp2Pct, limit=close + (close - slPrice) * tp2R, stop=slPrice)
        strategy.exit("Run", "Long", qty_percent=trailPct, stop=slPrice, trail_price=close + (close - slPrice) * tp1R, trail_offset=atr * 0.5)

if canGoShort and strategy.position_size == 0
    slPrice = high + atr * 1.5
    qty = math.floor(riskPerTrade / (math.abs(slPrice - close) * pointValue))
    if qty > 0
        strategy.entry("Short", strategy.short, qty=qty, comment=getPriority(false) + " Q" + str.tostring(math.round(shortQuality)))
        strategy.exit("TP1", "Short", qty_percent=tp1Pct, limit=close - (slPrice - close) * tp1R, stop=slPrice)
        strategy.exit("TP2", "Short", qty_percent=tp2Pct, limit=close - (slPrice - close) * tp2R, stop=slPrice)
        strategy.exit("Run", "Short", qty_percent=trailPct, stop=slPrice, trail_price=close - (slPrice - close) * tp1R, trail_offset=atr * 0.5)

// Break Even Logic
if useBreakEven and strategy.position_size != 0
    if strategy.position_size > 0 and high > strategy.position_avg_price + (atr * beTriggerR)
        strategy.exit("BE-L", "Long", stop=strategy.position_avg_price + syminfo.mintick)
    if strategy.position_size < 0 and low < strategy.position_avg_price - (atr * beTriggerR)
        strategy.exit("BE-S", "Short", stop=strategy.position_avg_price - syminfo.mintick)

// =============================================================================
// 📱 DASHBOARD
// =============================================================================
var table dash = table.new(position.top_right, 2, 8, border_width=1, bgcolor=color.new(color.black, 50))
if barstate.islast
    table.cell(dash, 0, 0, "HARMONY BOT", text_color=color.white)
    table.cell(dash, 1, 0, str.tostring(dayPnL, format.mintick), text_color=dayPnL >= 0 ? color.green : color.red)
    
    table.cell(dash, 0, 1, "Long Quality", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(longQuality, "#.0") + "%", text_color=qualityOKLong ? color.green : color.red)
    
    table.cell(dash, 0, 2, "Short Quality", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(shortQuality, "#.0") + "%", text_color=qualityOKShort ? color.green : color.red)
    
    table.cell(dash, 0, 3, "Trend Score", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(trendStrengthScore) + "/4", text_color=color.yellow)

    table.cell(dash, 0, 4, "Conf Score", text_color=color.white)
    table.cell(dash, 1, 4, str.tostring(totalConfluenceScore) + "/7+", text_color=color.yellow)

    table.cell(dash, 0, 5, "Session", text_color=color.white)
    table.cell(dash, 1, 5, inSession ? "OPEN" : "CLOSED", text_color=inSession ? color.green : color.red)

    table.cell(dash, 0, 6, "Consec Loss", text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(consecLoss) + "/" + str.tostring(maxConsecLoss), text_color=consecLoss == 0 ? color.green : color.red)

// Plots
plot(emaF, "EMA Fast", color=color.yellow)
plot(emaM, "EMA Mid", color=color.blue)
plot(emaS, "EMA Slow", color=color.white)
plot(vwap, "VWAP", color=color.purple)
plot(enableSar ? sar : na, "SAR", style=plot.style_circles, color=color.white)

// Quality Signals
plotshape(canGoLong, "Long Sig", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(canGoShort, "Short Sig", shape.triangledown, location.abovebar, color.red, size=size.small)
