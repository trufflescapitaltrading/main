        bool rawShortCondition = (ultraSellSignal or swingSellSignal or hasMomentumOverrideShort or impulseShort or hasStrongTrendOverrideBear) and canEnterShort and not maxLossReached and not maxTradesReached and not profitTargetReached and canEnterNewPosition and candleBear and routerShortRegimeOK and allowShortByBias and cooldownOK and candleConfirmShort
