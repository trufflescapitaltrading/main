mesRestrictToPminus1P1P2 = input.bool(true, "MES: Only allow P-1/P1/P2 entries", group=mesEntryGateGroup)
// ==================== 🔥 MNQ 3m "KENYA" PROFIT LOGIC (AS POSTED) ====================
kenyaGroup = "🔥 MNQ 3m Profit Logic (Kenya)"
