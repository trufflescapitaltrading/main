// Align MNQ 3m defaults to the proven "Kenya" ladder expectancy (SL 50 / TP1 45 / TP2 70 / TP3 100 / TP4 150).
mnq_customSL_3m = input.float(50.0, "MNQ 3m: Stop Loss (points)", group=perInstGroup)
