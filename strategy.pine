//@version=5
strategy("@MAIN-MNQ 3m/5m-1.18.2026 20:57 Cursor WIN-OPT MNQ/MES 3m/5m Multi-TF Cursor V.71+% 5-Star Scalper P1/P2 SAFE", overlay=true, initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1, calc_on_order_fills=false, calc_on_every_tick=true, process_orders_on_close=false, backtest_fill_limits_assumption=0, dynamic_requests=true)
// ==================== 💰 DAILY PROFIT TARGET ====================
profitTargetGroup = "💰 Daily Profit Target"
enableDailyProfitTarget = input.bool(true, "Enable Daily Profit Target", group=profitTargetGroup)
dailyProfitTarget = input.float(1500.0, "Daily Profit Target ($)", minval=500, maxval=5000, group=profitTargetGroup)
// ==================== 🎯 PRICE MOMENTUM OVERRIDE ====================
momentumOverrideGroup = "🎯 PRICE MOMENTUM OVERRIDE"
