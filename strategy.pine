    else if rangingMarket
        riskMultiplier := math.max((isMYM ? 1.4 : 1.2) * timeframeMultiplier, 0.5)
    else
        riskMultiplier := math.max((isMYM ? 1.0 : 0.8) * timeframeMultiplier, 0.5)
riskMultiplier := math.max(math.min(riskMultiplier, 5.0), 0.1)
effectiveRiskPercent = math.max(math.min(adjustedRiskPercent * riskMultiplier * tradeFrequencyBoost, 4.5), 0.1)
riskAmountDollars = math.max(strategy.equity * effectiveRiskPercent / 100, 100)
futuresStopDistance = math.max(safeATR * (is1min ? (isMYM ? 1.8 : 2.0) : is2min ? (isMYM ? 2.0 : 2.2) : is3min ? (isMYM ? 2.2 : 2.4) : is5min ? (isMYM ? 2.4 : 2.6) : is10min ? (isMYM ? 2.6 : 2.8) : is15min ? (isMYM ? 2.8 : 3.0) : is30min ? (isMYM ? 3.0 : 3.2) : is1hour ? (isMYM ? 3.2 : 3.4) : is2hour ? (isMYM ? 3.4 : 3.6) : is4hour ? (isMYM ? 3.6 : 3.8) : (isMYM ? 2.6 : 2.8)), syminfo.mintick * 10)
stopDistanceDollars = math.max(futuresStopDistance * syminfo.pointvalue, 1)
contractsFromRisk = math.floor(riskAmountDollars / stopDistanceDollars)
maxContracts = math.floor((strategy.equity * maxPositionSize / 100) / (close * syminfo.pointvalue))
if useFixedContractSize
    finalContractQty := fixedContracts
else if useDynamicSizing
    finalContractQty := int(math.max(math.min(contractsFromRisk, maxContracts), 1))
else
