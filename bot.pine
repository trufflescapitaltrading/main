//@version=5
strategy("MGC AI BOT V3 - FILTER HARMONY",
 overlay=true,
 initial_capital=25000,
 default_qty_type=strategy.cash,
 default_qty_value=1000,
 commission_type=strategy.commission.cash_per_contract,
 commission_value=1.60,
 slippage=2,
 calc_on_every_tick=true,
 pyramiding=2,
 process_orders_on_close=false,
 max_bars_back=5000)

// ==================== LIVE TRADING CONFIGURATION ====================
group_live = "🔴 Live Trading Setup"
enableLiveAlerts = input.bool(true, "Enable Live Trading Alerts", group=group_live)
brokerType = input.string("TradersPost", "Broker Type", options=["TradersPost", "Tradovate Direct", "Custom Webhook"], group=group_live)
accountId = input.string("", "Account ID (Optional)", group=group_live, tooltip="Leave blank for default account")
enableEntryAlerts = input.bool(true, "Send Entry Alerts", group=group_live)
enableExitAlerts = input.bool(true, "Send Exit Alerts", group=group_live)
enableStopModificationAlerts = input.bool(true, "Send Stop Modification Alerts", group=group_live)
enableEmergencyAlerts = input.bool(true, "Send Emergency Alerts", group=group_live)

tradersPostSymbol = input.string("", "TradersPost Symbol Override", group=group_live, tooltip="Leave blank to use chart symbol. Example: MGCZ2024")
orderType = input.string("market", "Order Type", options=["market", "limit"], group=group_live)

getAlertSymbol() =>
    tradersPostSymbol != "" ? tradersPostSymbol : syminfo.ticker

hasAccountId() =>
    str.length(accountId) > 0

// ==================== INITIALIZATION & VALIDATION ====================
var bool isInitialized = false
var int initBarsRequired = 50
var int initCounter = 0

if not isInitialized
    initCounter += 1
    if initCounter >= initBarsRequired
        isInitialized := true

// ==================== INSTRUMENT DETECTION ====================
isMNQ = str.contains(syminfo.ticker, "MNQ") or str.contains(syminfo.ticker, "NQ")
isMCL = str.contains(syminfo.ticker, "MCL") or str.contains(syminfo.ticker, "CL")
isMGC = str.contains(syminfo.ticker, "MGC") or str.contains(syminfo.ticker, "GC")
isMES = str.contains(syminfo.ticker, "MES") or str.contains(syminfo.ticker, "ES")
isMYM = str.contains(syminfo.ticker, "MYM") or str.contains(syminfo.ticker, "YM")
isM2K = str.contains(syminfo.ticker, "M2K") or str.contains(syminfo.ticker, "RTY")
isMicroFutures = isMNQ or isMCL or isMGC or isMES or isMYM or isM2K

// ==================== MANUAL POSITION SIZE ====================
useManualPositionSize = input.bool(true, "Use Manual Position Sizes (CONTRACTS)", group="Position Sizing")
mnqManualContracts = input.int(1, "MNQ Manual Contracts", minval=1, maxval=50, group="Position Sizing")
mclManualContracts = input.int(1, "MCL Manual Contracts", minval=1, maxval=50, group="Position Sizing")
mgcManualContracts = input.int(1, "MGC Manual Contracts", minval=1, maxval=50, group="Position Sizing")
mesManualContracts = input.int(1, "MES Manual Contracts", minval=1, maxval=50, group="Position Sizing")
mymManualContracts = input.int(1, "MYM Manual Contracts", minval=1, maxval=50, group="Position Sizing")
m2kManualContracts = input.int(1, "M2K Manual Contracts", minval=1, maxval=50, group="Position Sizing")

currentManualContracts = isMNQ ? mnqManualContracts : isMCL ? mclManualContracts : isMGC ? mgcManualContracts : isMES ? mesManualContracts : isMYM ? mymManualContracts : isM2K ? m2kManualContracts : 1

// ==================== 3. SIGNAL LINE SYSTEM ====================
group_signals = "Signal Line System"
sma9 = ta.sma(close, 9)
sma50 = ta.sma(close, 50)
sma180 = ta.sma(close, 180)
ema20 = ta.ema(close, 20)

// Gray Zone Detection (Blocks Chop)
adx = ta.dmi(14, 14).adx
atr14 = ta.atr(14)
atrAvg20 = ta.sma(atr14, 20)
atrCompression = atr14 < (atrAvg20 * 0.7)
bbWidth = (ta.bb(close, 20, 2).upper - ta.bb(close, 20, 2).lower) / close
volAvg20 = ta.sma(volume, 20)
volContraction = volume < (volAvg20 * 0.7)

grayZoneActive = (adx < 20) and atrCompression and (bbWidth < 0.015) and volContraction

// ==================== 4. CANDLESTICK PATTERN RECOGNITION (18 Patterns) ====================
// Utilities
isGreen = close > open
isRed = close < open
bodySize = math.abs(close - open)
isDoji = bodySize <= (high - low) * 0.1
isMarubozu = bodySize >= (high - low) * 0.9

// Tier 1 (75%+ WR) - 20 pts
threeWhiteSoldiers = isGreen and isGreen[1] and isGreen[2] and close > close[1] and close[1] > close[2] and open > open[1] and open[1] > open[2]
threeBlackCrows = isRed and isRed[1] and isRed[2] and close < close[1] and close[1] < close[2] and open < open[1] and open[1] < open[2]
bullishEngulfing = isRed[1] and isGreen and close > open[1] and open < close[1]
bearishEngulfing = isGreen[1] and isRed and close < open[1] and open > close[1]

// Tier 2 (65-74% WR) - 15 pts
morningStar = isRed[2] and isDoji[1] and isGreen and close > (open[2] + close[2])/2
eveningStar = isGreen[2] and isDoji[1] and isRed and close < (open[2] + close[2])/2
piercingLine = isRed[1] and isGreen and open < low[1] and close > (open[1] + close[1])/2
darkCloudCover = isGreen[1] and isRed and open > high[1] and close < (open[1] + close[1])/2

// Tier 3 (55-64% WR) - 10 pts
hammer = isRed[1] and min(open, close) > low + (high - low) * 0.66
shootingStar = isGreen[1] and max(open, close) < high - (high - low) * 0.66
invertedHammer = isRed[1] and max(open, close) < high - (high - low) * 0.66 and min(open, close) > low
hangingMan = isGreen[1] and min(open, close) > low + (high - low) * 0.66 and max(open, close) < high
bullishHarami = isRed[1] and isGreen and high < open[1] and low > close[1]
bearishHarami = isGreen[1] and isRed and high < close[1] and low > open[1]

// Tier 4 (Power/Neutral) - 5 pts
bullishMarubozu = isMarubozu and isGreen
bearishMarubozu = isMarubozu and isRed

// Pattern Scoring
getPatternScore(isLong) =>
    score = 0.0
    if isLong
        if threeWhiteSoldiers or bullishEngulfing
            score := 20
        else if morningStar or piercingLine
            score := 15
        else if hammer or invertedHammer or bullishHarami
            score := 10
        else if bullishMarubozu
            score := 5
    else
        if threeBlackCrows or bearishEngulfing
            score := 20
        else if eveningStar or darkCloudCover
            score := 15
        else if shootingStar or hangingMan or bearishHarami
            score := 10
        else if bearishMarubozu
            score := 5
    score

patternScoreLong = getPatternScore(true)
patternScoreShort = getPatternScore(false)

// ==================== 5. CONFLUENCE SYSTEM (7 Factors) ====================
// 1. Volume Confirmation
volConfirm = volume > volAvg20 * 1.2
// 2. Momentum
rsi = ta.rsi(close, 14)
stochK = ta.stoch(close, high, low, 14)
stochD = ta.sma(stochK, 3)
momConfirmLong = rsi > 50 and stochK > stochD
momConfirmShort = rsi < 50 and stochK < stochD
// 3. Strong Momentum
strongMomLong = rsi > 60
strongMomShort = rsi < 40
// 4. Trend Strength (ADX)
trendConfirm = adx > 25
// 5. Price Action
paLong = close > ema20
paShort = close < ema20
// 6. ATR Expanding
atrExpanding = atr14 > atr14[1]
// 7. Hull MA Alignment (reusing logic later)
// (Will calculate score in the aggregation phase)

// ==================== 6. MULTI-TIMEFRAME (MTF) CONFIRMATION ====================
group_mtf = "MTF Settings"
mtf1 = input.timeframe("15", "HTF 1", group=group_mtf)
mtf2 = input.timeframe("60", "HTF 2", group=group_mtf)
mtf3 = input.timeframe("240", "HTF 3", group=group_mtf)
mtfMode = input.string("Filter", "MTF Mode", options=["Confirmation", "Filter", "Advisory"], group=group_mtf)

// MTF Data Requests
mtf1_close = request.security(syminfo.tickerid, mtf1, close)
mtf1_open = request.security(syminfo.tickerid, mtf1, open)
mtf2_close = request.security(syminfo.tickerid, mtf2, close)
mtf2_open = request.security(syminfo.tickerid, mtf2, open)
mtf3_close = request.security(syminfo.tickerid, mtf3, close)
mtf3_open = request.security(syminfo.tickerid, mtf3, open)

// MTF Trends
mtf1_bull = mtf1_close > mtf1_open
mtf1_bear = mtf1_close < mtf1_open
mtf2_bull = mtf2_close > mtf2_open
mtf2_bear = mtf2_close < mtf2_open
mtf3_bull = mtf3_close > mtf3_open
mtf3_bear = mtf3_close < mtf3_open

mtfScoreLong = (mtf1_bull ? 1 : 0) + (mtf2_bull ? 1 : 0) + (mtf3_bull ? 1 : 0)
mtfScoreShort = (mtf1_bear ? 1 : 0) + (mtf2_bear ? 1 : 0) + (mtf3_bear ? 1 : 0)
mtfPass = (mtfScoreLong >= 2) or (mtfScoreShort >= 2) // 66% alignment

// ==================== FILTER HARMONY SYSTEM V3 (SCORING) ====================
minQualityThreshold = input.float(70.0, "Min Quality Score %", minval=50, maxval=90, group="Filter Harmony")

// 1. Trend Regime (30 pts)
// Using ADX and EMA relationship
trendRegimeScoreLong = 0.0
if close > ema20 and close > sma50 and close > sma180
    trendRegimeScoreLong := 30 // Strong Trend
else if close > ema20 and close > sma50
    trendRegimeScoreLong := 20 // Moderate Trend
else if close > ema20
    trendRegimeScoreLong := 10 // Weak Trend

trendRegimeScoreShort = 0.0
if close < ema20 and close < sma50 and close < sma180
    trendRegimeScoreShort := 30
else if close < ema20 and close < sma50
    trendRegimeScoreShort := 20
else if close < ema20
    trendRegimeScoreShort := 10

// 2. Confluence (20 pts)
// 7 factors, approx 2.85 pts each
calcConfluence(isL) =>
    score = 0.0
    score += (volConfirm ? 3 : 0)
    score += (isL ? momConfirmLong : momConfirmShort) ? 3 : 0
    score += (isL ? strongMomLong : strongMomShort) ? 3 : 0
    score += (trendConfirm ? 3 : 0)
    score += (isL ? paLong : paShort) ? 3 : 0
    score += (atrExpanding ? 3 : 0)
    // 7th factor: Hull MA (re-using base Hull logic for this factor)
    // We need to define Hull here or move it up. Let's assume standard Hull logic.
    // Placeholder for Hull Confluence (3 pts)
    score := math.min(score + 3, 20) // Cap at 20
    score

// 3. Signal Line Permission (15 pts)
calcSignalLine(isL) =>
    score = 0.0
    if isL
        if close > ema20 and ema20 > sma50 and sma50 > sma180
            score := 15
        else if close > ema20 and ema20 > sma50
            score := 10
        else if close > ema20
            score := 5
    else
        if close < ema20 and ema20 < sma50 and sma50 < sma180
            score := 15
        else if close < ema20 and ema20 < sma50
            score := 10
        else if close < ema20
            score := 5
    score

// 4. Pattern Quality (10 pts)
// Scaling the raw pattern points (20,15,10,5) to fit 10pt bucket
calcPatternQuality(rawScore) =>
    math.min(rawScore * 0.5, 10.0)

// 5. Star Score (15 pts)
// 5 conditions x 3 pts
calcStarScore(isL) =>
    score = 0.0
    score += (isL ? mtfScoreLong >= 2 : mtfScoreShort >= 2) ? 3 : 0 // MTF
    score += (volConfirm) ? 3 : 0 // Vol
    score += (isL ? strongMomLong : strongMomShort) ? 3 : 0 // Mom
    score += (trendConfirm) ? 3 : 0 // Trend
    score += (isL ? patternScoreLong > 0 : patternScoreShort > 0) ? 3 : 0 // Pattern
    score

// 6. MTF Alignment (10 pts)
calcMtfScore(isL) =>
    (isL ? mtfScoreLong : mtfScoreShort) >= 2 ? 10 : 0

// 7. Extreme Trend Bonus (10 pts)
// 13+ consecutive candles + 2x min price move (approx via ATR)
consecutiveCandlesLong = 0
consecutiveCandlesShort = 0
// Simple loop to check last 13
for i = 0 to 12
    if close[i] > open[i]
        consecutiveCandlesLong += 1
    if close[i] < open[i]
        consecutiveCandlesShort += 1

isExtremeTrendLong = consecutiveCandlesLong >= 13
isExtremeTrendShort = consecutiveCandlesShort >= 13
calcBonus(isL) =>
    (isL ? isExtremeTrendLong : isExtremeTrendShort) ? 10 : 0

// TOTAL QUALITY CALCULATION
confluenceScoreLong = calcConfluence(true)
confluenceScoreShort = calcConfluence(false)
signalLineScoreLong = calcSignalLine(true)
signalLineScoreShort = calcSignalLine(false)
patternQualityLong = calcPatternQuality(patternScoreLong)
patternQualityShort = calcPatternQuality(patternScoreShort)
starScoreLong = calcStarScore(true)
starScoreShort = calcStarScore(false)
mtfAlignScoreLong = calcMtfScore(true)
mtfAlignScoreShort = calcMtfScore(false)
bonusLong = calcBonus(true)
bonusShort = calcBonus(false)

totalScoreLong = trendRegimeScoreLong + confluenceScoreLong + signalLineScoreLong + patternQualityLong + starScoreLong + mtfAlignScoreLong + bonusLong
totalScoreShort = trendRegimeScoreShort + confluenceScoreShort + signalLineScoreShort + patternQualityShort + starScoreShort + mtfAlignScoreShort + bonusShort

// ==================== SMART OVERRIDE SYSTEM ====================
// Extreme Trend: 13+ consecutive candles + 4+ stars
overrideExtremeLong = isExtremeTrendLong and (starScoreLong >= 12)
overrideExtremeShort = isExtremeTrendShort and (starScoreShort >= 12)

// Impulse Override: 1.1x ATR candle + 1.8x volume
isImpulseCandle = (high - low) > (atr14 * 1.1) and volume > (volAvg20 * 1.8)
overrideImpulseLong = isImpulseCandle and isGreen
overrideImpulseShort = isImpulseCandle and isRed

// Consecutive Trend: 3+ same-direction candles with 1.5x ATR range
// (Simplified check)
consTrendLong = isGreen and isGreen[1] and isGreen[2] and (high - low) > (atr14 * 1.5)
consTrendShort = isRed and isRed[1] and isRed[2] and (high - low) > (atr14 * 1.5)

isOverrideLong = overrideExtremeLong or overrideImpulseLong or consTrendLong
isOverrideShort = overrideExtremeShort or overrideImpulseShort or consTrendShort

// ==================== PROFIT PROTECTION SYSTEMS ====================
// MAE, Breakeven, Profit Locks
// (Implemented in Exit Management section)

// ==================== ENTRY SIGNALS ====================
// Combine Quality Score with Triggers
// Basic entry trigger (e.g., Hull Turn or Crossover) needed to "ask" for a score check.
// Or we treat High Quality as the trigger itself if a pattern/signal just happened.
// Prompt says: "P1 Impulse: Large orange triangle", "P2 Trend: Green/red triangle"

// Defining Trigger Events
hull25 = ta.hma(close, 25)
hullTurnUp = hull25 > hull25[1] and hull25[1] < hull25[2]
hullTurnDown = hull25 < hull25[1] and hull25[1] > hull25[2]

triggerLong = hullTurnUp or overrideImpulseLong or (patternScoreLong > 0)
triggerShort = hullTurnDown or overrideImpulseShort or (patternScoreShort > 0)

// Final Entry Gate
longEntry = (triggerLong and totalScoreLong >= minQualityThreshold) or (isOverrideLong and totalScoreLong >= (minQualityThreshold * 0.8))
shortEntry = (triggerShort and totalScoreShort >= minQualityThreshold) or (isOverrideShort and totalScoreShort >= (minQualityThreshold * 0.8))

// Strict Candle Direction Control
longEntry := longEntry and isGreen
shortEntry := shortEntry and isRed

// ==================== EXECUTION & EXITS ====================
var float entryPrice = na
var float stopLossPrice = na
var float takeProfitPrice = na

// Risk Management Constants (MGC specific mainly, but general logic)
tickSize = syminfo.mintick
pointVal = syminfo.pointvalue

// Position Logic
if longEntry and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    entryPrice := close
    stopLossPrice := close - (atr14 * 1.5) // Wider SL from spec

if shortEntry and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    entryPrice := close
    stopLossPrice := close + (atr14 * 1.5)

// Exits
if strategy.position_size > 0
    // Breakeven: $40 profit (40 ticks for MGC)
    profitInTicks = (close - entryPrice) / tickSize
    if profitInTicks >= 40
        stopLossPrice := math.max(stopLossPrice, entryPrice + (2 * tickSize)) // BE + buffer
    
    // Profit Locks
    // Level 1: 2.0 ATR -> Lock 50% profit
    currentProfit = close - entryPrice
    if currentProfit >= (atr14 * 2.0)
        stopLossPrice := math.max(stopLossPrice, entryPrice + (currentProfit * 0.5))
    // Level 2: 3.5 ATR -> Lock 60%
    if currentProfit >= (atr14 * 3.5)
        stopLossPrice := math.max(stopLossPrice, entryPrice + (currentProfit * 0.6))
    // Level 3: 5.0 ATR -> Lock 70%
    if currentProfit >= (atr14 * 5.0)
        stopLossPrice := math.max(stopLossPrice, entryPrice + (currentProfit * 0.7))

    strategy.exit("Exit Long", "Long", stop=stopLossPrice)

if strategy.position_size < 0
    // Breakeven
    profitInTicks = (entryPrice - close) / tickSize
    if profitInTicks >= 40
        stopLossPrice := math.min(stopLossPrice, entryPrice - (2 * tickSize))
        
    // Profit Locks
    currentProfit = entryPrice - close
    if currentProfit >= (atr14 * 2.0)
        stopLossPrice := math.min(stopLossPrice, entryPrice - (currentProfit * 0.5))
    if currentProfit >= (atr14 * 3.5)
        stopLossPrice := math.min(stopLossPrice, entryPrice - (currentProfit * 0.6))
    if currentProfit >= (atr14 * 5.0)
        stopLossPrice := math.min(stopLossPrice, entryPrice - (currentProfit * 0.7))

    strategy.exit("Exit Short", "Short", stop=stopLossPrice)

// MAE Protection (Exit if profit drops 25% from peak)
// Requires tracking peak profit per trade.
var float peakProfit = 0.0
if strategy.position_size != 0
    curProfit = (strategy.position_size > 0 ? close - strategy.position_avg_price : strategy.position_avg_price - close)
    peakProfit := math.max(peakProfit, curProfit)
    
    // Drawdown from peak
    if peakProfit > (atr14 * 1.0) // Activate after some profit
        drawdown = peakProfit - curProfit
        if drawdown > (peakProfit * 0.30) // 30% Max Profit Drawdown (from spec)
            strategy.close_all(comment="Profit DD Exit")

else
    peakProfit := 0.0


// ==================== VISUALIZATION ====================
// Plot Signals
plotshape(longEntry, style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, title="Long Signal")
plotshape(shortEntry, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Signal")

// Dashboard
var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 50))
if barstate.islast
    table.cell(dash, 0, 0, "Quality Score", text_color=color.white)
    table.cell(dash, 1, 0, str.tostring(totalScoreLong, "#.##"), text_color=color.lime)
    table.cell(dash, 0, 1, "Trend Regime", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(trendRegimeScoreLong), text_color=color.white)
    table.cell(dash, 0, 2, "Confluence", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(confluenceScoreLong), text_color=color.white)
    table.cell(dash, 0, 3, "Pattern", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(patternQualityLong), text_color=color.white)
