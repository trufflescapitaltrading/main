disableChoppyInTrend = input.bool(true, "Disable Choppy Filter During Trends", group=choppyFilterGroup)
disableChoppyInPosition = input.bool(false, "Disable Choppy When In Position", group=choppyFilterGroup)
emergencyGroup = "V8 Emergency Safety System"
enableBackupSL = input.bool(true, "Enable Backup Stop Loss", group=emergencyGroup)
