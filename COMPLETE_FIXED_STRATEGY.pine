// ==================== 🕐 SESSION FILTERS (FIXED) ====================
sessionGroup = "🌍 Trading Sessions & Times"
enable24_7Trading = input.bool(true, "✅ Enable 24/7 Trading", group=sessionGroup)
enableTradingHours = input.bool(true, "Trading Hours (4 AM - 8 PM ET)", group=sessionGroup)
tradingHoursStart = input.int(400, "Start (4:00 AM ET)", minval=0, maxval=2359, group=sessionGroup)
tradingHoursEnd = input.int(2000, "End (8:00 PM ET)", minval=0, maxval=2359, group=sessionGroup)
enableNoTradeZone = input.bool(false, "🚫 No Trade Zone (BLOCKS trades)", group=sessionGroup)
noTradeStart = input.int(0, "No Trade Start (12:00 AM ET)", minval=0, maxval=2359, group=sessionGroup)
noTradeEnd = input.int(600, "No Trade End (6:00 AM ET)", minval=0, maxval=2359, group=sessionGroup)
enableAsianSession = input.bool(true, "🇯🇵 Asian Session", group=sessionGroup)
asianStart = input.int(1900, "Asian Start (ET)", minval=0, maxval=2359, group=sessionGroup)
asianEnd = input.int(300, "Asian End (ET)", minval=0, maxval=2359, group=sessionGroup)
enableLondonSession = input.bool(true, "🇬🇧 London Session", group=sessionGroup)
londonStart = input.int(300, "London Start (ET)", minval=0, maxval=2359, group=sessionGroup)
londonEnd = input.int(1200, "London End (ET)", minval=0, maxval=2359, group=sessionGroup)
enableNYSession = input.bool(true, "🇺🇸 NY Session", group=sessionGroup)
nyStart = input.int(400, "NY Start (ET)", minval=0, maxval=2359, group=sessionGroup)
nyEnd = input.int(2000, "NY End (ET)", minval=0, maxval=2359, group=sessionGroup)
enableUAESession = input.bool(true, "🇦🇪 UAE Session", group=sessionGroup)
uaeStart = input.int(0, "UAE Start (ET)", minval=0, maxval=2359, group=sessionGroup)
uaeEnd = input.int(800, "UAE End (ET)", minval=0, maxval=2359, group=sessionGroup)
