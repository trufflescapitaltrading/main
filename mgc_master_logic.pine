//@version=6
strategy("MGC Master Logic V8.0 [Harmony System]", overlay=true, margin_long=100, margin_short=100, currency=currency.USD, initial_capital=50000, calc_on_order_fills=true)

// =============================================================================
// 1. PARAMETERS & INPUTS
// =============================================================================

// --- Position & Risk ---
manual_contracts = input.int(12, "Manual Contracts", group="Position Sizing")
use_atr_sizing   = input.bool(false, "Use ATR Sizing", group="Position Sizing")
atr_risk_pct     = input.float(0.01, "ATR Risk %", group="Position Sizing")
atr_length       = input.int(14, "ATR Length", group="Position Sizing")

// --- Automation ---
use_automation = input.bool(true, "Enable TradersPost Alerts", group="Automation")

// --- Filter Harmony System v3 ---
quality_threshold_min = input.float(70.0, "Min Quality Score (%)", minval=50, maxval=90, group="Harmony Filter")
high_wr_mode          = input.bool(true, "High Win Rate Mode", group="Harmony Filter")

// --- Sessions ---
session_asian  = input.session("1900-0300:1234567", "Asian Session (ET)", group="Sessions")
session_london = input.session("0300-1200:1234567", "London Session (ET)", group="Sessions")
session_ny     = input.session("0930-1600:1234567", "NY Session (ET)", group="Sessions")
session_uae    = input.session("0000-0800:1234567", "UAE Session (ET)", group="Sessions")
session_block  = input.session("0000-0600:1234567", "No Trade Zone (ET)", group="Sessions")

// --- Signal Line System ---
sma_fast_len   = input.int(9, "SMA Fast (Red)", group="Signal Lines")
sma_med_len    = input.int(50, "SMA Medium (Blue)", group="Signal Lines")
sma_slow_len   = input.int(180, "SMA Slow (White)", group="Signal Lines")
ema_main_len   = input.int(20, "EMA Main (Yellow)", group="Signal Lines")

// --- Profit Protection ---
mae_threshold_pct     = input.float(0.7, "MAE Threshold (x Profit)", group="Protection") // 0.7 in High WR
breakeven_trigger_dol = input.float(40.0, "Breakeven Trigger ($)", group="Protection")
profit_lock_1_atr     = input.float(2.0, "Profit Lock 1 (ATR)", group="Protection")
profit_lock_1_pct     = input.float(0.5, "Profit Lock 1 (%)", group="Protection")
profit_lock_2_atr     = input.float(3.5, "Profit Lock 2 (ATR)", group="Protection")
profit_lock_2_pct     = input.float(0.6, "Profit Lock 2 (%)", group="Protection")
profit_lock_3_atr     = input.float(5.0, "Profit Lock 3 (ATR)", group="Protection")
profit_lock_3_pct     = input.float(0.7, "Profit Lock 3 (%)", group="Protection")
max_dd_from_peak_pct  = input.float(0.3, "Max Profit Drawdown (%)", group="Protection")

// --- Daily Limits ---
daily_loss_limit       = input.float(450.0, "Daily Loss Limit ($)", group="Daily Limits")
daily_profit_limit     = input.float(1000.0, "Daily Profit Limit ($)", group="Daily Limits")
max_consecutive_losses = input.int(3, "Max Consecutive Losses", group="Daily Limits")

// =============================================================================
// 2. INDICATOR CALCULATIONS
// =============================================================================

// ATR
atr_val = ta.atr(atr_length)

// Signal Lines
sma_9   = ta.sma(close, sma_fast_len)
sma_50  = ta.sma(close, sma_med_len)
sma_180 = ta.sma(close, sma_slow_len)
ema_20  = ta.ema(close, ema_main_len)

// HMA Suite
f_hma(src, len) =>
    half = math.floor(len / 2)
    sqrt = math.floor(math.sqrt(len))
    wma_half = ta.wma(src, half)
    wma_full = ta.wma(src, len)
    ta.wma(2 * wma_half - wma_full, sqrt)

hma_main   = f_hma(close, 25) // Base 25
hma_fast   = f_hma(close, 9)  // Base 9
hma_signal = f_hma(close, 14) // Base 14

// SuperTrend
[st_val, st_dir] = ta.supertrend(2.2, 10) // 2.2x ATR
st_bullish = st_dir == -1
st_bearish = st_dir == 1

// RSI
rsi_val = ta.rsi(close, 6) // Base 6

// Stochastic
k = ta.sma(ta.stoch(close, high, low, 6), 3)
d = ta.sma(k, 3)

// ADX
[di_plus, di_minus, adx_val] = ta.dmi(14, 14)

// Volume
vol_ma = ta.sma(volume, 20)
vol_surge = volume > (vol_ma * 1.2)
vol_normal = volume > (vol_ma * 0.7)

// =============================================================================
// 3. FILTER HARMONY SYSTEM v3 (SCORING)
// =============================================================================

// --- A. Trend Regime (30 pts) ---
// Strength score 0-4
trend_score = 0.0
if close > sma_50 and sma_50 > sma_180
    trend_score := trend_score + 1 // Bullish alignment
if hma_main > hma_main[1]
    trend_score := trend_score + 1 // Hull slope
if st_bullish
    trend_score := trend_score + 1 // Supertrend
if adx_val > 20
    trend_score := trend_score + 1 // ADX Strength

regime_pts_bull = (trend_score / 4) * 30

trend_score_bear = 0.0
if close < sma_50 and sma_50 < sma_180
    trend_score_bear := trend_score_bear + 1
if hma_main < hma_main[1]
    trend_score_bear := trend_score_bear + 1
if st_bearish
    trend_score_bear := trend_score_bear + 1
if adx_val > 20
    trend_score_bear := trend_score_bear + 1

regime_pts_bear = (trend_score_bear / 4) * 30

// --- B. Confluence (20 pts) ---
// 7 Factors: Vol, Strong Vol, Mom Align, Strong Mom, Trend, PA, ATR Exp
conf_score_bull = 0.0
if vol_normal
    conf_score_bull := conf_score_bull + 1
if vol_surge
    conf_score_bull := conf_score_bull + 1
if rsi_val > 50 and k > d
    conf_score_bull := conf_score_bull + 1 // Mom Align
if rsi_val > 60
    conf_score_bull := conf_score_bull + 1 // Strong Mom
if st_bullish
    conf_score_bull := conf_score_bull + 1 // Trend
if close > open
    conf_score_bull := conf_score_bull + 1 // PA
if atr_val > ta.sma(atr_val, 20)
    conf_score_bull := conf_score_bull + 1 // ATR Exp

confluence_pts_bull = (conf_score_bull / 7) * 20

conf_score_bear = 0.0
if vol_normal
    conf_score_bear := conf_score_bear + 1
if vol_surge
    conf_score_bear := conf_score_bear + 1
if rsi_val < 50 and k < d
    conf_score_bear := conf_score_bear + 1
if rsi_val < 40
    conf_score_bear := conf_score_bear + 1
if st_bearish
    conf_score_bear := conf_score_bear + 1
if close < open
    conf_score_bear := conf_score_bear + 1
if atr_val > ta.sma(atr_val, 20)
    conf_score_bear := conf_score_bear + 1

confluence_pts_bear = (conf_score_bear / 7) * 20

// --- C. Signal Line Permission (15 pts) ---
// SMA Alignment
sig_line_pts_bull = (close > ema_20 and ema_20 > sma_50) ? 15 : 0
sig_line_pts_bear = (close < ema_20 and ema_20 < sma_50) ? 15 : 0

// --- D. Pattern Quality (10 pts) ---
// Simplified Tier System for now
// Tier 1 (20pts used as max 10 here scaled?) -> Logic says Tier 1=20pts.
// Harmony specs say Pattern Quality is 10 points max.
// We will scale pattern tiers to fit 10 points.
// Tier 1: Engulfing, Soldiers/Crows -> 10 pts
// Tier 2: Morning/Evening Star -> 7.5 pts
// Tier 3: Hammer/Shooting Star -> 5 pts
// Tier 4: Doji -> 2.5 pts

is_engulfing_bull = open[1] > close[1] and close > open and close > open[1] and close[1] > open
is_soldiers = close > open and close[1] > open[1] and close[2] > open[2]
tier1_bull = is_engulfing_bull or is_soldiers

is_engulfing_bear = close[1] > open[1] and open > close and open > close[1] and close < open[1]
is_crows = close < open and close[1] < open[1] and close[2] < open[2]
tier1_bear = is_engulfing_bear or is_crows

pattern_pts_bull = tier1_bull ? 10 : 0 // Simplified for brevity, expand later
pattern_pts_bear = tier1_bear ? 10 : 0

// --- E. Star Score (15 pts) ---
// 5 stars * 3 pts
// Star 1: Fast > Signal
// Star 2: Close > Main HMA
// Star 3: SuperTrend
// Star 4: RSI > 50
// Star 5: Envelope (Simplified here as Close > EMA20 as proxy for envelope lower)
star_bull = 0
if hma_fast > hma_signal
    star_bull := star_bull + 1
if close > hma_main
    star_bull := star_bull + 1
if st_bullish
    star_bull := star_bull + 1
if rsi_val > 50
    star_bull := star_bull + 1
if close > ema_20
    star_bull := star_bull + 1
star_pts_bull = star_bull * 3

star_bear = 0
if hma_fast < hma_signal
    star_bear := star_bear + 1
if close < hma_main
    star_bear := star_bear + 1
if st_bearish
    star_bear := star_bear + 1
if rsi_val < 50
    star_bear := star_bear + 1
if close < ema_20
    star_bear := star_bear + 1
star_pts_bear = star_bear * 3

// --- F. MTF Alignment (10 pts) ---
// Placeholder for MTF (using current chart trend as proxy for now to avoid repainting/complex calls in this step)
// Real MTF would use request.security.
mtf_pts_bull = (close > sma_180) ? 10 : 0
mtf_pts_bear = (close < sma_180) ? 10 : 0

// --- G. Extreme Trend Bonus (10 pts) ---
// 13+ candles check
green_run = 0
for i = 0 to 12
    if close[i] > open[i]
        green_run := green_run + 1
extreme_bull = green_run >= 10 // Relaxed slightly
bonus_pts_bull = extreme_bull ? 10 : 0

red_run = 0
for i = 0 to 12
    if close[i] < open[i]
        red_run := red_run + 1
extreme_bear = red_run >= 10
bonus_pts_bear = extreme_bear ? 10 : 0

// --- TOTAL SCORE ---
quality_score_bull = regime_pts_bull + confluence_pts_bull + sig_line_pts_bull + pattern_pts_bull + star_pts_bull + mtf_pts_bull + bonus_pts_bull
quality_score_bear = regime_pts_bear + confluence_pts_bear + sig_line_pts_bear + pattern_pts_bear + star_pts_bear + mtf_pts_bear + bonus_pts_bear

// =============================================================================
// 4. OVERRIDES & GRAY ZONE
// =============================================================================
// Smart Override
impulse_override_bull = (high - low) > (atr_val * 1.1) and vol_surge and close > open
impulse_override_bear = (high - low) > (atr_val * 1.1) and vol_surge and close < open

// Gray Zone (Chop)
is_chop = adx_val < 20 and atr_val < (ta.sma(atr_val, 100) * 0.7)
// Allow swing signals in gray zone? (Not fully implemented, using strict score)

// =============================================================================
// 5. ENTRY LOGIC
// =============================================================================

// Strict Direction Control
valid_candle_bull = close > open and (math.abs(close - open) > atr_val * 0.1) // Body size check
valid_candle_bear = close < open and (math.abs(close - open) > atr_val * 0.1)

// Threshold Check
is_high_quality_bull = quality_score_bull >= quality_threshold_min
is_high_quality_bear = quality_score_bear >= quality_threshold_min

// Final Entry Signal
// Bias lock logic handled by score (Regime pts)
go_long = valid_candle_bull and (is_high_quality_bull or impulse_override_bull) and not is_chop
go_short = valid_candle_bear and (is_high_quality_bear or impulse_override_bear) and not is_chop

// Session Filter
time_ok = not na(time(timeframe.period, session_block)) == false // Block NOT active
// Must be in one of the active sessions
in_asian = not na(time(timeframe.period, session_asian))
in_london = not na(time(timeframe.period, session_london))
in_ny = not na(time(timeframe.period, session_ny))
in_uae = not na(time(timeframe.period, session_uae))
session_ok = (in_asian or in_london or in_ny or in_uae) and time_ok

// Daily Limit Logic
var float daily_pnl = 0.0
var int daily_losses = 0
var int last_day = -1
current_day = dayofmonth(time)
if current_day != last_day
    daily_pnl := 0.0
    daily_losses := 0
    last_day := current_day

can_trade_daily = daily_pnl > -daily_loss_limit and daily_pnl < daily_profit_limit and daily_losses < max_consecutive_losses

// =============================================================================
// 6. EXECUTION & RISK
// =============================================================================

// Position Sizing
qty = manual_contracts
if use_atr_sizing
    risk_amt = strategy.equity * atr_risk_pct
    stop_dist = math.max(atr_val * 2.5, syminfo.mintick * 10)
    qty := math.max(1, math.floor(risk_amt / stop_dist))

// Entries
if go_long and strategy.position_size == 0 and session_ok and can_trade_daily
    sl = close - (atr_val * 2.5) // Initial SL
    strategy.entry("Long", strategy.long, qty=qty)
    if use_automation
        alert('{"action": "buy", "symbol": "' + syminfo.ticker + '", "quantity": ' + str.tostring(qty) + ', "price": ' + str.tostring(close) + ', "stop_loss": ' + str.tostring(sl) + '}', alert.freq_once_per_bar_close)

if go_short and strategy.position_size == 0 and session_ok and can_trade_daily
    sl = close + (atr_val * 2.5) // Initial SL
    strategy.entry("Short", strategy.short, qty=qty)
    if use_automation
        alert('{"action": "sell", "symbol": "' + syminfo.ticker + '", "quantity": ' + str.tostring(qty) + ', "price": ' + str.tostring(close) + ', "stop_loss": ' + str.tostring(sl) + '}', alert.freq_once_per_bar_close)

// =============================================================================
// 7. EXIT MANAGEMENT (HIERARCHY)
// =============================================================================

if strategy.position_size != 0
    is_long = strategy.position_size > 0
    entry_p = strategy.opentrades.entry_price(strategy.opentrades - 1)
    cur_p = close
    cur_profit_dol = (cur_p - entry_p) * strategy.position_size * syminfo.pointvalue
    
    // Variables for Stop Management
    var float active_sl = 0.0
    // Initialize SL on new trade
    if strategy.position_size != strategy.position_size[1]
        active_sl := is_long ? entry_p - (atr_val * 2.5) : entry_p + (atr_val * 2.5)
    
    // 1. MAE Protection (Drop from peak)
    // Needs peak tracking per trade
    var float peak_profit = 0.0
    if strategy.position_size != strategy.position_size[1]
        peak_profit := 0.0
    
    open_profit = (cur_p - entry_p) * (is_long ? 1 : -1)
    if open_profit > peak_profit
        peak_profit := open_profit
    
    // Max Profit Drawdown (30% from peak)
    if peak_profit > (atr_val * 1.0) // Activate after some profit
        drawdown_val = peak_profit * (1.0 - max_dd_from_peak_pct)
        if open_profit < drawdown_val
            strategy.close_all(comment="Max Profit DD")
            if use_automation
                alert('{"action": "close", "reason": "max_profit_dd"}', alert.freq_once_per_bar)

    // 2. Breakeven Protection ($40)
    // MGC point value = $10 ? No, MGC is Micro Gold.
    // Gold futures: 100 oz. MGC is 10 oz.
    // Tick size 0.10. Tick value $1.00.
    // So 1 point = $10.
    // $40 profit = 4 points.
    points_profit = open_profit
    dol_profit = points_profit * syminfo.pointvalue * math.abs(strategy.position_size)
    
    if dol_profit >= breakeven_trigger_dol
        be_level = is_long ? entry_p + syminfo.mintick*2 : entry_p - syminfo.mintick*2 // Buffer
        // Update SL to BE if better
        if is_long and be_level > active_sl
            active_sl := be_level
        if not is_long and be_level < active_sl
            active_sl := be_level

    // 3. Profit Locks (Tiered)
    // Level 1
    if open_profit >= (atr_val * profit_lock_1_atr)
        lock_p = entry_p + (open_profit * profit_lock_1_pct * (is_long ? 1 : -1)) 
        // Logic: Move stop to lock % of current profit?
        // Or "Lock 50% of profit" usually means move stop to Entry + 0.5 * Current_Open_Profit?
        // Yes.
        new_sl = entry_p + (open_profit * profit_lock_1_pct * (is_long ? 1 : -1))
        if is_long and new_sl > active_sl
            active_sl := new_sl
        if not is_long and new_sl < active_sl
            active_sl := new_sl
            
    // Level 2 (Overrides Level 1 if higher)
    if open_profit >= (atr_val * profit_lock_2_atr)
        new_sl = entry_p + (open_profit * profit_lock_2_pct * (is_long ? 1 : -1))
        if is_long and new_sl > active_sl
            active_sl := new_sl
        if not is_long and new_sl < active_sl
            active_sl := new_sl

    // Level 3
    if open_profit >= (atr_val * profit_lock_3_atr)
        new_sl = entry_p + (open_profit * profit_lock_3_pct * (is_long ? 1 : -1))
        if is_long and new_sl > active_sl
            active_sl := new_sl
        if not is_long and new_sl < active_sl
            active_sl := new_sl
            
    // Smart Trailing (SuperTrend or ATR trail)
    // Strategy logic says "Smart Trailing Stop: 0.6x ATR after profit activation"
    // Let's use 0.6 ATR trail if profit > 1.0 ATR
    if open_profit > atr_val
        trail_level = is_long ? close - (atr_val * 0.6) : close + (atr_val * 0.6)
        if is_long and trail_level > active_sl
            active_sl := trail_level
        if not is_long and trail_level < active_sl
            active_sl := active_sl // Wait, for short, lower is better? No, SL for short is above price.
            // If trail_level < active_sl (meaning closer to price), we update.
            active_sl := trail_level

    // Apply Stop
    strategy.exit("Exit", stop=active_sl)

    // Time-Based Protection (15 bars)
    bars_held = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    if bars_held > 15 and open_profit < (atr_val * 0.5) // Stalling
        strategy.close_all(comment="Time Stalling")
        if use_automation
            alert('{"action": "close", "reason": "stalling"}', alert.freq_once_per_bar)

// =============================================================================
// 8. PnL Tracking
// =============================================================================
if strategy.closedtrades > strategy.closedtrades[1]
    pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    daily_pnl := daily_pnl + pnl
    if pnl < 0
        daily_losses := daily_losses + 1
    else
        daily_losses := 0 // Reset on win? Or strict consecutive? Strategy says "Consecutive"

// =============================================================================
// 9. VISUALS & DASHBOARD
// =============================================================================
plot(sma_50, "SMA 50", color=color.blue)
plot(ema_20, "EMA 20", color=color.yellow)
plotchar(go_long, "Long", "▲", location.belowbar, color.green, size=size.small)
plotchar(go_short, "Short", "▼", location.abovebar, color.red, size=size.small)

// Dashboard (Simple Quality Score Display)
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 50))
if barstate.islast
    table.cell(dash, 0, 0, "Quality Bull", text_color=color.white)
    table.cell(dash, 1, 0, str.tostring(math.round(quality_score_bull, 1)) + "%", text_color=quality_score_bull >= quality_threshold_min ? color.green : color.red)
    table.cell(dash, 0, 1, "Quality Bear", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(math.round(quality_score_bear, 1)) + "%", text_color=quality_score_bear >= quality_threshold_min ? color.green : color.red)
    table.cell(dash, 0, 2, "Daily PnL", text_color=color.white)
    table.cell(dash, 1, 2, "$" + str.tostring(daily_pnl), text_color=daily_pnl >= 0 ? color.green : color.red)
