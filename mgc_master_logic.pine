//@version=6
strategy("MGC Master Logic V7.1 [Converted]", overlay=true, margin_long=100, margin_short=100, currency=currency.USD, initial_capital=50000)

// --- Parameters ---
// Position Sizing
manual_contracts = input.int(12, "Manual Contracts")
use_atr_sizing = input.bool(false, "Use ATR Sizing")
atr_risk_pct = input.float(0.01, "ATR Risk %")
atr_length = input.int(14, "ATR Length")

// HMA Settings
hma_main_len = input.int(55, "HMA Main Length")
hma_fast_len = input.int(21, "HMA Fast Length")
hma_signal_len = input.int(13, "HMA Signal Length")

// Envelope
envelope_pct = input.float(0.002, "Envelope %")

// SuperTrend
supertrend_mult = input.float(3.0, "SuperTrend Multiplier")
supertrend_len = input.int(10, "SuperTrend Length")

// RSI
rsi_len = input.int(14, "RSI Length")
rsi_ob = input.int(60, "RSI Overbought")
rsi_os = input.int(40, "RSI Oversold")

// Risk Management Parameters
min_rr = input.float(1.5, "Min Risk/Reward (Unused in logic directly)")
be_trigger_r = input.float(0.75, "Breakeven Trigger (R)") // Lowered from 1.0 to 0.75 for win rate
be_buffer_mult = input.float(0.1, "BE Buffer Mult")
stop_loss_atr_mult = input.float(2.5, "Stop Loss ATR Mult")
trailing_stop_activation_r_mult = input.float(0.5, "Trailing Activation R Mult")

// Take Profit Parameters
tp1_r = input.float(0.5, "TP1 Target (R)")
tp2_r = input.float(1.0, "TP2 Target (R)")
tp3_r = input.float(1.5, "TP3 Target (R)")
tp4_r = input.float(2.0, "TP4 Target (R)")
tp1_pct = input.float(0.4, "TP1 Percent (0-1)")
tp2_pct = input.float(0.3, "TP2 Percent (0-1)")
tp3_pct = input.float(0.2, "TP3 Percent (0-1)")
tp4_pct = input.float(0.1, "TP4 Percent (0-1)")


// Daily Limits
daily_loss_limit_amount = input.float(1000.0, "Daily Loss Limit ($)")
daily_profit_target_amount = input.float(1000.0, "Daily Profit Target ($)")
circuit_breaker_dd_pct = input.float(0.15, "Circuit Breaker DD %")
max_consecutive_losses = input.int(3, "Max Consecutive Losses")

// Filters
quality_threshold = input.float(80.0, "Quality Threshold")
adx_length = input.int(14, "ADX Length")
adx_threshold = input.int(30, "ADX Threshold") // Raised from 25
session_string = input.session("0600-2100:1234567", "Session Filter (UTC)")

// --- Indicators ---

// HMA Function
f_hma(src, len) =>
    if len <= 0
        na
    else
        half_len = math.floor(len / 2)
        sqrt_len = math.floor(math.sqrt(len))
        wma_half = ta.wma(src, half_len)
        wma_full = ta.wma(src, len)
        hma_raw = 2 * wma_half - wma_full
        ta.wma(hma_raw, sqrt_len)

// ADX Function
f_adx(len) =>
    [di_plus, di_minus, adx_val] = ta.dmi(len, len)
    adx_val

// SuperTrend
[supertrend_val, supertrend_dir] = ta.supertrend(supertrend_mult, supertrend_len)
// Pine: dir=1 (Sell/Down), dir=-1 (Buy/Up).
st_bullish = supertrend_dir == -1
st_bearish = supertrend_dir == 1

// Envelopes
env_upper = close * (1 + envelope_pct)
env_lower = close * (1 - envelope_pct)

// Main Indicators
hma_main = f_hma(close, hma_main_len)
hma_fast = f_hma(close, hma_fast_len)
hma_signal = f_hma(close, hma_signal_len)
rsi_val = ta.rsi(close, rsi_len)
adx_val = f_adx(adx_length)
atr_val = ta.atr(atr_length)

// --- State Variables (Daily Tracking) ---
var float daily_pnl = 0.0
var int consecutive_losses = 0
var float equity_peak = 0.0
var bool daily_stopped = false
var int last_day = -1

// Detect new day
current_day = dayofmonth(time)
is_new_day = current_day != last_day

if is_new_day
    daily_pnl := 0.0
    daily_stopped := false
    // Python code does not reset consecutive_losses daily in _reset_daily
    last_day := current_day

// Update Equity Peak
if strategy.equity > equity_peak
    equity_peak := strategy.equity

// Calculate Drawdown
drawdown_pct = equity_peak > 0 ? (1 - strategy.equity / equity_peak) : 0.0

// Check Limits
if drawdown_pct >= circuit_breaker_dd_pct
    daily_stopped := true

if daily_pnl >= daily_profit_target_amount
    daily_stopped := true

if daily_pnl <= -daily_loss_limit_amount
    daily_stopped := true

if consecutive_losses >= max_consecutive_losses
    daily_stopped := true

// Time Session Check
in_session = not na(time(timeframe.period, session_string))

// --- Quality Score Calculation ---

// Quality Score - Bullish
qs_bull_1 = hma_fast > hma_signal ? 1 : 0
qs_bull_2 = close > hma_main ? 1 : 0
qs_bull_3 = st_bullish ? 1 : 0
qs_bull_4 = rsi_val > 50 ? 1 : 0
qs_bull_5 = close >= env_lower ? 1 : 0
stars_bull = qs_bull_1 + qs_bull_2 + qs_bull_3 + qs_bull_4 + qs_bull_5
score_bull = (stars_bull / 5) * 100

// Quality Score - Bearish (Inferred logic for symmetry)
qs_bear_1 = hma_fast < hma_signal ? 1 : 0
qs_bear_2 = close < hma_main ? 1 : 0
qs_bear_3 = st_bearish ? 1 : 0
qs_bear_4 = rsi_val < 50 ? 1 : 0
qs_bear_5 = close <= env_upper ? 1 : 0
stars_bear = qs_bear_1 + qs_bear_2 + qs_bear_3 + qs_bear_4 + qs_bear_5
score_bear = (stars_bear / 5) * 100

// Entry Logic
// HMA Main Slope
main_slope_up = hma_main > hma_main[4] // Lookback 4
main_slope_down = hma_main < hma_main[4]

// ADX Gate
adx_ok = adx_val >= adx_threshold

// Long Signals
ultra_long = main_slope_up and score_bull >= 90 and st_bullish and rsi_val > rsi_ob and hma_fast > hma_signal
strong_long = main_slope_up and score_bull >= 80 and st_bullish and close > hma_main

valid_long = (ultra_long or strong_long) and score_bull >= quality_threshold and stars_bull >= 4 and adx_ok and in_session and not daily_stopped

// Short Signals
ultra_short = main_slope_down and score_bear >= 90 and st_bearish and rsi_val < rsi_os and hma_fast < hma_signal
strong_short = main_slope_down and score_bear >= 80 and st_bearish and close < hma_main

valid_short = (ultra_short or strong_short) and score_bear >= quality_threshold and stars_bear >= 4 and adx_ok and in_session and not daily_stopped

// --- Position Management Variables ---
var float entry_price = 0.0
var float initial_sl = 0.0
var float initial_r = 0.0
var float initial_qty = 0.0

// Position Sizing
qty_to_trade = manual_contracts
if use_atr_sizing
    risk_per_trade = strategy.equity * atr_risk_pct
    stop_dist_atr = math.max(atr_val * stop_loss_atr_mult, close * 0.001)
    qty_to_trade := math.max(1, math.floor(risk_per_trade / stop_dist_atr))

// Trade Entry
if valid_long and strategy.position_size == 0
    sl_price = close - (atr_val * stop_loss_atr_mult)
    strategy.entry("Long", strategy.long, qty=qty_to_trade, comment="Long")
    // Initialize state
    entry_price := close
    initial_sl := sl_price
    initial_r := close - sl_price
    initial_qty := qty_to_trade

if valid_short and strategy.position_size == 0
    sl_price = close + (atr_val * stop_loss_atr_mult)
    strategy.entry("Short", strategy.short, qty=qty_to_trade, comment="Short")
    // Initialize state
    entry_price := close
    initial_sl := sl_price
    initial_r := sl_price - close
    initial_qty := qty_to_trade

// --- Exit Management ---
if strategy.position_size != 0
    is_long = strategy.position_size > 0
    cur_price = close
    r = initial_r
    
    // Breakeven Logic
    float new_sl = na
    if is_long
        if cur_price >= entry_price + (initial_r * be_trigger_r) // Configurable Trigger
            new_sl := entry_price + (r * be_buffer_mult)
    else
        if cur_price <= entry_price - (initial_r * be_trigger_r) // Configurable Trigger
            new_sl := entry_price - (r * be_buffer_mult)

    // Trailing Stop Logic (SuperTrend)
    profit_trigger = is_long ? (cur_price >= entry_price + (r * trailing_stop_activation_r_mult)) : (cur_price <= entry_price - (r * trailing_stop_activation_r_mult))
    
    if profit_trigger
        if is_long
            if supertrend_val > (na(new_sl) ? initial_sl : new_sl)
                new_sl := supertrend_val
        else
            if supertrend_val < (na(new_sl) ? initial_sl : new_sl)
                new_sl := supertrend_val

    // Determine Active Stop
    // Use new_sl if set and better than initial/previous, otherwise maintain structure
    // In Pine, we submit exit orders every tick.
    // If new_sl is NA, use initial_sl.
    // Note: If we already moved SL to BE, we shouldn't move it back. 
    // We should track the "current best stop".
    
    var float current_stop = 0.0
    if strategy.position_size != strategy.position_size[1] // Reset on new trade or partial
        if strategy.position_size[1] == 0
            current_stop := initial_sl
    
    if not na(new_sl)
        // Only move stop in favorable direction
        if is_long
            if new_sl > current_stop
                current_stop := new_sl
        else
            if new_sl < current_stop
                current_stop := new_sl
                
    // Execute Exits
    // TP Splits configurable via inputs
    
    qty_1 = math.round(initial_qty * tp1_pct)
    qty_2 = math.round(initial_qty * tp2_pct)
    qty_3 = math.round(initial_qty * tp3_pct)
    qty_4 = math.round(initial_qty * tp4_pct)
    
    tp1_p = is_long ? entry_price + (tp1_r * r) : entry_price - (tp1_r * r)
    tp2_p = is_long ? entry_price + (tp2_r * r) : entry_price - (tp2_r * r)
    tp3_p = is_long ? entry_price + (tp3_r * r) : entry_price - (tp3_r * r)
    tp4_p = is_long ? entry_price + (tp4_r * r) : entry_price - (tp4_r * r)
    
    id_base = is_long ? "Exit Long" : "Exit Short"
    
    // We use strategy.exit multiple times for partials
    strategy.exit("TP1", from_entry = is_long ? "Long" : "Short", qty = qty_1, limit = tp1_p, stop = current_stop)
    strategy.exit("TP2", from_entry = is_long ? "Long" : "Short", qty = qty_2, limit = tp2_p, stop = current_stop)
    strategy.exit("TP3", from_entry = is_long ? "Long" : "Short", qty = qty_3, limit = tp3_p, stop = current_stop)
    strategy.exit("TP4", from_entry = is_long ? "Long" : "Short", qty = qty_4, limit = tp4_p, stop = current_stop)
    
    // Catch-all stop for remaining (if rounding errors or if above TPs didn't cover 100% due to int math)
    // strategy.exit("Stop All", from_entry = is_long ? "Long" : "Short", stop = current_stop)

// Max Hold Time
if strategy.position_size != 0
    ms_held = time - strategy.opentrades.entry_time(strategy.opentrades - 1)
    if ms_held >= 8 * 60 * 60 * 1000
        strategy.close_all(comment="Time Exit")

// PnL Tracking
var int last_closed_trades = 0
if strategy.closedtrades > last_closed_trades
    for i = last_closed_trades to strategy.closedtrades - 1
        pnl = strategy.closedtrades.profit(i)
        daily_pnl := daily_pnl + pnl
        if pnl < 0
            consecutive_losses := consecutive_losses + 1
        else
            consecutive_losses := 0
    last_closed_trades := strategy.closedtrades

// Visuals
plot(hma_main, "HMA Main", color=color.blue)
plot(hma_fast, "HMA Fast", color=color.yellow)
plot(hma_signal, "HMA Signal", color=color.purple)
plot(env_upper, "Env Upper", color=color.gray)
plot(env_lower, "Env Lower", color=color.gray)
plot(supertrend_val, "SuperTrend", color = supertrend_dir == 1 ? color.red : color.green)
